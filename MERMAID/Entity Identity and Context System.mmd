        Identity --> Subjective[Subjective Identity]
        Identity --> Objective[Objective Identity]
        Identity --> Relative[Relative Identity]
        
        Entity --> Context[Context/Path]
        Context --> ChildPaths[Derived Child Paths]
        
        subgraph Language_Processing
            WordNet[WordNet Database]
