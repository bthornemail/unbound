#!/bin/rc
# codep.rc - inside Plan 9: the four files compared independently to YHWH and
# YAHWEH, and codependently to each other (zcodep).
rfork e
w=/tmp/zc2
rm -rf $w
mkdir -p $w/unbound $w/zout
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zcodep.c} || exit tar
cd $w/unbound/PLAN9/src
8c zcodep.c && 8l -o $w/zcodep zcodep.8 || exit compile
{ echo 'GOD IS WORD'; echo 'GOD OF WORD'; echo 'WORD IS GOD'; echo 'WORD OF GOD'; echo YHWH; echo YAHWEH } | $w/zcodep >$w/zout/codep.txt >[2=1]
@{cd $w && tar cf /dev/sd02/data zout} || exit tar
tail -1 $w/zout/codep.txt
