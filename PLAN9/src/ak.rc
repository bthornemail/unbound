#!/bin/rc
# ak.rc - inside Plan 9: the author's atomic-kernel, the first project after the
# delta law (zak.c), its three versions against their own goldens (in/ak): 16d-v1
# against the Haskell fixtures at widths 16 to 256, the Coq law against the Coq
# golden, kernel-v1 against kernel.py; then the law: period half the width.
rfork e
w=/tmp/zak
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zak.c PLAN9/in/ak} || exit tar
a=$w/unbound/PLAN9/in/ak
cd $w/unbound/PLAN9/src
8c zak.c && 8l -o $w/zak zak.8 || exit compile
fail=0
for(n in 16 32 64 128 256){
	seed=`{sed 1q $a/haskell-$n | sed 's/^[0-9]+ ([^ ]+) .*/\1/'}
	$w/zak delta $n $seed 16 > $w/d$n
	if(cmp -s $w/d$n $a/haskell-$n) echo ok 16d-v1 at width $n: 16 steps as the Haskell fixture, state and band
	if not { echo FAIL width $n differs from the Haskell fixture; fail=1 }
}
$w/zak delta 16 0x0001 8 | sed 's/^([0-9]+ [^ ]+) .*/\1/' > $w/coq
if(cmp -s $w/coq $a/coq-16) echo ok the Coq law: 8 states as the Coq golden from 0x0001
if not { echo FAIL the Coq golden differs; fail=1 }
$w/zak kernel 0x06AC 24 > $w/kernel
if(cmp -s $w/kernel $a/kernel) echo ok kernel-v1: 24 ticks as kernel.py, state, position, orbit, offset, phase, B, band
if not { echo FAIL kernel-v1 differs; fail=1 }
$w/zak law || fail=1
$w/zak period > $w/period
if(cmp -s $w/period $a/period) echo ok the period at every byte width 16 to 256 as measured on the host, `{wc -l < $w/period} widths
if not { echo FAIL the periods differ; diff $w/period $a/period; fail=1 }
$w/zak order > $w/order
if(cmp -s $w/order $a/order) echo ok the order by algebra at every byte width, `{wc -l < $w/order} widths, 248 the one where L is no unit
if not { echo FAIL the orders differ; diff $w/order $a/order; fail=1 }
if(~ $fail 0) echo 'ak.rc: every answer as expected'
