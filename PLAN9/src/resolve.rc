#!/bin/rc
# resolve.rc - inside Plan 9: omi-dom's shared/prolog-resolve.js in rc, as the
# wordnet shim did for WordNet: no Prolog, a table and a lookup. A message is
# classified by switch on glob patterns, its kind looked up in the rule table
# (a switch), the action run as recover() does. Every case must give the
# module's kind, action, rule and output (in/resolve, written by selfHeal on the
# host, each case four lines: kind, message, input, command); every version the
# answer of compatibleVersion (zver.c, parseInt as JavaScript reads it, since rc
# has no arithmetic); each (kind, action) asked of wsn/resolve.wsn, in the
# relation exactly when a rule matched. The module lowercases the message, then
# tests ePIPE: a condition that cannot hold, since epipe beside it is what matches.
rfork e
w=/tmp/zres
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zlazy.c PLAN9/src/zver.c PLAN9/wsn/resolve.wsn PLAN9/in/resolve} || exit tar
p=$w/unbound/PLAN9
cd $p/src
for(t in zlazy zver){
	8c $t.c && 8l -o $w/$t $t.8 || exit compile
}
tab='	'
ifs='
'
# the rule table: error(Kind) to recover(Action); a kind not here has no rule
fn rule {
	switch($1){
	case unknown_command
		echo fallback
	case invalid_input
		echo sanitize
	case stream_broken
		echo reconnect
	case version_mismatch
		echo upgrade
	case state_corrupt
		echo reset
	case unknown
		echo default
	}
}
# toLowerCase as far as the patterns can see: ASCII, and the Kelvin sign, which lowers to k
fn classify {
	m=`{echo -n $1 | tr 'A-ZK' 'a-zk'}
	switch($"m){
	case *'not found'* *'unknown command'*
		echo unknown_command
	case *invalid*
		echo invalid_input
	case *stream* *epipe*
		echo stream_broken
	case *version*
		echo version_mismatch
	case *corrupt*
		echo state_corrupt
	case *
		echo unknown
	}
}
fn recover {
	switch($1){
	case fallback
		echo 'help: known applets echo|cat|xor|true|false — tried: '^$"command
	case sanitize
		s=$"input
		if(~ $s '') s=$"message
		echo -n $s | tr -d -c 'A-Za-z0-9_.\055 \011\012\013\014\015   -     　﻿'
		echo
	case reconnect
		echo 'streams reconnected (virtual)'
	case upgrade
		echo 'compat mode 1.36.0..2.0.0'
	case reset
		echo 'state reset'
	case *
		echo 'default recovery'
	}
}
fail=0
c=$p/in/resolve/cases
n=`{wc -l < $c}
k1=`{seq 1 4 $n}
k2=`{seq 2 4 $n}
k3=`{seq 3 4 $n}
k4=`{seq 4 4 $n}
{ for(i in `{seq $#k1}){
	kind=`{sed -n $k1($i)^p $c}
	message=`{sed -n $k2($i)^p $c}
	input=`{sed -n $k3($i)^p $c}
	command=`{sed -n $k4($i)^p $c}
	if(~ $"kind '') kind=`{classify $"message}
	action=`{rule $"kind}
	r=rule
	if(~ $"action ''){ action=default; r=none }
	out=`{recover $"action}
	echo $"kind^$tab^$"action^$tab^$r^$tab^$"out
	echo $"kind' '$"action' '$r >> $w/pairs
} } > $w/got
if(cmp -s $w/got $p/in/resolve/expected) echo ok every case gives the kind, action, rule and output of the module, `{wc -l < $w/got} cases
if not { echo FAIL the cases differ; diff $w/got $p/in/resolve/expected; fail=1 }
$w/zver $p/in/resolve/versions > $w/versions
if(cmp -s $w/versions $p/in/resolve/versions.expected) echo ok every version gets the answer of the module, `{wc -l < $w/versions} versions
if not { echo FAIL the versions differ; diff $w/versions $p/in/resolve/versions.expected; fail=1 }
ifs=' 
'
{ for(i in `{seq `{wc -l < $w/pairs}}){
	x=`{sed -n $i^p $w/pairs}
	if($w/zlazy $p/wsn/resolve.wsn RESOLUTION $x(1)^' '^$x(2) >/dev/null) a=rule
	if not a=none
	if(~ $a $x(3)) echo same
	if not echo DIFFERS $x
} } > $w/rel
ifs='
'
if(! grep -s DIFFERS $w/rel) echo ok each kind and action is in the WSN relation exactly when a rule matched
if not { echo FAIL; grep DIFFERS $w/rel; fail=1 }
# the module selfTest, its six assertions
if(~ `{classify 'command not found'} unknown_command) echo ok classify not found
if not fail=1
if(~ `{rule unknown_command} fallback) echo ok resolve fallback
if not fail=1
input='a<script>' message='' { o=`{recover sanitize} }
if(! ~ $"o *'<'*) echo ok sanitize healed
if not fail=1
v=`{sed -n 1,3p $w/versions}
if(~ $"v 'yes yes no') echo ok compat 1.36, compat 2.0, incompat 3.0
if not fail=1
if(~ $fail 0) echo 'resolve.rc: every answer as expected'
