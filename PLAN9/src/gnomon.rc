#!/bin/rc
# gnomon.rc - inside Plan 9: why I-195's gnomon has eight frames (zgnomon.c).
rfork e
w=/tmp/zgnomon
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zgnomon.c} || exit tar
cd $w/unbound/PLAN9/src
8c zgnomon.c && 8l -o $w/zgnomon zgnomon.8 || exit compile
$w/zgnomon && echo 'gnomon.rc: every answer as expected'
