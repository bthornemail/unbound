#!/bin/rc
# repfs.rc - inside Plan 9: every number a path that resolves (src/repfs.c). Builds repfs, mounts it at /n/repetend,
# and for each line of in/repfs/cases asks whether the path resolves and, if so, its qid (the number as
# num<<32 | den) and its listing (its literal equivalents, N÷D and I.P(R)), one line a case; the answers must be
# in/repfs/expected, computed on the host by in/repfs/gen.mjs apart from repfs.c. With -s, repfs stays mounted.
rfork e
ifs='
'
w=/tmp/zrepfs
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/repfs.c PLAN9/in/repfs} || exit tar
p=$w/unbound/PLAN9
cd $p/src
8c repfs.c && 8l -o $w/repfs repfs.8 || exit compile
unmount /n/repetend >[2]/dev/null
rm -f /srv/repetend
$w/repfs || exit repfs
{ for(c in `{cat $p/in/repfs/cases}){
	f=/n/repetend/$c
	if(test -d $f){
		q=`{ls -qd $f | sed 's/^\(([0-9a-f]+) .*/\1/'}
		n=`{ls -pQ $f}
		ifs=' ' { echo $c: $q $n }
	}
	if not echo $c: refused
} } >$w/answers
if(cmp -s $w/answers $p/in/repfs/expected) echo 'repfs.rc: every answer as expected,' `{wc -l <$w/answers} cases
if not { echo 'repfs.rc: answers DIFFER'; diff $w/answers $p/in/repfs/expected | sed 12q }
@{cd $w && tar cf /dev/sd02/data answers} || exit tar
if(! ~ $1 -s) unmount /n/repetend
