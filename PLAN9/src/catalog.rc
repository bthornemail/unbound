#!/bin/rc
# catalog.rc - inside Plan 9: every _CATALOG entry, Wirth syntax notation at its
# source (ZIGUAROTH no longer keeps YAML), each read by zwsn, the readings
# written to the output disk.
rfork e
ifs='
'
w=/tmp/zk
rm -rf $w
mkdir -p $w/unbound $w/zout
@{cd $w/unbound && tar xf /dev/sd01/data} || exit tar
p=$w/unbound/PLAN9
cd $p/src
8c zwsn.c && 8l -o $w/zwsn zwsn.8 || exit compile
cd $p/run/catalog
for(f in `{du -a . | sed 's/^[0-9]+[ 	]+//; s,^\./,,' | grep '\.wsn$'})
	$w/zwsn $f >>$w/zout/catalog.txt
@{cd $w && tar cf /dev/sd02/data zout} || exit tar
