#!/bin/rc
# probe.rc - inside Plan 9: omi-dom's shared module ported (zprobe.c), its selfTest
# as the module makes it, then the check it names, with a falsifier.
rfork e
w=/tmp/zprobe
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zprobe.c} || exit tar
cd $w/unbound/PLAN9/src
8c zprobe.c && 8l -o $w/zprobe zprobe.8 || exit compile
fail=0
$w/zprobe test || fail=1
$w/zprobe probe || fail=1
$w/zprobe falsify || fail=1
if(~ $fail 0) echo 'probe.rc: every answer as expected'
