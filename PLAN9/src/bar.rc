#!/bin/rc
# bar.rc - inside Plan 9: omi-dom's shared module ported (zbar.c), its selfTest
# as the module makes it, then the check it names, with a falsifier.
rfork e
w=/tmp/zbar
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zbar.c} || exit tar
cd $w/unbound/PLAN9/src
8c zbar.c && 8l -o $w/zbar zbar.8 || exit compile
fail=0
$w/zbar test || fail=1
$w/zbar race || fail=1
$w/zbar falsify || fail=1
if(~ $fail 0) echo 'bar.rc: every answer as expected'
