#!/bin/rc
# hand.rc - inside Plan 9: parity handshakes between two 9P nodes (ramfs),
# each holding blocks 0 .. n-1 (zhand).
rfork ne
w=/tmp/zh3
rm -rf $w
mkdir -p $w/unbound
@{cd $w/unbound && tar xf /dev/sd01/data PLAN9/src/zhand.c} || exit tar
cd $w/unbound/PLAN9/src
8c zhand.c && 8l -o $w/zhand zhand.8 || exit compile
fn node {
	rm -f /srv/$1
	mkdir -p /n/$1
	ramfs -S $1 -m /n/$1
}
fn put {
	d=$1; i=0
	for(b in `{echo $2}){ echo -n $b > $d/$i; i=`{echo $i + 1 | hoc} }
}
fn shake {
	echo '==' $1
	node nodeA; node nodeB
	put /n/nodeA $2
	put /n/nodeB $3
	$w/zhand /n/nodeA /n/nodeB $4
	unmount /n/nodeA; unmount /n/nodeB; rm -f /srv/nodeA /srv/nodeB
}
# each node's blocks as one string, split on spaces (rc flattens list arguments)
shake 'rotation' 'GOD IS WORD' 'IS WORD GOD' 3
shake 'reversal' 'GOD IS WORD' 'WORD IS GOD' 3
shake 'four blocks, past rotation and rev' 'W O R D' 'O W R D' 4
shake 'different blocks' 'GOD IS WORD' 'GOD OF WORD' 3
