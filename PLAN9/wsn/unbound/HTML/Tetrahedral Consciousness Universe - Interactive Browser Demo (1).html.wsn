FILE = HEAD .

HEAD =
  "<!DOCTYPE html>"
  "<html lang=""en"">"
  "<head>"
  "    <meta charset=""UTF-8"">"
  "    <meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">"
  "    <title>Tetrahedral Consciousness Universe</title>"
  "    <script src=""https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js""></script>"
  "    <style>"
  "        body {"
  "            margin: 0;"
  "            padding: 0;"
  "            background: linear-gradient(135deg, #0a0a0a, #1a1a2e, #16213e);"
  "            font-family: 'Courier New', monospace;"
  "            color: #ffffff;"
  "            overflow: hidden;"
  "        }"
  "        #container {"
  "            position: relative;"
  "            width: 100vw;"
  "            height: 100vh;"
  "        }"
  "        #controls {"
  "            position: absolute;"
  "            top: 20px;"
  "            left: 20px;"
  "            z-index: 100;"
  "            background: rgba(0, 0, 0, 0.8);"
  "            padding: 20px;"
  "            border-radius: 10px;"
  "            border: 1px solid #444;"
  "            backdrop-filter: blur(10px);"
  "            min-width: 300px;"
  "        }"
  "        #info {"
  "            position: absolute;"
  "            top: 20px;"
  "            right: 20px;"
  "            z-index: 100;"
  "            background: rgba(0, 0, 0, 0.8);"
  "            padding: 20px;"
  "            border-radius: 10px;"
  "            border: 1px solid #444;"
  "            backdrop-filter: blur(10px);"
  "            min-width: 250px;"
  "            font-size: 12px;"
  "        }"
  "        .control-group {"
  "            margin-bottom: 15px;"
  "        }"
  "        label {"
  "            display: block;"
  "            margin-bottom: 5px;"
  "            color: #00ffff;"
  "            font-size: 14px;"
  "        }"
  "        input[type=""range""] {"
  "            width: 100%;"
  "            margin-bottom: 5px;"
  "        }"
  "        button {"
  "            background: linear-gradient(45deg, #ff6b6b, #ff8e53);"
  "            border: none;"
  "            color: white;"
  "            padding: 10px 20px;"
  "            border-radius: 5px;"
  "            cursor: pointer;"
  "            margin: 5px;"
  "            font-weight: bold;"
  "        }"
  "        button:hover {"
  "            opacity: 0.8;"
  "        }"
  "        .metric {"
  "            display: flex;"
  "            justify-content: space-between;"
  "            margin: 5px 0;"
  "            padding: 5px;"
  "            background: rgba(255, 255, 255, 0.1);"
  "            border-radius: 3px;"
  "        }"
  "        .binary-display {"
  "            font-family: 'Courier New', monospace;"
  "            font-size: 11px;"
  "            margin: 2px 0;"
  "            padding: 3px;"
  "            background: rgba(0, 255, 255, 0.1);"
  "            border-radius: 2px;"
  "        }"
  "        #title {"
  "            position: absolute;"
  "            bottom: 20px;"
  "            left: 50%;"
  "            transform: translateX(-50%);"
  "            z-index: 100;"
  "            font-size: 24px;"
  "            font-weight: bold;"
  "            color: #00ffff;"
  "            text-shadow: 0 0 10px #00ffff;"
  "        }"
  "    </style>"
  "</head>"
  "<body>"
  "    <div id=""container"">"
  "        <div id=""controls"">"
  "            <h3 style=""color: #00ffff; margin-top: 0;"">Consciousness Controls</h3>"
  "            <div class=""control-group"">"
  "                <label for=""alpha"">Consciousness Focus (α): <span id=""alphaValue"">1.0</span></label>"
  "                <input type=""range"" id=""alpha"" min=""0.1"" max=""3.0"" step=""0.1"" value=""1.0"">"
  "            </div>"
  "            <div class=""control-group"">"
  "                <label for=""mutationRate"">Quantum Noise: <span id=""mutationValue"">0.1</span></label>"
  "                <input type=""range"" id=""mutationRate"" min=""0.01"" max=""0.5"" step=""0.01"" value=""0.1"">"
  "            </div>"
  "            <div class=""control-group"">"
  "                <label for=""evolutionSpeed"">Time Flow: <span id=""speedValue"">100</span>ms</label>"
  "                <input type=""range"" id=""evolutionSpeed"" min=""50"" max=""1000"" step=""50"" value=""300"">"
  "            </div>"
  "            <div class=""control-group"">"
  "                <button id=""startStop"">Start Evolution</button>"
  "                <button id=""reset"">Reset Universe</button>"
  "                <button id=""step"">Single Step</button>"
  "            </div>"
  "        </div>"
  "        <div id=""info"">"
  "            <h3 style=""color: #00ffff; margin-top: 0;"">Consciousness Metrics</h3>"
  "            <div class=""metric"">"
  "                <span>Time Step:</span>"
  "                <span id=""timeStep"">0</span>"
  "            </div>"
  "            <div class=""metric"">"
  "                <span>Entropy:</span>"
  "                <span id=""entropy"">0.000</span>"
  "            </div>"
  "            <div class=""metric"">"
  "                <span>Coherence:</span>"
  "                <span id=""coherence"">0.000</span>"
  "            </div>"
  "            <div class=""metric"">"
  "                <span>Integration:</span>"
  "                <span id=""integration"">0.000</span>"
  "            </div>"
  "            <div style=""margin-top: 15px;"">"
  "                <h4 style=""color: #00ffff;"">Binary States:</h4>"
  "                <div id=""binaryStates""></div>"
  "            </div>"
  "            <div style=""margin-top: 15px;"">"
  "                <h4 style=""color: #00ffff;"">Centroid:</h4>"
  "                <div id=""centroidDisplay"" style=""font-family: 'Courier New', monospace; font-size: 11px;""></div>"
  "            </div>"
  "        </div>"
  "        <div id=""title"">Tetrahedral Consciousness Universe</div>"
  "    </div>"
  "    <script>"
  "        class TetrahedralConsciousness {"
  "            constructor() {"
  "                this.scene = new THREE.Scene();"
  "                this.camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);"
  "                this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });"
  "                this.setupRenderer();"
  "                this.setupCamera();"
  "                this.setupLighting();"
  "                // Tetrahedral vertices (normalized)"
  "                this.vertices = ["
  "                    new THREE.Vector3(1, 1, 1).normalize(),"
  "                    new THREE.Vector3(1, -1, -1).normalize(),"
  "                    new THREE.Vector3(-1, 1, -1).normalize(),"
  "                    new THREE.Vector3(-1, -1, 1).normalize()"
  "                ];"
  "                // Binary states (8-bit each vertex)"
  "                this.binaryStates = ["
  "                    this.randomBinary(),"
  "                    this.randomBinary(),"
  "                    this.randomBinary(),"
  "                    this.randomBinary()"
  "                ];"
  "                // Parameters"
  "                this.alpha = 1.0;"
  "                this.mutationRate = 0.1;"
  "                this.timeStep = 0;"
  "                this.isRunning = false;"
  "                this.evolutionInterval = null;"
  "                // History for consciousness trajectory"
  "                this.centroidHistory = [];"
  "                this.maxHistoryLength = 100;"
  "                // 3D Objects"
  "                this.vertexSpheres = [];"
  "                this.attentionArrows = [];"
  "                this.centroidStar = null;"
  "                this.trajectoryLine = null;"
  "                this.tetrahedronEdges = null;"
  "                this.initializeScene();"
  "                this.setupControls();"
  "                this.updateDisplay();"
  "                this.animate();"
  "            }"
  "            setupRenderer() {"
  "                this.renderer.setSize(window.innerWidth, window.innerHeight);"
  "                this.renderer.setClearColor(0x000000, 0);"
  "                this.renderer.shadowMap.enabled = true;"
  "                this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;"
  "                document.getElementById('container').appendChild(this.renderer.domElement);"
  "            }"
  "            setupCamera() {"
  "                this.camera.position.set(3, 3, 3);"
  "                this.camera.lookAt(0, 0, 0);"
  "            }"
  "            setupLighting() {"
  "                // Ambient light"
  "                const ambientLight = new THREE.AmbientLight(0x404040, 0.3);"
  "                this.scene.add(ambientLight);"
  "                // Directional light"
  "                const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);"
  "                directionalLight.position.set(5, 5, 5);"
  "                directionalLight.castShadow = true;"
  "                this.scene.add(directionalLight);"
  "                // Point lights for atmosphere"
  "                const pointLight1 = new THREE.PointLight(0x00ffff, 0.5, 10);"
  "                pointLight1.position.set(2, 2, 2);"
  "                this.scene.add(pointLight1);"
  "                const pointLight2 = new THREE.PointLight(0xff00ff, 0.5, 10);"
  "                pointLight2.position.set(-2, -2, -2);"
  "                this.scene.add(pointLight2);"
  "            }"
  "            randomBinary() {"
  "                return Array.from({length: 8}, () => Math.random() > 0.5 ? 1 : 0);"
  "            }"
  "            binaryToAttentionVector(binary) {"
  "                // Convert 8-bit binary to spherical coordinates"
  "                const thetaBits = binary.slice(0, 4);"
  "                const phiBits = binary.slice(4, 8);"
  "                const theta = (parseInt(thetaBits.join(''), 2) / 15.0) * Math.PI;"
  "                const phi = (parseInt(phiBits.join(''), 2) / 15.0) * 2 * Math.PI;"
  "                return new THREE.Vector3("
  "                    Math.sin(theta) * Math.cos(phi),"
  "                    Math.sin(theta) * Math.sin(phi),"
  "                    Math.cos(theta)"
  "                );"
  "            }"
  "            getAttentionVectors() {"
  "                return this.binaryStates.map(binary => this.binaryToAttentionVector(binary));"
  "            }"
  "            computeCentroid(attentionVectors) {"
  "                if (this.alpha === 1.0) {"
  "                    // Linear centroid"
  "                    const sum = attentionVectors.reduce((acc, vec) => acc.add(vec), new THREE.Vector3());"
  "                    return sum.divideScalar(attentionVectors.length);"
  "                } else {"
  "                    // Nonlinear centroid"
  "                    const weightedSum = new THREE.Vector3();"
  "                    attentionVectors.forEach(vec => {"
  "                        const powered = new THREE.Vector3("
  "                            Math.sign(vec.x) * Math.pow(Math.abs(vec.x), this.alpha),"
  "                            Math.sign(vec.y) * Math.pow(Math.abs(vec.y), this.alpha),"
  "                            Math.sign(vec.z) * Math.pow(Math.abs(vec.z), this.alpha)"
  "                        );"
  "                        weightedSum.add(powered);"
  "                    });"
  "                    weightedSum.divideScalar(attentionVectors.length);"
  "                    return new THREE.Vector3("
  "                        Math.sign(weightedSum.x) * Math.pow(Math.abs(weightedSum.x), 1/this.alpha),"
  "                        Math.sign(weightedSum.y) * Math.pow(Math.abs(weightedSum.y), 1/this.alpha),"
  "                        Math.sign(weightedSum.z) * Math.pow(Math.abs(weightedSum.z), 1/this.alpha)"
  "                    );"
  "                }"
  "            }"
  "            computeMetrics(attentionVectors, centroid) {"
  "                // Shannon entropy"
  "                let entropy = 0;"
  "                this.binaryStates.forEach(binary => {"
  "                    const p = binary.reduce((sum, bit) => sum + bit, 0) / 8;"
  "                    if (p > 0 && p < 1) {"
  "                        entropy += -(p * Math.log2(p) + (1-p) * Math.log2(1-p));"
  "                    }"
  "                });"
  "                entropy /= 4;"
  "                // Coherence - alignment with centroid"
  "                const coherence = attentionVectors.reduce((sum, vec) => "
  "                    sum + vec.dot(centroid), 0) / attentionVectors.length;"
  "                // Integration - centroid magnitude"
  "                const integration = centroid.length();"
  "                return { entropy, coherence, integration };"
  "            }"
  "            evolveSystem() {"
  "                const attentionVectors = this.getAttentionVectors();"
  "                const centroid = this.computeCentroid(attentionVectors);"
  "                // Store centroid in history"
  "                this.centroidHistory.push(centroid.clone());"
  "                if (this.centroidHistory.length > this.maxHistoryLength) {"
  "                    this.centroidHistory.shift();"
  "                }"
  "                // Evolve binary states"
  "                for (let i = 0; i < 4; i++) {"
  "                    const alignment = attentionVectors[i].dot(centroid);"
  "                    const adaptiveMutation = this.mutationRate * (1 - Math.abs(alignment));"
  "                    for (let j = 0; j < 8; j++) {"
  "                        if (Math.random() < adaptiveMutation) {"
  "                            this.binaryStates[i][j] = 1 - this.binaryStates[i][j];"
  "                        }"
  "                    }"
  "                }"
  "                this.timeStep++;"
  "                this.updateScene();"
  "                this.updateDisplay();"
  "            }"
  "            initializeScene() {"
  "                // Create tetrahedron edges"
  "                const edgeGeometry = new THREE.BufferGeometry();"
  "                const edgePositions = [];"
  "                const edges = [[0,1], [0,2], [0,3], [1,2], [1,3], [2,3]];"
  "                edges.forEach(([i, j]) => {"
  "                    edgePositions.push(...this.vertices[i].toArray());"
  "                    edgePositions.push(...this.vertices[j].toArray());"
  "                });"
  "                edgeGeometry.setAttribute('position', new THREE.Float32BufferAttribute(edgePositions, 3));"
  "                const edgeMaterial = new THREE.LineBasicMaterial({ color: 0x444444, transparent: true, opacity: 0.3 });"
  "                this.tetrahedronEdges = new THREE.LineSegments(edgeGeometry, edgeMaterial);"
  "                this.scene.add(this.tetrahedronEdges);"
  "                // Create vertex spheres"
  "                for (let i = 0; i < 4; i++) {"
  "                    const geometry = new THREE.SphereGeometry(0.08, 16, 16);"
  "                    const material = new THREE.MeshPhongMaterial({ "
  "                        color: 0xff0000,"
  "                        emissive: 0x330000,"
  "                        transparent: true,"
  "                        opacity: 0.8"
  "                    });"
  "                    const sphere = new THREE.Mesh(geometry, material);"
  "                    sphere.position.copy(this.vertices[i]);"
  "                    sphere.castShadow = true;"
  "                    this.vertexSpheres.push(sphere);"
  "                    this.scene.add(sphere);"
  "                }"
  "                // Create centroid star"
  "                const starGeometry = new THREE.SphereGeometry(0.12, 8, 6);"
  "                const starMaterial = new THREE.MeshPhongMaterial({ "
  "                    color: 0xffd700,"
  "                    emissive: 0x664400,"
  "                    transparent: true,"
  "                    opacity: 0.9"
  "                });"
  "                this.centroidStar = new THREE.Mesh(starGeometry, starMaterial);"
  "                this.centroidStar.castShadow = true;"
  "                this.scene.add(this.centroidStar);"
  "                this.updateScene();"
  "            }"
  "            updateScene() {"
  "                const attentionVectors = this.getAttentionVectors();"
  "                const centroid = this.computeCentroid(attentionVectors);"
  "                // Update vertex colors based on Hamming weight"
  "                this.vertexSpheres.forEach((sphere, i) => {"
  "                    const hammingWeight = this.binaryStates[i].reduce((sum, bit) => sum + bit, 0);"
  "                    const intensity = hammingWeight / 8;"
  "                    sphere.material.color.setHSL(0.6 - intensity * 0.6, 1, 0.5 + intensity * 0.3);"
  "                    sphere.material.emissive.setHSL(0.6 - intensity * 0.6, 1, intensity * 0.2);"
  "                });"
  "                // Remove old attention arrows"
  "                this.attentionArrows.forEach(arrow => this.scene.remove(arrow));"
  "                this.attentionArrows = [];"
  "                // Create new attention arrows"
  "                attentionVectors.forEach((vec, i) => {"
  "                    const origin = this.vertices[i];"
  "                    const direction = vec.clone().normalize();"
  "                    const length = 0.5;"
  "                    const arrowHelper = new THREE.ArrowHelper(direction, origin, length, "
  "                        this.vertexSpheres[i].material.color.getHex(), length * 0.2, length * 0.1);"
  "                    arrowHelper.line.material.transparent = true;"
  "                    arrowHelper.line.material.opacity = 0.7;"
  "                    arrowHelper.cone.material.transparent = true;"
  "                    arrowHelper.cone.material.opacity = 0.7;"
  "                    this.attentionArrows.push(arrowHelper);"
  "                    this.scene.add(arrowHelper);"
  "                });"
  "                // Update centroid position"
  "                this.centroidStar.position.copy(centroid);"
  "                // Update trajectory line"
  "                if (this.trajectoryLine) {"
  "                    this.scene.remove(this.trajectoryLine);"
  "                }"
  "                if (this.centroidHistory.length > 1) {"
  "                    const trajectoryGeometry = new THREE.BufferGeometry();"
  "                    const positions = [];"
  "                    this.centroidHistory.forEach(point => {"
  "                        positions.push(...point.toArray());"
  "                    });"
  "                    trajectoryGeometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));"
  "                    const trajectoryMaterial = new THREE.LineBasicMaterial({ "
  "                        color: 0xffd700, "
  "                        transparent: true, "
  "                        opacity: 0.6 "
  "                    });"
  "                    this.trajectoryLine = new THREE.Line(trajectoryGeometry, trajectoryMaterial);"
  "                    this.scene.add(this.trajectoryLine);"
  "                }"
  "            }"
  "            updateDisplay() {"
  "                const attentionVectors = this.getAttentionVectors();"
  "                const centroid = this.computeCentroid(attentionVectors);"
  "                const metrics = this.computeMetrics(attentionVectors, centroid);"
  "                // Update metrics"
  "                document.getElementById('timeStep').textContent = this.timeStep;"
  "                document.getElementById('entropy').textContent = metrics.entropy.toFixed(3);"
  "                document.getElementById('coherence').textContent = metrics.coherence.toFixed(3);"
  "                document.getElementById('integration').textContent = metrics.integration.toFixed(3);"
  "                // Update binary states display"
  "                const binaryContainer = document.getElementById('binaryStates');"
  "                binaryContainer.innerHTML = '';"
  "                this.binaryStates.forEach((binary, i) => {"
  "                    const div = document.createElement('div');"
  "                    div.className = 'binary-display';"
  "                    const hammingWeight = binary.reduce((sum, bit) => sum + bit, 0);"
  "                    div.innerHTML = `V${i}: ${binary.join('')} (${hammingWeight})`;"
  "                    binaryContainer.appendChild(div);"
  "                });"
  "                // Update centroid display"
  "                document.getElementById('centroidDisplay').textContent = "
  "                    `[${centroid.x.toFixed(3)}, ${centroid.y.toFixed(3)}, ${centroid.z.toFixed(3)}]`;"
  "            }"
  "            setupControls() {"
  "                // Alpha control"
  "                const alphaSlider = document.getElementById('alpha');"
  "                const alphaValue = document.getElementById('alphaValue');"
  "                alphaSlider.addEventListener('input', (e) => {"
  "                    this.alpha = parseFloat(e.target.value);"
  "                    alphaValue.textContent = this.alpha.toFixed(1);"
  "                    this.updateScene();"
  "                    this.updateDisplay();"
  "                });"
  "                // Mutation rate control"
  "                const mutationSlider = document.getElementById('mutationRate');"
  "                const mutationValue = document.getElementById('mutationValue');"
  "                mutationSlider.addEventListener('input', (e) => {"
  "                    this.mutationRate = parseFloat(e.target.value);"
  "                    mutationValue.textContent = this.mutationRate.toFixed(2);"
  "                });"
  "                // Evolution speed control"
  "                const speedSlider = document.getElementById('evolutionSpeed');"
  "                const speedValue = document.getElementById('speedValue');"
  "                speedSlider.addEventListener('input', (e) => {"
  "                    const speed = parseInt(e.target.value);"
  "                    speedValue.textContent = speed;"
  "                    if (this.isRunning) {"
  "                        this.stopEvolution();"
  "                        this.startEvolution(speed);"
  "                    }"
  "                });"
  "                // Start/Stop button"
  "                document.getElementById('startStop').addEventListener('click', () => {"
  "                    if (this.isRunning) {"
  "                        this.stopEvolution();"
  "                    } else {"
  "                        const speed = parseInt(document.getElementById('evolutionSpeed').value);"
  "                        this.startEvolution(speed);"
  "                    }"
  "                });"
  "                // Reset button"
  "                document.getElementById('reset').addEventListener('click', () => {"
  "                    this.reset();"
  "                });"
  "                // Step button"
  "                document.getElementById('step').addEventListener('click', () => {"
  "                    this.evolveSystem();"
  "                });"
  "                // Mouse controls for camera"
  "                let mouseDown = false;"
  "                let mouseX = 0, mouseY = 0;"
  "                this.renderer.domElement.addEventListener('mousedown', (e) => {"
  "                    mouseDown = true;"
  "                    mouseX = e.clientX;"
  "                    mouseY = e.clientY;"
  "                });"
  "                document.addEventListener('mouseup', () => {"
  "                    mouseDown = false;"
  "                });"
  "                document.addEventListener('mousemove', (e) => {"
  "                    if (!mouseDown) return;"
  "                    const deltaX = e.clientX - mouseX;"
  "                    const deltaY = e.clientY - mouseY;"
  "                    const spherical = new THREE.Spherical();"
  "                    spherical.setFromVector3(this.camera.position);"
  "                    spherical.theta -= deltaX * 0.01;"
  "                    spherical.phi += deltaY * 0.01;"
  "                    spherical.phi = Math.max(0.1, Math.min(Math.PI - 0.1, spherical.phi));"
  "                    this.camera.position.setFromSpherical(spherical);"
  "                    this.camera.lookAt(0, 0, 0);"
  "                    mouseX = e.clientX;"
  "                    mouseY = e.clientY;"
  "                });"
  "                // Zoom with mouse wheel"
  "                this.renderer.domElement.addEventListener('wheel', (e) => {"
  "                    const distance = this.camera.position.length();"
  "                    const newDistance = distance + e.deltaY * 0.01;"
  "                    this.camera.position.normalize().multiplyScalar(Math.max(1, Math.min(10, newDistance)));"
  "                });"
  "            }"
  "            startEvolution(speed = 300) {"
  "                this.evolutionInterval = setInterval(() => {"
  "                    this.evolveSystem();"
  "                }, speed);"
  "                this.isRunning = true;"
  "                document.getElementById('startStop').textContent = 'Stop Evolution';"
  "            }"
  "            stopEvolution() {"
  "                if (this.evolutionInterval) {"
  "                    clearInterval(this.evolutionInterval);"
  "                }"
  "                this.isRunning = false;"
  "                document.getElementById('startStop').textContent = 'Start Evolution';"
  "            }"
  "            reset() {"
  "                this.stopEvolution();"
  "                this.binaryStates = ["
  "                    this.randomBinary(),"
  "                    this.randomBinary(),"
  "                    this.randomBinary(),"
  "                    this.randomBinary()"
  "                ];"
  "                this.timeStep = 0;"
  "                this.centroidHistory = [];"
  "                this.updateScene();"
  "                this.updateDisplay();"
  "            }"
  "            animate() {"
  "                requestAnimationFrame(() => this.animate());"
  "                // Rotate camera slowly when not evolving"
  "                if (!this.isRunning) {"
  "                    const time = Date.now() * 0.0005;"
  "                    this.camera.position.x = Math.cos(time) * 3;"
  "                    this.camera.position.z = Math.sin(time) * 3;"
  "                    this.camera.lookAt(0, 0, 0);"
  "                }"
  "                // Animate consciousness star"
  "                if (this.centroidStar) {"
  "                    const time = Date.now() * 0.003;"
  "                    this.centroidStar.scale.setScalar(1 + 0.2 * Math.sin(time));"
  "                    this.centroidStar.rotation.y = time;"
  "                }"
  "                this.renderer.render(this.scene, this.camera);"
  "            }"
  "        }"
  "        // Initialize the universe when page loads"
  "        window.addEventListener('load', () => {"
  "            new TetrahedralConsciousness();"
  "        });"
  "        // Handle window resize"
  "        window.addEventListener('resize', () => {"
  "            const camera = window.universe?.camera;"
  "            const renderer = window.universe?.renderer;"
  "            if (camera && renderer) {"
  "                camera.aspect = window.innerWidth / window.innerHeight;"
  "                camera.updateProjectionMatrix();"
  "                renderer.setSize(window.innerWidth, window.innerHeight);"
  "            }"
  "        });"
  "    </script>"
  "</body>"
  "</html>"
  .
