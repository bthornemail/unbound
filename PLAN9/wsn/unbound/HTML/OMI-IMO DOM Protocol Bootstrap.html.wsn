FILE = HEAD .

HEAD =
  "<!DOCTYPE html>"
  "<html lang=""en"">"
  "<head>"
  "    <meta charset=""UTF-8"">"
  "    <meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">"
  "    <title>OMI-IMO DOM Protocol</title>"
  "    <style>"
  "        :root {"
  "            --bg-color: #0d1117;"
  "            --text-main: #c9d1d9;"
  "            --accent-green: #2ea043;"
  "            --accent-blue: #58a6ff;"
  "            --accent-red: #f85149;"
  "            --font-mono: ui-monospace, SFMono-Regular, ""SF Mono"", Menlo, Consolas, ""Liberation Mono"", monospace;"
  "        }"
  "        body {"
  "            background-color: var(--bg-color);"
  "            color: var(--text-main);"
  "            font-family: var(--font-mono);"
  "            margin: 0;"
  "            padding: 20px;"
  "            display: flex;"
  "            flex-direction: column;"
  "            align-items: center;"
  "        }"
  "        h1 {"
  "            color: var(--accent-blue);"
  "            font-size: 1.5rem;"
  "            margin-bottom: 5px;"
  "        }"
  "        h2 {"
  "            font-size: 1rem;"
  "            color: #8b949e;"
  "            font-weight: normal;"
  "            margin-top: 0;"
  "            margin-bottom: 30px;"
  "        }"
  "        .dashboard {"
  "            display: grid;"
  "            grid-template-columns: 1fr 1fr;"
  "            gap: 20px;"
  "            width: 100%;"
  "            max-width: 1000px;"
  "        }"
  "        .panel {"
  "            background: #161b22;"
  "            border: 1px solid #30363d;"
  "            border-radius: 6px;"
  "            padding: 20px;"
  "        }"
  "        .panel h3 {"
  "            margin-top: 0;"
  "            color: var(--accent-green);"
  "            border-bottom: 1px solid #30363d;"
  "            padding-bottom: 10px;"
  "        }"
  "        .log-window {"
  "            background: #010409;"
  "            border: 1px solid #30363d;"
  "            border-radius: 4px;"
  "            padding: 10px;"
  "            height: 250px;"
  "            overflow-y: auto;"
  "            font-size: 0.85rem;"
  "            line-height: 1.5;"
  "        }"
  "        .log-entry.system { color: #8b949e; }"
  "        .log-entry.success { color: var(--accent-green); }"
  "        .log-entry.warn { color: #d29922; }"
  "        .log-entry.error { color: var(--accent-red); }"
  "        button {"
  "            background-color: #238636;"
  "            color: #ffffff;"
  "            border: 1px solid rgba(240, 246, 252, 0.1);"
  "            padding: 10px 20px;"
  "            font-size: 1rem;"
  "            border-radius: 6px;"
  "            cursor: pointer;"
  "            font-family: var(--font-mono);"
  "            transition: 0.2s;"
  "            margin-bottom: 20px;"
  "            width: 100%;"
  "            max-width: 1000px;"
  "        }"
  "        button:hover {"
  "            background-color: #2ea043;"
  "        }"
  "        button:disabled {"
  "            background-color: #161b22;"
  "            color: #8b949e;"
  "            cursor: not-allowed;"
  "        }"
  "        .matrix-grid {"
  "            display: grid;"
  "            grid-template-columns: repeat(8, 1fr);"
  "            gap: 4px;"
  "            margin-top: 10px;"
  "        }"
  "        .matrix-cell {"
  "            background: #010409;"
  "            border: 1px solid #30363d;"
  "            text-align: center;"
  "            padding: 5px 0;"
  "            font-size: 0.75rem;"
  "            color: #484f58;"
  "            transition: all 0.1s;"
  "        }"
  "        .matrix-cell.active {"
  "            background: var(--accent-blue);"
  "            color: #fff;"
  "            border-color: #fff;"
  "        }"
  "    </style>"
  "</head>"
  "<body>"
  "    <h1>OMI-IMO Protocol</h1>"
  "    <h2>Bootstrap Environment (-5D to 10D Pipeline)</h2>"
  "    <button id=""bootstrap-btn"">INITIALIZE 0D OBSERVER & PROTOCOL BOOTSTRAP</button>"
  "    <div class=""dashboard"">"
  "        <div class=""panel"">"
  "            <h3>The Observer (PannerNode)</h3>"
  "            <div id=""observer-status"">Status: Offline (Awaiting audio context)</div>"
  "            <div style=""margin-top: 15px;"">"
  "                <strong>Position:</strong><br>"
  "                X: <span id=""pos-x"">0</span><br>"
  "                Y: <span id=""pos-y"">0</span><br>"
  "                Z: <span id=""pos-z"">0</span><br>"
  "            </div>"
  "            <p style=""font-size: 0.8rem; color: #8b949e; margin-top: 20px;"">"
  "                The 0D observer is a point mapped transparently via the Web Audio PannerNode. Identity mapping: Abstract Position -> PannerNode positionX/Y/Z."
  "            </p>"
  "        </div>"
  "        <div class=""panel"">"
  "            <h3>Logic Kernel & Closure Ring</h3>"
  "            <div id=""closure-status"">13-Step Closure: Pending</div>"
  "            <div class=""matrix-grid"" id=""matrix-grid"">"
  "                <!-- 13 Canonical Masks Grid -->"
  "            </div>"
  "            <p style=""font-size: 0.8rem; color: #8b949e; margin-top: 20px;"">"
  "                Validating The Trigintaduonion and Sexagintaquatronion Gate Formalization."
  "            </p>"
  "        </div>"
  "        <div class=""panel"" style=""grid-column: 1 / -1;"">"
  "            <h3>Trace Log</h3>"
  "            <div class=""log-window"" id=""log-window""></div>"
  "        </div>"
  "    </div>"
  "    <script>"
  "        const DOM = {"
  "            btn: document.getElementById('bootstrap-btn'),"
  "            log: document.getElementById('log-window'),"
  "            posX: document.getElementById('pos-x'),"
  "            posY: document.getElementById('pos-y'),"
  "            posZ: document.getElementById('pos-z'),"
  "            observerStatus: document.getElementById('observer-status'),"
  "            closureStatus: document.getElementById('closure-status'),"
  "            matrixGrid: document.getElementById('matrix-grid')"
  "        };"
  "        function logMessage(msg, type = 'system') {"
  "            const el = document.createElement('div');"
  "            el.className = `log-entry ${type}`;"
  "            const time = new Date().toISOString().substring(11, 23);"
  "            el.innerText = `[${time}] ${msg}`;"
  "            DOM.log.appendChild(el);"
  "            DOM.log.scrollTop = DOM.log.scrollHeight;"
  "        }"
  "        // --- 1. The Gate Formalization ---"
  "        // Implementation of: The Trigintaduonion and Sexagintaquatronion Gate Formalization"
  "        const ALGEBRA = {"
  "            // e_1 as the observer unit"
  "            BETA: 1n << 1n "
  "        };"
  "        const GATES = {"
  "            and: (a, b) => a ^ (a ^ b) ^ b,"
  "            nand: (a, b) => GATES.and(a, b) ^ ALGEBRA.BETA,"
  "            or: (a, b) => a ^ b ^ (a & b),"
  "            nor: (a, b) => GATES.or(a, b) ^ ALGEBRA.BETA,"
  "            xnor: (a, b) => (a ^ b) ^ ALGEBRA.BETA,"
  "            not: (a) => a ^ ALGEBRA.BETA,"
  "            buf: (a) => a,"
  "            bind: (a, b) => a ^ b // Bidirectional symmetry"
  "        };"
  "        // 13 Canonical Masks for Invariant XOR Loop Closure"
  "        const XOR_13_MASKS = new Uint8Array(["
  "            0x00, 0x07, 0xFF, 0x78, 0x87, 0x20, 0x80, 0xAA, 0x55, 0x27, 0xD8, 0xA0, 0x27"
  "        ]);"
  "        // Regex Dimensional Constraints"
  "        const REGEX_CONSTRAINTS = {"
  "            FRONT: /^[A-Za-z0-9:+]$/,"
  "            BACK:  /^[A-Za-z0-9.\-]$/,"
  "            UP:    /^[A-Z_]$/,"
  "            DOWN:  /^[a-z_]$/,"
  "            CENTER:/^[0-9]\.[0-9]$/"
  "        };"
  "        // --- 2. The Protocol Kernel ---"
  "        class OMIProtocol {"
  "            constructor() {"
  "                this.audioCtx = null;"
  "                this.panner = null;"
  "                this.oscillator = null;"
  "                this.state = 0n;"
  "                this.initialized = false;"
  "            }"
  "            async bootstrap() {"
  "                logMessage(""Initiating DOM Protocol bootstrap sequence..."");"
  "                // 1. Initialize 0D Observer (Audio Graph)"
  "                this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();"
  "                this.panner = this.audioCtx.createPanner();"
  "                this.panner.panningModel = 'HRTF';"
  "                this.oscillator = this.audioCtx.createOscillator();"
  "                this.oscillator.type = 'sine';"
  "                // Route: Oscillator -> Panner -> Destination"
  "                this.oscillator.connect(this.panner);"
  "                this.panner.connect(this.audioCtx.destination);"
  "                this.oscillator.start();"
  "                DOM.observerStatus.innerText = ""Status: Online (0D Observer Active)"";"
  "                DOM.observerStatus.style.color = ""var(--accent-green)"";"
  "                logMessage(""0D Observer (PannerNode) materialized."", ""success"");"
  "                // 2. Validate The Trigintaduonion and Sexagintaquatronion Gate Formalization"
  "                this.verifyGates();"
  "                // 3. Execute 13-Step XOR Closure"
  "                await this.executeClosureRing();"
  "                // 4. Begin Spatial Circulation"
  "                this.initialized = true;"
  "                this.circulate();"
  "            }"
  "            verifyGates() {"
  "                logMessage(""Validating base trigintaduonion pure-XOR reduction..."");"
  "                const a = 5n, b = 12n;"
  "                // Bind is the fundamental topological knot"
  "                const knot = GATES.bind(a, b);"
  "                logMessage(`eval(bind(${a}, ${b})) = ${knot}`);"
  "                logMessage(`NAND gate evaluated with BETA observer unit: ${GATES.nand(a, b)}`);"
  "                logMessage(""Verification passed. All operations reduced to XOR."", ""success"");"
  "            }"
  "            async executeClosureRing() {"
  "                logMessage(""Beginning 13-Step XOR Closure sequence..."");"
  "                // Render matrix DOM"
  "                DOM.matrixGrid.innerHTML = '';"
  "                for(let i = 0; i < 16; i++) {"
  "                    const el = document.createElement('div');"
  "                    el.className = 'matrix-cell';"
  "                    el.innerText = i < XOR_13_MASKS.length ? `0x${XOR_13_MASKS[i].toString(16).toUpperCase().padStart(2, '0')}` : '--';"
  "                    DOM.matrixGrid.appendChild(el);"
  "                }"
  "                const cells = document.querySelectorAll('.matrix-cell');"
  "                let accumulator = 0x00;"
  "                // Step through masks with artificial delay for visualization"
  "                for (let i = 0; i < XOR_13_MASKS.length; i++) {"
  "                    const mask = XOR_13_MASKS[i];"
  "                    accumulator = accumulator ^ mask;"
  "                    cells[i].classList.add('active');"
  "                    logMessage(`Closure step ${i+1}/13: applied mask 0x${mask.toString(16).padStart(2,'0')} -> Current state: 0x${accumulator.toString(16).padStart(2,'0')}`);"
  "                    // Modulate audio frequency based on closure accumulator (Spectral instantiation)"
  "                    this.oscillator.frequency.setValueAtTime(220 + (accumulator * 10), this.audioCtx.currentTime);"
  "                    await new Promise(r => setTimeout(r, 150));"
  "                }"
  "                if (accumulator === 0x00) {"
  "                    DOM.closureStatus.innerText = ""13-Step Closure: VERIFIED (0x00 Centroid)"";"
  "                    DOM.closureStatus.style.color = ""var(--accent-green)"";"
  "                    logMessage(""Parity Lock Achieved. Inference collapsed to 0x00 Null Void Centroid."", ""success"");"
  "                } else {"
  "                    DOM.closureStatus.innerText = ""13-Step Closure: DRIFT DETECTED"";"
  "                    DOM.closureStatus.style.color = ""var(--accent-red)"";"
  "                    logMessage(`State drift detected: 0x${accumulator.toString(16)}. Halting.`, ""error"");"
  "                }"
  "            }"
  "            circulate() {"
  "                let tick = 0;"
  "                logMessage(""Observer circulation instantiated across 3D vector space."", ""system"");"
  "                const step = () => {"
  "                    if(!this.initialized) return;"
  "                    // Calculate positional trajectory "
  "                    // Simulating the 0D point moving through knot space"
  "                    const x = Math.sin(tick * 0.05) * 10;"
  "                    const z = Math.cos(tick * 0.05) * 10;"
  "                    const y = Math.sin(tick * 0.02) * 5;"
  "                    // Transparent translation to PannerNode"
  "                    this.panner.positionX.setTargetAtTime(x, this.audioCtx.currentTime, 0.1);"
  "                    this.panner.positionY.setTargetAtTime(y, this.audioCtx.currentTime, 0.1);"
  "                    this.panner.positionZ.setTargetAtTime(z, this.audioCtx.currentTime, 0.1);"
  "                    // Update UI readings"
  "                    DOM.posX.innerText = x.toFixed(3);"
  "                    DOM.posY.innerText = y.toFixed(3);"
  "                    DOM.posZ.innerText = z.toFixed(3);"
  "                    tick++;"
  "                    requestAnimationFrame(step);"
  "                };"
  "                requestAnimationFrame(step);"
  "            }"
  "        }"
  "        const protocolNode = new OMIProtocol();"
  "        DOM.btn.addEventListener('click', async () => {"
  "            DOM.btn.disabled = true;"
  "            DOM.btn.innerText = ""BOOTSTRAP IN PROGRESS..."";"
  "            try {"
  "                await protocolNode.bootstrap();"
  "                DOM.btn.innerText = ""PROTOCOL ACTIVE (OBSERVING)"";"
  "            } catch (err) {"
  "                logMessage(err.message, ""error"");"
  "                DOM.btn.innerText = ""BOOTSTRAP FAILED"";"
  "            }"
  "        });"
  "        logMessage(""DOM initialized. Awaiting user interaction to bypass Web Audio auto-play constraints."");"
  "    </script>"
  "</body>"
  "</html>"
  .
