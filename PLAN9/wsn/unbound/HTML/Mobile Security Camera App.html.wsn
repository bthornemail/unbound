FILE = HEAD .

HEAD =
  "<!DOCTYPE html>"
  "<html lang=""en"">"
  "<head>"
  "    <meta charset=""UTF-8"">"
  "    <meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">"
  "    <title>Security Camera</title>"
  "    <style>"
  "        * {"
  "            margin: 0;"
  "            padding: 0;"
  "            box-sizing: border-box;"
  "        }"
  "        body {"
  "            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;"
  "            background: linear-gradient(135deg, #1a1a2e, #16213e);"
  "            color: white;"
  "            min-height: 100vh;"
  "            display: flex;"
  "            flex-direction: column;"
  "        }"
  "        .header {"
  "            background: rgba(0, 0, 0, 0.8);"
  "            padding: 1rem;"
  "            text-align: center;"
  "            border-bottom: 2px solid #00ff88;"
  "        }"
  "        .header h1 {"
  "            font-size: 1.5rem;"
  "            margin-bottom: 0.5rem;"
  "        }"
  "        .status {"
  "            display: flex;"
  "            align-items: center;"
  "            justify-content: center;"
  "            gap: 0.5rem;"
  "            font-size: 0.9rem;"
  "        }"
  "        .status-dot {"
  "            width: 12px;"
  "            height: 12px;"
  "            border-radius: 50%;"
  "            background: #ff4444;"
  "            animation: pulse 2s infinite;"
  "        }"
  "        .status-dot.active {"
  "            background: #00ff88;"
  "        }"
  "        @keyframes pulse {"
  "            0%, 100% { opacity: 1; }"
  "            50% { opacity: 0.5; }"
  "        }"
  "        .camera-container {"
  "            flex: 1;"
  "            position: relative;"
  "            display: flex;"
  "            justify-content: center;"
  "            align-items: center;"
  "            padding: 1rem;"
  "        }"
  "        #videoElement {"
  "            width: 100%;"
  "            max-width: 800px;"
  "            height: auto;"
  "            border-radius: 15px;"
  "            box-shadow: 0 10px 30px rgba(0, 255, 136, 0.3);"
  "            background: #000;"
  "        }"
  "        .overlay {"
  "            position: absolute;"
  "            top: 20px;"
  "            left: 20px;"
  "            background: rgba(0, 0, 0, 0.7);"
  "            padding: 10px 15px;"
  "            border-radius: 10px;"
  "            font-size: 0.9rem;"
  "            border: 1px solid #00ff88;"
  "        }"
  "        .controls {"
  "            padding: 1rem;"
  "            background: rgba(0, 0, 0, 0.8);"
  "            display: flex;"
  "            flex-wrap: wrap;"
  "            gap: 1rem;"
  "            justify-content: center;"
  "            align-items: center;"
  "        }"
  "        .btn {"
  "            padding: 12px 24px;"
  "            border: none;"
  "            border-radius: 25px;"
  "            font-size: 1rem;"
  "            cursor: pointer;"
  "            transition: all 0.3s ease;"
  "            font-weight: 600;"
  "            text-transform: uppercase;"
  "            letter-spacing: 1px;"
  "        }"
  "        .btn-primary {"
  "            background: linear-gradient(45deg, #00ff88, #00cc6a);"
  "            color: #000;"
  "        }"
  "        .btn-primary:hover {"
  "            transform: translateY(-2px);"
  "            box-shadow: 0 5px 15px rgba(0, 255, 136, 0.4);"
  "        }"
  "        .btn-secondary {"
  "            background: linear-gradient(45deg, #ff4444, #cc3333);"
  "            color: white;"
  "        }"
  "        .btn-secondary:hover {"
  "            transform: translateY(-2px);"
  "            box-shadow: 0 5px 15px rgba(255, 68, 68, 0.4);"
  "        }"
  "        .btn-info {"
  "            background: linear-gradient(45deg, #4a90e2, #357abd);"
  "            color: white;"
  "        }"
  "        .btn-info:hover {"
  "            transform: translateY(-2px);"
  "            box-shadow: 0 5px 15px rgba(74, 144, 226, 0.4);"
  "        }"
  "        .btn:disabled {"
  "            opacity: 0.5;"
  "            cursor: not-allowed;"
  "            transform: none;"
  "        }"
  "        .camera-select {"
  "            padding: 10px 15px;"
  "            border-radius: 10px;"
  "            border: 2px solid #00ff88;"
  "            background: rgba(0, 0, 0, 0.8);"
  "            color: white;"
  "            font-size: 1rem;"
  "        }"
  "        .recording-indicator {"
  "            position: fixed;"
  "            top: 20px;"
  "            right: 20px;"
  "            background: #ff4444;"
  "            color: white;"
  "            padding: 8px 16px;"
  "            border-radius: 20px;"
  "            font-weight: bold;"
  "            animation: pulse 1s infinite;"
  "            display: none;"
  "        }"
  "        .motion-alert {"
  "            position: fixed;"
  "            top: 50%;"
  "            left: 50%;"
  "            transform: translate(-50%, -50%);"
  "            background: #ff4444;"
  "            color: white;"
  "            padding: 20px 40px;"
  "            border-radius: 15px;"
  "            font-size: 1.2rem;"
  "            font-weight: bold;"
  "            display: none;"
  "            animation: alertBlink 0.5s infinite;"
  "            z-index: 1000;"
  "        }"
  "        @keyframes alertBlink {"
  "            0%, 100% { opacity: 1; }"
  "            50% { opacity: 0.7; }"
  "        }"
  "        .settings {"
  "            display: flex;"
  "            flex-wrap: wrap;"
  "            gap: 1rem;"
  "            align-items: center;"
  "        }"
  "        .setting-group {"
  "            display: flex;"
  "            align-items: center;"
  "            gap: 0.5rem;"
  "        }"
  "        .setting-group label {"
  "            font-size: 0.9rem;"
  "            color: #ccc;"
  "        }"
  "        .setting-group input[type=""range""] {"
  "            width: 100px;"
  "        }"
  "        .toast {"
  "            position: fixed;"
  "            bottom: 20px;"
  "            right: 20px;"
  "            background: #00ff88;"
  "            color: #000;"
  "            padding: 12px 20px;"
  "            border-radius: 10px;"
  "            font-weight: bold;"
  "            display: none;"
  "            animation: slideIn 0.3s ease;"
  "        }"
  "        @keyframes slideIn {"
  "            from { transform: translateX(100%); }"
  "            to { transform: translateX(0); }"
  "        }"
  "        @media (max-width: 768px) {"
  "            .controls {"
  "                padding: 0.5rem;"
  "            }"
  "            .btn {"
  "                padding: 10px 20px;"
  "                font-size: 0.9rem;"
  "            }"
  "            .settings {"
  "                justify-content: center;"
  "            }"
  "            .overlay {"
  "                font-size: 0.8rem;"
  "                padding: 8px 12px;"
  "            }"
  "        }"
  "    </style>"
  "</head>"
  "<body>"
  "    <div class=""header"">"
  "        <h1>🔒 Security Camera</h1>"
  "        <div class=""status"">"
  "            <div class=""status-dot"" id=""statusDot""></div>"
  "            <span id=""statusText"">Camera Offline</span>"
  "        </div>"
  "    </div>"
  "    <div class=""camera-container"">"
  "        <video id=""videoElement"" autoplay muted playsinline></video>"
  "        <div class=""overlay"">"
  "            <div>📅 <span id=""currentTime""></span></div>"
  "            <div>📍 Monitoring Active</div>"
  "        </div>"
  "    </div>"
  "    <div class=""recording-indicator"" id=""recordingIndicator"">"
  "        🔴 RECORDING"
  "    </div>"
  "    <div class=""motion-alert"" id=""motionAlert"">"
  "        ⚠️ MOTION DETECTED ⚠️"
  "    </div>"
  "    <div class=""controls"">"
  "        <button class=""btn btn-primary"" id=""startBtn"">Start Camera</button>"
  "        <button class=""btn btn-secondary"" id=""stopBtn"" disabled>Stop Camera</button>"
  "        <button class=""btn btn-info"" id=""recordBtn"" disabled>Start Recording</button>"
  "        <button class=""btn btn-info"" id=""screenshotBtn"" disabled>Screenshot</button>"
  "        <select class=""camera-select"" id=""cameraSelect"">"
  "            <option value="""">Select Camera</option>"
  "        </select>"
  "        <div class=""settings"">"
  "            <div class=""setting-group"">"
  "                <label>Motion Sensitivity:</label>"
  "                <input type=""range"" id=""motionSensitivity"" min=""10"" max=""100"" value=""30"">"
  "                <span id=""sensitivityValue"">30</span>"
  "            </div>"
  "            <div class=""setting-group"">"
  "                <label>"
  "                    <input type=""checkbox"" id=""motionDetection""> Motion Detection"
  "                </label>"
  "            </div>"
  "            <div class=""setting-group"">"
  "                <label>"
  "                    <input type=""checkbox"" id=""nightMode""> Night Mode"
  "                </label>"
  "            </div>"
  "        </div>"
  "    </div>"
  "    <div class=""toast"" id=""toast""></div>"
  "    <script>"
  "        class SecurityCamera {"
  "            constructor() {"
  "                this.video = document.getElementById('videoElement');"
  "                this.canvas = document.createElement('canvas');"
  "                this.ctx = this.canvas.getContext('2d');"
  "                this.stream = null;"
  "                this.mediaRecorder = null;"
  "                this.recordedChunks = [];"
  "                this.isRecording = false;"
  "                this.motionDetection = false;"
  "                this.lastFrame = null;"
  "                this.motionThreshold = 30;"
  "                this.initializeElements();"
  "                this.updateTime();"
  "                this.setupEventListeners();"
  "                this.getCameraDevices();"
  "                setInterval(() => this.updateTime(), 1000);"
  "            }"
  "            initializeElements() {"
  "                this.startBtn = document.getElementById('startBtn');"
  "                this.stopBtn = document.getElementById('stopBtn');"
  "                this.recordBtn = document.getElementById('recordBtn');"
  "                this.screenshotBtn = document.getElementById('screenshotBtn');"
  "                this.cameraSelect = document.getElementById('cameraSelect');"
  "                this.statusDot = document.getElementById('statusDot');"
  "                this.statusText = document.getElementById('statusText');"
  "                this.recordingIndicator = document.getElementById('recordingIndicator');"
  "                this.motionAlert = document.getElementById('motionAlert');"
  "                this.motionSensitivity = document.getElementById('motionSensitivity');"
  "                this.sensitivityValue = document.getElementById('sensitivityValue');"
  "                this.motionDetectionCheckbox = document.getElementById('motionDetection');"
  "                this.nightModeCheckbox = document.getElementById('nightMode');"
  "                this.toast = document.getElementById('toast');"
  "            }"
  "            setupEventListeners() {"
  "                this.startBtn.addEventListener('click', () => this.startCamera());"
  "                this.stopBtn.addEventListener('click', () => this.stopCamera());"
  "                this.recordBtn.addEventListener('click', () => this.toggleRecording());"
  "                this.screenshotBtn.addEventListener('click', () => this.takeScreenshot());"
  "                this.cameraSelect.addEventListener('change', () => this.switchCamera());"
  "                this.motionSensitivity.addEventListener('input', (e) => {"
  "                    this.motionThreshold = parseInt(e.target.value);"
  "                    this.sensitivityValue.textContent = e.target.value;"
  "                });"
  "                this.motionDetectionCheckbox.addEventListener('change', (e) => {"
  "                    this.motionDetection = e.target.checked;"
  "                    if (this.motionDetection) {"
  "                        this.startMotionDetection();"
  "                        this.showToast('Motion detection enabled');"
  "                    } else {"
  "                        this.showToast('Motion detection disabled');"
  "                    }"
  "                });"
  "                this.nightModeCheckbox.addEventListener('change', (e) => {"
  "                    this.toggleNightMode(e.target.checked);"
  "                });"
  "                // Handle page visibility changes"
  "                document.addEventListener('visibilitychange', () => {"
  "                    if (document.hidden && this.stream) {"
  "                        this.showToast('Camera running in background');"
  "                    }"
  "                });"
  "            }"
  "            async getCameraDevices() {"
  "                try {"
  "                    const devices = await navigator.mediaDevices.enumerateDevices();"
  "                    const videoDevices = devices.filter(device => device.kind === 'videoinput');"
  "                    this.cameraSelect.innerHTML = '<option value="""">Select Camera</option>';"
  "                    videoDevices.forEach((device, index) => {"
  "                        const option = document.createElement('option');"
  "                        option.value = device.deviceId;"
  "                        option.textContent = device.label || `Camera ${index + 1}`;"
  "                        this.cameraSelect.appendChild(option);"
  "                    });"
  "                } catch (error) {"
  "                    console.error('Error getting camera devices:', error);"
  "                    this.showToast('Error accessing camera devices');"
  "                }"
  "            }"
  "            async startCamera() {"
  "                try {"
  "                    const constraints = {"
  "                        video: {"
  "                            width: { ideal: 1280 },"
  "                            height: { ideal: 720 },"
  "                            facingMode: 'environment'"
  "                        },"
  "                        audio: false"
  "                    };"
  "                    if (this.cameraSelect.value) {"
  "                        constraints.video.deviceId = { exact: this.cameraSelect.value };"
  "                    }"
  "                    this.stream = await navigator.mediaDevices.getUserMedia(constraints);"
  "                    this.video.srcObject = this.stream;"
  "                    this.updateStatus(true);"
  "                    this.startBtn.disabled = true;"
  "                    this.stopBtn.disabled = false;"
  "                    this.recordBtn.disabled = false;"
  "                    this.screenshotBtn.disabled = false;"
  "                    this.showToast('Camera started successfully');"
  "                    // Setup canvas for motion detection"
  "                    this.video.addEventListener('loadedmetadata', () => {"
  "                        this.canvas.width = this.video.videoWidth;"
  "                        this.canvas.height = this.video.videoHeight;"
  "                    });"
  "                } catch (error) {"
  "                    console.error('Error starting camera:', error);"
  "                    this.showToast('Error starting camera. Please check permissions.');"
  "                }"
  "            }"
  "            stopCamera() {"
  "                if (this.stream) {"
  "                    this.stream.getTracks().forEach(track => track.stop());"
  "                    this.stream = null;"
  "                    this.video.srcObject = null;"
  "                }"
  "                if (this.isRecording) {"
  "                    this.stopRecording();"
  "                }"
  "                this.updateStatus(false);"
  "                this.startBtn.disabled = false;"
  "                this.stopBtn.disabled = true;"
  "                this.recordBtn.disabled = true;"
  "                this.screenshotBtn.disabled = true;"
  "                this.showToast('Camera stopped');"
  "            }"
  "            async switchCamera() {"
  "                if (this.stream) {"
  "                    this.stopCamera();"
  "                    await new Promise(resolve => setTimeout(resolve, 100));"
  "                    this.startCamera();"
  "                }"
  "            }"
  "            toggleRecording() {"
  "                if (this.isRecording) {"
  "                    this.stopRecording();"
  "                } else {"
  "                    this.startRecording();"
  "                }"
  "            }"
  "            startRecording() {"
  "                try {"
  "                    this.recordedChunks = [];"
  "                    this.mediaRecorder = new MediaRecorder(this.stream, {"
  "                        mimeType: 'video/webm'"
  "                    });"
  "                    this.mediaRecorder.ondataavailable = (event) => {"
  "                        if (event.data.size > 0) {"
  "                            this.recordedChunks.push(event.data);"
  "                        }"
  "                    };"
  "                    this.mediaRecorder.onstop = () => {"
  "                        const blob = new Blob(this.recordedChunks, { type: 'video/webm' });"
  "                        this.downloadVideo(blob);"
  "                    };"
  "                    this.mediaRecorder.start();"
  "                    this.isRecording = true;"
  "                    this.recordBtn.textContent = 'Stop Recording';"
  "                    this.recordBtn.className = 'btn btn-secondary';"
  "                    this.recordingIndicator.style.display = 'block';"
  "                    this.showToast('Recording started');"
  "                } catch (error) {"
  "                    console.error('Error starting recording:', error);"
  "                    this.showToast('Error starting recording');"
  "                }"
  "            }"
  "            stopRecording() {"
  "                if (this.mediaRecorder && this.isRecording) {"
  "                    this.mediaRecorder.stop();"
  "                    this.isRecording = false;"
  "                    this.recordBtn.textContent = 'Start Recording';"
  "                    this.recordBtn.className = 'btn btn-info';"
  "                    this.recordingIndicator.style.display = 'none';"
  "                    this.showToast('Recording stopped and saved');"
  "                }"
  "            }"
  "            takeScreenshot() {"
  "                this.ctx.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);"
  "                this.canvas.toBlob((blob) => {"
  "                    const url = URL.createObjectURL(blob);"
  "                    const a = document.createElement('a');"
  "                    a.href = url;"
  "                    a.download = `security-screenshot-${new Date().toISOString().slice(0, 19).replace(/[:.]/g, '-')}.png`;"
  "                    a.click();"
  "                    URL.revokeObjectURL(url);"
  "                    this.showToast('Screenshot saved');"
  "                });"
  "            }"
  "            downloadVideo(blob) {"
  "                const url = URL.createObjectURL(blob);"
  "                const a = document.createElement('a');"
  "                a.href = url;"
  "                a.download = `security-recording-${new Date().toISOString().slice(0, 19).replace(/[:.]/g, '-')}.webm`;"
  "                a.click();"
  "                URL.revokeObjectURL(url);"
  "            }"
  "            startMotionDetection() {"
  "                if (!this.motionDetection || !this.stream) return;"
  "                const detectMotion = () => {"
  "                    if (!this.motionDetection || !this.stream) return;"
  "                    this.ctx.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);"
  "                    const currentFrame = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);"
  "                    if (this.lastFrame) {"
  "                        const diff = this.calculateFrameDifference(this.lastFrame, currentFrame);"
  "                        if (diff > this.motionThreshold) {"
  "                            this.triggerMotionAlert();"
  "                        }"
  "                    }"
  "                    this.lastFrame = currentFrame;"
  "                    setTimeout(detectMotion, 100);"
  "                };"
  "                setTimeout(detectMotion, 1000);"
  "            }"
  "            calculateFrameDifference(frame1, frame2) {"
  "                let diff = 0;"
  "                const pixels = frame1.data.length;"
  "                for (let i = 0; i < pixels; i += 4) {"
  "                    const r1 = frame1.data[i], g1 = frame1.data[i + 1], b1 = frame1.data[i + 2];"
  "                    const r2 = frame2.data[i], g2 = frame2.data[i + 1], b2 = frame2.data[i + 2];"
  "                    diff += Math.abs(r1 - r2) + Math.abs(g1 - g2) + Math.abs(b1 - b2);"
  "                }"
  "                return diff / (pixels / 4);"
  "            }"
  "            triggerMotionAlert() {"
  "                this.motionAlert.style.display = 'block';"
  "                setTimeout(() => {"
  "                    this.motionAlert.style.display = 'none';"
  "                }, 2000);"
  "                this.showToast('Motion detected!');"
  "                // Auto-screenshot on motion"
  "                if (this.stream) {"
  "                    setTimeout(() => this.takeScreenshot(), 500);"
  "                }"
  "            }"
  "            toggleNightMode(enabled) {"
  "                if (enabled) {"
  "                    this.video.style.filter = 'brightness(1.5) contrast(1.2)';"
  "                    this.showToast('Night mode enabled');"
  "                } else {"
  "                    this.video.style.filter = 'none';"
  "                    this.showToast('Night mode disabled');"
  "                }"
  "            }"
  "            updateStatus(active) {"
  "                if (active) {"
  "                    this.statusDot.classList.add('active');"
  "                    this.statusText.textContent = 'Camera Online';"
  "                } else {"
  "                    this.statusDot.classList.remove('active');"
  "                    this.statusText.textContent = 'Camera Offline';"
  "                }"
  "            }"
  "            updateTime() {"
  "                const now = new Date();"
  "                const timeString = now.toLocaleString();"
  "                document.getElementById('currentTime').textContent = timeString;"
  "            }"
  "            showToast(message) {"
  "                this.toast.textContent = message;"
  "                this.toast.style.display = 'block';"
  "                setTimeout(() => {"
  "                    this.toast.style.display = 'none';"
  "                }, 3000);"
  "            }"
  "        }"
  "        // Initialize the security camera app"
  "        const securityCamera = new SecurityCamera();"
  "    </script>"
  "</body>"
  "</html>"
  .
