FILE = HEAD .

HEAD =
  "<!DOCTYPE html>"
  "<html lang=""en"">"
  "<head>"
  "<meta charset=""UTF-8"">"
  "<meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">"
  "<title>Media Spectrum DevTools</title>"
  "<style>"
  ":root{"
  "  --bg:#f5f5f7; --panel:#ffffff; --border:#d8d8dc; --text:#1a1a1e;"
  "  --muted:#6b6b74; --accent:#3a6ff0; --accent-dim:#e4ecff;"
  "  --cell-low:#e9eaf5; --cell-hi:#3a6ff0; --danger:#d0413f;"
  "  font-family:-apple-system,BlinkMacSystemFont,""Segoe UI"",Roboto,sans-serif;"
  "}"
  "@media (prefers-color-scheme: dark){"
  "  :root:not([data-theme=""light""]){"
  "    --bg:#0f0f13; --panel:#18181e; --border:#2c2c34; --text:#eceef2;"
  "    --muted:#9a9aa5; --accent:#6d93ff; --accent-dim:#1e2942;"
  "    --cell-low:#20222c; --cell-hi:#6d93ff; --danger:#ff6b68;"
  "  }"
  "}"
  ":root[data-theme=""dark""]{"
  "  --bg:#0f0f13; --panel:#18181e; --border:#2c2c34; --text:#eceef2;"
  "  --muted:#9a9aa5; --accent:#6d93ff; --accent-dim:#1e2942;"
  "  --cell-low:#20222c; --cell-hi:#6d93ff; --danger:#ff6b68;"
  "}"
  "*{box-sizing:border-box;}"
  "body{margin:0;background:var(--bg);color:var(--text);min-height:100vh;}"
  "header{padding:14px 16px;border-bottom:1px solid var(--border);background:var(--panel);}"
  "h1{font-size:16px;margin:0 0 4px;}"
  ".sub{font-size:12px;color:var(--muted);margin-bottom:10px;line-height:1.5;}"
  ".controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;}"
  ".controls label{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px;}"
  "button{"
  "  font-size:13px;padding:7px 12px;border-radius:8px;border:1px solid var(--border);"
  "  background:var(--panel);color:var(--text);cursor:pointer;"
  "}"
  "button.primary{background:var(--accent);color:#fff;border-color:var(--accent);}"
  "button:disabled{opacity:.45;cursor:not-allowed;}"
  "input[type=range]{width:120px;}"
  "main{"
  "  display:grid;"
  "  grid-template-columns:200px 1fr 220px;"
  "  gap:1px;background:var(--border);"
  "  max-width:100%;"
  "  min-height:420px;"
  "}"
  "@media (max-width:760px){"
  "  main{grid-template-columns:1fr;}"
  "}"
  ".panel{background:var(--panel);padding:10px;overflow:auto;}"
  ".panel h2{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 8px;}"
  "#ports{display:flex;flex-direction:column;gap:2px;font-family:ui-monospace,Menlo,monospace;font-size:11px;max-height:400px;overflow:auto;}"
  ".port-row{display:flex;justify-content:space-between;padding:2px 4px;border-radius:4px;}"
  ".port-row span.v{color:var(--muted);}"
  "#asciiGrid{"
  "  display:grid;grid-template-columns:repeat(16,1fr);gap:3px;max-width:480px;margin:0 auto;"
  "}"
  ".cell{"
  "  aspect-ratio:1;display:flex;align-items:center;justify-content:center;"
  "  font-family:ui-monospace,Menlo,monospace;font-size:11px;border-radius:4px;"
  "  background:var(--cell-low);color:var(--text);transition:background .08s linear;"
  "}"
  "#legend div{font-size:11px;color:var(--muted);padding:3px 0;border-bottom:1px dashed var(--border);}"
  "#legend b{color:var(--text);}"
  "footer{padding:10px 16px;border-top:1px solid var(--border);background:var(--panel);}"
  "#timeline{display:flex;gap:4px;overflow-x:auto;padding:6px 0;}"
  ".cue{"
  "  flex:0 0 auto;font-size:10px;font-family:ui-monospace,monospace;color:var(--muted);"
  "  border:1px solid var(--border);border-radius:6px;padding:4px 7px;cursor:pointer;background:var(--panel);"
  "}"
  ".cue.active{background:var(--accent-dim);color:var(--accent);border-color:var(--accent);}"
  ".status{font-size:11px;color:var(--muted);margin-top:6px;}"
  "</style>"
  "</head>"
  "<body>"
  "<header>"
  "  <h1>Media Spectrum DevTools</h1>"
  "  <div class=""sub"">Real FFT via Web Audio's <code>AnalyserNode</code> (fftSize 256 → 128 frequency bins), laid out as an 8×16 grid. No plugins, no external libraries.</div>"
  "  <div class=""controls"">"
  "    <label>Source: <input type=""file"" id=""fileInput"" accept=""audio/*,video/*""></label>"
  "    <button id=""micBtn"">🎙️ Use microphone</button>"
  "    <button id=""playBtn"" class=""primary"" disabled>▶ Play</button>"
  "    <label>Pan <input type=""range"" id=""pan"" min=""-1"" max=""1"" step=""0.05"" value=""0""></label>"
  "    <label>Snapshot every <input type=""range"" id=""interval"" min=""150"" max=""2000"" step=""50"" value=""500""> ms</label>"
  "  </div>"
  "  <div class=""status"" id=""status"">No source loaded.</div>"
  "</header>"
  "<main>"
  "  <section class=""panel"">"
  "    <h2>Ports (128 channels)</h2>"
  "    <div id=""ports""></div>"
  "  </section>"
  "  <section class=""panel"">"
  "    <h2>Spectrum grid (8 rows × 16 cols)</h2>"
  "    <div id=""asciiGrid""></div>"
  "  </section>"
  "  <section class=""panel"">"
  "    <h2>Row legend</h2>"
  "    <div id=""legend""></div>"
  "  </section>"
  "</main>"
  "<footer>"
  "  <h2 style=""font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 4px;"">Timeline (click a snapshot to inspect it)</h2>"
  "  <div id=""timeline""></div>"
  "</footer>"
  "<script>"
  "(() => {"
  "  const fileInput = document.getElementById('fileInput');"
  "  const micBtn = document.getElementById('micBtn');"
  "  const playBtn = document.getElementById('playBtn');"
  "  const panCtl = document.getElementById('pan');"
  "  const intervalCtl = document.getElementById('interval');"
  "  const statusEl = document.getElementById('status');"
  "  const portsEl = document.getElementById('ports');"
  "  const gridEl = document.getElementById('asciiGrid');"
  "  const legendEl = document.getElementById('legend');"
  "  const timelineEl = document.getElementById('timeline');"
  "  const ROWS = 8, COLS = 16, N = ROWS * COLS; // 128 bins, matches fftSize=256 analyser output exactly"
  "  const rowLabels = ["
  "    '0x0_ — bins 0–15',"
  "    '0x1_ — bins 16–31',"
  "    '0x2_ — bins 32–47',"
  "    '0x3_ — bins 48–63',"
  "    '0x4_ — bins 64–79',"
  "    '0x5_ — bins 80–95',"
  "    '0x6_ — bins 96–111',"
  "    '0x7_ — bins 112–127',"
  "  ];"
  "  rowLabels.forEach((l,i) => {"
  "    const d = document.createElement('div');"
  "    d.innerHTML = `<b>Row ${i}</b> ${l}`;"
  "    legendEl.appendChild(d);"
  "  });"
  "  // Build grid cells + port rows once"
  "  const cells = [];"
  "  for (let i = 0; i < N; i++) {"
  "    const c = document.createElement('div');"
  "    c.className = 'cell';"
  "    gridEl.appendChild(c);"
  "    cells.push(c);"
  "    const p = document.createElement('div');"
  "    p.className = 'port-row';"
  "    p.innerHTML = `<span>ch${String(i).padStart(3,'0')}</span><span class=""v"">0</span>`;"
  "    portsEl.appendChild(p);"
  "  }"
  "  const portVals = Array.from(portsEl.querySelectorAll('.v'));"
  "  let audioCtx, analyser, sourceNode, pannerNode, mediaEl, rafId;"
  "  let dataArr;"
  "  let playing = false;"
  "  let cues = [];       // {t, snapshot}"
  "  let lastSnapshotAt = 0;"
  "  let viewingCueIdx = null; // null = live"
  "  function ensureCtx() {"
  "    if (!audioCtx) {"
  "      audioCtx = new (window.AudioContext || window.webkitAudioContext)();"
  "      analyser = audioCtx.createAnalyser();"
  "      analyser.fftSize = 256; // => frequencyBinCount === 128"
  "      pannerNode = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;"
  "      dataArr = new Uint8Array(analyser.frequencyBinCount);"
  "    }"
  "    return audioCtx;"
  "  }"
  "  function wireGraph(node, {toDestination}) {"
  "    node.disconnect && node.disconnect();"
  "    if (pannerNode) {"
  "      node.connect(pannerNode);"
  "      pannerNode.connect(analyser);"
  "    } else {"
  "      node.connect(analyser);"
  "    }"
  "    if (toDestination) analyser.connect(audioCtx.destination);"
  "  }"
  "  fileInput.addEventListener('change', async (e) => {"
  "    const file = e.target.files[0];"
  "    if (!file) return;"
  "    ensureCtx();"
  "    if (mediaEl) { mediaEl.pause(); mediaEl.remove(); }"
  "    mediaEl = document.createElement(file.type.startsWith('video') ? 'video' : 'audio');"
  "    mediaEl.src = URL.createObjectURL(file);"
  "    mediaEl.controls = false;"
  "    mediaEl.style.display = 'none';"
  "    document.body.appendChild(mediaEl);"
  "    sourceNode = audioCtx.createMediaElementSource(mediaEl);"
  "    wireGraph(sourceNode, {toDestination: true});"
  "    statusEl.textContent = `Loaded: ${file.name}`;"
  "    playBtn.disabled = false;"
  "  });"
  "  micBtn.addEventListener('click', async () => {"
  "    try {"
  "      ensureCtx();"
  "      const stream = await navigator.mediaDevices.getUserMedia({audio: true});"
  "      sourceNode = audioCtx.createMediaStreamSource(stream);"
  "      wireGraph(sourceNode, {toDestination: false}); // avoid feedback: analyse only, no output"
  "      statusEl.textContent = 'Microphone connected (monitoring only, not routed to speakers).';"
  "      playBtn.disabled = false;"
  "      startLoop();"
  "      playing = true;"
  "      playBtn.textContent = '■ Stop';"
  "    } catch (err) {"
  "      statusEl.textContent = 'Microphone access denied or unavailable: ' + err.message;"
  "    }"
  "  });"
  "  playBtn.addEventListener('click', async () => {"
  "    if (!audioCtx) return;"
  "    if (audioCtx.state === 'suspended') await audioCtx.resume();"
  "    if (mediaEl) {"
  "      if (playing) { mediaEl.pause(); } else { mediaEl.play(); }"
  "    }"
  "    playing = !playing;"
  "    playBtn.textContent = playing ? '⏸ Pause' : '▶ Play';"
  "    if (playing) startLoop(); else stopLoop();"
  "  });"
  "  panCtl.addEventListener('input', () => {"
  "    if (pannerNode) pannerNode.pan.value = parseFloat(panCtl.value);"
  "  });"
  "  function snapshotToGrid(arr) {"
  "    for (let i = 0; i < N; i++) {"
  "      const v = arr[i] || 0; // 0..255"
  "      const pct = v / 255;"
  "      cells[i].style.background = `color-mix(in srgb, var(--cell-low), var(--cell-hi) ${Math.round(pct*100)}%)`;"
  "      cells[i].textContent = v > 40 ? String.fromCharCode(0x20 + (v % 95)) : '';"
  "      portVals[i].textContent = v;"
  "    }"
  "  }"
  "  function startLoop() {"
  "    cancelAnimationFrame(rafId);"
  "    const tick = () => {"
  "      if (!analyser) return;"
  "      analyser.getByteFrequencyData(dataArr);"
  "      if (viewingCueIdx === null) snapshotToGrid(dataArr);"
  "      const now = performance.now();"
  "      const interval = parseInt(intervalCtl.value, 10);"
  "      if (now - lastSnapshotAt >= interval) {"
  "        lastSnapshotAt = now;"
  "        addCue(Array.from(dataArr));"
  "      }"
  "      rafId = requestAnimationFrame(tick);"
  "    };"
  "    rafId = requestAnimationFrame(tick);"
  "  }"
  "  function stopLoop() { cancelAnimationFrame(rafId); }"
  "  function addCue(snapshot) {"
  "    const t = mediaEl ? mediaEl.currentTime : performance.now()/1000;"
  "    cues.push({t, snapshot});"
  "    if (cues.length > 60) cues.shift();"
  "    renderTimeline();"
  "  }"
  "  function renderTimeline() {"
  "    timelineEl.innerHTML = '';"
  "    cues.forEach((c, idx) => {"
  "      const el = document.createElement('div');"
  "      el.className = 'cue' + (viewingCueIdx === idx ? ' active' : '');"
  "      el.textContent = c.t.toFixed(2) + 's';"
  "      el.addEventListener('click', () => {"
  "        viewingCueIdx = idx;"
  "        snapshotToGrid(c.snapshot);"
  "        renderTimeline();"
  "      });"
  "      timelineEl.appendChild(el);"
  "    });"
  "    timelineEl.scrollLeft = timelineEl.scrollWidth;"
  "  }"
  "  // Double-click timeline area background to return to live view"
  "  timelineEl.addEventListener('dblclick', (e) => {"
  "    if (e.target === timelineEl) { viewingCueIdx = null; renderTimeline(); }"
  "  });"
  "})();"
  "</script>"
  "</body>"
  "</html>"
  .
