FILE = HEAD .

HEAD =
  "<!doctype html><html><head><meta charset=utf8><meta name=viewport content=""width=device-width,initial-scale=1,viewport-fit=cover""><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>"
  "<title>Reading I-229</title>"
  "<meta name=""claude:viewport-fit-sides"" content=""cover"">"
  "<link rel=""preconnect"" href=""https://fonts.googleapis.com"">"
  "<link rel=""stylesheet"" href=""https://fonts.googleapis.com/css2?family=Spectral:wght@500;600&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;600&family=Frank+Ruhl+Libre:wght@400;500&display=swap"">"
  "<style>"
  "/* Layout: a single reading column of numbered steps; each step pairs the words with the code and a live run beneath it. */"
  ":root {"
  "  --bg: #f4f6f8; --panel: #ffffff; --ink: #18202b; --muted: #5b6676; --rule: #d9dfe6;"
  "  --accent: #1f5a73; --code-bg: #eef2f5;"
  "  --mirror: #24704a; --mirror-bg: #e3f2ea; --raise: #9a5a10; --raise-bg: #f8ecd9;"
  "  --f-display: ""Spectral"", Georgia, serif;"
  "  --f-body: ""Atkinson Hyperlegible"", system-ui, sans-serif;"
  "  --f-code: ""JetBrains Mono"", ui-monospace, Menlo, monospace;"
  "  --f-heb: ""Frank Ruhl Libre"", ""SBL Hebrew"", ""Times New Roman"", serif;"
  "}"
  "@media (prefers-color-scheme: dark) { :root:not([data-theme=""light""]) {"
  "  --bg: #11161d; --panel: #18202a; --ink: #e4e9ef; --muted: #9aa6b4; --rule: #2b3643;"
  "  --accent: #7cc0dc; --code-bg: #0d1218;"
  "  --mirror: #7fd3a4; --mirror-bg: #173326; --raise: #f0b866; --raise-bg: #3a2a14; color-scheme: dark } }"
  ":root[data-theme=""dark""] {"
  "  --bg: #11161d; --panel: #18202a; --ink: #e4e9ef; --muted: #9aa6b4; --rule: #2b3643;"
  "  --accent: #7cc0dc; --code-bg: #0d1218;"
  "  --mirror: #7fd3a4; --mirror-bg: #173326; --raise: #f0b866; --raise-bg: #3a2a14; color-scheme: dark }"
  "body { background: var(--bg); color: var(--ink); font: 17px/1.6 var(--f-body); }"
  ".wrap { max-width: 860px; margin: 0 auto; padding-block: 40px 80px;"
  "  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }"
  "h1, h2 { font-family: var(--f-display); font-weight: 600; text-wrap: balance; line-height: 1.2; margin: 0; }"
  "h1 { font-size: 2.3rem; }"
  "h2 { font-size: 1.45rem; }"
  "p { margin: 0; max-width: 65ch; }"
  "a { color: var(--accent); }"
  ".lede { color: var(--muted); font-size: 1.05rem; }"
  "header { display: grid; gap: 14px; margin-bottom: 36px; }"
  ".eyebrow { font: 600 .78rem var(--f-code); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }"
  ".loop { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font: .85rem var(--f-code); color: var(--muted); }"
  ".loop span { background: var(--panel); border: 1px solid var(--rule); border-radius: 4px; padding: 2px 8px; color: var(--ink); }"
  "section.step { display: grid; grid-template-columns: 3rem 1fr; gap: 0 14px; padding-block: 28px; border-top: 1px solid var(--rule); }"
  ".num { font: 600 1.45rem/1.2 var(--f-display); color: var(--accent); }"
  ".body { display: grid; gap: 14px; min-width: 0; }"
  "pre { margin: 0; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 6px; padding: 12px 14px; overflow-x: auto;"
  "  font: .82rem/1.55 var(--f-code); }"
  "pre .c { color: var(--muted); }"
  "code { font-family: var(--f-code); font-size: .88em; }"
  ".heb { font-family: var(--f-heb); font-size: 1.35em; direction: rtl; unicode-bidi: isolate; }"
  ".run { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 14px; display: grid; gap: 12px; min-width: 0; }"
  ".run-label { font: 600 .72rem var(--f-code); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }"
  ".controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }"
  "input[type=text] { font: 1rem var(--f-code); padding: 7px 10px; border: 1px solid var(--rule); border-radius: 4px; background: var(--bg); color: var(--ink); min-width: 0; flex: 1 1 12rem; }"
  "input.heb-in { font-family: var(--f-heb); font-size: 1.3rem; direction: rtl; }"
  "button { font: .85rem var(--f-code); padding: 6px 10px; border: 1px solid var(--rule); border-radius: 4px; background: var(--bg); color: var(--ink); cursor: pointer; }"
  "button:hover { border-color: var(--accent); }"
  "button:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }"
  ".trace { display: grid; gap: 4px; font: .88rem/1.5 var(--f-code); overflow-x: auto; }"
  ".trace .row { display: grid; grid-template-columns: 11rem 1fr; gap: 10px; }"
  ".trace .k { color: var(--muted); }"
  ".trace .v { word-break: break-all; }"
  ".pill { display: inline-block; font: 600 .78rem var(--f-code); padding: 2px 8px; border-radius: 999px; letter-spacing: .04em; }"
  ".pill.MIRROR { color: var(--mirror); background: var(--mirror-bg); }"
  ".pill.RAISE { color: var(--raise); background: var(--raise-bg); }"
  ".table-wrap { overflow-x: auto; }"
  "table { border-collapse: collapse; font: .85rem var(--f-code); font-variant-numeric: tabular-nums; }"
  "th, td { text-align: left; padding: 5px 10px; border-bottom: 1px solid var(--rule); white-space: nowrap; }"
  "th { color: var(--muted); font-weight: 600; }"
  "td.g { font-family: var(--f-heb); font-size: 1.3rem; }"
  "tr.mark td { color: var(--accent); }"
  "tr.accent td { color: var(--muted); }"
  ".note { font-size: .9rem; color: var(--muted); }"
  "footer { border-top: 1px solid var(--rule); padding-top: 24px; display: grid; gap: 10px; font-size: .9rem; color: var(--muted); }"
  "@media (max-width: 520px) {"
  "  section.step { grid-template-columns: 1fr; gap: 6px; }"
  "  .trace .row { grid-template-columns: 1fr; gap: 0; }"
  "  .trace .k { margin-top: 6px; }"
  "  h1 { font-size: 1.8rem; }"
  "}"
  "</style>"
  "<div class=""wrap"">"
  "<header>"
  "  <div class=""eyebrow"">I-229 · tag 6D · JS proof catalog</div>"
  "  <h1>Reading I-229: YHWH and its renderings</h1>"
  "  <p class=""lede"">This page follows one proof from start to finish, in the order the work was done. Each step gives the reason, the actual lines from <code>js/catalog/I-229.ts</code>, and a live panel that runs the same code in your browser, so you can try your own inputs and watch each transformation.</p>"
  "  <div class=""loop"" aria-label=""The method in order"">"
  "    <span>predict</span>→<span>fix the literal</span>→<span>reduce</span>→<span>compare</span>→<span>declare folds</span>→<span>separate layers</span>→<span>run and record</span>"
  "  </div>"
  "</header>"
  "<section class=""step"" id=""predict"">"
  "  <div class=""num"">1</div>"
  "  <div class=""body"">"
  "    <h2>Write the prediction before anything runs</h2>"
  "    <p>The question came from the author: what happens to the literal when YHWH becomes THE LORD, Yahweh, Yah, Jah or Jehovah? The predictions go into the file's header first, so the result can prove them wrong. A check written after seeing the answer can't fail, and a check that can't fail tests nothing.</p>"
  "<pre><span class=""c"">//   P1  YHWH vs ADONAI, YHWH vs THE LORD ........ RAISE  (the base is replaced)"
  "//   P2  YHWH vs YAHWEH ............................ MIRROR (same base, vowels supplied)"
  "//   P3  YHWH vs YAH ............................... MIRROR (prefix)"
  "//   P4  YHWH vs JAH, JEHOVAH ...................... RAISE letter for letter;"
  "//       MIRROR only under the declared fold J -&gt; Y, V -&gt; W"
  "//   P5  Leningrad vs MAM .......................... same consonants; one mark apart"
  "//   P6  Hebrew Yah vs YHWH ........................ MIRROR (prefix)</span></pre>"
  "    <p class=""note"">One limit is on the record. Two of these, THE LORD and YAHWEH, had already been run by the earlier audit in <code>src/terms.mjs</code>, so those two predictions were not blind. The others were.</p>"
  "  </div>"
  "</section>"
  "<section class=""step"" id=""literal"">"
  "  <div class=""num"">2</div>"
  "  <div class=""body"">"
  "    <h2>Fix the literal as codepoints</h2>"
  "    <p>A word on screen can look the same and still be different bytes. So each Hebrew form goes into the file as its exact Unicode codepoints, copied from the codex text with the cantillation accents removed. The proof then carries its own evidence, and anyone can check it without trusting a font or a website.</p>"
  "<pre>const wlc = ""יְהוָה"";    <span class=""c"">// Leningrad, Deut 29:1   U+05D9 05B0 05D4 05D5 05B8 05D4</span>"
  "const mam = ""יְהֹוָה"";   <span class=""c"">// MAM (Aleppo), Deut 29:1   U+05D9 05B0 05D4 05B9 05D5 05B8 05D4</span>"
  "const yah = ""יָהּ"";      <span class=""c"">// Exodus 15:2   U+05D9 05B8 05D4 05BC</span></pre>"
  "    <p class=""note"">The file stores the characters themselves. The codepoints are shown in the comments here, and step 6 breaks each word into one codepoint per row.</p>"
  "  </div>"
  "</section>"
  "<section class=""step"" id=""reduce"">"
  "  <div class=""num"">3</div>"
  "  <div class=""body"">"
  "    <h2>Reduce a name to its base</h2>"
  "    <p>English renderings need a common ground before they can be compared. The base keeps the letters A to Z only, in upper case, and removes the vowels A, E, I, O and U. That copies what Hebrew writing does with the Name: the consonants are written and the vowels are supplied. Case makes no difference, and digits are dropped along with spaces and punctuation.</p>"
  "<pre>const base = (s: string) =&gt; s.toUpperCase()"
  "  .replace(/[^A-Z]/g, """")    <span class=""c"">// A-Z only: digits, spaces and punctuation go</span>"
  "  .replace(/[AEIOU]/g, """");  <span class=""c"">// the vowels go</span></pre>"
  "    <div class=""run"">"
  "      <div class=""run-label"">Run it</div>"
  "      <div class=""controls"">"
  "        <input type=""text"" id=""name-in"" value=""JEHOVAH"" aria-label=""A name to reduce and compare"" autocomplete=""off"" spellcheck=""false"">"
  "      </div>"
  "      <div class=""controls"" id=""name-samples""></div>"
  "      <div class=""trace"" id=""reduce-out"" aria-live=""polite""></div>"
  "    </div>"
  "  </div>"
  "</section>"
  "<section class=""step"" id=""compare"">"
  "  <div class=""num"">4</div>"
  "  <div class=""body"">"
  "    <h2>Compare the bases: MIRROR or RAISE</h2>"
  "    <p>Two bases MIRROR when they are the same literal, or when one is a non-empty head of the other. Otherwise the rendering RAISES: it puts a different literal in place of the original. This is the guard <code>src/terms.mjs</code> uses.</p>"
  "<pre>const verdict = (a: string, b: string) =&gt; {"
  "  if (a === b) return ""MIRROR"";"
  "  const [short, long] = a.length &lt;= b.length ? [a, b] : [b, a];"
  "  return short.length &gt; 0 &amp;&amp; long.startsWith(short) ? ""MIRROR"" : ""RAISE"";"
  "};</pre>"
  "    <div class=""run"">"
  "      <div class=""run-label"">Run it on the name from step 3, against YHWH</div>"
  "      <div class=""trace"" id=""compare-out"" aria-live=""polite""></div>"
  "    </div>"
  "    <p class=""note"">Why <code>short.length &gt; 0</code>: a name with no consonants left, such as ""IOU"" or ""1234"", reduces to the empty base, and every string starts with the empty string. The first filing of I-229 left this check out, so an empty base mirrored everything. It was corrected on 2026-10-25, and section 7 of the record now checks that the empty base mirrors only another empty base. Try IOU in step 3.</p>"
  "  </div>"
  "</section>"
  "<section class=""step"" id=""fold"">"
  "  <div class=""num"">5</div>"
  "  <div class=""body"">"
  "    <h2>Declare any fold out loud</h2>"
  "    <p>JEHOVAH reduces to JHVH, and JHVH is not YHWH letter for letter. It matches only if J is read as Y and V as W, which is how Latin and German spelling carried the Name into English. That reading is a choice, so the proof writes it down as a function and tests both ways. It also tests that the fold doesn't rescue THE LORD, so the fold can't hide a substitution.</p>"
  "<pre>const fold = (s: string) =&gt; s.replace(/J/g, ""Y"").replace(/V/g, ""W"");"
  "assert.equal(verdict(""YHWH"", base(""JEHOVAH"")), ""RAISE"");        <span class=""c"">// without the fold</span>"
  "assert.equal(verdict(""YHWH"", fold(base(""JEHOVAH""))), ""MIRROR""); <span class=""c"">// with it</span>"
  "assert.equal(verdict(""YHWH"", fold(base(""THE LORD""))), ""RAISE""); <span class=""c"">// the fold rescues no substitution</span></pre>"
  "    <div class=""run"">"
  "      <div class=""run-label"">All six names, both ways</div>"
  "      <div class=""table-wrap""><table id=""fold-table""></table></div>"
  "    </div>"
  "  </div>"
  "</section>"
  "<section class=""step"" id=""layers"">"
  "  <div class=""num"">6</div>"
  "  <div class=""body"">"
  "    <h2>Separate the layers of the Hebrew</h2>"
  "    <p>The codices write the same Hebrew word in layers. The consonants are the oldest layer. The vowel points (niqqud) were added later by the Masoretes, and the cantillation accents (te'amim) after them. The proof splits each word into consonants and marks, then compares the layers separately.</p>"
  "<pre>const cons  = (s: string) =&gt; [...s].filter((c) =&gt; c &gt;= ""א"" &amp;&amp; c &lt;= ""ת"").join("""");   <span class=""c"">// alef to tav</span>"
  "const marks = (s: string) =&gt; [...s].filter((c) =&gt; !(c &gt;= ""א"" &amp;&amp; c &lt;= ""ת""));         <span class=""c"">// everything else</span>"
  "assert.equal(cons(wlc), cons(mam), ""the consonant base is one literal: MIRROR"");"
  "<span class=""c"">// extra = the marks MAM has more of than Leningrad</span>"
  "assert.deepEqual(extra, [""ֹ""], ""the vowel layers differ by exactly one mark: holam"");</pre>"
  "    <div class=""run"">"
  "      <div class=""run-label"">Paste or pick Hebrew</div>"
  "      <div class=""controls"">"
  "        <input type=""text"" id=""heb-a"" class=""heb-in"" aria-label=""First Hebrew word"" autocomplete=""off"" spellcheck=""false"">"
  "        <input type=""text"" id=""heb-b"" class=""heb-in"" aria-label=""Second Hebrew word"" autocomplete=""off"" spellcheck=""false"">"
  "      </div>"
  "      <div class=""controls"" id=""heb-samples""></div>"
  "      <div id=""heb-out"" aria-live=""polite"" style=""display:grid;gap:14px""></div>"
  "    </div>"
  "    <p>Read in order, MAM's marks are sheva, holam and qamatz. Under the declared reading sheva as E, holam as O and qamatz as A, that is E, O, A: the vowels of JEHOVAH in order. Leningrad's pointing has no holam, so it reads E, A.</p>"
  "  </div>"
  "</section>"
  "<section class=""step"" id=""record"">"
  "  <div class=""num"">7</div>"
  "  <div class=""body"">"
  "    <h2>Run it, record it, and correct it in the open</h2>"
  "    <p>The check either holds or it doesn't. If it fails, the failure gets recorded, not hidden, and a check that doesn't hold moves to <code>js/pending/</code>. A record also keeps its origin: who asked, when, and in their words, in <code>ORIGINS.json</code>. All six predictions held. When a flaw turns up later, as the empty base did, the fix goes in as a new commit with a dated note in the file and a check of its own, so the first filing stays readable in the history.</p>"
  "<pre><span class=""c"">// ── 7. The empty base heads nothing but itself ──</span>"
  "assert.equal(verdict(N, base(""IOU"")), ""RAISE"", ""an empty base does not mirror YHWH"");"
  "assert.equal(verdict(N, base(""1234"")), ""RAISE"", ""nor does a base of digits only"");"
  "assert.equal(verdict(base(""IOU""), base(""1234"")), ""MIRROR"", ""the empty base mirrors only the empty base"");"
  "$ node js/catalog/I-229.ts"
  "I-229: YHWH and its renderings — which keep the literal and which replace it — passed"
  "  RAISE (replace the base): ADONAI (DN), THE LORD (THLRD)"
  "  MIRROR (keep the base): YAHWEH (YHWH), YAH (YH, a prefix)"
  "  JAH, JEHOVAH: RAISE letter for letter (JH, JHVH); MIRROR only under the declared fold J-&gt;Y, V-&gt;W"
  "  Leningrad יְהוָה and MAM יְהֹוָה: one consonant literal; one mark apart, holam, the O of JEHOVAH"
  "$ make -C proofs js-docs"
  "116 records (116 holding)</pre>"
  "    <p class=""note"">The proof asserts how the letters relate. What a rendering means, and whether the fold is fair, are readings, and they stay open.</p>"
  "  </div>"
  "</section>"
  "<footer>"
  "  <p>Source: <a href=""https://github.com/bthornemail/omi-axioms/blob/main/js/catalog/I-229.ts"">js/catalog/I-229.ts</a> in <a href=""https://github.com/bthornemail/omi-axioms"">omi-axioms</a>; its generated document is <a href=""https://github.com/bthornemail/omi-axioms/blob/main/js-docs/other/I-229.md"">js-docs/other/I-229.md</a>.</p>"
  "  <p>Hebrew texts: Westminster Leningrad Codex (public domain), and Miqra according to the Masorah, based on the Aleppo Codex (CC BY-SA 4.0), both via Sefaria. The one MAM word quoted here, יְהֹוָה from Deuteronomy 29:1, is shared under CC BY-SA.</p>"
  "</footer>"
  "</div>"
  "<script>"
  "const base = (s) => s.toUpperCase().replace(/[^A-Z]/g, """").replace(/[AEIOU]/g, """");"
  "const verdict = (a, b) => {"
  "  if (a === b) return ""MIRROR"";"
  "  const [short, long] = a.length <= b.length ? [a, b] : [b, a];"
  "  return short.length > 0 && long.startsWith(short) ? ""MIRROR"" : ""RAISE"";"
  "};"
  "const fold = (s) => s.replace(/J/g, ""Y"").replace(/V/g, ""W"");"
  "const N = ""YHWH"";"
  "const esc = (s) => s.replace(/[&<>""]/g, (c) => ({ ""&"": ""&amp;"", ""<"": ""&lt;"", "">"": ""&gt;"", '""': ""&quot;"" }[c]));"
  "const show = (s) => s === """" ? ""(empty)"" : esc(s);"
  "const pill = (v) => `<span class=""pill ${v}"">${v}</span>`;"
  "const row = (k, v) => `<div class=""row""><div class=""k"">${k}</div><div class=""v"">${v}</div></div>`;"
  "function why(a, b) {"
  "  if (a === b) return `${show(a)} === ${show(b)}: the same literal`;"
  "  if (b === """" || a === """") return `one base is empty; the empty base is a head of everything, so it is not counted`;"
  "  if (a.startsWith(b)) return `${show(a)} starts with ${show(b)}: a prefix`;"
  "  if (b.startsWith(a)) return `${show(b)} starts with ${show(a)}: a prefix`;"
  "  return `not equal, and neither starts with the other`;"
  "}"
  "const nameIn = document.getElementById(""name-in"");"
  "const NAMES = [""ADONAI"", ""THE LORD"", ""YAHWEH"", ""YAH"", ""JAH"", ""JEHOVAH""];"
  "const samples = document.getElementById(""name-samples"");"
  "for (const n of [...NAMES, ""IOU"", ""1234""]) {"
  "  const b = document.createElement(""button"");"
  "  b.type = ""button""; b.textContent = n;"
  "  b.addEventListener(""click"", () => { nameIn.value = n; renderName(); });"
  "  samples.append(b);"
  "}"
  "function renderName() {"
  "  const s = nameIn.value;"
  "  const up = s.toUpperCase();"
  "  const letters = up.replace(/[^A-Z]/g, """");"
  "  const b = letters.replace(/[AEIOU]/g, """");"
  "  document.getElementById(""reduce-out"").innerHTML ="
  "    row(""input"", show(s)) +"
  "    row(""toUpperCase()"", show(up)) +"
  "    row(""A-Z only"", show(letters)) +"
  "    row(""vowels removed"", `<strong>${show(b)}</strong>`);"
  "  const v = verdict(N, b), f = fold(b), vf = verdict(N, f);"
  "  let html ="
  "    row(`compare ${N} with`, show(b)) +"
  "    row(""why"", why(N, b)) +"
  "    row(""verdict"", pill(v)) +"
  "    row(""with the fold"", `${show(b)} → ${show(f)}`) +"
  "    row(""why"", why(N, f)) +"
  "    row(""verdict under fold"", pill(vf));"
  "  if (b === """") html += `<p class=""note"">The base is empty: no consonant is left to compare, so it does not mirror YHWH.</p>`;"
  "  document.getElementById(""compare-out"").innerHTML = html;"
  "}"
  "nameIn.addEventListener(""input"", renderName);"
  "renderName();"
  "document.getElementById(""fold-table"").innerHTML ="
  "  `<thead><tr><th>name</th><th>base</th><th>verdict</th><th>folded</th><th>verdict under fold</th></tr></thead><tbody>` +"
  "  NAMES.map((n) => { const b = base(n), f = fold(b);"
  "    return `<tr><td>${n}</td><td>${b}</td><td>${pill(verdict(N, b))}</td><td>${f}</td><td>${pill(verdict(N, f))}</td></tr>`; }).join("""") +"
  "  `</tbody>`;"
  "// Hebrew layers"
  "const LETTERS = ""alef bet gimel dalet he vav zayin het tet yod final-kaf kaf lamed final-mem mem final-nun nun samekh ayin final-pe pe final-tsadi tsadi qof resh shin tav"".split("" "");"
  "const MARKS = { 0x05B0: ""sheva"", 0x05B1: ""hataf segol"", 0x05B2: ""hataf patah"", 0x05B3: ""hataf qamatz"", 0x05B4: ""hiriq"","
  "  0x05B5: ""tsere"", 0x05B6: ""segol"", 0x05B7: ""patah"", 0x05B8: ""qamatz"", 0x05B9: ""holam"", 0x05BA: ""holam haser for vav"","
  "  0x05BB: ""qubuts"", 0x05BC: ""dagesh or mappiq"", 0x05BD: ""meteg"", 0x05BE: ""maqaf"", 0x05BF: ""rafe"", 0x05C1: ""shin dot"","
  "  0x05C2: ""sin dot"", 0x05C7: ""qamatz qatan"" };"
  "const SOUND = { 0x05B0: ""E"", 0x05B9: ""O"", 0x05B8: ""A"" };"
  "const isLetter = (c) => c >= ""א"" && c <= ""ת"";"
  "const cp = (c) => ""U+"" + c.codePointAt(0).toString(16).toUpperCase().padStart(4, ""0"");"
  "function kind(c) {"
  "  const n = c.codePointAt(0);"
  "  if (isLetter(c)) return [""letter"", LETTERS[n - 0x05D0]];"
  "  if (n >= 0x0591 && n <= 0x05AF) return [""accent"", ""te'am (cantillation)""];"
  "  if (MARKS[n]) return [""mark"", MARKS[n]];"
  "  return [""other"", ""not Hebrew""];"
  "}"
  "const dotted = (c) => isLetter(c) ? c : ""◌"" + c;"
  "function layerTable(s) {"
  "  const chars = [...s];"
  "  if (!chars.length) return """";"
  "  return `<div class=""table-wrap""><table><thead><tr><th>glyph</th><th>codepoint</th><th>layer</th><th>name</th></tr></thead><tbody>` +"
  "    chars.map((c) => { const [k, name] = kind(c);"
  "      return `<tr class=""${k}""><td class=""g"">${esc(dotted(c))}</td><td>${cp(c)}</td><td>${k}</td><td>${name}</td></tr>`; }).join("""") +"
  "    `</tbody></table></div>`;"
  "}"
  "const consOf = (s) => [...s].filter(isLetter).join("""");"
  "const marksOf = (s) => [...s].filter((c) => kind(c)[0] === ""mark"");"
  "const hebA = document.getElementById(""heb-a""), hebB = document.getElementById(""heb-b"");"
  "const HEB = ["
  "  [""Leningrad and MAM"", ""יְהוָה"", ""יְהֹוָה""],"
  "  [""Leningrad and Yah"", ""יְהוָה"", ""יָהּ""],"
  "];"
  "const hs = document.getElementById(""heb-samples"");"
  "for (const [label, a, b] of HEB) {"
  "  const btn = document.createElement(""button"");"
  "  btn.type = ""button""; btn.textContent = label;"
  "  btn.addEventListener(""click"", () => { hebA.value = a; hebB.value = b; renderHeb(); });"
  "  hs.append(btn);"
  "}"
  "hebA.value = HEB[0][1]; hebB.value = HEB[0][2];"
  "function multisetMinus(x, y) {"
  "  const left = [...y];"
  "  return x.filter((m) => { const i = left.indexOf(m); if (i >= 0) { left.splice(i, 1); return false; } return true; });"
  "}"
  "function renderHeb() {"
  "  const a = hebA.value.normalize(""NFC"").trim(), b = hebB.value.normalize(""NFC"").trim();"
  "  const ca = consOf(a), cb = consOf(b), ma = marksOf(a), mb = marksOf(b);"
  "  const markNames = (ms) => ms.length ? ms.map((m) => MARKS[m.codePointAt(0)]).join("", "") : ""none"";"
  "  const sounds = (ms) => ms.map((m) => SOUND[m.codePointAt(0)] || ""·"").join("""");"
  "  let rel;"
  "  if (!ca || !cb) rel = ""Enter Hebrew in both boxes."";"
  "  else rel = `${pill(verdict(ca, cb))} ${ca === cb ? ""the same consonants"" : (ca.startsWith(cb) || cb.startsWith(ca)) ? ""one is the head of the other"" : ""different consonants""}`;"
  "  const accents = [...a, ...b].some((c) => kind(c)[0] === ""accent"");"
  "  document.getElementById(""heb-out"").innerHTML ="
  "    `<div class=""trace"">` +"
  "    row(""first: consonants"", `<span class=""heb"">${esc(ca) || ""(none)""}</span>`) +"
  "    row(""second: consonants"", `<span class=""heb"">${esc(cb) || ""(none)""}</span>`) +"
  "    row(""consonant layer"", rel) +"
  "    row(""first: marks"", markNames(ma)) +"
  "    row(""second: marks"", markNames(mb)) +"
  "    row(""only in first"", markNames(multisetMinus(ma, mb))) +"
  "    row(""only in second"", markNames(multisetMinus(mb, ma))) +"
  "    row(""E/O/A reading"", `${sounds(ma) || ""(none)""} · ${sounds(mb) || ""(none)""} <span class=""note"">(sheva E, holam O, qamatz A; · for any other mark)</span>`) +"
  "    `</div>` +"
  "    (accents ? `<p class=""note"">This text carries cantillation accents. The proof removes them before comparing, and they are not counted as marks here.</p>` : """") +"
  "    `<div class=""run-label"">first, one codepoint per row</div>` + layerTable(a) +"
  "    `<div class=""run-label"">second, one codepoint per row</div>` + layerTable(b);"
  "}"
  "hebA.addEventListener(""input"", renderHeb);"
  "hebB.addEventListener(""input"", renderHeb);"
  "renderHeb();"
  "</script>"
  "</body></html>"
  .
