FILE = HEAD .

HEAD =
  "<!DOCTYPE html>"
  "<html lang=""en"">"
  "<head>"
  "    <meta charset=""UTF-8"">"
  "    <meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">"
  "    <title>Cryptocurrency 5-Simplex Visualization</title>"
  "    <!-- Tailwind CSS CDN -->"
  "    <script src=""https://cdn.tailwindcss.com""></script>"
  "    <!-- Three.js CDN -->"
  "    <script src=""https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js""></script>"
  "    <!-- OrbitControls for camera interaction -->"
  "    <script src=""https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js""></script>"
  "    <style>"
  "        body {"
  "            margin: 0;"
  "            overflow: hidden; /* Hide scrollbars */"
  "            font-family: 'Inter', sans-serif; /* Use Inter font */"
  "            background-color: #1a202c; /* Dark background */"
  "            color: #e2e8f0; /* Light text color */"
  "        }"
  "        canvas {"
  "            display: block;"
  "            width: 100%;"
  "            height: 100%;"
  "        }"
  "        #info-panel {"
  "            position: absolute;"
  "            top: 1rem;"
  "            left: 1rem;"
  "            background-color: rgba(26, 32, 44, 0.8); /* Dark background with transparency */"
  "            padding: 1rem;"
  "            border-radius: 0.75rem; /* Rounded corners */"
  "            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);"
  "            max-height: calc(100% - 2rem); /* Limit height for responsiveness */"
  "            overflow-y: auto; /* Enable scrolling if content overflows */"
  "        }"
  "        #loading-overlay {"
  "            position: absolute;"
  "            top: 0;"
  "            left: 0;"
  "            width: 100%;"
  "            height: 100%;"
  "            background-color: rgba(0, 0, 0, 0.7);"
  "            display: flex;"
  "            justify-content: center;"
  "            align-items: center;"
  "            color: white;"
  "            font-size: 1.5rem;"
  "            z-index: 1000;"
  "        }"
  "        .crypto-item {"
  "            display: flex;"
  "            justify-content: space-between;"
  "            align-items: center;"
  "            padding: 0.5rem 0;"
  "            border-bottom: 1px solid rgba(255, 255, 255, 0.1);"
  "        }"
  "        .crypto-item:last-child {"
  "            border-bottom: none;"
  "        }"
  "        .crypto-name {"
  "            font-weight: bold;"
  "            margin-right: 1rem;"
  "        }"
  "        .crypto-price {"
  "            color: #48bb78; /* Green color for prices */"
  "        }"
  "    </style>"
  "</head>"
  "<body>"
  "    <div id=""loading-overlay"">"
  "        <p>Loading cryptocurrency data and setting up visualization...</p>"
  "    </div>"
  "    <div id=""info-panel"" class=""text-sm"">"
  "        <h2 class=""text-lg font-bold mb-2"">Cryptocurrency Values</h2>"
  "        <div id=""crypto-prices-display"">"
  "            <!-- Crypto prices will be dynamically inserted here -->"
  "        </div>"
  "        <p class=""mt-4 text-xs text-gray-400"">"
  "            * Sizes of spheres reflect current market prices."
  "            <br>"
  "            * Updates every 30 seconds."
  "        </p>"
  "    </div>"
  "    <script>"
  "        // Global variables for Three.js scene"
  "        let scene, camera, renderer, controls;"
  "        // Array to store Three.js mesh objects for cryptocurrencies"
  "        const cryptoMeshes = [];"
  "        // Array to store Three.js line objects for connections"
  "        const cryptoLines = [];"
  "        // Object to store text sprites for labels"
  "        const cryptoLabels = {};"
  "        // Configuration for cryptocurrencies to fetch"
  "        const cryptocurrencies = ["
  "            { id: 'bitcoin', name: 'Bitcoin', symbol: 'BTC', color: 0xffa500 }, // Orange"
  "            { id: 'ethereum', name: 'Ethereum', symbol: 'ETH', color: 0x667eea }, // Indigo"
  "            { id: 'ripple', name: 'XRP', symbol: 'XRP', color: 0x4299e1 }, // Blue"
  "            { id: 'solana', name: 'Solana', symbol: 'SOL', color: 0x9f7aea }, // Purple"
  "            { id: 'cardano', name: 'Cardano', symbol: 'ADA', color: 0xf6ad55 }, // Orange-yellow"
  "            { id: 'dogecoin', name: 'Dogecoin', symbol: 'DOGE', color: 0xf6e05e }  // Yellow"
  "        ];"
  "        // Base URL for CoinGecko API"
  "        const COINGECKO_API_URL = 'https://api.coingecko.com/api/v3/simple/price';"
  "        // Interval for fetching data (in milliseconds)"
  "        const FETCH_INTERVAL = 30000; // 30 seconds"
  "        /**"
  "         * Initializes the Three.js scene, camera, renderer, and controls."
  "         */"
  "        function init() {"
  "            // Scene setup"
  "            scene = new THREE.Scene();"
  "            scene.background = new THREE.Color(0x1a202c); // Dark background"
  "            // Camera setup"
  "            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);"
  "            camera.position.z = 5; // Initial camera position"
  "            // Renderer setup"
  "            renderer = new THREE.WebGLRenderer({ antialias: true });"
  "            renderer.setSize(window.innerWidth, window.innerHeight);"
  "            document.body.appendChild(renderer.domElement);"
  "            // OrbitControls for camera interaction"
  "            controls = new THREE.OrbitControls(camera, renderer.domElement);"
  "            controls.enableDamping = true; // Enable smooth camera movement"
  "            controls.dampingFactor = 0.05;"
  "            controls.screenSpacePanning = false;"
  "            controls.minDistance = 2;"
  "            controls.maxDistance = 10;"
  "            // Lighting"
  "            const ambientLight = new THREE.AmbientLight(0x404040, 2); // Soft white light"
  "            scene.add(ambientLight);"
  "            const pointLight = new THREE.PointLight(0xffffff, 1);"
  "            pointLight.position.set(5, 5, 5);"
  "            scene.add(pointLight);"
  "            // Handle window resizing"
  "            window.addEventListener('resize', onWindowResize, false);"
  "            // Initial setup of cryptocurrency spheres and connections"
  "            setupSimplexNodes();"
  "            animate(); // Start the animation loop"
  "        }"
  "        /**"
  "         * Sets up the initial symmetrical positions for the cryptocurrency nodes"
  "         * and draws the connecting lines (edges of the conceptual simplex)."
  "         */"
  "        function setupSimplexNodes() {"
  "            const radius = 2; // Radius for initial symmetrical placement"
  "            const numCryptos = cryptocurrencies.length;"
  "            // Create spheres for each cryptocurrency and position them symmetrically"
  "            for (let i = 0; i < numCryptos; i++) {"
  "                const crypto = cryptocurrencies[i];"
  "                // Distribute points roughly on a sphere for initial symmetry"
  "                const phi = Math.acos(-1 + (2 * i) / numCryptos);"
  "                const theta = Math.sqrt(numCryptos * Math.PI) * phi;"
  "                const x = radius * Math.cos(theta) * Math.sin(phi);"
  "                const y = radius * Math.sin(theta) * Math.sin(phi);"
  "                const z = radius * Math.cos(phi);"
  "                const geometry = new THREE.SphereGeometry(0.1, 32, 32); // Small initial size"
  "                const material = new THREE.MeshPhongMaterial({ color: crypto.color });"
  "                const sphere = new THREE.Mesh(geometry, material);"
  "                sphere.position.set(x, y, z);"
  "                sphere.userData.id = crypto.id; // Store crypto ID for later lookup"
  "                scene.add(sphere);"
  "                cryptoMeshes.push(sphere);"
  "                // Create text label for each crypto"
  "                const canvas = document.createElement('canvas');"
  "                const context = canvas.getContext('2d');"
  "                const fontSize = 48;"
  "                context.font = `${fontSize}px Arial`;"
  "                const textWidth = context.measureText(crypto.symbol).width;"
  "                canvas.width = textWidth + 20;"
  "                canvas.height = fontSize + 20;"
  "                context.font = `${fontSize}px Arial`;"
  "                context.fillStyle = 'white';"
  "                context.textAlign = 'center';"
  "                context.textBaseline = 'middle';"
  "                context.fillText(crypto.symbol, canvas.width / 2, canvas.height / 2);"
  "                const texture = new THREE.CanvasTexture(canvas);"
  "                const spriteMaterial = new THREE.SpriteMaterial({ map: texture });"
  "                const sprite = new THREE.Sprite(spriteMaterial);"
  "                sprite.scale.set(0.5, 0.25, 1); // Adjust scale as needed"
  "                sprite.position.copy(sphere.position).add(new THREE.Vector3(0, 0.2, 0)); // Position above sphere"
  "                scene.add(sprite);"
  "                cryptoLabels[crypto.id] = sprite; // Store sprite for updates"
  "            }"
  "            // Connect all nodes to each other to form the conceptual simplex edges (K6 graph)"
  "            for (let i = 0; i < numCryptos; i++) {"
  "                for (let j = i + 1; j < numCryptos; j++) {"
  "                    const material = new THREE.LineBasicMaterial({ color: 0x6b7280, transparent: true, opacity: 0.5 }); // Gray, semi-transparent"
  "                    const points = [];"
  "                    points.push(cryptoMeshes[i].position);"
  "                    points.push(cryptoMeshes[j].position);"
  "                    const geometry = new THREE.BufferGeometry().setFromPoints(points);"
  "                    const line = new THREE.Line(geometry, material);"
  "                    scene.add(line);"
  "                    cryptoLines.push(line);"
  "                }"
  "            }"
  "        }"
  "        /**"
  "         * Fetches cryptocurrency prices from CoinGecko API."
  "         */"
  "        async function fetchCryptoPrices() {"
  "            document.getElementById('loading-overlay').style.display = 'flex'; // Show loading overlay"
  "            const ids = cryptocurrencies.map(c => c.id).join(',');"
  "            const vsCurrencies = 'usd';"
  "            const url = `${COINGECKO_API_URL}?ids=${ids}&vs_currencies=${vsCurrencies}`;"
  "            try {"
  "                const response = await fetch(url);"
  "                if (!response.ok) {"
  "                    throw new Error(`HTTP error! status: ${response.status}`);"
  "                }"
  "                const data = await response.json();"
  "                updateVisualization(data);"
  "            } catch (error) {"
  "                console.error('Error fetching cryptocurrency prices:', error);"
  "                document.getElementById('crypto-prices-display').innerHTML = '<p class=""text-red-500"">Failed to load prices. Please try again later.</p>';"
  "            } finally {"
  "                document.getElementById('loading-overlay').style.display = 'none'; // Hide loading overlay"
  "            }"
  "        }"
  "        /**"
  "         * Updates the 3D visualization based on fetched cryptocurrency prices."
  "         * @param {object} data - The price data from CoinGecko API."
  "         */"
  "        function updateVisualization(data) {"
  "            let maxPrice = 0;"
  "            // Find the maximum price for normalization"
  "            for (const crypto of cryptocurrencies) {"
  "                if (data[crypto.id] && data[crypto.id].usd) {"
  "                    maxPrice = Math.max(maxPrice, data[crypto.id].usd);"
  "                }"
  "            }"
  "            const priceDisplay = document.getElementById('crypto-prices-display');"
  "            priceDisplay.innerHTML = ''; // Clear previous prices"
  "            cryptoMeshes.forEach(sphere => {"
  "                const cryptoId = sphere.userData.id;"
  "                const priceInfo = data[cryptoId];"
  "                if (priceInfo && priceInfo.usd) {"
  "                    const price = priceInfo.usd;"
  "                    // Normalize price to scale sphere size (e.g., 0.1 to 1.0)"
  "                    // Using a logarithmic scale for better visual distinction across vastly different prices"
  "                    const minLogPrice = Math.log(0.001); // Smallest possible price for log scale"
  "                    const maxLogPrice = Math.log(maxPrice);"
  "                    const normalizedPrice = (Math.log(Math.max(price, 0.001)) - minLogPrice) / (maxLogPrice - minLogPrice);"
  "                    const scaleFactor = 0.1 + normalizedPrice * 0.9; // Scale from 0.1 to 1.0"
  "                    sphere.scale.set(scaleFactor, scaleFactor, scaleFactor);"
  "                    // Update text label position"
  "                    if (cryptoLabels[cryptoId]) {"
  "                        cryptoLabels[cryptoId].position.copy(sphere.position).add(new THREE.Vector3(0, sphere.geometry.parameters.radius * scaleFactor + 0.1, 0));"
  "                    }"
  "                    // Update price display in the info panel"
  "                    const cryptoName = cryptocurrencies.find(c => c.id === cryptoId)?.name || cryptoId;"
  "                    const priceElement = document.createElement('div');"
  "                    priceElement.className = 'crypto-item';"
  "                    priceElement.innerHTML = `"
  "                        <span class=""crypto-name"">${cryptoName} (${cryptoId.toUpperCase()})</span>"
  "                        <span class=""crypto-price"">$${price.toFixed(2)}</span>"
  "                    `;"
  "                    priceDisplay.appendChild(priceElement);"
  "                } else {"
  "                    // If price data is missing, reset scale and show N/A"
  "                    sphere.scale.set(0.1, 0.1, 0.1); // Reset to base size"
  "                    const cryptoName = cryptocurrencies.find(c => c.id === cryptoId)?.name || cryptoId;"
  "                    const priceElement = document.createElement('div');"
  "                    priceElement.className = 'crypto-item';"
  "                    priceElement.innerHTML = `"
  "                        <span class=""crypto-name"">${cryptoName} (${cryptoId.toUpperCase()})</span>"
  "                        <span class=""crypto-price text-red-500"">N/A</span>"
  "                    `;"
  "                    priceDisplay.appendChild(priceElement);"
  "                }"
  "            });"
  "            // Update lines to reflect new sphere positions (if positions were dynamic, which they are not in this version, but good practice)"
  "            cryptoLines.forEach(line => {"
  "                line.geometry.attributes.position.needsUpdate = true;"
  "            });"
  "        }"
  "        /**"
  "         * Handles window resize events to keep the canvas responsive."
  "         */"
  "        function onWindowResize() {"
  "            camera.aspect = window.innerWidth / window.innerHeight;"
  "            camera.updateProjectionMatrix();"
  "            renderer.setSize(window.innerWidth, window.innerHeight);"
  "        }"
  "        /**"
  "         * Animation loop for Three.js."
  "         */"
  "        function animate() {"
  "            requestAnimationFrame(animate);"
  "            controls.update(); // Only required if controls.enableDamping or controls.autoRotate are set to true"
  "            renderer.render(scene, camera);"
  "        }"
  "        // Start the application when the window loads"
  "        window.onload = function () {"
  "            init();"
  "            fetchCryptoPrices(); // Initial fetch"
  "            setInterval(fetchCryptoPrices, FETCH_INTERVAL); // Fetch prices periodically"
  "        };"
  "    </script>"
  "</body>"
  "</html>"
  .
