FILE = HEAD .

HEAD =
  "graph TD"
  "    subgraph HDNodeWallet"
  "        HD[HDNode] --> LC[Logic Controller]"
  "        LC --> LG[Logic Gates]"
  "        LG --> NAND[NAND Gate]"
  "        LG --> NOR[NOR Gate]"
  "        HD --> Content"
  "        Content --> Doc[Encrypted JSON Documents]"
  "        Content --> Assets[Encrypted Binary Assets]"
  "        Content --> Scripts[JSON Scripts]"
  "        HD --> RPCInterface[RPC Interface]"
  "        RPCInterface --> Methods[Method Definitions]"
  "        Methods --> Retrieve[Retrieval Methods]"
  "        Methods --> Validate[Validation Methods]"
  "        LC --> ValidationEngine[Validation Engine]"
  "        ValidationEngine --> GraphCompat[Graph Compatibility]"
  "        ValidationEngine --> NodeCompat[Node Compatibility]"
  "        HD --> ServiceDesc[Service Description]"
  "        ServiceDesc --> PropRules[Propagation Rules]"
  "        ServiceDesc --> ConnRules[Connection Rules]"
  "    end"
  "    subgraph Networking"
  "        RPCInterface --> P2P[P2P Communication]"
  "        P2P --> Online[Online Mode]"
  "        P2P --> Offline[Offline Mode]"
  "        ServiceDesc --> Discovery[Content Discovery]"
  "        Discovery --> DHT[DHT Mapping]"
  "    end"
  .
