FILE = HEAD .

HEAD =
  "graph TD"
  "    Environment[Environment] --> Sensor[Sensor Interface]"
  "    Sensor --> Perception[Perception Module]"
  "    Perception --> BeliefState[Belief State]"
  "    BeliefState --> Planner[Planning Module]"
  "    KB[Knowledge Base] --> BeliefState"
  "    KB --> Planner"
  "    Goals[Goal Repository] --> Planner"
  "    Planner --> ActionSelector[Action Selector]"
  "    ActionSelector --> Executor[Action Executor]"
  "    Executor --> Actuator[Actuator Interface]"
  "    Actuator --> Environment"
  "    LearningModule[Learning Module] --> KB"
  "    Perception --> LearningModule"
  "    Executor --> LearningModule"
  "    subgraph Cognitive Core"
  "        BeliefState"
  "        Planner"
  "        ActionSelector"
  "        LearningModule"
  "    end"
  "    subgraph Memory Systems"
  "        KB"
  "        Goals"
  "    end"
  "    style Environment fill:#f9f,stroke:#333"
  "    style Cognitive Core fill:#cfd,stroke:#333"
  "    style Memory Systems fill:#dcf,stroke:#333"
  .
