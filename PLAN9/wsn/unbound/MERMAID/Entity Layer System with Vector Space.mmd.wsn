FILE = HEAD .

HEAD =
  "graph TD"
  "    subgraph Entity_Layers"
  "        Entity --> AbstractLayer[Abstract Layer]"
  "        Entity --> SubjectiveLayer[Subjective Layer]"
  "        Entity --> RelativeLayer[Relative Layer]"
  "        Entity --> ObjectiveLayer[Objective Layer]"
  "        subgraph ObjectiveLayer"
  "            Object3D[ThreeJS Object]"
  "            Object3D --> Position[Vector4 Position]"
  "            Position --> X[x coordinate]"
  "            Position --> Y[y coordinate]"
  "            Position --> Z[z coordinate]"
  "            Position --> W[w coordinate/size]"
  "            Object3D --> References"
  "            References --> Documents"
  "            References --> Assets"
  "            References --> Services"
  "            Object3D --> Definitions"
  "            Definitions --> Properties"
  "            Definitions --> Attributes"
  "            Definitions --> Parameters"
  "            Definitions --> ComposedEntities[Composed Entities]"
  "        end"
  "        subgraph RelativeLayer"
  "            RelativeID[Relative Identity]"
  "            RelativeID --> ComponentEntities[Component Entities]"
  "            RelativeID --> EntityPointers[Entity Pointers]"
  "        end"
  "        subgraph SubjectiveLayer"
  "            SubjectiveID[Subjective Identity]"
  "            SubjectiveID --> FeatureScores[Feature Scores]"
  "            SubjectiveID --> AttributeBias[Attribute Bias]"
  "            SubjectiveID --> LayerEvals[Layer Evaluations]"
  "        end"
  "        subgraph ComputationLayer"
  "            LogicGates[Logic Gates]"
  "            LogicGates --> Backpropagation"
  "            Backpropagation --> FeatureValidation"
  "            Backpropagation --> EntityRelations"
  "        end"
  "    end"
  .
