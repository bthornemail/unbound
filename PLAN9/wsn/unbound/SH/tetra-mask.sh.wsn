FILE = HEAD .

HEAD =
  "#!/bin/sh"
  "# Compare four raw-byte vertices of a tetrahedron using only POSIX shell and"
  "# BusyBox applets. The temporary paired stream keeps the read loop in the"
  "# current shell, so its counters survive on BusyBox ash."
  "set -eu"
  "BUSYBOX=${BUSYBOX:-busybox}"
  "VERBOSE=0"
  "usage() {"
  "    printf 'Usage: sh tetra-mask.sh [-v] FILE1 FILE2 FILE3 FILE4\n'"
  "}"
  "case ""${1:-}"" in"
  "    -v)"
  "        VERBOSE=1"
  "        shift"
  "        ;;"
  "    -h|--help)"
  "        usage"
  "        exit 0"
  "        ;;"
  "esac"
  "[ ""$#"" -eq 4 ] || {"
  "    usage >&2"
  "    exit 2"
  "}"
  "F1=$1"
  "F2=$2"
  "F3=$3"
  "F4=$4"
  "for file in ""$F1"" ""$F2"" ""$F3"" ""$F4""; do"
  "    [ -r ""$file"" ] || {"
  "        printf 'Cannot read: %s\n' ""$file"" >&2"
  "        exit 2"
  "    }"
  "done"
  "TMP=$(""$BUSYBOX"" mktemp -d ""${TMPDIR:-/tmp}/tetra-mask.XXXXXX"")"
  "trap '""$BUSYBOX"" rm -rf ""$TMP""' EXIT HUP INT TERM"
  "byte_list() {"
  "    # od emits unsigned decimal bytes; one byte per line makes paste safe."
  "    ""$BUSYBOX"" od -An -v -tu1 ""$1"" |"
  "        ""$BUSYBOX"" tr -s '[:space:]' '\n' |"
  "        ""$BUSYBOX"" grep '[0-9]' > ""$2"" || :"
  "}"
  "pair() {"
  "    A=$1"
  "    B=$2"
  "    A_BYTES=$TMP/a"
  "    B_BYTES=$TMP/b"
  "    PAIRED=$TMP/paired"
  "    byte_list ""$A"" ""$A_BYTES"""
  "    byte_list ""$B"" ""$B_BYTES"""
  "    LA=$(""$BUSYBOX"" wc -l < ""$A_BYTES"")"
  "    LB=$(""$BUSYBOX"" wc -l < ""$B_BYTES"")"
  "    printf 'EDGE %s - %s\n' ""$A"" ""$B"""
  "    printf '  bytes:      %d and %d\n' ""$LA"" ""$LB"""
  "    if [ ""$LA"" -ne ""$LB"" ]; then"
  "        printf '  length:     MISMATCH (%d vs %d)\n' ""$LA"" ""$LB"""
  "        printf '  result:     not comparable\n\n'"
  "        return 0"
  "    fi"
  "    ""$BUSYBOX"" paste -d ' ' ""$A_BYTES"" ""$B_BYTES"" > ""$PAIRED"""
  "    DIFF_BITS=0"
  "    DIFF_BYTES=0"
  "    MASK_HEX="
  "    while read -r X Y; do"
  "        Z=$((X ^ Y))"
  "        [ ""$Z"" -ne 0 ] && DIFF_BYTES=$((DIFF_BYTES + 1))"
  "        C=0"
  "        I=0"
  "        while [ ""$I"" -lt 8 ]; do"
  "            [ $(((Z >> I) & 1)) -ne 0 ] && C=$((C + 1))"
  "            I=$((I + 1))"
  "        done"
  "        DIFF_BITS=$((DIFF_BITS + C))"
  "        MASK_HEX=$MASK_HEX$(printf '%02x' ""$Z"")"
  "    done < ""$PAIRED"""
  "    printf '  length:     equal (%d bytes)\n' ""$LA"""
  "    printf '  differing:  %d bits across %d bytes\n' ""$DIFF_BITS"" ""$DIFF_BYTES"""
  "    [ ""$VERBOSE"" -eq 1 ] && printf '  mask:       %s\n' ""$MASK_HEX"""
  "    printf '\n'"
  "}"
  "printf '%s\n' '=== RAW-BYTE TETRAHEDRON ==='"
  "printf 'Vertices: %s | %s | %s | %s\n\n' ""$F1"" ""$F2"" ""$F3"" ""$F4"""
  "pair ""$F1"" ""$F2"""
  "pair ""$F1"" ""$F3"""
  "pair ""$F1"" ""$F4"""
  "pair ""$F2"" ""$F3"""
  "pair ""$F2"" ""$F4"""
  "pair ""$F3"" ""$F4"""
  .
