FILE = HEAD .

HEAD =
  "import { lazy, type ComponentType, type LazyExoticComponent } from 'react';"
  "export interface Example {"
  "  slug: string;"
  "  title: string;"
  "  group: string;"
  "  summary: string;"
  "  description: string;"
  "  Component: LazyExoticComponent<ComponentType>;"
  "}"
  "interface ExampleSource {"
  "  title: string;"
  "  group: string;"
  "  summary: string;"
  "  description: string;"
  "  load: () => Promise<{ default: ComponentType }>;"
  "}"
  "const entry = ({ load, ...meta }: ExampleSource): Example => ({"
  "  ...meta,"
  "  slug: meta.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),"
  "  Component: lazy(load),"
  "});"
  "export const examples: Example[] = ["
  "  entry({"
  "    title: 'Atomic ALU Surface',"
  "    group: 'Atomic',"
  "    summary: 'A hardware-style ALU driving the base-60, base-15 and base-7 clocks.',"
  "    description:"
  "      'Runs a 4-channel sonar (τ₁₅ × 4 = 60 slots) alongside the Wallis base-60 and Fano base-7 clocks, dividing with Barrett reduction (reciprocal multiply and shift) the way an FPGA would. A byte-order mark switches the stream between forward two’s-complement (U+FEFF) and inverted one’s-complement (U+FFFE).',"
  "    load: () => import('../templates/Atomic ALU Surface.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Atomic Incidence Surface',"
  "    group: 'Atomic',"
  "    summary: 'A 5-channel sonar projection that resets every 7! = 5040 ticks.',"
  "    description:"
  "      'Maps a 5-channel sonar (τ₁₅ × 5 = 75 slots) and the 7-phase Fano clock onto a symbol projection surface. A live readout tracks the absolute tick, goal phase, sonar phase and Fano phase against the 5040-tick master reset.',"
  "    load: () => import('../templates/Atomic Incidence Surface.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Atomic Incidence Monitor',"
  "    group: 'Atomic',"
  "    summary: 'The Fano and sonar clocks, synced to 7!, walking the Unicode planes.',"
  "    description:"
  "      'Combines the τ₇ Fano and τ₁₅ sonar clocks to pick a “current codepoint”: the sonar lane chooses a Unicode plane (Braille and math in the BMP, Aegean numbers in the SMP, then the ideographic and tertiary planes) and the Fano phase sets the offset within it.',"
  "    load: () => import('../templates/Atomic Incidence Monitor.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Atomic Wallis Surface',"
  "    group: 'Atomic',"
  "    summary: 'Clock state written in Wallis sexagesimal notation, with Aegean numerals.',"
  "    description:"
  "      'Shows the 60-slot sonar and the 5040-tick master period in Wallis’s base-60 notation (‵ ° ′ ″) and spells digits 1–9 in Aegean numerals (from U+10107), with an Aegean header marking the stream’s orientation.',"
  "    load: () => import('../templates/Atomic Wallis Surface.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Atomic Tape Reader',"
  "    group: 'Atomic',"
  "    summary: 'Time is read off a tape of byte-order marks instead of ticking.',"
  "    description:"
  "      'An auto-feeder streams a tape of BOMs (mostly U+FEFF, a few U+FFFE); each one consumed advances the state. The reader splits the stream into 10 discretions (2 orientations × 5 channels), adds Fano jitter, and keeps a trace memory bounded at 5040 incidents.',"
  "    load: () => import('../templates/Atomic Tape Reader.tsx'),"
  "  }),"
  "  // entry({ title: 'Feature Map Runtime', group: 'Runtime', summary: '', description: '', load: () => import('../templates/Feature Map Runtime.tsx') }),"
  "  // entry({ title: 'Feature Map Runtime v2', group: 'Runtime', summary: '', description: '', load: () => import('../templates/Feature Map Runtime.v2.tsx') }),"
  "  entry({"
  "    title: 'Feature Map Runtime v3',"
  "    group: 'Runtime',"
  "    summary: 'A 3D “brain layer” that morphs a 2D system map into semantic space.',"
  "    description:"
  "      'Five system nodes (auth kernel, ledger shard, routing table, enclave gate, stream buffer) start on a flat 2D layout and morph into 3D positions weighted by their HD-node bits, around a glowing central closure shaded by network density. Click a node to inspect it. Built with three.js.',"
  "    load: () => import('../templates/Feature Map Runtime.v3.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'GENESIS Protocol Explorer',"
  "    group: 'Runtime',"
  "    summary: 'A dashboard for the GENESIS protocol’s layers, files and logs.',"
  "    description:"
  "      'Tabs for the Layer 0 kernel (files turned into atoms from path, size and mtime), the Layer 1 projections, the canvas suite (GENESIS, Light/Dark, Wrappers, Judge) and the GENESIS.jsonl log. The file system is sample data.',"
  "    load: () => import('../templates/GENESIS Protocol Explorer.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'SCGNN VM',"
  "    group: 'Runtime',"
  "    summary: 'A stateless VM that runs RPC calls as sacred-geometry transforms.',"
  "    description:"
  "      'The Stateless Sacred Geometry Neural Network VM: enter a from-node, to-node, method and JSON parameters, and the call is encoded as a geometric state with a spin, an HD path and an attention vector. A canvas draws the spin field, and “consensus” is reached when the spins line up.',"
  "    load: () => import('../templates/SCGNN VM - Stateless Sacred Geometry Neural Network Virtual Mach.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'UBHP Core Functions Demo',"
  "    group: 'Runtime',"
  "    summary: 'Try UBHP’s encoding, harmonic signatures and vector rays on any text.',"
  "    description:"
  "      'Type some text (and an optional origin buffer to XOR against) to see it encoded as an S-expression with variable-length integers, harmonized into a content-based signature, and turned into a normalized vector “ray”, with cosine similarity and centroid helpers alongside.',"
  "    load: () => import('../templates/UBHP Core Functions Demo.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Geometric Hypergraph AI System',"
  "    group: 'Geometry',"
  "    summary: 'Message passing on a hypergraph, constrained to deltoid and astroid curves.',"
  "    description:"
  "      'A step-by-step simulation of a hypergraph neural network: messages flow from vertices to simplices to hyperedges, simplex features are projected onto a deltoid (3-cusp) curve and hyperedge weights onto an astroid (4-cusp) curve, and the loss is how far they drift off those curves. Play, pause, step and reset, with Betti numbers shown.',"
  "    load: () => import('../templates/Geometric Hypergraph AI System.tsx'),"
  "  }),"
  "  // entry({ title: 'Basic Incidents Graph', group: 'Geometry', summary: '', description: '', load: () => import('../templates/Basic Incidents Graph.tsx') }),"
  "  entry({"
  "    title: 'Incidence Hypergraph Visualization',"
  "    group: 'Geometry',"
  "    summary: 'A sample hypergraph drawn as hulls, with its incidence matrix.',"
  "    description:"
  "      'Draws each hyperedge as a line (2 vertices) or a convex hull (3 or more), next to the vertex-by-edge incidence matrix and a list of hyperedges, so you can see the same structure as a picture and as a table.',"
  "    load: () => import('../templates/Incidence Hypergraph Visualization.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Polyhedral Spin Explorer',"
  "    group: 'Geometry',"
  "    summary: 'The “universal spin” of the Platonic, Archimedean and custom solids.',"
  "    description:"
  "      'A card per Platonic and Archimedean solid showing its structure, parameters, invariants and universal spin value, plus a form to enter your own vertex, edge and face counts and an explanation of the spin function.',"
  "    load: () => import('../templates/Polyhedral Spin Explorer.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Tetrahedral Graph Visualization',"
  "    group: 'Geometry',"
  "    summary: 'The complete graph K₄ as a tetrahedron you can rotate.',"
  "    description:"
  "      'K₄ shown both as a 3D tetrahedron (move the mouse over it to rotate) and as a planar drawing, with its vertex degrees and its graph-theory, geometric, connectivity and chromatic properties.',"
  "    load: () => import('../templates/Tetrahedral Graph Visualization.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'I Ching 256 Centroid',"
  "    group: 'Geometry',"
  "    summary: 'A 256-LED address space that points at a single hexagram.',"
  "    description:"
  "      'Generates a 256-cell LED grid, maps a selector onto it, and draws the active I Ching hexagram at the centre, built bottom-up from its binary, with a pointer back to its LED. Labelled the “Shao Yong engine” after the binary ordering of the hexagrams.',"
  "    load: () => import('../templates/I Ching 256 Centroid.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Harmonic Closure Editor',"
  "    group: 'Geometry',"
  "    summary: 'Nodes orbit a central closure, encoded as deterministic mnemonics.',"
  "    description:"
  "      'A three.js scene where nodes orbit a central closure mesh, driven by a global oscillator. A Fano scrubber sets the phase, each node gets a deterministic mnemonic from a semantic table, and the colours dim during the “Sabbath” phase.',"
  "    load: () => import('../templates/Harmonic Closure Editor.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Spectral Integration Closure',"
  "    group: 'Geometry',"
  "    summary: 'A “spectral modem”: orbiting nodes sum into a breathing closure.',"
  "    description:"
  "      'A three.js simulation in which a Fano scrubber sets phase and hue, nodes seeded from a small WordNet-style dictionary orbit the centre, and the closure mesh glows and “breathes” with the sum of their harmonic inputs.',"
  "    load: () => import('../templates/Spectral Integration Closure.tsx'),"
  "  }),"
  "  // entry({ title: 'Unified Projective Workbench', group: 'Geometry', summary: '', description: '', load: () => import('../templates/Unified Projective Workbench.tsx') }),"
  "  entry({"
  "    title: 'Unified Projective Workbench v2',"
  "    group: 'Geometry',"
  "    summary: 'Upload a file and resolve it through dotfile rules and λ-transforms.',"
  "    description:"
  "      'The “Projective Resolver”: upload or stream in a file and it is checked against a stack of dotfile rules (.schema, .include/.ignore, .genesis/.atom, .manifest) and Church-encoded λ functions, with a mnemonic state lock and an epistemological quadrant view. State persists between visits.',"
  "    load: () => import('../templates/Unified Projective Workbench.v2.tsx'),"
  "  }),"
  "  // entry({ title: 'Semantic Merkle Tree Visualization', group: 'Semantic', summary: '', description: '', load: () => import('../templates/Semantic Merkle Tree Visualization.tsx') }),"
  "  entry({"
  "    title: 'Semantic Merkle Tree Visualization v2',"
  "    group: 'Semantic',"
  "    summary: 'A Merkle tree from a Fano point down to a 240-node shell.',"
  "    description:"
  "      'Choose the root (1 of 7 Fano points), branch (1 of 8 register states) and sub-branch (1 of 64 hexagrams), and watch the tree and its root hash update down to a 240-node verification shell, with binary, trinary and lattice-density readouts. The hash is a simplified mock.',"
  "    load: () => import('../templates/Semantic Merkle Tree Visualization.v2.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Semantic Mnemonic Editor',"
  "    group: 'Semantic',"
  "    summary: 'Turn word pairs into bits, Pfister rings and a 240° colour wheel.',"
  "    description:"
  "      'Pick a subject and a predicate from a 2048-word table (1024 of each, 11 bits per word); the editor derives Pfister rings, a 240° colour wheel and its centroid, and renders them in three.js, with a Fano scrubber for phase.',"
  "    load: () => import('../templates/Semantic Mnemonic Editor.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Semantic Raycasting Through Platonic Space',"
  "    group: 'Semantic',"
  "    summary: 'Word count picks a Platonic solid; raycast to its neighbours.',"
  "    description:"
  "      'Change the number of words to move from tetrahedron (4) through cube, octahedron and icosahedron to dodecahedron (20). Turn on raycasting to see each offset from n read as point, line, plane or transformer, relative to a centroid of 10.',"
  "    load: () => import('../templates/Semantic Raycasting Through Platonic Space.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Omicron Evaluator: Polyform Truth Surface',"
  "    group: 'Omi',"
  "    summary: 'The 16 Boolean functions as 16 polyforms, signed with a 15-bit code.',"
  "    description:"
  "      'Treats the 16 two-input Boolean truth functions as 16 polyform bases. Live P and Q streams are evaluated through the selected function’s truth table, and the result is summarized as a 15-bit MaxiCode polynomial signature.',"
  "    load: () => import('../templates/Omicron Evaluator_ Polyform Truth Surface.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Omi-World Builder',"
  "    group: 'Omi',"
  "    summary: 'Place cons cells on a 45° isometric grid.',"
  "    description:"
  "      'A 2.5D world editor: click to place cons-cell nodes on a 45°-rotated grid, drawn as isometric cubes. Growth follows a transfer-matrix (Jensen’s algorithm) approximation of the polyomino sequence, with a 19-term exponent plus a sign bit for conflicts.',"
  "    load: () => import('../templates/Omi-World Builder.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'Omnitron Multi-Axis Analyzer',"
  "    group: 'Omi',"
  "    summary: 'Score a news story on 15 narrative axes with Gemini.',"
  "    description:"
  "      'Pick a story from the sample news feed or paste your own text, and Gemini rates it on 15 “Hopf term” axes, drawn as a radial chart on a 1–9 Aegean scale with fiber-bundle metrics. Needs a Gemini API key filled in to work.',"
  "    load: () => import('../templates/Omnitron Multi-Axis Analyzer.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'NFT Upload Demo',"
  "    group: 'Apps',"
  "    summary: 'A mock flow for uploading and pinning an NFT to IPFS.',"
  "    description:"
  "      'Fill in an NFT’s details and upload it; the result shows its CID and a gateway link, with pin and error states. Uploading and pinning are simulated, so nothing is sent anywhere.',"
  "    load: () => import('../templates/NFT Upload Demo.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'LLM Chat Interface',"
  "    group: 'Apps',"
  "    summary: 'One chat window for Ollama, OpenAI-compatible APIs, Claude, OpenCode or a WebSocket relay.',"
  "    description:"
  "      'Pick a provider in the settings panel, set its base URL, model and key, and test the connection to list its models. Replies stream in as they are written, can be stopped mid-reply, and the settings are remembered in this browser.',"
  "    load: () => import('../templates/Ollama Chat Interface Component.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'P2P Marketplace Web App',"
  "    group: 'Apps',"
  "    summary: 'Browse, filter and post listings in a peer-to-peer market.',"
  "    description:"
  "      'A marketplace front end with search, category and price filters, product detail views and a form for creating a new listing. All listings are sample data held in memory.',"
  "    load: () => import('../templates/P2P Marketplace Web App.tsx'),"
  "  }),"
  "  entry({"
  "    title: 'WebAuthn Wallet QR Code App',"
  "    group: 'Apps',"
  "    summary: 'A passkey-protected Ethereum wallet that signs and verifies QR codes.',"
  "    description:"
  "      'Register or sign in with WebAuthn (a passkey or security key) to create an Ethereum wallet with ethers, then sign data into a QR code and verify a signature against its address. The QR image is a placeholder pattern, not a scannable code.',"
  "    load: () => import('../templates/WebAuthn Wallet QR Code App.tsx'),"
  "  }),"
  "];"
  "export const groups = [...new Set(examples.map((e) => e.group))];"
  "export const findExample = (slug: string | undefined) => examples.findIndex((e) => e.slug === slug);"
