FILE = HEAD .

HEAD =
  "import React, { useState, useEffect, useMemo } from 'react';"
  "import { "
  "  Shield, "
  "  Search, "
  "  Hexagon, "
  "  Layers, "
  "  Eye, "
  "  FileText, "
  "  Terminal, "
  "  Box,"
  "  ChevronRight,"
  "  Database,"
  "  Hash"
  "} from 'lucide-react';"
  "const GenesisExplorer = () => {"
  "  const [activeTab, setActiveTab] = useState('kernel');"
  "  const [logs, setLogs] = useState([]);"
  "  const [fileSystem, setFileSystem] = useState(["
  "    { path: 'README.org', size: 1024, mtime: 1715600000 },"
  "    { path: 'AGENT.org', size: 512, mtime: 1715600500 },"
  "    { path: 'MANIFESTO.org', size: 2048, mtime: 1715601000 },"
  "    { path: 'src/main.sh', size: 4096, mtime: 1715602000 },"
  "    { path: 'assets/logo.png', size: 12400, mtime: 1715603000 },"
  "  ]);"
  "  // Genesis Protocol Logic"
  "  const getAtom = (path, size, mtime) => {"
  "    const seed = `${path}|${size}|${mtime}`;"
  "    // Simplified hash for UI demonstration"
  "    let hash = 0;"
  "    for (let i = 0; i < seed.length; i++) {"
  "      hash = ((hash << 5) - hash) + seed.charCodeAt(i);"
  "      hash |= 0;"
  "    }"
  "    return `A${Math.abs(hash).toString(16).toUpperCase()}B${seed.length}`;"
  "  };"
  "  const getWrappers = (atom) => {"
  "    return {"
  "      left: ""♤♡◇♧"","
  "      right: ""♧◇♡♤"","
  "      canonical: `${atom.toUpperCase()}`,"
  "      ipv6: atom.match(/.{1,4}/g).join(':')"
  "    };"
  "  };"
  "  const handleScan = () => {"
  "    const newLogs = fileSystem.map(f => {"
  "      const atom = getAtom(f.path, f.size, f.mtime);"
  "      return {"
  "        t: new Date().toISOString(),"
  "        k: ""genesis.obs"","
  "        v: {"
  "          atom,"
  "          path: f.path,"
  "          stat: `12345 67 ${f.size} ${f.mtime}`,"
  "          wrappers: getWrappers(atom)"
  "        }"
  "      };"
  "    });"
  "    setLogs(newLogs);"
  "  };"
  "  return ("
  "    <div className=""flex flex-col h-screen bg-slate-950 text-slate-200 font-sans"">"
  "      {/* Header */}"
  "      <header className=""border-b border-slate-800 p-4 bg-slate-900/50 flex items-center justify-between"">"
  "        <div className=""flex items-center gap-3"">"
  "          <div className=""bg-emerald-500/20 p-2 rounded-lg border border-emerald-500/50"">"
  "            <Shield className=""w-6 h-6 text-emerald-400"" />"
  "          </div>"
  "          <div>"
  "            <h1 className=""text-xl font-bold tracking-tight"">GENESIS PROTOCOL</h1>"
  "            <p className=""text-xs text-slate-500 font-mono uppercase tracking-widest"">Layer 0 Authority :: POSIX Reference</p>"
  "          </div>"
  "        </div>"
  "        <div className=""flex gap-2"">"
  "          <button "
  "            onClick={handleScan}"
  "            className=""flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-md transition-all text-sm font-medium"""
  "          >"
  "            <Search className=""w-4 h-4"" />"
  "            GENESIS SCAN"
  "          </button>"
  "        </div>"
  "      </header>"
  "      <div className=""flex flex-1 overflow-hidden"">"
  "        {/* Sidebar */}"
  "        <nav className=""w-64 border-r border-slate-800 bg-slate-900/30 p-4 flex flex-col gap-2"">"
  "          <NavItem active={activeTab === 'kernel'} onClick={() => setActiveTab('kernel')} icon={<Hexagon size={18}/>} label=""Kernel (Layer 0)"" />"
  "          <NavItem active={activeTab === 'views'} onClick={() => setActiveTab('views')} icon={<Eye size={18}/>} label=""Projections (Layer 1)"" />"
  "          <NavItem active={activeTab === 'canvas'} onClick={() => setActiveTab('canvas')} icon={<Layers size={18}/>} label=""Canvas Suite"" />"
  "          <NavItem active={activeTab === 'logs'} onClick={() => setActiveTab('logs')} icon={<Terminal size={18}/>} label=""GENESIS.jsonl"" />"
  "          <div className=""mt-auto p-4 bg-slate-800/40 rounded-lg border border-slate-700/50"">"
  "            <p className=""text-[10px] text-slate-500 uppercase font-bold mb-1"">Status</p>"
  "            <div className=""flex items-center gap-2"">"
  "              <div className=""w-2 h-2 rounded-full bg-emerald-500 animate-pulse"" />"
  "              <span className=""text-xs font-mono text-emerald-400 italic"">Auth: Stat-Truth</span>"
  "            </div>"
  "          </div>"
  "        </nav>"
  "        {/* Main Content */}"
  "        <main className=""flex-1 overflow-auto p-6 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-slate-950"">"
  "          {activeTab === 'kernel' && ("
  "            <div className=""space-y-6"">"
  "              <SectionHeader title=""Source Truth"" subtitle=""Filesystem atoms derived from L0 stats"" />"
  "              <div className=""grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"">"
  "                {fileSystem.map((file, i) => {"
  "                  const atom = getAtom(file.path, file.size, file.mtime);"
  "                  return ("
  "                    <div key={i} className=""bg-slate-900 border border-slate-800 p-4 rounded-xl hover:border-slate-600 transition-colors group"">"
  "                      <div className=""flex justify-between items-start mb-3"">"
  "                        <FileText className=""text-slate-500 group-hover:text-emerald-400 transition-colors"" />"
  "                        <span className=""text-[10px] font-mono bg-slate-800 px-2 py-1 rounded text-slate-400"">ATOM {atom}</span>"
  "                      </div>"
  "                      <h3 className=""font-mono text-sm truncate"">{file.path}</h3>"
  "                      <div className=""mt-4 space-y-1"">"
  "                        <div className=""flex justify-between text-[10px] font-mono text-slate-500"">"
  "                          <span>SIZE</span>"
  "                          <span>{file.size} B</span>"
  "                        </div>"
  "                        <div className=""flex justify-between text-[10px] font-mono text-slate-500"">"
  "                          <span>MTIME</span>"
  "                          <span>{file.mtime}</span>"
  "                        </div>"
  "                      </div>"
  "                    </div>"
  "                  );"
  "                })}"
  "              </div>"
  "            </div>"
  "          )}"
  "          {activeTab === 'views' && ("
  "            <div className=""space-y-6"">"
  "              <SectionHeader title=""Projection Views"" subtitle=""Emoji / Separator algebra wrappers"" />"
  "              <div className=""bg-slate-900 border border-slate-800 rounded-xl overflow-hidden"">"
  "                <table className=""w-full text-left text-sm font-mono"">"
  "                  <thead className=""bg-slate-800/50 text-slate-400 text-xs uppercase"">"
  "                    <tr>"
  "                      <th className=""p-4"">Path</th>"
  "                      <th className=""p-4"">Wrapped Identity</th>"
  "                      <th className=""p-4"">IPv6 Projection</th>"
  "                    </tr>"
  "                  </thead>"
  "                  <tbody>"
  "                    {logs.map((log, i) => ("
  "                      <tr key={i} className=""border-t border-slate-800 hover:bg-slate-800/30"">"
  "                        <td className=""p-4 text-slate-400"">{log.v.path}</td>"
  "                        <td className=""p-4 text-emerald-400"">"
  "                          {log.v.wrappers.left}"
  "                          <span className=""text-white font-bold mx-1"">{log.v.atom}</span>"
  "                          {log.v.wrappers.right}"
  "                        </td>"
  "                        <td className=""p-4 text-sky-400"">{log.v.wrappers.ipv6}</td>"
  "                      </tr>"
  "                    ))}"
  "                    {logs.length === 0 && ("
  "                      <tr>"
  "                        <td colSpan=""3"" className=""p-8 text-center text-slate-500 italic"">No scan performed. Run GENESIS SCAN.</td>"
  "                      </tr>"
  "                    )}"
  "                  </tbody>"
  "                </table>"
  "              </div>"
  "            </div>"
  "          )}"
  "          {activeTab === 'canvas' && ("
  "            <div className=""space-y-6"">"
  "              <SectionHeader title=""Obsidian Canvas Suite"" subtitle=""Visualizing the Protocol architecture"" />"
  "              <div className=""grid grid-cols-1 md:grid-cols-2 gap-6"">"
  "                <CanvasCard title=""00_GENESIS.canvas"" description=""Core Protocol mapping (Layers 0-7)"" color=""bg-emerald-500"" />"
  "                <CanvasCard title=""01_LightDark.canvas"" description=""Inclusion/Exclusion Logic"" color=""bg-amber-500"" />"
  "                <CanvasCard title=""02_Wrappers.canvas"" description=""Separator Algebra Projections"" color=""bg-sky-500"" />"
  "                <CanvasCard title=""03_Judge.canvas"" description=""Reconciliation and Authority"" color=""bg-rose-500"" />"
  "              </div>"
  "            </div>"
  "          )}"
  "          {activeTab === 'logs' && ("
  "            <div className=""space-y-4 h-full flex flex-col"">"
  "              <SectionHeader title=""GENESIS.jsonl"" subtitle=""Append-only observation log"" />"
  "              <div className=""flex-1 bg-black rounded-xl p-4 font-mono text-[11px] overflow-auto border border-slate-800"">"
  "                {logs.length > 0 ? ("
  "                  logs.map((log, i) => ("
  "                    <div key={i} className=""mb-2 text-slate-400"">"
  "                      <span className=""text-emerald-500"">[{log.t}]</span> {JSON.stringify(log)}"
  "                    </div>"
  "                  ))"
  "                ) : ("
  "                  <div className=""text-slate-700 italic"">Waiting for scan event...</div>"
  "                )}"
  "              </div>"
  "            </div>"
  "          )}"
  "        </main>"
  "      </div>"
  "    </div>"
  "  );"
  "};"
  "const NavItem = ({ active, onClick, icon, label }) => ("
  "  <button "
  "    onClick={onClick}"
  "    className={`flex items-center gap-3 px-3 py-2 rounded-lg transition-all text-sm font-medium ${"
  "      active "
  "        ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' "
  "        : 'text-slate-500 hover:text-slate-300 hover:bg-slate-800'"
  "    }`}"
  "  >"
  "    {icon}"
  "    {label}"
  "  </button>"
  ");"
  "const SectionHeader = ({ title, subtitle }) => ("
  "  <div className=""mb-6"">"
  "    <h2 className=""text-2xl font-bold text-white tracking-tight"">{title}</h2>"
  "    <p className=""text-slate-500 text-sm font-mono"">{subtitle}</p>"
  "  </div>"
  ");"
  "const CanvasCard = ({ title, description, color }) => ("
  "  <div className=""bg-slate-900 border border-slate-800 p-6 rounded-2xl relative overflow-hidden group hover:border-slate-500 transition-all cursor-pointer"">"
  "    <div className={`absolute top-0 right-0 w-32 h-32 ${color} opacity-5 blur-3xl group-hover:opacity-20 transition-opacity`} />"
  "    <Box className=""text-slate-500 mb-4 group-hover:text-white transition-colors"" size={32} />"
  "    <h3 className=""text-lg font-bold text-slate-200"">{title}</h3>"
  "    <p className=""text-slate-500 text-sm mt-1"">{description}</p>"
  "    <div className=""mt-6 flex items-center text-[10px] font-bold text-slate-400 uppercase tracking-widest"">"
  "      <span>Preview Projection</span>"
  "      <ChevronRight size={14} className=""ml-1"" />"
  "    </div>"
  "  </div>"
  ");"
  "export default GenesisExplorer;"
  .
