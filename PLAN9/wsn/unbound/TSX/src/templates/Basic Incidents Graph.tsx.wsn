FILE = HEAD .

HEAD =
  "import React from 'react';"
  "import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';"
  "interface IncidentData {"
  "  date: string;"
  "  incidents: number;"
  "  severity: 'low' | 'medium' | 'high';"
  "}"
  "const IncidentsGraph: React.FC = () => {"
  "  // Sample incident data"
  "  const incidentData: IncidentData[] = ["
  "    { date: '2024-01-01', incidents: 12, severity: 'low' },"
  "    { date: '2024-01-02', incidents: 8, severity: 'medium' },"
  "    { date: '2024-01-03', incidents: 15, severity: 'low' },"
  "    { date: '2024-01-04', incidents: 22, severity: 'high' },"
  "    { date: '2024-01-05', incidents: 18, severity: 'medium' },"
  "    { date: '2024-01-06', incidents: 9, severity: 'low' },"
  "    { date: '2024-01-07', incidents: 25, severity: 'high' },"
  "    { date: '2024-01-08', incidents: 14, severity: 'medium' },"
  "    { date: '2024-01-09', incidents: 11, severity: 'low' },"
  "    { date: '2024-01-10', incidents: 19, severity: 'medium' },"
  "    { date: '2024-01-11', incidents: 16, severity: 'medium' },"
  "    { date: '2024-01-12', incidents: 7, severity: 'low' },"
  "    { date: '2024-01-13', incidents: 28, severity: 'high' },"
  "    { date: '2024-01-14', incidents: 13, severity: 'medium' }"
  "  ];"
  "  const formatDate = (dateStr: string): string => {"
  "    const date = new Date(dateStr);"
  "    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });"
  "  };"
  "  const getSeverityColor = (severity: string): string => {"
  "    switch (severity) {"
  "      case 'low': return '#10b981';"
  "      case 'medium': return '#f59e0b';"
  "      case 'high': return '#ef4444';"
  "      default: return '#6b7280';"
  "    }"
  "  };"
  "  return ("
  "    <div className=""w-full p-6 bg-white rounded-lg shadow-lg"">"
  "      <div className=""mb-6"">"
  "        <h2 className=""text-2xl font-bold text-gray-800 mb-2"">Incident Reports Over Time</h2>"
  "        <p className=""text-gray-600"">Daily incident count with severity indicators</p>"
  "      </div>"
  "      <ResponsiveContainer width=""100%"" height={400}>"
  "        <LineChart"
  "          data={incidentData}"
  "          margin={{"
  "            top: 5,"
  "            right: 30,"
  "            left: 20,"
  "            bottom: 5,"
  "          }}"
  "        >"
  "          <CartesianGrid strokeDasharray=""3 3"" stroke=""#e5e7eb"" />"
  "          <XAxis "
  "            dataKey=""date"" "
  "            tickFormatter={formatDate}"
  "            stroke=""#6b7280"""
  "            fontSize={12}"
  "          />"
  "          <YAxis "
  "            stroke=""#6b7280"""
  "            fontSize={12}"
  "            label={{ value: 'Number of Incidents', angle: -90, position: 'insideLeft' }}"
  "          />"
  "          <Tooltip "
  "            formatter={(value: number, name: string, props: any) => ["
  "              `${value} incidents`,"
  "              `Severity: ${props.payload.severity}`"
  "            ]}"
  "            labelFormatter={(label: string) => `Date: ${formatDate(label)}`}"
  "            contentStyle={{"
  "              backgroundColor: '#f9fafb',"
  "              border: '1px solid #e5e7eb',"
  "              borderRadius: '6px'"
  "            }}"
  "          />"
  "          <Legend />"
  "          <Line "
  "            type=""monotone"" "
  "            dataKey=""incidents"" "
  "            stroke=""#3b82f6"""
  "            strokeWidth={2}"
  "            dot={{ fill: '#3b82f6', strokeWidth: 2, r: 4 }}"
  "            activeDot={{ r: 6, stroke: '#3b82f6', strokeWidth: 2 }}"
  "            name=""Incidents"""
  "          />"
  "        </LineChart>"
  "      </ResponsiveContainer>"
  "      <div className=""mt-6 grid grid-cols-3 gap-4"">"
  "        <div className=""bg-red-50 p-4 rounded-lg border border-red-200"">"
  "          <div className=""flex items-center"">"
  "            <div className=""w-3 h-3 bg-red-500 rounded-full mr-2""></div>"
  "            <span className=""text-sm font-medium text-red-700"">High Severity</span>"
  "          </div>"
  "          <p className=""text-2xl font-bold text-red-800 mt-1"">"
  "            {incidentData.filter(d => d.severity === 'high').length}"
  "          </p>"
  "        </div>"
  "        <div className=""bg-yellow-50 p-4 rounded-lg border border-yellow-200"">"
  "          <div className=""flex items-center"">"
  "            <div className=""w-3 h-3 bg-yellow-500 rounded-full mr-2""></div>"
  "            <span className=""text-sm font-medium text-yellow-700"">Medium Severity</span>"
  "          </div>"
  "          <p className=""text-2xl font-bold text-yellow-800 mt-1"">"
  "            {incidentData.filter(d => d.severity === 'medium').length}"
  "          </p>"
  "        </div>"
  "        <div className=""bg-green-50 p-4 rounded-lg border border-green-200"">"
  "          <div className=""flex items-center"">"
  "            <div className=""w-3 h-3 bg-green-500 rounded-full mr-2""></div>"
  "            <span className=""text-sm font-medium text-green-700"">Low Severity</span>"
  "          </div>"
  "          <p className=""text-2xl font-bold text-green-800 mt-1"">"
  "            {incidentData.filter(d => d.severity === 'low').length}"
  "          </p>"
  "        </div>"
  "      </div>"
  "    </div>"
  "  );"
  "};"
  "export default IncidentsGraph;"
  .
