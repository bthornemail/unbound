FILE = HEAD .

HEAD =
  "import React, { useState, useEffect, useRef, useMemo } from 'react';"
  "import { "
  "  Box, "
  "  Settings, "
  "  Share2, "
  "  Download, "
  "  Layers, "
  "  Maximize2, "
  "  Move, "
  "  Hexagon, "
  "  Grid3X3,"
  "  Activity,"
  "  Zap"
  "} from 'lucide-react';"
  "/**"
  " * Omi-Cons World Builder"
  " * Paradigm: Transfer-Matrix (Jensen's Algorithm) on a 45° rotated grid."
  " * Precision: 19-term exponent + 1 sign bit (Conflict)."
  " */"
  "const App = () => {"
  "  // --- State Management ---"
  "  const [nodes, setNodes] = useState([]);"
  "  const [connections, setConnections] = useState([]);"
  "  const [viewMode, setViewMode] = useState('2.5d'); // 2d, 2.5d, 3d"
  "  const [activeLayer, setActiveLayer] = useState(0);"
  "  const [draggedNode, setDraggedNode] = useState(null);"
  "  const [viewOffset, setViewOffset] = useState({ x: 0, y: 0 });"
  "  const [zoom, setZoom] = useState(1);"
  "  const [polyominoCount, setPolyominoCount] = useState(0);"
  "  const canvasRef = useRef(null);"
  "  const GRID_SIZE = 40;"
  "  const ROTATION_45 = Math.PI / 4;"
  "  // --- Jensen's Algorithm / Transfer Matrix Simulation ---"
  "  const calculateTransferMatrix = useMemo(() => {"
  "    // This simulates the growth of the boundary for n-terms"
  "    // based on the 45 degree lattice optimization."
  "    return (n) => {"
  "      // Approximate polyomino sequence (A001419) logic"
  "      const lambda = 4.0625; // Growth constant for square lattice"
  "      return Math.floor(Math.pow(lambda, n) / (n * n));"
  "    };"
  "  }, []);"
  "  // --- Coordinate Transformation ---"
  "  const toIsometric = (x, y, z = 0) => {"
  "    if (viewMode === '2d') return { x, y };"
  "    // 45 degree rotation + 2.5D projection"
  "    const isoX = (x - y) * Math.cos(ROTATION_45);"
  "    const isoY = (x + y) * Math.sin(ROTATION_45) - (z * 20);"
  "    return { x: isoX, y: isoY };"
  "  };"
  "  // --- Interaction Handlers ---"
  "  const handleCanvasClick = (e) => {"
  "    const rect = canvasRef.current.getBoundingClientRect();"
  "    const rawX = (e.clientX - rect.left - rect.width / 2 - viewOffset.x) / zoom;"
  "    const rawY = (e.clientY - rect.top - rect.height / 2 - viewOffset.y) / zoom;"
  "    // Reverse isometric would go here, for now we snap to grid"
  "    const newNode = {"
  "      id: `node-${Date.now()}`,"
  "      x: Math.round(rawX / GRID_SIZE) * GRID_SIZE,"
  "      y: Math.round(rawY / GRID_SIZE) * GRID_SIZE,"
  "      z: activeLayer * 20,"
  "      meta64: `::ffff:10.120.${activeLayer}.${nodes.length}`,"
  "      type: 'cons256'"
  "    };"
  "    setNodes([...nodes, newNode]);"
  "    setPolyominoCount(calculateTransferMatrix(nodes.length + 1));"
  "  };"
  "  const exportPolynomial = () => {"
  "    const data = {"
  "      type: ""Omi-Cons Polynomial Export"","
  "      terms: nodes.length,"
  "      view: viewMode,"
  "      bqf: ""f(x,y) = ax^2 + bxy + cy^2"","
  "      nodes: nodes.map(n => ({ m64: n.meta64, pos: [n.x, n.y, n.z] }))"
  "    };"
  "    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });"
  "    const url = URL.createObjectURL(blob);"
  "    const link = document.createElement('a');"
  "    link.href = url;"
  "    link.download = `omi_world_${Date.now()}.json`;"
  "    link.click();"
  "  };"
  "  // --- Rendering ---"
  "  useEffect(() => {"
  "    const canvas = canvasRef.current;"
  "    const ctx = canvas.getContext('2d');"
  "    ctx.clearRect(0, 0, canvas.width, canvas.height);"
  "    const centerX = canvas.width / 2 + viewOffset.x;"
  "    const centerY = canvas.height / 2 + viewOffset.y;"
  "    // Draw Rotated Grid"
  "    ctx.strokeStyle = '#1e293b';"
  "    ctx.lineWidth = 1;"
  "    for (let i = -10; i <= 10; i++) {"
  "      const start = toIsometric(-400, i * GRID_SIZE);"
  "      const end = toIsometric(400, i * GRID_SIZE);"
  "      ctx.beginPath();"
  "      ctx.moveTo(centerX + start.x * zoom, centerY + start.y * zoom);"
  "      ctx.lineTo(centerX + end.x * zoom, centerY + end.y * zoom);"
  "      ctx.stroke();"
  "      const startV = toIsometric(i * GRID_SIZE, -400);"
  "      const endV = toIsometric(i * GRID_SIZE, 400);"
  "      ctx.beginPath();"
  "      ctx.moveTo(centerX + startV.x * zoom, centerY + startV.y * zoom);"
  "      ctx.lineTo(centerX + endV.x * zoom, centerY + endV.y * zoom);"
  "      ctx.stroke();"
  "    }"
  "    // Draw Nodes (Cons Cells)"
  "    nodes.forEach(node => {"
  "      const pos = toIsometric(node.x, node.y, node.z);"
  "      const screenX = centerX + pos.x * zoom;"
  "      const screenY = centerY + pos.y * zoom;"
  "      // Draw Node Body"
  "      ctx.fillStyle = '#3b82f6';"
  "      ctx.shadowBlur = 10;"
  "      ctx.shadowColor = '#3b82f6';"
  "      ctx.beginPath();"
  "      if (viewMode === '2d') {"
  "        ctx.arc(screenX, screenY, 8, 0, Math.PI * 2);"
  "      } else {"
  "        // Isometric Diamond/Cube"
  "        ctx.moveTo(screenX, screenY - 10);"
  "        ctx.lineTo(screenX + 15, screenY);"
  "        ctx.lineTo(screenX, screenY + 10);"
  "        ctx.lineTo(screenX - 15, screenY);"
  "        ctx.closePath();"
  "      }"
  "      ctx.fill();"
  "      ctx.shadowBlur = 0;"
  "      // Label Meta64"
  "      ctx.fillStyle = '#94a3b8';"
  "      ctx.font = '10px monospace';"
  "      ctx.fillText(node.meta64, screenX + 15, screenY - 15);"
  "    });"
  "  }, [nodes, zoom, viewOffset, viewMode, activeLayer]);"
  "  return ("
  "    <div className=""flex h-screen w-screen bg-[#020617] text-slate-200 overflow-hidden font-sans"">"
  "      {/* Sidebar Controls */}"
  "      <div className=""w-80 bg-[#0f172a] border-r border-slate-800 p-6 flex flex-col gap-6 z-10 shadow-xl"">"
  "        <div className=""flex items-center gap-3"">"
  "          <div className=""p-2 bg-blue-600 rounded-lg"">"
  "            <Hexagon size={24} className=""text-white"" />"
  "          </div>"
  "          <h1 className=""text-xl font-bold tracking-tight"">OMI WORLD</h1>"
  "        </div>"
  "        <div className=""space-y-4"">"
  "          <label className=""text-xs font-bold uppercase tracking-widest text-slate-500"">View Mode</label>"
  "          <div className=""grid grid-cols-3 gap-2"">"
  "            {['2d', '2.5d', '3d'].map(m => ("
  "              <button "
  "                key={m}"
  "                onClick={() => setViewMode(m)}"
  "                className={`py-2 rounded border transition-all ${viewMode === m ? 'bg-blue-600 border-blue-400 text-white' : 'bg-slate-800 border-slate-700 text-slate-400 hover:bg-slate-700'}`}"
  "              >"
  "                {m.toUpperCase()}"
  "              </button>"
  "            ))}"
  "          </div>"
  "        </div>"
  "        <div className=""space-y-4"">"
  "          <label className=""text-xs font-bold uppercase tracking-widest text-slate-500"">Jensen's TMA Stats</label>"
  "          <div className=""bg-slate-900 rounded-lg p-4 border border-slate-800 space-y-2"">"
  "            <div className=""flex justify-between items-center"">"
  "              <span className=""text-sm text-slate-400"">Fixed Terms:</span>"
  "              <span className=""text-sm font-mono text-blue-400"">{nodes.length}</span>"
  "            </div>"
  "            <div className=""flex justify-between items-center"">"
  "              <span className=""text-sm text-slate-400"">Polyominoes:</span>"
  "              <span className=""text-sm font-mono text-green-400"">{polyominoCount.toLocaleString()}</span>"
  "            </div>"
  "            <div className=""w-full bg-slate-800 h-1 rounded-full overflow-hidden mt-2"">"
  "              <div className=""bg-blue-500 h-full"" style={{ width: `${(nodes.length / 70) * 100}%` }}></div>"
  "            </div>"
  "          </div>"
  "        </div>"
  "        <div className=""space-y-4"">"
  "          <label className=""text-xs font-bold uppercase tracking-widest text-slate-500"">Layer (z-index)</label>"
  "          <input "
  "            type=""range"" min=""0"" max=""10"" value={activeLayer} "
  "            onChange={(e) => setActiveLayer(parseInt(e.target.value))}"
  "            className=""w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500"""
  "          />"
  "          <div className=""flex justify-between text-[10px] text-slate-500 font-mono"">"
  "            <span>LAYER 0 (OMI)</span>"
  "            <span>LAYER 10 (CONS)</span>"
  "          </div>"
  "        </div>"
  "        <div className=""mt-auto space-y-2"">"
  "          <button "
  "            onClick={exportPolynomial}"
  "            className=""w-full flex items-center justify-center gap-2 bg-slate-100 text-slate-900 font-bold py-3 rounded-xl hover:bg-white transition-all shadow-lg shadow-white/5"""
  "          >"
  "            <Download size={18} />"
  "            EXPORT POLYNOMIAL"
  "          </button>"
  "          <button "
  "            onClick={() => setNodes([])}"
  "            className=""w-full flex items-center justify-center gap-2 bg-red-900/20 text-red-400 border border-red-900/50 py-3 rounded-xl hover:bg-red-900/30 transition-all"""
  "          >"
  "            CLEAR MANIFOLD"
  "          </button>"
  "        </div>"
  "      </div>"
  "      {/* Main Canvas Area */}"
  "      <div className=""relative flex-1 cursor-crosshair group"">"
  "        <canvas "
  "          ref={canvasRef}"
  "          width={window.innerWidth - 320}"
  "          height={window.innerHeight}"
  "          onClick={handleCanvasClick}"
  "          className=""w-full h-full"""
  "        />"
  "        {/* Overlay Tools */}"
  "        <div className=""absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 bg-[#0f172a]/80 backdrop-blur-md p-2 rounded-2xl border border-slate-800 shadow-2xl transition-all opacity-0 group-hover:opacity-100"">"
  "          <div className=""px-4 py-2 flex items-center gap-4 border-r border-slate-700"">"
  "             <div className=""flex items-center gap-2"">"
  "                <div className=""w-3 h-3 bg-blue-500 rounded-full animate-pulse""></div>"
  "                <span className=""text-xs font-mono text-slate-400"">45° LATTICE ACTIVE</span>"
  "             </div>"
  "          </div>"
  "          <button onClick={() => setZoom(z => z * 1.1)} className=""p-3 text-slate-400 hover:text-white hover:bg-slate-700 rounded-xl transition-all"">"
  "            <Maximize2 size={20} />"
  "          </button>"
  "          <button onClick={() => setZoom(z => z * 0.9)} className=""p-3 text-slate-400 hover:text-white hover:bg-slate-700 rounded-xl transition-all"">"
  "            <Layers size={20} />"
  "          </button>"
  "          <div className=""w-px h-6 bg-slate-700 mx-1""></div>"
  "          <button className=""p-3 text-slate-400 hover:text-white hover:bg-slate-700 rounded-xl transition-all"">"
  "            <Move size={20} />"
  "          </button>"
  "        </div>"
  "        {/* Floating Metrics */}"
  "        <div className=""absolute top-8 right-8 flex flex-col gap-4 text-right"">"
  "          <div className=""bg-blue-500/10 border border-blue-500/20 px-4 py-2 rounded-lg backdrop-blur-sm"">"
  "            <div className=""text-[10px] text-blue-400 font-bold uppercase"">Consensus Status</div>"
  "            <div className=""text-lg font-mono text-blue-100"">STABLE (L10)</div>"
  "          </div>"
  "          <div className=""bg-slate-900/80 border border-slate-800 px-4 py-2 rounded-lg backdrop-blur-sm"">"
  "            <div className=""text-[10px] text-slate-500 font-bold uppercase"">Coordinates</div>"
  "            <div className=""text-sm font-mono text-slate-300"">"
  "              {nodes.length > 0 ? `${nodes[nodes.length-1].x}, ${nodes[nodes.length-1].y}` : ""0, 0""}"
  "            </div>"
  "          </div>"
  "        </div>"
  "      </div>"
  "    </div>"
  "  );"
  "};"
  "export default App;"
  .
