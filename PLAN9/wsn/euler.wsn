PROGRAM = BLOCK .
VARDECL = "new" ID .
FORDECL = "formal" ID .
LABDECL = "label" ID .
VAR = ID | VAR "[" EXPR "]" | VAR "." .
LOGVAL = "true" | "false" .
REFERENCE = "@" VAR .
LISTHEAD = LISTHEAD EXPR "," | "(" .
LISTN = LISTHEAD EXPR ")" | LISTHEAD ")" .
PROCHEAD = PROCHEAD FORDECL ";" | "'" .
PROCDEF = PROCHEAD EXPR "'" .
PRIMARY = VAR | VAR LISTN | LOGVAL | NUMBER | SYMBOL | REFERENCE | LISTN | "tail" PRIMARY | PROCDEF | "undef" | "[" EXPR "]" | "in" | "isb" VAR | "isr" VAR | "isl" VAR | "isli" VAR | "isy" VAR | "isp" VAR | "isu" VAR | "abs" PRIMARY | "length" VAR | "integer" PRIMARY | "real" PRIMARY | "logical" PRIMARY | "list" PRIMARY .
FACTOR = PRIMARY | FACTOR "**" PRIMARY .
TERM = FACTOR | TERM "*" FACTOR | TERM "/" FACTOR | TERM "div" FACTOR | TERM "mod" FACTOR .
SUM = TERM | "+" TERM | "-" TERM | SUM "+" TERM | SUM "-" TERM .
CHOICE = SUM | CHOICE "min" SUM | CHOICE "max" SUM .
RELATION = CHOICE | CHOICE "=" CHOICE | CHOICE "~=" CHOICE | CHOICE "<" CHOICE | CHOICE "<=" CHOICE | CHOICE ">" CHOICE | CHOICE ">=" CHOICE .
NEGATION = RELATION | "~" RELATION .
CONJHEAD = NEGATION "and" .
CONJ = CONJHEAD CONJ | NEGATION .
DISJHEAD = CONJ "or" .
DISJ = DISJHEAD DISJ | CONJ .
CATENA = CATENA "&" PRIMARY | DISJ .
TRUEPART = EXPR "else" .
IFCLAUSE = "if" EXPR "then" .
EXPR = BLOCK | IFCLAUSE TRUEPART EXPR | VAR "<-" EXPR | "goto" PRIMARY | "out" EXPR | CATENA .
STAT = LABDEF STAT | EXPR .
LABDEF = ID ":" .
BLOKHEAD = "begin" | BLOKHEAD VARDECL ";" | BLOKHEAD LABDECL ";" .
BLOKBODY = BLOKHEAD | BLOKBODY STAT ";" .
BLOCK = BLOKBODY STAT "end" .
ID = "id" .
NUMBER = "number" .
SYMBOL = "symbol" .
