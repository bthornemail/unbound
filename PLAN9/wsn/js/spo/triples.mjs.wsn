FILE = HEAD .

HEAD =
  "// The triples, each a candidate for consideration (P1: a finite, computable"
  "// check; PROOF_CANONIZATION.md), indexed by subject, predicate and object."
  "// Subject and object are written as literals: the radix belongs to the literal."
  "// [subject, predicate, argument or null, object, source in boxedPINE]"
  "export const TRIPLES = ["
  "  ['0xFEFF', 'swap16', null, '0xFFFE', 'boxedPINE src/i134.ts, I-134 (the two byte-order marks are byte swaps)'],"
  "  ['0xFEFF', 'xor', '0xFFFE', '0x0101', 'boxedPINE src/i134.ts, I-134 (each byte flips its low bit)'],"
  "  ['0x7C00', 'swap16', null, '0x007C', 'README.v2 (the x86 boot sector address)'],"
  "  ['60', 'xor', '64', '124', 'SPEC-07 I-18 (the lower pole)'],"
  "  ['60', 'xor', '128', '188', 'SPEC-07 I-18 (the higher pole)'],"
  "  ['9', 'xor', '10', '3', 'SPEC-07 I-80 (swap32 seen through 9 and 10)'],"
  "  ['11', 'xor', '3', '8', 'SPEC-07 I-80'],"
  "  ['443', 'and', '7', '3', 'SRC-12 (port 443 sits at atom 3, the throw)'],"
  "  ['0x01010101', 'xor', '0x08080808', '0x09090909', 'SPEC-07 I-99 (1.1.1.1, 8.8.8.8, 9.9.9.9 are a line)'],"
  "  ['0x96', 'xor', '0xFF', '0x69', 'SPEC-07 I-102 (the organ byte: Thue-Morse complemented)'],"
  "  ['0x4242', 'K', null, '0x061B', 'SPEC-07 I-101 (the chain root, on the ESP32 and the host)'],"
  "  ['0x4242', 'periodK', null, '8', 'SPEC-07 I-10, I-101 (Coq: Delta16HasExactPeriodEight)'],"
  "  ['0o111', 'value', null, '73', 'SRC-12 (111 in octal is the period prime 73)'],"
  "  ['97', 'unitIndex', '210', '21', 'SPEC-07 I-104 (the regular ladder starts just after index 20)'],"
  "];"
  "// Must-reject: claims that were checked and do not hold. Each must FAIL here,"
  "// so a false relation cannot return unnoticed. [subject, predicate, argument, claimed object, why]"
  "export const REJECTS = ["
  "  ['0xFFFE', 'xor', '0xFFFF', '0xFEFF', 'src/i134.ts, corrected 2026-10-12: the BOMs are not bit complements (~0xFFFE is 0x0001)'],"
  "  ['0x96', 'xor', '0x00', '0x69', 'the organ byte is 0x96 complemented, not 0x96 itself'],"
  "  ['0x4242', 'periodK', null, '16', 'SPEC-07 I-10: the period is 8, not 16'],"
  "];"
  .
