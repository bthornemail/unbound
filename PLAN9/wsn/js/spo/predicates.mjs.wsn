FILE = HEAD .

HEAD =
  "// The predicates of the subject-predicate-object index: named relations over"
  "// BigInt, so a constant keeps its width (0n is a value like any other)."
  "// Index operations only (XOR, shifts, masks, rotations), except where marked"
  "// ""value door"" (as boxedPINE's SPEC-07 I-74 asks)."
  "const rotl16 = (x, n) => ((x << BigInt(n)) | (x >> BigInt(16 - n))) & 0xffffn;"
  "const K = (p, c = 0x1dn) => rotl16(p, 1) ^ rotl16(p, 3) ^ rotl16(p, 14) ^ c; // rotr 2 = rotl 14"
  "/** name -> (subject, argument) -> object */"
  "export const PREDICATES = {"
  "  /** the two bytes of a 16-bit word trade places */"
  "  swap16: (s) => ((s & 0xffn) << 8n) | ((s >> 8n) & 0xffn),"
  "  /** XOR with the argument */"
  "  xor: (s, a) => s ^ a,"
  "  /** keep the bits of the argument */"
  "  and: (s, a) => s & a,"
  "  /** one step of the step law K(p, 0x1D) on 16 bits */"
  "  K: (s) => K(s),"
  "  /** steps of K until the subject returns */"
  "  periodK: (s) => { let x = K(s), n = 1n; while (x !== s) { x = K(x); n++; } return n; },"
  "  /** the subject written in its own radix, read as a number */"
  "  value: (s) => s,"
  "  /** place among the residues coprime to the argument (value door: gcd) */"
  "  unitIndex: (s, a) => {"
  "    const gcd = (x, y) => (y ? gcd(y, x % y) : x);"
  "    let i = 0n;"
  "    for (let x = 0n; x < s; x++) if (gcd(x, a) === 1n) i++;"
  "    return gcd(s, a) === 1n ? i : -1n;"
  "  },"
  "};"
  "/** A literal as BigInt: 0x, 0o, 0b or decimal, as written. */"
  "export const literal = (text) => BigInt(text);"
  .
