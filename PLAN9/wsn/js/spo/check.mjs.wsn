FILE = HEAD .

HEAD =
  "// Check every triple, then write the three indexes (by subject, by predicate,"
  "// by object) to index.json. Exits 1 if any triple does not hold."
  "// Run: node proofs/js/check.mjs"
  "import { writeFileSync } from 'node:fs';"
  "import { PREDICATES, literal } from './predicates.mjs';"
  "import { TRIPLES, REJECTS } from './triples.mjs';"
  "const width = (text) => text.replace(/^0[xob]/i, '').length;"
  "const show = (n, like) => {"
  "  const m = /^0([xob])/i.exec(like);"
  "  if (!m) return n.toString(10);"
  "  const radix = { x: 16, o: 8, b: 2 }[m[1].toLowerCase()];"
  "  return `0${m[1]}${n.toString(radix).toUpperCase().padStart(width(like), '0')}`;"
  "};"
  "const index = { subject: {}, predicate: {}, object: {} };"
  "let failed = 0;"
  "for (const [s, p, arg, o, source] of TRIPLES) {"
  "  const got = PREDICATES[p](literal(s), arg === null ? undefined : literal(arg));"
  "  const ok = got === literal(o);"
  "  if (!ok) failed++;"
  "  const pred = arg === null ? p : `${p} ${arg}`;"
  "  console.log(`${ok ? '✔' : '✗'} ${s.padEnd(11)} ${pred.padEnd(18)} ${o.padEnd(11)} ${ok ? '' : `got ${show(got, o)}  `}${source}`);"
  "  const entry = { subject: s, predicate: pred, object: o, source, holds: ok };"
  "  for (const [key, value] of [['subject', s], ['predicate', p], ['object', o]]) (index[key][value] ??= []).push(entry);"
  "}"
  "console.log('\nmust-reject (each must not hold):');"
  "for (const [s, p, arg, o, why] of REJECTS) {"
  "  const got = PREDICATES[p](literal(s), arg === null ? undefined : literal(arg));"
  "  const rejected = got !== literal(o);"
  "  if (!rejected) failed++;"
  "  const pred = arg === null ? p : `${p} ${arg}`;"
  "  console.log(`${rejected ? '✔ rejected' : '✗ HOLDS  '} ${s.padEnd(11)} ${pred.padEnd(18)} ${o.padEnd(11)} ${why}`);"
  "}"
  "writeFileSync(new URL('./index.json', import.meta.url), JSON.stringify(index, null, 2) + '\n');"
  "console.log(`\n${TRIPLES.length} triples, ${REJECTS.length} must-rejects, ${failed} problems; index.json written (by subject, predicate, object)`);"
  "process.exit(failed ? 1 : 0);"
  .
