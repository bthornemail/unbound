  "    },"
  "    ""statements"": ["
  "      {"
  "        ""section"": ""The face: SUBJECT and OBJECT share BJECT"","
  "        ""text"": ""the shared face, BJECT, five letters"""
  "      },"
  "      {"
  "        ""section"": ""The face: SUBJECT and OBJECT share BJECT"","
  "        ""text"": ""reflected, S ^ O = s, SUB, then five nulls: the face cancels"""
  "      },"
  "      {"
  "        ""section"": ""The face: SUBJECT and OBJECT share BJECT"","
  "        ""text"": ""the S against the space: the subject demoted"""
  "      },"
  "      {"
  "        ""section"": ""The face: SUBJECT and OBJECT share BJECT"","
  "        ""text"": ""U ^ O = 0x1A, the control named SUB (substitute)"""
  "      },"
  "      {"
  "        ""section"": ""The face: SUBJECT and OBJECT share BJECT"","
  "        ""text"": ""left-aligned, nothing cancels: the face meets only reflected"""
  "      },"
  "      {"
  "        ""section"": ""The slot of five: the predicate passes through whole"","
  "        ""text"": ""SUBJECT ${p} OBJECT, reflected: S, then ${p} whole"""
  "      },"
  "      {"
  "        ""section"": ""The slot of five: the predicate passes through whole"","
  "        ""text"": ""S ^ P ^ O is not 0: what holds is the reflection, not the closure"""
  "      },"
  "      {"
  "        ""section"": ""Substituting LOGIC for PIXEL"","
  "        ""text"": ""LOGIC ^ PIXEL = FS ACK US FF SI"""
  "      },"
  "      {"
  "        ""section"": ""Substituting LOGIC for PIXEL"","
  "        ""text"": ""it opens with FS, the File Separator"""
  "      },"
  "      {"
  "        ""section"": ""Substituting LOGIC for PIXEL"","
  "        ""text"": ""and holds US, the Unit Separator: from the file to the unit"""
  "      },"
  "      {"
  "        ""section"": ""Substituting LOGIC for PIXEL"","
  "        ""text"": ""all five in the control column: two tags, letter against letter (I-201)"""
  "      }"
  "    ],"
