  "      },"
  "      {"
  "        ""section"": ""Braille: four decades on one base of ten"","
  "        ""text"": ""each decade adds one fixed pattern: dot 3 (0x04), dots 3 and 6 (0x24), dot 6 (0x20)"""
  "      },"
  "      {"
