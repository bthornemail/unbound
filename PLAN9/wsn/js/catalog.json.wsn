  "  },"
  "  {"
  "    ""id"": ""I-218"","
  "    ""tag"": ""62"","
  "    ""title"": ""S>H>I>F>T> — the shift held, for an ILLOGICal AWAKEning: a catch-22"","
  "    ""category"": ""other"","
  "    ""status"": ""P1"","
  "    ""holds"": true,"
  "    ""owners"": ["
  "      ""js/catalog/I-218.ts"""
  "    ],"
  "    ""carriers"": {"
  "      ""script"": {"
  "        ""bytes"": 4709"
  "      },"
  "      ""base64"": ""js/vm/62.b64"","
  "      ""base64url"": ""js/vm/62.b64url"","
  "      ""vm"": ""holds"","
  "      ""worker"": ""holds"""
  "    },"
  "    ""statements"": ["
  "      {"
  "        ""section"": ""The capitals are cut at five: the cave's rule"","
  "        ""text"": ""${cut}: the first five of ${word}"""
  "      },"
  "      {"
  "        ""section"": ""The capitals are cut at five: the cave's rule"","
  "        ""text"": ""${cut} is a tag"""
  "      },"
  "      {"
  "        ""section"": ""The capitals are cut at five: the cave's rule"","
  "        ""text"": ""the whole words, over 8 letters, are not tags"""
  "      },"
  "      {"
  "        ""section"": ""The capitals are cut at five: the cave's rule"","
  "        ""text"": ""LOGICAL (7) is a tag whole, and its five are LOGIC"""
  "      },"
  "      {"
  "        ""section"": ""S>H>I>F>T>: the shift held over itself"","
  "        ""text"": ""the shift held over s.h.i.f.t. gives S>H>I>F>T>"""
  "      },"
  "      {"
  "        ""section"": ""S>H>I>F>T>: the shift held over itself"","
  "        ""text"": ""held over the word shift: SHIFT"""
  "      },"
  "      {"
  "        ""section"": ""S>H>I>F>T>: the shift held over itself"","
  "        ""text"": ""and over held: HELD"""
  "      },"
  "      {"
  "        ""section"": ""S>H>I>F>T>: the shift held over itself"","
  "        ""text"": ""held again, the same: it propagates, it does not accumulate"""
  "      },"
  "      {"
  "        ""section"": ""S>H>I>F>T>: the shift held over itself"","
  "        ""text"": ""each letter passed on to the next, as G>L>U>E>"""
  "      },"
  "      {"
  "        ""section"": ""The letters"","
  "        ""text"": ""SHIFT's letters XOR to 0x40: the uppercase column's bit, one bit"""
  "      },"
  "      {"
  "        ""section"": ""The letters"","
  "        ""text"": ""REVEL reversed is LEVER"""
  "      },"
  "      {"
  "        ""section"": ""The letters"","
  "        ""text"": ""HELD reversed begins DLE"""
  "      },"
  "      {"
  "        ""section"": ""The letters"","
  "        ""text"": ""DLE is 0x10, the bit a held Shift sets on the stop (the name a coincidence of letters; the bit, arithmetic)"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""ILLOGICAL is IL + LOGICAL"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""nine letters, no tag; its first five, ILLOG, are"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""Shift + 2 on the teletype: the quote"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""and the quote is 0x22: the Catch-22 byte read as hex"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""0x22 = 0o42: frame 42, where the exchange's reset falls (60 ^ 22 = 42)"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""`assert.equal(60 ^ 22, 42);`"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""on today's keyboard the shift held gives the command pair, digits untouched"""
  "      },"
  "      {"
  "        ""section"": ""The illogical awakening: a catch-22"","
  "        ""text"": ""on the teletype the digits turn too: the catch, the indices that could not be deprecated changed by the held shift"""
  "      }"
  "    ],"
  "    ""corrections"": [],"
  "    ""witnesses"": []"
  "  },"
