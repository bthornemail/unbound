  "      ""vm"": ""holds"","
  "      ""worker"": ""holds"""
  "    },"
  "    ""statements"": ["
  "      {"
  "        ""section"": ""The difference and the agreement"","
  "        ""text"": ""DEADBEEF is a tag: eight letters, all of them hex"""
  "      },"
  "      {"
  "        ""section"": ""The difference and the agreement"","
  "        ""text"": ""de88bc2d XOR deadbeef = 00 25 02 c2: the first byte cancels"""
  "      },"
  "      {"
  "        ""section"": ""The difference and the agreement"","
  "        ""text"": ""XNOR, the complement: ff da fd 3d"""
  "      },"
  "      {"
  "        ""section"": ""00 25 02 c2: the letters at their indices"","
  "        ""text"": ""00 25 02, read in base 10 as indices: A, Z, C"""
  "      },"
  "      {"
  "        ""section"": ""00 25 02 c2: the letters at their indices"","
  "        ""text"": ""and c2: c is at index 2, the 02 just before it (C the 3rd letter, index 2)"""
  "      },"
  "      {"
  "        ""section"": ""00 25 02 c2: the letters at their indices"","
  "        ""text"": ""read in base 16 the 25 is 37, past Z: the letters read the digits in base 10"""
  "      },"
  "      {"
  "        ""section"": ""The c is the difference of the base"","
  "        ""text"": ""between 0 and 25 the difference is 25, not c"""
  "      },"
  "      {"
  "        ""section"": ""The c is the difference of the base"","
