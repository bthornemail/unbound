  "      {"
  "        ""section"": ""test: can fail, no side effect (P1)"","
  "        ""text"": ""the check fails on 0x0102 (density 2)"""
  "      },"
  "      {"
  "        ""section"": ""test: can fail, no side effect (P1)"","
  "        ""text"": ""and never changes the buffer"""
  "      },"
  "      {"
  "        ""section"": ""predicate: changes the buffer only on success (P2)"","
  "        ""text"": ""compareExchange fails when the cell is not the expected value"""
  "      },"
  "      {"
  "        ""section"": ""predicate: changes the buffer only on success (P2)"","
  "        ""text"": ""and then the buffer is byte-identical"""
  "      },"
  "      {"
  "        ""section"": ""predicate: changes the buffer only on success (P2)"","
  "        ""text"": ""it succeeds when the cell is the expected value"""
  "      },"
  "      {"
  "        ""section"": ""predicate: changes the buffer only on success (P2)"","
  "        ""text"": ""and then exactly that one cell changes"""
  "      },"
  "      {"
  "        ""section"": ""function: never fails, no side effect (P3)"","
  "        ""text"": ""load never fails"""
  "      },"
  "      {"
  "        ""section"": ""function: never fails, no side effect (P3)"","
  "        ""text"": ""and never changes the buffer"""
  "      },"
  "      {"
