  "      {"
  "        ""section"": ""The name in bytes, and its parts against each other"","
  "        ""text"": ""`assert.deepEqual(xor(\""BRIAN\"", \""JAMES\""), [0x08, 0x13, 0x04, 0x04, 0x1d]);`"""
  "      },"
  "      {"
  "        ""section"": ""The name in bytes, and its parts against each other"","
  "        ""text"": ""`assert.deepEqual(xor(\""JAMES\"", \""THORNE\""), [0x1e, 0x09, 0x02, 0x17, 0x1d, 0x65]);`"""
  "      },"
