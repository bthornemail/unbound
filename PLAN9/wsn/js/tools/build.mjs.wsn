FILE = HEAD .

HEAD =
  "// Build the I-series catalogue and its documents from the checks themselves."
  "//"
  "// Reads every check in js/catalog (its header line, its section headings and"
  "// its assertions) and the roll-up I-122.ts (each record's claim, its shape and"
  "// the corrections it lists), runs every check, and writes:"
  "//   js/catalog.json             every record, its owner, category, statement, whether it holds"
  "//   js-docs/JS-PROOF-INDEX.md   the registry, in the manner of coq-docs/PROOF-INDEX.md"
  "//   js-docs/<category>/I-*.md   one RFC-style document per record"
  "// The documents are derived, so they say only what the checks check. No dates"
  "// are written: rebuilding unchanged checks gives the same files."
  "// Run: node proofs/js/tools/build.mjs   (or: make js-docs)"
  "import { readFileSync, readdirSync, writeFileSync, mkdirSync, rmSync } from 'node:fs';"
  "import { spawnSync } from 'node:child_process';"
  "import { tag, classicScript, base64, base64url, runInVm, runInWorker } from './vm.mjs';"
  "const root = new URL('../../', import.meta.url);"
  "const catalogDir = new URL('js/catalog/', root);"
  "const docsDir = new URL('js-docs/', root);"
  "const CATEGORIES = { 'point/line/duality': 'point-line-duality', 'catch-at-0': 'catch-at-0', 'head/value/tail': 'head-value-tail' };"
  "const category = (shape) => CATEGORIES[shape] ?? 'other';"
  "const order = (a, b) => {"
  "  const [, na, sa = ''] = /^I-(\d+)([a-z]?)$/.exec(a);"
  "  const [, nb, sb = ''] = /^I-(\d+)([a-z]?)$/.exec(b);"
  "  return Number(na) - Number(nb) || sa.localeCompare(sb);"
  "};"
  "/** The assertions of a piece of source, in order, grouped under its ""// ── n. heading ──"" sections. */"
  "function statements(source) {"
  "  const lines = source.split('\n');"
  "  const out = [];"
  "  let section = null;"
  "  for (let i = 0; i < lines.length; i++) {"
  "    const head = /^\s*\/\/\s*──+\s*(?:\d+\.\s*)?(.+?)\s*─*\s*$/.exec(lines[i]);"
  "    if (head && !/^─+$/.test(head[1])) { section = head[1]; continue; }"
  "    if (!/^\s*assert[.(]/.test(lines[i])) continue;"
  "    let stmt = lines[i].trim();"
  "    while (!/\);\s*(\/\/.*)?$/.test(stmt) && i + 1 < lines.length) stmt += ' ' + lines[++i].trim();"
  "    stmt = stmt.replace(/\s*\/\/.*$/, '');"
  "    const msg = /,\s*([""'`])((?:\\.|(?!\1).)*)\1\s*\);$/.exec(stmt);"
  "    out.push({ section, text: msg ? msg[2] : '`' + stmt.replace(/\s+/g, ' ').slice(0, 140) + '`' });"
  "  }"
  "  return out;"
  "}"
  "// ---- the roll-up: its records, shapes, corrections and engine witnesses ----"
  "const rollupSource = readFileSync(new URL('I-122.ts', catalogDir), 'utf8');"
  "const rollup = new Map();"
  "const starts = [...rollupSource.matchAll(/^record\(""([^""]+)"",\s*""((?:\\.|[^""])*)"",/gm)];"
  "const runnerAt = rollupSource.indexOf('for (const r of records)');"
  "const rollupPreamble = rollupSource.slice(0, rollupSource.search(/^\/\/ ═+\n\/\/ I-108/m) >= 0 ? rollupSource.search(/^\/\/ ═+\n\/\/ I-108/m) : rollupSource.indexOf('record(""I-108""'));"
  "starts.forEach((m, k) => {"
  "  const block = rollupSource.slice(m.index, k + 1 < starts.length ? starts[k + 1].index : runnerAt);"
  "  const shape = /\},\s*""([^""]+)""\);\s*(?:\/\/[^\n]*)?\s*(?:\/\/ ═+[\s\S]*)?$/.exec(block.trimEnd().replace(/\n\/\/ ═[\s\S]*$/, ''))?.[1];"
  "  rollup.set(m[1], { claim: m[2], shape, statements: statements(block), block });"
  "});"
  "const notes = (heading) => {"
  "  const at = rollupSource.indexOf(heading);"
  "  if (at < 0) return new Map();"
  "  const text = rollupSource.slice(at, rollupSource.indexOf('`', at));"
  "  const map = new Map();"
  "  for (const line of text.split('\n')) {"
  "    const m = /^\s+(.+?)\s+\((I-\d+[a-z]?)\)\s*$/.exec(line) ?? /^\s+(I-\d+[a-z]?):\s*(.+)$/.exec(line);"
  "    if (!m) continue;"
  "    const [id, what] = m[1].startsWith('I-') ? [m[1], m[2]] : [m[2], m[1]];"
  "    map.set(id, [...(map.get(id) ?? []), what.trim()]);"
  "  }"
  "  return map;"
  "};"
  "const corrections = notes('Threshold corrections:');"
  "const witnesses = notes(""Strongest claims (the engine's own words):"");"
  "// ---- run everything ----"
  "const rollupRun = spawnSync(process.execPath, [new URL('I-122.ts', catalogDir).pathname], { encoding: 'utf8', timeout: 120000 });"
  "const rollupHolds = new Map();"
  "for (const line of rollupRun.stdout.split('\n')) {"
  "  const m = /^(I-\d+[a-z]?)\s.*(✔ pass|✗ FAIL)\s*$/.exec(line);"
  "  if (m) rollupHolds.set(m[1], m[2] === '✔ pass');"
  "}"
  "const files = readdirSync(catalogDir).filter((f) => /^I-\d+[a-z]?\.ts$/.test(f));"
  "let ORIGINS = {};"
  "try { ORIGINS = JSON.parse(readFileSync(new URL('ORIGINS.json', catalogDir), 'utf8')); } catch {}"
  "const records = new Map();"
  "for (const file of files) {"
  "  const id = file.replace(/\.ts$/, '');"
  "  const source = readFileSync(new URL(file, catalogDir), 'utf8');"
  "  const header = source.split('\n')[0];"
  "  const title = /—\s*(?:I-\d+[a-z]?(?:\s*\([^)]*\))?:\s*)?(.+)$/.exec(header)?.[1]?.trim() ?? id;"
  "  const run = spawnSync(process.execPath, [new URL(file, catalogDir).pathname], { encoding: 'utf8', timeout: 120000 });"
  "  records.set(id, { id, title, owners: [`js/catalog/${file}`], statements: statements(source), holds: run.status === 0 });"
  "}"
  "for (const [id, r] of rollup) {"
  "  const own = records.get(id);"
  "  if (own) { own.owners.push(`js/catalog/I-122.ts (roll-up record ${id})`); own.shape = r.shape; own.holds &&= rollupHolds.get(id) !== false; continue; }"
  "  records.set(id, { id, title: r.claim, owners: [`js/catalog/I-122.ts (roll-up record ${id})`], statements: r.statements, shape: r.shape, holds: rollupHolds.get(id) === true });"
  "}"
  "const rollupRecord = records.get('I-122');"
  "rollupRecord.title = `the roll-up: runs ${rollup.size} records (${[...rollup.keys()].sort(order)[0]} … ${[...rollup.keys()].sort(order).at(-1)}) and reports their shared shapes`;"
  "rollupRecord.statements = [{ section: null, text: `every record in it passes (${[...rollupHolds.values()].filter(Boolean).length} of ${rollupHolds.size})` }];"
  "rollupRecord.holds = rollupRun.status === 0;"
  "const all = [...records.values()].sort((a, b) => order(a.id, b.id));"
  "const NOTES = {"
  "  'I-120': ['Its three stream checks (stdin, stdout, stderr are fds 0, 1, 2) run asynchronously. In the roll-up they finish after the record is already marked passed, so there they do not gate it; only the 3! ordering count does. The vm carrier waits for them, so there they count.', 'Those stream checks hold on a main thread; in a Worker the streams are not fds 0, 1, 2, so its Worker carrier fails on them.'],"
  "  'I-122': ['In a Worker it fails through I-120: there stdin is not fd 0, because a Worker\'s standard streams are piped through the main thread.'],"
  "  'I-177': ['What it checks: the three indices 59, 63, 127 and their spans; one atomic compare-exchange step at each index on a shared buffer; the step-1 and limit cases of the derivative; the forward and reverse chains.', 'What it states but does not check: that I-167, I-170 and I-171 drive those steps as the automaton\'s transition function (nothing connects them to the steps), and that the rate is the derivative (its rate function only checks that sin(59) is finite).', 'Section 3 corrected on 2026-10-12: it asserted 60 ⊕ 68 = 128; 60 ⊕ 68 is 120, and the pole relation is 60 ⊕ 128 = 188.'],"
  "  'I-178': ['What it checks: 64 fixed frames (FS, GS, RS, US at places away from 59, 63, 127) against all 256 routed bytes, each XORed in by Atomics.compareExchange at 59, 63, 127; read by place, every frame holds and every unit carries what was routed; read by value, exactly 0x1C-0x1F break each frame; a step at a held position breaks it; the agents\' order does not change the units; the same agent walked back restores the document; a stale exchange does not land.', 'What it does not check: where the routed bytes come from (the proxy, the reflected literals of the proof tree); all 256 are tried in their place. The frames are drawn by a fixed generator, not derived from the vault.', 'The positional reading is derived from the author\'s ""static indices"" and ""positions to hold""; the author chose between it and escaping or breaking only by those words.'],"
  "  'I-182': ['What it checks: the 7! relabellings of the Fano plane (168 symmetries x 30 planes); the slot f*720 + t*180 + p covering 5040 once; the row 5040/7m (a multiple of 60 iff m divides 12); the primes above 7; the orbits of Δ (one fixed point, one orbit of 65535) and what a phase on them can carry; how often Δ keeps Q mod 240; where Cayley-Dickson stops multiplying lengths, and a sedenion zero divisor.', 'Two claims of the notes fail, each by index, not value: 120 is 5040/42, written at 28 (5040/28 = 180); and 240 = 15 x 16, of which Δ\'s orbit of 2^16 - 1 carries the 15 only, so Q mod 240 cannot be its phase (Q is also not invariant under Δ, as the bqfObserver says).', 'What it does not check: the 240-LED clock, the 60 Klein points and the light messages.'],"
  "  'I-183': ['What it checks: the sexy chains below 1.1 million (the exceptional five from 5 is the only chain of five); the next set of three or more, (7, 13, 19), and that 19 + 6 = 25 = 5²; the prime sextuplets below 1.1 million (the first {7, …, 23} holds 19; every later one starts at 97 mod 210).', 'What it does not check: how 19 pairs with 63 in ""1963""; the author has not said.'],"
  "  'I-184': ['What it checks: for every index to 16 bits, the index and its written view (x ^ (2^n - 1)) differ by the closure 2^n - 1 by XOR, addition and subtraction alike, and (to 10 bits, every pair) no other pair is that far apart; the four tag pairs; 19, 44 and 63 in six bits; and, to 10 bits, that subtraction (the read) and XOR (the write) agree for every index only at the closure.', 'The reading of the closure as 2^n - 1 is from I-182 and I-183; 19 as a closure of the other kind (I-183, 5²) is not what this checks.'],"
  "  'I-185': ['What it checks: every Schläfli symbol with entries 3 to 12, in 3 to 9 dimensions, by whether its mirror Gram matrix is positive definite: 5 in 3D, 6 in 4D, and from 5D on exactly {3,…,3}, {4,3,…,3} and {3,…,3,4}; each regular symbol\'s reverse is regular (its dual); the cube\'s corners as the n-bit indices, each index opposite its written view.', 'What it does not check: why the three go on (the theorem behind positive definiteness), or the language layers mod 3 and mod 4.'],"
  "  'I-186': ['What it checks: over all 1,112,064 Unicode scalar values, UTF-8 writes each code point below 0x80 as its own byte and every other code point with bytes of 0x80 and above; 19 and 63 encode and decode as themselves.', 'What it does not check: the history of the ASCII table (its 1963 edition left lowercase unassigned; the 1967 revision is the table later specs reference), or specs that do not use UTF-8.'],"
  "  'I-187': ['What it checks: in the Cayley-Dickson doubling, the product of two units is ± the unit at the XOR of their indices (every pair in dimensions 8, 16, 32; in 64, every unit with every fifth partner); the triples a ^ b ^ c = 0 number (2^n - 1)(2^n - 2)/6: 7, 35, 155, 651; Wikipedia\'s 155 trigintaduonion triples, as listed, are exactly the lines of PG(4, 2), and each closes under the product.', 'What it does not check: the signs (which units multiply to +e_c and which to -e_c), the five types Wikipedia sorts the triples into, or the tripod-packing problem.'],"
  "  'I-188': ['What it checks: 19.4.4 read as frame 4, sub-frame 4, index 19; its base-36 form 44J; 44J = 5347, prime, with decimal digits 5, 3, 4, 7 summing to 19; the product 420 = 4 x 0x69; the compare-exchange at 19 of 64 bytes, 128 for 63, landing once; 44 as the tag of I-148.', 'What it does not check: what RFC 2616 section 19.4.4 says (the author pasted it as the Introduction of Content-Encoding; RFC 2616 was replaced by RFC 7230 to 7235 in 2014 and RFC 9110 in 2022).'],"
  "  'I-189': ['What it checks: 1729 and 91 are the first numbers with two cube sums (positive; with negatives or zero); 1729 = 7 x 13 x 19 and 91 = 7 x 13; the sum-of-cubes factoring of each cube sum gives a + b = 13, 19 and 7; each product of two of the triplet as midpoint squared minus half-gap squared (3, 3, 6), and 1729 = 55^2 - 36^2 with 36 = 6^2.', 'The link to the sexy set is found, not stated by the author: the author pasted the pages without comment, after I-183.'],"
  "  'I-191': ['What it checks: every draw of three from 1-14 (364), 1-30 (4,060) and 1-62 (37,820) meets one of the tickets (the lines of two copies of PG(k-1, 2): 14, 70, 310) in two numbers, and those two rebuild the ticket\'s third by XOR; any two numbers of one plane share exactly one ticket, of two planes none.', 'What it does not check: that 14 tickets is the fewest that guarantee a match of two (MathWorld gives the construction, not the bound here), or the author\'s 16^4 and 16^10.'],"
  "  'I-193': ['What it checks: the seven Fano lines of the 16-index, their complements, 0 and 0x7F are 16 words closed under XOR at minimum distance 3 (the Hamming (7,4) code); every one of the 128 ASCII codes is within one bit of exactly one of them (16 balls of 8); which characters they are; that none falls in the separator gap 0x3A-0x40 (a claim from the conversation, which fails).', 'What it does not check: the zipper itself (I-107) or the compare-and-exchange (I-177, I-178), which the author names alongside.'],"
  "  'I-194': ['What it checks: each of G2, F4, E6, E7, E8 read as a base-36 tag is family x 36 + rank; its root system built from its simple roots by reflection has the known number of roots; its Coxeter element returns every root after the Coxeter number of steps; roots = rank x Coxeter number and dimension = roots + rank; E6, E7, E8 are 2^9 - 2, 2^9 - 1, 2^9.', 'The archived Racket modules (~/devops/Vault/Archive/epistemic-observability-engine/substrate-geometry) were tried first: e8.rkt agrees; g2.rkt does not compile (an unbound coords), and f4.rkt and e6.rkt cannot load (f4.rkt and weyl.rkt require each other). The archive is unchanged.'],"
  "  'I-195': ['What it checks: polytron\'s K(p, 0x1D) from 0x4242 gives the eight states tetra-gnomon-anim prints, each SID the next state and the eighth the seed; all 65,536 states have period 8 under 0x1D; under the atomic kernel\'s 0x1D1D, 8 are fixed, 56 have period 2, 4,032 period 4 and 61,440 period 8.', 'The source is omi-files/polytron/tetra-gnomon-anim.c, unchanged; the Agent Commons draws the same eight steps as the dial at its Polytron station (space/src/gnomon.ts).'],"
  "  'I-196': ['What it checks: the braille decades (Wikipedia\'s cells for a-j, k-t, u-ù, â-w) add fixed patterns 0x00, 0x04, 0x24, 0x20 in the Unicode braille block; dot 6 is 0x20, ASCII\'s case bit; a byte\'s top three bits are one octal digit, 8 columns of 32; EBCDIC (code page 037, from iconv) has letters in zones C, D, E.', 'The EBCDIC codes were read from iconv -t IBM037 and are written into the record as literals.'],"
  "  'I-197': ['What it checks: K(p, C) equals (x + x^3 + x^14) p + C over GF(2)[x]/(x^16 + 1) for all 65,536 words with C = 0x1D and 0x1D1D; A^8 = 1 and no smaller power; 1 + A + ... + A^7 = 0, so eight steps return every word for every C.', 'Period exactly 8 for every word holds for 0x1D (I-195), not for every C: under 0x1D1D some words return sooner.'],"
  "  'I-198': ['What it checks: the triples of points 1-7 whose XOR is 0 are seven, and form the Steiner triple system S(2,3,7) (any two points on exactly one, the third their XOR; each point on three); the seven Fano line masks of the 16-index, point n at bit n-1, are exactly those triples.', 'The null as the space 0x20 and the frame omi-ip6-ip8-imo are the author\'s words, recorded and not checked here: in this record the null of a triple is 0, the XOR of its three points.'],"
  "  'I-199': ['What it checks: the 144 synsets written in the record form one tree rooted at entity, each once; color\'s route to entity is color, visual property, property, attribute, abstraction, entity; 138 synsets lie below color, so 138 + 1 + 5 = 144; red\'s route is eight synsets; the twelve characters of a, b, c have the space at index 6 and d at index 11; 144 = 12 x 12 and 360 = 12 x 30.', 'The synsets are literals read once from WordNet 3.0\'s Prolog files (~/Downloads/WNprolog-3.0), which are outside the repository; the record does not read them.'],"
  "  'I-200': ['What it checks: 0o777 = 511 = 2^9 - 1, three 0b111, E7 in base 36; 0o777 + 1 = 0o1000 = 512 = E8; E6 = 0o776; the E8 Gram matrix from the proofs\' simple roots is integral, 2 on the diagonal, determinant 1; 0^2 + ... + 24^2 = 70^2, and n = 1 and 24 are the only n up to 100000 with a square sum of squares.', 'The Leech lattice itself (196560 minimal vectors) and II(25,1) are not built here: only the facts that place them are checked.'],"
  "  'I-136': ['In a Worker it fails on ""stdin = fd 0 (catch)"": a Worker\'s standard streams are not file descriptors 0, 1, 2. The claim holds on a main thread.'],"
  "};"
  "for (const r of records.values()) r.notes = NOTES[r.id] ?? [];"
  "for (const r of all) {"
  "  r.category = category(r.shape);"
  "  r.corrections = corrections.get(r.id) ?? [];"
  "  r.witnesses = witnesses.get(r.id) ?? [];"
  "}"
  "// ---- tags, the classic script, its two base64 dialects, and where it holds ----"
  "const vmDir = new URL('js/vm/', root);"
  "rmSync(vmDir, { recursive: true, force: true });"
  "mkdirSync(vmDir, { recursive: true });"
  "for (const r of all) {"
  "  r.tag = tag(r.id);"
  "  // a record with its own module carries that module; a record found only in the"
  "  // roll-up carries the roll-up's preamble, its own block and one call to run it"
  "  const own = !r.owners[0].startsWith('js/catalog/I-122.ts ');"
  "  const source = own"
  "    ? readFileSync(new URL(r.owners[0].replace(/ \(.*$/, '').replace('js/catalog/', ''), catalogDir), 'utf8')"
  "    : `${rollupPreamble}${rollup.get(r.id).block}\nfor (const rec of records) rec.run();\n`;"
  "  const script = classicScript(source);"
  "  const b64 = base64(script), b64url = base64url(script);"
  "  writeFileSync(new URL(`${r.tag}.b64`, vmDir), b64 + '\n');"
  "  writeFileSync(new URL(`${r.tag}.b64url`, vmDir), b64url + '\n');"
  "  const vmError = await runInVm(b64, 'base64');"
  "  const workerError = await runInWorker(b64url, 'base64url');"
  "  r.carriers = {"
  "    script: { bytes: Buffer.byteLength(script) },"
  "    base64: `js/vm/${r.tag}.b64`,"
  "    base64url: `js/vm/${r.tag}.b64url`,"
  "    vm: vmError === null ? 'holds' : `fails: ${vmError}`,"
  "    worker: workerError === null ? 'holds' : `fails: ${workerError}`,"
  "  };"
  "}"
  "// ---- the catalogue ----"
  "writeFileSync(new URL('js/catalog.json', root), JSON.stringify(all.map(({ id, tag, title, category, owners, holds, carriers, statements, corrections, witnesses }) =>"
  "  ({ id, tag, title, category, status: 'P1', holds, owners, carriers, statements, corrections, witnesses })), null, 2) + '\n');"
  "// ---- the documents ----"
  "rmSync(docsDir, { recursive: true, force: true });"
  "for (const c of new Set(all.map((r) => r.category))) mkdirSync(new URL(`${c}/`, docsDir), { recursive: true });"
  "const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);"
  "for (const r of all) {"
  "  const siblings = all.filter((x) => x.category === r.category && x.id !== r.id).map((x) => `[${x.id}](${x.id}.md)`);"
  "  const lines = ["
  "    `# ${r.id}: ${cap(r.title)}`,"
  "    '',"
  "    '| | |',"
  "    '|-|-|',"
  "    `| Record | ${r.id} |`,"
  "    `| Tag | \`${r.tag}\` (the record number in base 36, /A-Z0-9/) |`,"
  "    `| Category | ${r.category} |`,"
  "    `| Status | P1, for consideration: a finite, computable check (PROOF_CANONIZATION.md); not in the Coq registry |`,"
  "    `| Holds | ${r.holds ? 'yes, when this document was built' : '**no**, when this document was built'} |`,"
  "    `| Checked by | ${r.owners.map((o) => `\`${o}\``).join(', ')} |`,"
  "    `| Origin | ${ORIGINS[r.id] ?? ""boxedPINE, the I-series session of 2026-10-12, from the author's statements""} |`,"
  "    '',"
  "    '## Abstract',"
  "    '',"
  "    `${cap(r.title)}.`,"
  "    '',"
  "    '## Statement',"
  "    '',"
  "    'The check holds when each of the following holds, in this order (taken from its assertions):',"
  "    '',"
  "  ];"
  "  let section;"
  "  let n = 0;"
  "  for (const s of r.statements) {"
  "    if (s.section && s.section !== section) { section = s.section; lines.push('', `**${cap(section)}**`, ''); }"
  "    lines.push(`${++n}. ${s.text}`);"
  "  }"
  "  lines.push('', '## Carriers', '',"
  "    'The check as one classic script (types stripped; the host supplies `assert`, and `os` or `process` where used), in two base64 dialects that decode to the same bytes:', '',"
  "    '| | |', '|-|-|',"
  "    `| Script | ${r.carriers.script.bytes} bytes |`,"
  "    `| base64 | \`${r.carriers.base64}\` |`,"
  "    `| base64url | \`${r.carriers.base64url}\` |`,"
  "    `| As a vm.Script | ${r.carriers.vm} |`,"
  "    `| In a Worker | ${r.carriers.worker} |`);"
  "  if (r.notes?.length) lines.push('', '## Notes', '', ...r.notes.map((n) => `- ${n}`));"
  "  if (r.witnesses.length) lines.push('', '## What the engine itself reports', '', ...r.witnesses.map((w) => `- ${w}`));"
  "  if (r.corrections.length) lines.push('', '## Corrections', '', 'Recorded by the roll-up as corrected during the session:', '', ...r.corrections.map((c) => `- ${c}`));"
  "  lines.push('', '## Relations', '', siblings.length ? `Same category: ${siblings.join(', ')}.` : 'No other record in this category.', '');"
  "  lines.push('## Run', '', '```', ...r.owners.map((o) => `node proofs/${o.replace(/ \(.*$/, '')}`), '```', '');"
  "  writeFileSync(new URL(`${r.category}/${r.id}.md`, docsDir), lines.join('\n'));"
  "}"
  "const index = ["
  "  '# OMI JavaScript Proof Index',"
  "  '',"
  "  'The I-series checks in `js/catalog/` are the authority here; each document in this',"
  "  'folder is built from its check by `js/tools/build.mjs` and says only what the check checks.',"
  "  'Every record is **P1, for consideration** (PROOF_CANONIZATION.md): a finite, computable',"
  "  'check, a target for a P0 Coq proof, and not part of the locked `coq/` registry.',"
  "  '',"
  "  'The categories are the shapes the roll-up (I-122) assigns. The constant relations',"
  "  'among them are indexed by subject, predicate and object in `js/spo/`.',"
  "  '',"
  "  '## Registry',"
  "  '',"
  "  '| Category | Record | Tag | Statement | Checked by | Holds | vm | Worker |',"
  "  '| --- | --- | --- | --- | --- | --- | --- | --- |',"
  "  ...all.map((r) => `| ${r.category} | [${r.id}](${r.category}/${r.id}.md) | \`${r.tag}\` | ${cap(r.title).replace(/\|/g, '\\|')} | \`${r.owners[0].replace(/ \(.*$/, '')}\` | ${r.holds ? 'yes' : '**no**'} | ${r.carriers.vm === 'holds' ? 'yes' : 'no'} | ${r.carriers.worker === 'holds' ? 'yes' : 'no'} |`),"
  "  '',"
  "  '## Counts',"
  "  '',"
  "  ...Object.entries(all.reduce((m, r) => ({ ...m, [r.category]: (m[r.category] ?? 0) + 1 }), {})).map(([c, n]) => `- ${c}: ${n}`),"
  "  `- total: ${all.length} records, ${all.filter((r) => r.holds).length} holding`,"
  "  '',"
  "];"
  "writeFileSync(new URL('JS-PROOF-INDEX.md', docsDir), index.join('\n'));"
  "console.log(`${all.length} records (${all.filter((r) => r.holds).length} holding) -> js/catalog.json, js-docs/JS-PROOF-INDEX.md and ${all.length} documents in ${new Set(all.map((r) => r.category)).size} categories`);"
  "process.exit(all.every((r) => r.holds) ? 0 : 1);"
  .
