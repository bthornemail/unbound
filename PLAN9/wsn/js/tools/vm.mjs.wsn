FILE = HEAD .

HEAD =
  "// Each I-series check as one classic script, for node:vm and for Workers, and"
  "// its two base64 dialects. The author: ""give each one a base36 /A-Z0-9/ tag"
  "// and the function as a vm script, worker compatible, base64 and URL-encoded"
  "// base64 dialectic""."
  "import vm from 'node:vm';"
  "import { Worker } from 'node:worker_threads';"
  "import { stripTypeScriptTypes } from 'node:module';"
  "process.removeAllListeners('warning'); // stripTypeScriptTypes is marked experimental; the build checks its output itself"
  "import assert from 'node:assert';"
  "import os from 'node:os';"
  "/** The record's tag: its number in base 36 and its letter, uppercase (I-141 -> 3X, I-127b -> 3JB). */"
  "export const tag = (id) => {"
  "  const [, n, letter = ''] = /^I-(\d+)([a-z]?)$/.exec(id);"
  "  return (Number(n).toString(36) + letter).toUpperCase();"
  "};"
  "/** And back: 3X -> I-141, 3JB -> I-127b (the series' numbers are two base-36 digits). */"
  "export const untag = (t) => `I-${parseInt(t.slice(0, 2), 36)}${t.slice(2).toLowerCase()}`;"
  "/**"
  " * A check as one classic script: types stripped, imports replaced by names the"
  " * host supplies (assert; os; process for stdin, stdout, stderr)."
  " */"
  "export function classicScript(source) {"
  "  const js = stripTypeScriptTypes(source, { mode: 'strip' });"
  "  return js"
  "    .replace(/^import assert from [""']node:assert[""'];?\s*$/m, '// assert: supplied by the host')"
  "    .replace(/^import \* as os from [""']node:os[""'];?\s*$/m, '// os: supplied by the host')"
  "    .replace(/^import \{([^}]+)\} from [""']node:process[""'];?\s*$/m, (_, names) => `const {${names}} = process; // process: supplied by the host`)"
  "    .replace(/^import \{([^}]+)\} from [""'](node:[a-z_/]+)[""'];?\s*$/gm, (_, names, mod) => `const {${names}} = process.getBuiltinModule('${mod}');`)"
  "    .replace(/\bimport\([""']node:process[""']\)/g, 'Promise.resolve(process)');"
  "}"
  "export const base64 = (text) => Buffer.from(text, 'utf8').toString('base64');"
  "export const base64url = (text) => Buffer.from(text, 'utf8').toString('base64url');"
  "/**"
  " * Decode one dialect and run it as a vm.Script: null if it holds, else the error."
  " * It runs in this realm (a fresh vm context is another realm, and checks that"
  " * compare cloned objects would see the host's prototypes), inside its own block"
  " * so the checks' top-level names stay apart. The host supplies assert and os"
  " * (left in place, since some checks assert later, in promise callbacks), and"
  " * failures that arrive after the script returns are caught and count too."
  " */"
  "Object.assign(globalThis, { assert, os });"
  "export async function runInVm(encoded, dialect) {"
  "  const script = Buffer.from(encoded, dialect).toString('utf8');"
  "  const late = [];"
  "  const onLate = (e) => late.push(String(e?.message ?? e).split('\n')[0]);"
  "  const saved = { exit: process.exit, log: console.log, info: console.info, table: console.table };"
  "  process.exit = (code) => { if (code) throw new Error(`exit ${code}`); };"
  "  console.log = console.info = console.table = () => {};"
  "  process.on('unhandledRejection', onLate);"
  "  try {"
  "    new vm.Script(`{\n${script}\n}`, { filename: 'check.js' }).runInThisContext({ timeout: 60000 });"
  "    for (let i = 0; i < 5; i++) await new Promise((r) => setImmediate(r)); // let promise callbacks run"
  "    return late[0] ?? null;"
  "  } catch (e) {"
  "    return String(e?.message ?? e).split('\n')[0];"
  "  } finally {"
  "    process.off('unhandledRejection', onLate);"
  "    process.exit = saved.exit; console.log = saved.log; console.info = saved.info; console.table = saved.table;"
  "  }"
  "}"
  "/** Decode one dialect and run it in a worker_threads Worker: null if it holds, else the error. */"
  "export function runInWorker(encoded, dialect) {"
  "  const script = Buffer.from(encoded, dialect).toString('utf8');"
  "  const prelude = ""globalThis.assert = process.getBuiltinModule('node:assert'); globalThis.os = process.getBuiltinModule('node:os');\nconsole.log = console.info = console.table = () => {};\n"";"
  "  return new Promise((resolve) => {"
  "    const w = new Worker(prelude + script, { eval: true, stdout: true, stderr: true });"
  "    let error = null;"
  "    w.on('error', (e) => { error = String(e?.message ?? e).split('\n')[0]; });"
  "    w.on('exit', (code) => resolve(error ?? (code ? `exit ${code}` : null)));"
  "  });"
  "}"
  .
