RECORD = HEAD THEFANOPLANERELABELLEDEVERYWAY THEATLASSLOTFTPCOVERSONCE THEROWMSITSATNOT ANDEVERYPRIMEABOVE QMODISNOTTHEPHASETHENEEDSASECONDINDEX WHERETHEALGEBRASTOPS THEAUTHORSFORM .

HEAD =
  "// i182.ts — I-182: the atlas, 7! = 5040, and where its rules break: the values are right, two indices are not"
  "//"
  "// The author's notes (_archive/_deprecated/4320/BQF.md, _4320.finding.md,"
  "// Pure.Typescript.Functions.md): ""7! = 5040 ;; incidences of factors"", the"
  "// rows 5040/7 … 5040/37, the atlas slot f*720 + t*180 + p, the form"
  "// Q(x,c) = 60x² + 16xc + 4c², the step Δ(x,c) = (A(x) ⊕ c, c) with A the LFSR"
  "// x^16 + x^5 + x^3 + x^2 + 1, and ""Tell me when it breaks"". Asked, 2026-10-13,"
  "// why two claims failed: ""it's not the wrong value but the wrong position, or"
  "// for us, index"". Both are: the value is right and sits at another index."
  "import assert from ""node:assert"";"
  "const fact = (n: number): number => (n <= 1 ? 1 : n * fact(n - 1));"
  "const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : a);"
  .

THEFANOPLANERELABELLEDEVERYWAY =
  "// ── 1. 7! = 5040: the Fano plane, relabelled every way ──────"
  "// Points 1..7 are the non-zero vectors of GF(2)^3; a line is {a, b, a ^ b}."
  "const lineSet = new Set<string>();"
  "for (let a = 1; a < 8; a++) for (let b = a + 1; b < 8; b++) lineSet.add([a, b, a ^ b].sort().join());"
  "const lines = [...lineSet].map((s) => s.split("","").map(Number));"
  "assert.strictEqual(lines.length, 7, ""7 lines"");"
  "for (let p = 1; p < 8; p++) assert.strictEqual(lines.filter((l) => l.includes(p)).length, 3, `3 lines through ${p}`);"
  "function* perms(a: number[]): Generator<number[]> {"
  "  if (a.length <= 1) { yield a; return; }"
  "  for (let i = 0; i < a.length; i++) for (const p of perms([...a.slice(0, i), ...a.slice(i + 1)])) yield [a[i]!, ...p];"
  "}"
  "const key = (ls: number[][]) => ls.map((l) => [...l].sort().join()).sort().join(""|"");"
  "const base = key(lines);"
  "let relabellings = 0, symmetries = 0;"
  "const planes = new Set<string>();"
  "for (const p of perms([1, 2, 3, 4, 5, 6, 7])) {"
  "  relabellings++;"
  "  const k = key(lines.map((l) => l.map((x) => p[x - 1]!)));"
  "  planes.add(k);"
  "  if (k === base) symmetries++;"
  "}"
  "assert.strictEqual(relabellings, fact(7), ""7! = 5040 relabellings"");"
  "assert.strictEqual(symmetries, 168, ""168 of them give the same plane back"");"
  "assert.strictEqual(planes.size, 30, ""the rest give 30 distinct Fano planes"");"
  "assert.strictEqual(symmetries * planes.size, 5040, ""5040 = 168 x 30: every plane with its symmetries"");"
  "assert.strictEqual(fact(7) / 7, fact(6), ""720 = 7!/7 = 6!, the orderings that keep one point (GF(2)^3 has 7 non-zero vectors, not 6)"");"
  .

THEATLASSLOTFTPCOVERSONCE =
  "// ── 2. The atlas slot: f*720 + t*180 + p covers 5040 once ───"
  "const slots = new Set<number>();"
  "for (let f = 0; f < 7; f++) for (let t = 0; t < 4; t++) for (let p = 0; p < 180; p++) slots.add(f * 720 + t * 180 + p);"
  "assert.strictEqual(slots.size, 5040, ""7 x 4 x 180 tuples, 5040 slots, each once"");"
  "assert.strictEqual(Math.max(...slots), 5039, ""the last slot is 5039"");"
  "assert.strictEqual(6 * 720, 4320, ""4320 starts the fano = 6 block"");"
  "const old = new Set<number>();"
  "for (let f = 0; f < 7; f++) for (let t = 0; t < 4; t++) for (let p = 0; p < 240; p++) old.add(f * 720 + t * 240 + p);"
  "assert.ok(old.size < 7 * 4 * 240, ""the first form, t*240 with four t's, overlaps itself"");"
  .

THEROWMSITSATNOT =
  "// ── 3. The row 5040/7m: 120 sits at 42, not 28 ──────────────"
  "// 5040/7m = 60 x 12/m: a multiple of 60 exactly when m divides 12."
  "const row = Array.from({ length: 12 }, (_, i) => 5040 / (7 * (i + 1)));"
  "for (let m = 1; m <= 12; m++) assert.strictEqual(row[m - 1]! % 60 === 0, 12 % m === 0, `5040/${7 * m}: a multiple of 60 iff ${m} divides 12`);"
  "assert.strictEqual(5040 / 28, 180, ""5040/28 = 180 = 12*5*3 (the note has 120 = 12*5*2)"");"
  "assert.strictEqual(5040 / 42, 120, ""120 is the value at 42: the note's row 12, 6, 4, 2 is 12/m for m = 1, 2, 3, 6"");"
  "assert.strictEqual(5040 / 35, 144, ""35 (m = 5) is the gap: 144 = 12 x 12, no factor 5 left"");"
  "assert.strictEqual(5040 / 84, 60, ""and the row runs on past it, to 60 at 84"");"
  .

ANDEVERYPRIMEABOVE =
  "// ── 4. 37 and every prime above 7 ───────────────────────────"
  "assert.strictEqual(5040 % 37, 8, ""5040 mod 37 = 8"");"
  "assert.strictEqual(8 * 27, 216, ""8/37 = 216/999, so 5040/37 = 136.216216…"");"
  "for (const p of [11, 13, 17, 19, 23, 29, 31, 37]) assert.notStrictEqual(5040 % p, 0, `no prime above 7 divides 7!: ${p}`);"
  .

QMODISNOTTHEPHASETHENEEDSASECONDINDEX =
  "// ── 5. Q mod 240 is not the phase: the 240 needs a second index ─"
  "const A = (x: number) => ((x << 1) & 0xffff) ^ (x & 0x8000 ? 0x002d : 0);"
  "// For each c, Δ has one fixed point and one orbit through all 65535 other states."
  "for (const c of [0, 0x1d, 0x3c]) {"
  "  const seen = new Uint8Array(65536);"
  "  const lengths: number[] = [];"
  "  for (let s = 0; s < 65536; s++) {"
  "    if (seen[s]) continue;"
  "    let x = s, n = 0;"
  "    do { seen[x] = 1; x = A(x) ^ c; n++; } while (x !== s);"
  "    lengths.push(n);"
  "  }"
  "  assert.deepStrictEqual(lengths.sort((a, b) => a - b), [1, 65535], `c = ${c}: one fixed point, one orbit of 65535`);"
  "}"
  "// A phase that moves one each step comes back with the state, so its period divides 65535."
  "assert.strictEqual(65535 % 240, 15, ""a 240-phase is off by 15 after each full orbit"");"
  "assert.strictEqual(gcd(65535, 240), 15, ""Δ carries the 15 of 240 = 15 x 16"");"
  "assert.strictEqual(240 / 15, 16, ""and not the 16: 2^16 - 1 is odd"");"
  "const Q = (x: number, c: number) => 60 * x * x + 16 * x * c + 4 * c * c;"
  "// Over all 65536 x, for five c: never all kept, at most half."
  "const keptBy: Record<number, number> = {};"
  "for (const c of [0, 1, 0x1d, 0x3c, 0xff]) {"
  "  let k = 0;"
  "  for (let x = 0; x < 65536; x++) if ((Q(A(x) ^ c, c) - Q(x, c)) % 240 === 0) k++;"
  "  keptBy[c] = k;"
  "}"
  "assert.deepStrictEqual(keptBy, { 0: 32768, 1: 2185, 0x1d: 2186, 0x3c: 32768, 0xff: 32768 },"
  "  ""Δ keeps Q mod 240 in half the states for c = 0, 0x3c, 0xff and in 1 of 30 for c = 1, 0x1d: Q is not invariant (the bqfObserver says it is)"");"
  "const reached = new Set<number>();"
  "for (let x = 0; x < 240; x++) for (let c = 0; c < 240; c++) reached.add(Q(x, c) % 240);"
  "assert.ok([...reached].every((v) => v % 4 === 0), ""Q = 4 x (15x² + 4xc + c²): Q mod 240 lands only on multiples of 4"");"
  "assert.strictEqual(reached.size, 45, ""45 of the 60 multiples of 4: a 60-place index scaled by 4, not a 240-place one"");"
  .

WHERETHEALGEBRASTOPS =
  "// ── 6. Where the algebra stops: 16 ──────────────────────────"
  "const conj = (a: number[]): number[] => (a.length === 1 ? [...a] : [...conj(a.slice(0, a.length / 2)), ...a.slice(a.length / 2).map((v) => -v)]);"
  "const add = (a: number[], b: number[]) => a.map((v, i) => v + b[i]!);"
  "function mul(a: number[], b: number[]): number[] {"
  "  if (a.length === 1) return [a[0]! * b[0]!];"
  "  const h = a.length / 2, a1 = a.slice(0, h), a2 = a.slice(h), b1 = b.slice(0, h), b2 = b.slice(h);"
  "  return [...add(mul(a1, b1), mul(conj(b2), a2).map((v) => -v)), ...add(mul(b2, a1), mul(a2, conj(b1)))];"
  "}"
  "const unit = (n: number, i: number, s = 1) => Array.from({ length: n }, (_, k) => (k === i ? s : 0));"
  "const norm = (a: number[]) => Math.hypot(...a);"
  "let seed = 7;"
  "const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff) - 0.5;"
  "const multiplies = (n: number) => {"
  "  for (let t = 0; t < 100; t++) {"
  "    const a = Array.from({ length: n }, rnd), b = Array.from({ length: n }, rnd);"
  "    if (Math.abs(norm(mul(a, b)) - norm(a) * norm(b)) > 1e-9) return false;"
  "  }"
  "  return true;"
  "};"
  "for (const n of [2, 4, 8]) assert.ok(multiplies(n), `dimension ${n}: |ab| = |a||b|`);"
  "assert.ok(!multiplies(16), ""dimension 16: |ab| = |a||b| fails"");"
  "const zd = mul(add(unit(16, 1), unit(16, 10)), add(unit(16, 4), unit(16, 15, -1)));"
  "assert.ok(zd.every((v) => v === 0), ""(e1 + e10)(e4 - e15) = 0: the sedenions have zero divisors"");"
  "assert.ok(!mul(unit(4, 1), unit(4, 2)).every((v, i) => v === mul(unit(4, 2), unit(4, 1))[i]), ""the quaternions do not commute"");"
  .

THEAUTHORSFORM =
  "// ── 7. The author's form ────────────────────────────────────"
  "for (let v = -5; v <= 5; v++) assert.strictEqual((4 * v - 4) * (2 * v - 2) * (v - 1), 8 * (v - 1) ** 3, ""(4x-4)(2x-2)(x-1) = 8(x-1)^3"");"
  "console.log(""I-182: the atlas, 7! = 5040, and where its rules break — passed"");"
  "console.log(""  5040 = 168 symmetries x 30 Fano planes; the slot f*720 + t*180 + p covers it once"");"
  "console.log(""  120 is 5040/42, not 5040/28 (180); 35 is the gap, and the row runs on to 60 at 84"");"
  "console.log(""  Δ's orbit is 65535 long: it carries the 15 of 240 = 15 x 16, not the 16; Q mod 240 is kept in at most half the states"");"
  "console.log(""  the algebra stops at 16: |ab| = |a||b| fails, and (e1 + e10)(e4 - e15) = 0"");"
  .
