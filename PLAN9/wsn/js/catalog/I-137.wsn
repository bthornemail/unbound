RECORD = HEAD THEPRIORITYLADDER TESTTHELADDER THEREDUCTIONLADDERAXES PHASENAMEMATCH THECATCHALLMAINSERVERDEFAULT CIDRASTHEMODREDUCTION THETHREEPROTOCOLLEVELS THEMAPPINGTOTHEVAULT .

HEAD =
  "// i137.ts — I-137: mod_rewrite as two-phase reduction"
  "import assert from ""node:assert"";"
  .

THEPRIORITYLADDER =
  "// ── 1. The priority ladder ───────────────────────────────────────"
  "type Vhost = {"
  "  ip: string | ""*"";"
  "  port: number | ""*"";"
  "  serverName: string;"
  "  priority: number;"
  "};"
  "function phase1Match(vhosts: Vhost[], ip: string, port: number): Vhost[] {"
  "  // return the highest-priority tier that matches"
  "  const tiers = ["
  "    (v: Vhost) => v.ip === ip && v.port === port,       // 1: exact/exact"
  "    (v: Vhost) => v.ip === ip && v.port === ""*"",        // 2: exact/wild"
  "    (v: Vhost) => v.ip === ""*"" && v.port === port,      // 3: wild/port"
  "    (v: Vhost) => v.ip === ""*"" && v.port === ""*"",       // 4: wild/wild"
  "  ];"
  "  for (let i = 0; i < tiers.length; i++) {"
  "    const matched = vhosts.filter(tiers[i]);"
  "    if (matched.length > 0) return matched;"
  "  }"
  "  return [];  // 5: main server"
  "}"
  .

TESTTHELADDER =
  "// ── 2. Test the ladder ───────────────────────────────────────────"
  "const vhosts: Vhost[] = ["
  "  { ip: ""10.0.0.1"", port: 80,   serverName: ""a.example.com"", priority: 1 },"
  "  { ip: ""10.0.0.1"", port: ""*"",  serverName: ""b.example.com"", priority: 2 },"
  "  { ip: ""*"",        port: 80,   serverName: ""c.example.com"", priority: 3 },"
  "  { ip: ""*"",        port: ""*"",  serverName: ""d.example.com"", priority: 4 },"
  "];"
  "// exact match -> tier 1 only"
  "assert.deepStrictEqual("
  "  phase1Match(vhosts, ""10.0.0.1"", 80).map(v => v.serverName),"
  "  [""a.example.com""],"
  "  ""exact/exact -> tier 1"""
  ");"
  "// exact IP, other port -> tier 2"
  "assert.deepStrictEqual("
  "  phase1Match(vhosts, ""10.0.0.1"", 8080).map(v => v.serverName),"
  "  [""b.example.com""],"
  "  ""exact/wild -> tier 2"""
  ");"
  "// other IP, exact port -> tier 3"
  "assert.deepStrictEqual("
  "  phase1Match(vhosts, ""10.0.0.2"", 80).map(v => v.serverName),"
  "  [""c.example.com""],"
  "  ""wild/port -> tier 3"""
  ");"
  "// other IP, other port -> tier 4"
  "assert.deepStrictEqual("
  "  phase1Match(vhosts, ""10.0.0.2"", 8080).map(v => v.serverName),"
  "  [""d.example.com""],"
  "  ""wild/wild -> tier 4"""
  ");"
  .

THEREDUCTIONLADDERAXES =
  "// ── 3. The reduction ladder: 4 -> 3 -> 2 -> 1 -> 0 axes ─────────"
  "const tiers = ["
  "  { name: ""exact/exact"",  axes: 2, wildcards: 0 },"
  "  { name: ""exact/wild"",   axes: 2, wildcards: 1 },"
  "  { name: ""wild/exact"",   axes: 2, wildcards: 1 },"
  "  { name: ""wild/wild"",    axes: 2, wildcards: 2 },"
  "  { name: ""main server"",  axes: 0, wildcards: 0 },"
  "];"
  "assert.strictEqual(tiers[0].wildcards, 0, ""tier 1: no wildcards"");"
  "assert.strictEqual(tiers[3].wildcards, 2, ""tier 4: both wildcards"");"
  "assert.strictEqual(tiers[4].axes, 0, ""tier 5: no axes (catch-all)"");"
  .

PHASENAMEMATCH =
  "// ── 4. Phase 2: name match ───────────────────────────────────────"
  "function phase2Match(vhosts: Vhost[], hostHeader: string): Vhost {"
  "  // first vhost whose serverName matches the Host header"
  "  for (const v of vhosts) {"
  "    if (v.serverName === hostHeader) return v;"
  "  }"
  "  return vhosts[0];  // fallback: first vhost"
  "}"
  "const phase2Set: Vhost[] = ["
  "  { ip: ""*"", port: 80, serverName: ""a.example.com"", priority: 1 },"
  "  { ip: ""*"", port: 80, serverName: ""b.example.com"", priority: 1 },"
  "  { ip: ""*"", port: 80, serverName: ""c.example.com"", priority: 1 },"
  "];"
  "assert.strictEqual("
  "  phase2Match(phase2Set, ""b.example.com"").serverName,"
  "  ""b.example.com"","
  "  ""phase2: match on Host header"""
  ");"
  "assert.strictEqual("
  "  phase2Match(phase2Set, ""unknown.example.com"").serverName,"
  "  ""a.example.com"","
  "  ""phase2: fallback to first vhost"""
  ");"
  .

THECATCHALLMAINSERVERDEFAULT =
  "// ── 5. The catch-all (main server / _default_) ───────────────────"
  "// main server fallback: only reachable when no *:* vhost exists"
  "const noWildcard: Vhost[] = ["
  "  { ip: ""10.0.0.1"", port: 80,  serverName: ""a.example.com"", priority: 1 },"
  "  { ip: ""10.0.0.1"", port: ""*"", serverName: ""b.example.com"", priority: 2 },"
  "  // no *:80, no *:*"
  "];"
  "assert.deepStrictEqual("
  "  phase1Match(noWildcard, ""10.0.0.2"", 99999),"
  "  [],"
  "  ""no match -> main server (no *:* vhost)"""
  ");"
  "// with a *:* vhost, the wildcard catches everything"
  "assert.deepStrictEqual("
  "  phase1Match(vhosts, ""10.0.0.2"", 99999).map(v => v.serverName),"
  "  [""d.example.com""],"
  "  ""with *:* vhost, wildcard catches all"""
  ");"
  .

CIDRASTHEMODREDUCTION =
  "// ── 6. CIDR as the mod reduction ────────────────────────────────"
  "function cidrMask(prefix: number): number {"
  "  return prefix === 0 ? 0 : (~0 << (32 - prefix)) >>> 0;"
  "}"
  "function cidrNetwork(ip: number, prefix: number): number {"
  "  return (ip & cidrMask(prefix)) >>> 0;"
  "}"
  "// 192.168.1.0/24 covers 192.168.1.0 - 192.168.1.255"
  "const net24 = cidrNetwork(0xC0A80100, 24);"
  "assert.strictEqual(net24, 0xC0A80100, ""/24 network"");"
  "// 192.168.1.5 is in that network"
  "assert.strictEqual("
  "  cidrNetwork(0xC0A80105, 24),"
  "  net24,"
  "  ""192.168.1.5 in 192.168.1.0/24"""
  ");"
  "// mask size: /24 -> 256 addresses"
  "assert.strictEqual(2 ** (32 - 24), 256, ""/24 has 256 addresses"");"
  "assert.strictEqual(2 ** (32 - 8),  2 ** 24, ""/8 has 16M addresses"");"
  .

THETHREEPROTOCOLLEVELS =
  "// ── 7. The three protocol levels ─────────────────────────────────"
  "const protocols = {"
  "  TCP:  { codes: [""SYN"", ""ACK"", ""FIN"", ""RST""],       layer: ""transport"" },"
  "  HTTP: { codes: [200, 301, 404, 500],                layer: ""application"" },"
  "  FTP:  { codes: [100, 200, 300, 400, 500],           layer: ""application"" },"
  "};"
  "assert.strictEqual(protocols.TCP.layer,  ""transport"");"
  "assert.strictEqual(protocols.HTTP.layer, ""application"");"
  "assert.strictEqual(protocols.FTP.layer,  ""application"");"
  "// HTTP and FTP both use 1xx-5xx"
  "assert.ok(protocols.HTTP.codes.every(c => c >= 100 && c < 600), ""HTTP codes"");"
  "assert.ok(protocols.FTP.codes.every(c => c >= 100 && c < 600),  ""FTP codes"");"
  .

THEMAPPINGTOTHEVAULT =
  "// ── 8. The mapping to the vault ──────────────────────────────────"
  "const mapping = {"
  "  ""phase1"":       ""space reduction (I-108)"","
  "  ""phase2"":       ""identity reduction (I-108 head/tail)"","
  "  ""priority"":     ""reduction ladder (specific -> catch-all)"","
  "  ""main server"":  ""catch-all at 0 (I-136)"","
  "  ""CIDR"":         ""mod reduction (reduce address to space)"","
  "  ""IPP"":          ""fixed-field binary headers (nibble-pair)"","
  "  ""TCP/HTTP/FTP"": ""three-level taxonomy (space/range/frame)"","
  "};"
  "assert.strictEqual(Object.keys(mapping).length, 7, ""7 mappings"");"
  "console.log(""I-137: mod_rewrite two-phase reduction + catch-all — passed"");"
  .
