ONETREEOFROOTEDATENTITY =
  "// ── 1. One tree of 144, rooted at entity ─────────────────────"
  "assert.strictEqual(SYNSETS.length, 144, ""144 synsets"");"
  "const byId = new Map(SYNSETS.map(([id, parent, word]) => [id, { parent, word }]));"
  "assert.strictEqual(byId.size, 144, ""each once"");"
  "assert.deepStrictEqual(SYNSETS.filter(([, p]) => p === 0).map(([, , w]) => w), [""entity""], ""one root, entity"");"
  "for (const [id, parent] of SYNSETS) if (parent) assert.ok(byId.has(parent), `the parent of ${id} is in the tree`);"
  "const route = (id: number) => { const r = [byId.get(id)!.word]; for (let p = byId.get(id)!.parent; p; p = byId.get(p)!.parent) r.push(byId.get(p)!.word); return r; };"
  .

COLORBELOWITSELFABOVE =
  "// ── 2. color: 138 below, itself, 5 above ─────────────────────"
  "const COLOR = 4956594;"
  "assert.deepStrictEqual(route(COLOR), [""color"", ""visual property"", ""property"", ""attribute"", ""abstraction"", ""entity""], ""color's route to entity"");"
  "const under = (id: number) => { for (let p = byId.get(id)!.parent; p; p = byId.get(p)!.parent) if (p === COLOR) return true; return false; };"
  "const below = SYNSETS.filter(([id]) => under(id));"
  "assert.strictEqual(below.length, 138, ""138 synsets below color"");"
  "assert.strictEqual(below.length + 1 + 5, 144, ""138 + color + 5 above = 144"");"
  "assert.strictEqual(144 + 1, 145, ""and with globalThis, 145"");"
  "assert.deepStrictEqual(route(4962784), [""red"", ""chromatic color"", ""color"", ""visual property"", ""property"", ""attribute"", ""abstraction"", ""entity""], ""red: eight synsets, seven steps"");"
  .

TWELVEBYTWELVE =
  "// ── 3. Twelve by twelve ──────────────────────────────────────"
  "const twelve = [""hell"", ""o, w"", ""orld""].join("""");"
  "assert.strictEqual(twelve.length, 12, ""a, b, c: the first 12"");"
  "assert.strictEqual(twelve.charCodeAt(6), 0x20, ""the space at index 6"");"
  "assert.strictEqual(twelve[11], ""d"", ""the 11th index is the last"");"
  "assert.strictEqual(12 * 12, 144, ""12 x 12 = 144"");"
  "assert.strictEqual(360 / 12, 30, ""360 hues: 12 sectors of 30"");"
  "console.log(""I-199: color is 144 synsets, twelve by twelve — passed"");"
  "console.log(""  color: 138 below + itself + 5 to entity = 144, each once (+ globalThis = 145)"");"
  "console.log(""  'hello, world': indices 0-11, the space at 6, the 11th index 'd'; 144 = 12 x 12; 360 = 12 x 30"");"
  .
