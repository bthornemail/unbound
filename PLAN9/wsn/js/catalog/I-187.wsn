RECORD = HEAD APRODUCTOFUNITSISTHEUNITATTHEXOROFTHEIRINDICES SOTHETRIPODSARETHELINESOFPGNNN WIKIPEDIASASLISTED .

HEAD =
  "// i187.ts — I-187: the tripods of the 2^n-ions: e_a e_b = ±e_(a ^ b), and the triples are the lines of PG(n-1, 2)"
  "//"
  "// The author, 2026-10-13: ""tripods of trigintaduonions of the 64-nions"", with"
  "// Wikipedia's Trigintaduonion page (its 155 triples below, as listed there,"
  "// citing OEIS A171477). A tripod here is three imaginary units {a, b, c} whose"
  "// products close: e_a e_b = ±e_c. In the Cayley-Dickson doubling the index of a"
  "// product is the XOR of the indices (the boolean write, I-184) and only the sign"
  "// is left to the rest of the multiplication, so the tripods are the triples"
  "// a ^ b ^ c = 0: the lines of the projective space PG(n-1, 2) over the 2^n - 1"
  "// units, (2^n - 1)(2^n - 2)/6 of them. Octonions 7, sedenions 35,"
  "// trigintaduonions 155, 64-ions 651; the 64-ions have 63 imaginary units, the"
  "// 6-bit closure."
  "import assert from ""node:assert"";"
  "const conj = (a: number[]): number[] => (a.length === 1 ? [...a] : [...conj(a.slice(0, a.length / 2)), ...a.slice(a.length / 2).map((v) => -v)]);"
  "const add = (a: number[], b: number[]) => a.map((v, i) => v + b[i]!);"
  "function mul(a: number[], b: number[]): number[] {"
  "  if (a.length === 1) return [a[0]! * b[0]!];"
  "  const h = a.length / 2, a1 = a.slice(0, h), a2 = a.slice(h), b1 = b.slice(0, h), b2 = b.slice(h);"
  "  return [...add(mul(a1, b1), mul(conj(b2), a2).map((v) => -v)), ...add(mul(b2, a1), mul(a2, conj(b1)))];"
  "}"
  "const unit = (n: number, i: number) => Array.from({ length: n }, (_, k) => (k === i ? 1 : 0));"
  .

APRODUCTOFUNITSISTHEUNITATTHEXOROFTHEIRINDICES =
  "// ── 1. A product of units is ± the unit at the XOR of their indices ─"
  "// every pair through the trigintaduonions; in the 64-ions every unit with every fifth partner"
  "for (const n of [8, 16, 32, 64]) {"
  "  for (let a = 0; a < n; a++) for (let b = n === 64 ? a % 5 : 0; b < n; b += n === 64 ? 5 : 1) {"
  "    const p = mul(unit(n, a), unit(n, b));"
  "    const at = p.findIndex((v) => v !== 0);"
  "    assert.ok(at === (a ^ b) && Math.abs(p[at]!) === 1 && p.filter((v) => v !== 0).length === 1, `dimension ${n}: e${a} e${b} = ±e${a ^ b}`);"
  "    if (a === b && a > 0) assert.strictEqual(p[0], -1, `e${a}² = -1`);"
  "  }"
  "}"
  .

SOTHETRIPODSARETHELINESOFPGNNN =
  "// ── 2. So the tripods are the lines of PG(n-1, 2): (2^n - 1)(2^n - 2)/6 ─"
  "const lines = (units: number) => {"
  "  const s = new Set<string>();"
  "  for (let a = 1; a <= units; a++) for (let b = a + 1; b <= units; b++) s.add([a, b, a ^ b].sort((x, y) => x - y).join());"
  "  return s;"
  "};"
  "const counts = [3, 4, 5, 6].map((k) => lines(2 ** k - 1).size);"
  "assert.deepStrictEqual(counts, [7, 35, 155, 651], ""octonions 7, sedenions 35, trigintaduonions 155, 64-ions 651"");"
  "for (const k of [3, 4, 5, 6]) assert.strictEqual(lines(2 ** k - 1).size, ((2 ** k - 1) * (2 ** k - 2)) / 6, `(2^${k} - 1)(2^${k} - 2)/6`);"
  "assert.strictEqual(2 ** 6 - 1, 63, ""the 64-ions have 63 imaginary units: the 6-bit closure"");"
  .

WIKIPEDIASASLISTED =
  "// ── 3. Wikipedia's 155, as listed ───────────────────────────"
  "const LISTED = ["
  "  { stated: 45, type: ""{α, α, β}"", triples: [[3,13,14],[3,21,22],[3,25,26],[5,11,14],[5,19,22],[5,25,28],[6,11,13],[6,19,21],[6,26,28],[7,9,14],[7,10,13],[7,11,12],[7,17,22],[7,18,21],[7,19,20],[7,25,30],[7,26,29],[7,27,28],[9,19,26],[9,21,28],[10,19,25],[10,22,28],[11,17,26],[11,18,25],[11,19,24],[11,21,30],[11,22,29],[11,23,28],[12,21,25],[12,22,26],[13,17,28],[13,19,30],[13,20,25],[13,21,24],[13,22,27],[13,23,26],[14,18,28],[14,19,29],[14,20,26],[14,21,27],[14,22,24],[14,23,25],[15,19,28],[15,21,26],[15,22,25]] },"
  "  { stated: 20, type: ""{β, β, β}"", triples: [[3,5,6],[3,9,10],[3,17,18],[3,29,30],[5,9,12],[5,17,20],[5,27,30],[6,10,12],[6,18,20],[6,27,29],[9,17,24],[9,23,30],[10,18,24],[10,23,29],[12,20,24],[12,23,27],[15,17,30],[15,18,29],[15,20,27],[15,23,24]] },"
  "  { stated: 15, type: ""{β, β, β}"", triples: [[3,12,15],[3,20,23],[3,24,27],[5,10,15],[5,18,23],[5,24,29],[6,9,15],[6,17,23],[6,24,30],[9,18,27],[9,20,29],[10,17,27],[10,20,30],[12,17,29],[12,18,30]] },"
  "  { stated: 60, type: ""{α, β, γ}"", triples: [[1,6,7],[1,10,11],[1,12,13],[1,14,15],[1,18,19],[1,20,21],[1,22,23],[1,24,25],[1,26,27],[1,28,29],[2,5,7],[2,9,11],[2,12,14],[2,13,15],[2,17,19],[2,20,22],[2,21,23],[2,24,26],[2,25,27],[2,28,30],[3,4,7],[3,8,11],[3,16,19],[3,28,31],[4,9,13],[4,10,14],[4,11,15],[4,17,21],[4,18,22],[4,19,23],[4,24,28],[4,25,29],[4,26,30],[5,8,13],[5,16,21],[5,26,31],[6,8,14],[6,16,22],[6,25,31],[7,8,15],[7,16,23],[7,24,31],[8,17,25],[8,18,26],[8,19,27],[8,20,28],[8,21,29],[8,22,30],[9,16,25],[9,22,31],[10,16,26],[10,21,31],[11,16,27],[11,20,31],[12,16,28],[12,19,31],[13,16,29],[13,18,31],[14,16,30],[14,17,31]] },"
  "  { stated: 15, type: ""{β, γ, γ}"", triples: [[1,2,3],[1,4,5],[1,8,9],[1,16,17],[1,30,31],[2,4,6],[2,8,10],[2,16,18],[2,29,31],[4,8,12],[4,16,20],[4,27,31],[8,16,24],[8,23,31],[15,16,31]] },"
  "];"
  "for (const g of LISTED) assert.strictEqual(g.triples.length, g.stated, `${g.stated} of type ${g.type}`);"
  "const all = LISTED.flatMap((g) => g.triples);"
  "for (const [a, b, c] of all) assert.strictEqual(a! ^ b!, c, `{${a}, ${b}, ${c}}: a ^ b = c`);"
  "const pg42 = lines(31);"
  "assert.deepStrictEqual(new Set(all.map((t) => [...t].sort((x, y) => x - y).join())), pg42, ""the listed 155 are exactly the lines of PG(4, 2)"");"
  "for (const [a, b, c] of all) {"
  "  const p = mul(unit(32, a!), unit(32, b!));"
  "  assert.strictEqual(Math.abs(p[c!]!), 1, `e${a} e${b} = ±e${c} in the trigintaduonions`);"
  "}"
  "console.log(""I-187: the tripods of the 2^n-ions — passed"");"
  "console.log(""  e_a e_b = ±e_(a ^ b) through the 64-ions: the index is written by XOR, the sign by the rest"");"
  "console.log(""  the tripods are the lines of PG(n-1, 2): 7, 35, 155, 651; Wikipedia's 155 are exactly PG(4, 2)'s lines"");"
  .
