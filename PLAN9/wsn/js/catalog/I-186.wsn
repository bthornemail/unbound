RECORD = HEAD .

HEAD =
  "// i186.ts — I-186: the ASCII indices pass through UTF-8 as themselves"
  "//"
  "// The author, 2026-10-13: ""how does the year of closure of the table be the"
  "// indices of closure, and this survives all the official ubiquitous specs""."
  "// The specs that carry text now (HTTP, HTML, JSON, the DOM) carry it as UTF-8,"
  "// and UTF-8 keeps the ASCII table: every code point below 0x80 is its own one"
  "// byte, and no other code point's bytes fall below 0x80. So 19 (DC3) and 63"
  "// (?) cannot be made by anything else, anywhere in UTF-8 text. Checked over"
  "// every Unicode scalar value. (The table's history, the 1963 edition and its"
  "// 1967 revision, is not what this checks.)"
  "import assert from ""node:assert"";"
  "const enc = new TextEncoder();"
  "let scalars = 0;"
  "for (let cp = 0; cp <= 0x10ffff; cp++) {"
  "  if (cp >= 0xd800 && cp <= 0xdfff) continue; // surrogates are not scalar values"
  "  const bytes = enc.encode(String.fromCodePoint(cp));"
  "  scalars++;"
  "  if (cp < 0x80) assert.deepStrictEqual([...bytes], [cp], `U+${cp.toString(16)} is its own byte`);"
  "  else assert.ok(bytes.every((b) => b >= 0x80), `U+${cp.toString(16)}: no byte below 0x80`);"
  "}"
  "assert.strictEqual(scalars, 1112064, ""every Unicode scalar value"");"
  "assert.deepStrictEqual([...enc.encode(""\x13?"")], [19, 63], ""19 and 63 are themselves"");"
  "assert.strictEqual(new TextDecoder().decode(new Uint8Array([19, 63])), ""\x13?"", ""and read back as themselves"");"
  "console.log(""I-186: the ASCII indices pass through UTF-8 as themselves — passed"");"
  "console.log(`  over ${scalars} code points, bytes below 0x80 appear only as their own ASCII character; 19 and 63 included`);"
  .
