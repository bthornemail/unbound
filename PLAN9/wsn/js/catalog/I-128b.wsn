RECORD = HEAD .

HEAD =
  "// promptTest2.ts — I-128b: cycle ON prompt characters"
  "import assert from ""node:assert"";"
  "const prompt = ""main@TOSHIBA-PORTEGE-Z30t-C:~/Programs/boxedPINE/src$ "";"
  "const buf = Buffer.alloc(256);"
  "Buffer.from(prompt).copy(buf, 0);"
  "const view = new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength);"
  "// indices INSIDE the prompt: 10, 20, 30 (all < 54)"
  "const IA = 10, IB = 20, IC = 30;"
  "const bA = buf[IA], bB = buf[IB], bC = buf[IC];"
  "console.log(""A(10):"", JSON.stringify(String.fromCharCode(bA)),"
  "            ""B(20):"", JSON.stringify(String.fromCharCode(bB)),"
  "            ""C(30):"", JSON.stringify(String.fromCharCode(bC)));"
  "// cycle: A <- B <- C <- A"
  "Atomics.compareExchange(view, IA, bA, bB);"
  "Atomics.compareExchange(view, IB, bB, bC);"
  "Atomics.compareExchange(view, IC, bC, bA);"
  "assert.strictEqual(buf[IA], bB, ""A now holds old B"");"
  "assert.strictEqual(buf[IB], bC, ""B now holds old C"");"
  "assert.strictEqual(buf[IC], bA, ""C now holds old A"");"
  "// mod 12 of these indices"
  "const m12 = (n: number) => ((n % 12) + 12) % 12;"
  "console.log(""mod-12 of 10/20/30:"", m12(IA), m12(IB), m12(IC));"
  "assert.deepStrictEqual([m12(10), m12(20), m12(30)], [10, 8, 6]);"
  "// mod-12 orbit {6, 8, 10} — even, descending"
  "console.log(""prompt chars cycle — passed"");"
  .
