CELLINCIDENCEBALANCEE =
  "Theorem cell16_incidence_balance :"
  "  (c16_vertices cell16 * 6 = c16_edges cell16 * 2)%N /\"
  "  (c16_edges cell16 * 4 = c16_faces cell16 * 3)%N /\"
