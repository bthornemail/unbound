PROOFREGISTRY = CHECKED .

CHECKED = COQ SCOPE PROOFREGISTRYOWNER PROOFREGISTRYPROOF PROOFREGISTRYFACES PROOFREGISTRYSTRATA PROOFREGISTRYFILES PROOFREGISTRYFACESTIMESSTRATA .

COQ =
  "From Coq Require Import NArith.NArith."
  .

SCOPE =
  "Open Scope N_scope."
  .

PROOFREGISTRYOWNER =
  "Definition proof_registry15_owner : Prop := True."
  .

PROOFREGISTRYPROOF =
  "Definition proof_registry15_proof : proof_registry15_owner := I."
  .

PROOFREGISTRYFACES =
  "Definition proof_registry15_faces : N := 5."
  .

PROOFREGISTRYSTRATA =
  "Definition proof_registry15_strata : N := 3."
  .

PROOFREGISTRYFILES =
  "Definition proof_registry15_files : N := 15."
  .

PROOFREGISTRYFACESTIMESSTRATA =
  "Theorem proof_registry15_faces_times_strata :"
  "  proof_registry15_faces * proof_registry15_strata = proof_registry15_files."
  "Proof."
  "  reflexivity."
  "Qed."
  .
