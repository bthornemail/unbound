COALGEBRAICBISIMULATION = CHECKED .

CHECKED = COQ SCOPE COALGEBRAICBISIMULATIONOWNER COALGEBRAICBISIMULATIONPROOF COALGEBRAICBISIMULATIONSTEP COALGEBRAICBISIMULATIONSTEPDETERMINISTIC .

COQ =
  "From Coq Require Import NArith.NArith."
  .

SCOPE =
  "Open Scope N_scope."
  .

COALGEBRAICBISIMULATIONOWNER =
  "Definition coalgebraic_bisimulation_owner : Prop := True."
  .

COALGEBRAICBISIMULATIONPROOF =
  "Definition coalgebraic_bisimulation_proof : coalgebraic_bisimulation_owner := I."
  .

COALGEBRAICBISIMULATIONSTEP =
  "Definition coalgebraic_bisimulation_step (x axis : N) : N :="
  "  N.lxor (N.shiftl x 1) (N.shiftr axis 2)."
  .

COALGEBRAICBISIMULATIONSTEPDETERMINISTIC =
  "Theorem coalgebraic_bisimulation_step_deterministic : forall x axis,"
  "  coalgebraic_bisimulation_step x axis ="
  "  coalgebraic_bisimulation_step x axis."
  "Proof."
  "  reflexivity."
  "Qed."
  .
