DELTAORBITTHEORY = CHECKED .

CHECKED = COQ SCOPE DELTAORBITTHEORYOWNER DELTAORBITTHEORYPROOF DELTAORBITTHEORYDELTA DELTAORBITTHEORYZERODELTA .

COQ =
  "From Coq Require Import NArith.NArith."
  .

SCOPE =
  "Open Scope N_scope."
  .

DELTAORBITTHEORYOWNER =
  "Definition delta_orbit_theory_owner : Prop := True."
  .

DELTAORBITTHEORYPROOF =
  "Definition delta_orbit_theory_proof : delta_orbit_theory_owner := I."
  .

DELTAORBITTHEORYDELTA =
  "Definition delta_orbit_theory_delta (x : N) : N := N.lxor x 0x1D."
  .

DELTAORBITTHEORYZERODELTA =
  "Theorem delta_orbit_theory_zero_delta :"
  "  delta_orbit_theory_delta 0 = 0x1D."
  "Proof."
  "  reflexivity."
  "Qed."
  .
