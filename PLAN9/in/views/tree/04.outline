DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n    
    STARTTAG <meta charset="UTF-8">
    TEXT \n    
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n    
    STARTTAG <title>
      RAWTEXT Cryptocurrency Fano Plane Cycle
    ENDTAG </title>
    TEXT \n    
    COMMENT <!-- Tailwind CSS CDN -->
    TEXT \n    
    STARTTAG <script src="https://cdn.tailwindcss.com">
    ENDTAG </script>
    TEXT \n    
    COMMENT <!-- Three.js CDN -->
    TEXT \n    
    STARTTAG <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js">
    ENDTAG </script>
    TEXT \n    
    COMMENT <!-- OrbitControls for camera interaction -->
    TEXT \n    
    STARTTAG <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js">
    ENDTAG </script>
    TEXT \n    
    STARTTAG <style>
      RAWTEXT \n        body {\n            margin: 0;\n            overflow: hidden; /* Hide scrollbars */\n            font-family: 'Inter', sans-serif; /* Use Inter font */\n            background-color: #1a202c; /* Dark background */\n            color: #e2e8f0; /* Light text color */\n        }\n        canvas {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n        #info-panel {\n            position: absolute;\n            top: 1rem;\n            left: 1rem;\n            background-color: rgba(26, 32, 44, 0.8); /* Dark background with transparency */\n            padding: 1rem;\n            border-radius: 0.75rem; /* Rounded corners */\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n            max-height: calc(100% - 2rem); /* Limit height for responsiveness */\n            overflow-y: auto; /* Enable scrolling if content overflows */\n            z-index: 10;\n        }\n        #controls-panel {\n            position: absolute;\n            bottom: 1rem;\n            left: 50%;\n            transform: translateX(-50%);\n            background-color: rgba(26, 32, 44, 0.8);\n            padding: 1rem;\n            border-radius: 0.75rem;\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n            z-index: 10;\n        }\n        #loading-overlay {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background-color: rgba(0, 0, 0, 0.7);\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            color: white;\n            font-size: 1.5rem;\n            z-index: 1000;\n        }\n        .crypto-item {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 0.5rem 0;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .crypto-item:last-child {\n            border-bottom: none;\n        }\n        .crypto-name {\n            font-weight: bold;\n            margin-right: 1rem;\n        }\n        .crypto-price {\n            color: #48bb78; /* Green color for prices */\n        }\n        button {\n            @apply bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-xl shadow-lg transition duration-300 ease-in-out transform hover:scale-105;\n        }\n    
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n    
    STARTTAG <div id="loading-overlay">
      TEXT \n        
      STARTTAG <p>
        TEXT Loading cryptocurrency data and setting up visualization...
      ENDTAG </p>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div id="info-panel" class="text-sm">
      TEXT \n        
      STARTTAG <h2 class="text-lg font-bold mb-2">
        TEXT Cryptocurrency Values
      ENDTAG </h2>
      TEXT \n        
      STARTTAG <div id="crypto-prices-display">
        TEXT \n            
        COMMENT <!-- Crypto prices will be dynamically inserted here -->
        TEXT \n        
      ENDTAG </div>
      TEXT \n        
      STARTTAG <p class="mt-4 text-xs text-gray-400">
        TEXT \n            * Sizes of spheres reflect current market prices.\n            
        STARTTAG <br>
        TEXT \n            * Updates every 30 seconds.\n        
      ENDTAG </p>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div id="controls-panel">
      TEXT \n        
      STARTTAG <button id="cycleFanoPlaneBtn">
        TEXT Cycle Fano Plane Lines
      ENDTAG </button>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <script>
      RAWTEXT \n        // Global variables for Three.js scene\n        let scene, camera, renderer, controls;\n        // Array to store Three.js mesh objects for cryptocurrencies\n        const cryptoMeshes = [];\n        // Array to store Three.js line objects for Fano Plane connections\n        const fanoLinesObjects = [];\n        // Object to store text sprites for labels\n        const cryptoLabels = {};\n\n        // Index to track the currently highlighted Fano Plane line\n        let currentFanoLineIndex = -1; // -1 means no line is highlighted initially\n\n        // Configuration for cryptocurrencies to fetch (7 for Fano Plane)\n        // Mapped to Fano Plane points 1-7 (index 0-6 in array)\n        const cryptocurrencies = [\n            { id: 'bitcoin', name: 'Bitcoin', symbol: 'BTC', color: 0xffa500 }, // Point 1\n            { id: 'ethereum', name: 'Ethereum', symbol: 'ETH', color: 0x667eea }, // Point 2\n            { id: 'ripple', name: 'XRP', color: 0x4299e1 }, // Point 3\n            { id: 'solana', name: 'Solana', symbol: 'SOL', color: 0x9f7aea }, // Point 4\n            { id: 'cardano', name: 'Cardano', symbol: 'ADA', color: 0xf6ad55 }, // Point 5\n            { id: 'dogecoin', name: 'Dogecoin', symbol: 'DOGE', color: 0xf6e05e }, // Point 6\n            { id: 'polkadot', name: 'Polkadot', symbol: 'DOT', color: 0xe91e63 } // Point 7 (Center for visualization)\n        ];\n\n        // Fano Plane lines using indices of the cryptocurrencies array (0-6)\n        // These correspond to the standard Fano Plane lines {1,2,3}, {1,4,5}, etc.\n        const fanoLinesConfig = [\n            [0, 1, 2], // {1, 2, 3} - BTC, ETH, XRP\n            [0, 3, 4], // {1, 4, 5} - BTC, SOL, ADA\n            [0, 5, 6], // {1, 6, 7} - BTC, DOGE, DOT\n            [1, 3, 5], // {2, 4, 6} - ETH, SOL, DOGE\n            [1, 4, 6], // {2, 5, 7} - ETH, ADA, DOT\n            [2, 3, 6], // {3, 4, 7} - XRP, SOL, DOT\n            [2, 4, 5]  // {3, 5, 6} - XRP, ADA, DOGE (the "circular" line)\n        ];\n\n        // Base URL for CoinGecko API\n        const COINGECKO_API_URL = 'https://api.coingecko.com/api/v3/simple/price';\n        // Interval for fetching data (in milliseconds)\n        const FETCH_INTERVAL = 30000; // 30 seconds\n\n        // Highlight colors\n        const HIGHLIGHT_SPHERE_COLOR = new THREE.Color(0xffff00); // Bright yellow for spheres\n        const HIGHLIGHT_LINE_COLOR = new THREE.Color(0xffd700); // Gold for lines\n        const DEFAULT_LINE_COLOR = new THREE.Color(0x6b7280); // Gray for lines\n        const DEFAULT_LINE_OPACITY = 0.5;\n\n        /**\n         * Initializes the Three.js scene, camera, renderer, and controls.\n         */\n        function init() {\n            // Scene setup\n            scene = new THREE.Scene();\n            scene.background = new THREE.Color(0x1a202c); // Dark background\n\n            // Camera setup\n            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.z = 5; // Initial camera position\n\n            // Renderer setup\n            renderer = new THREE.WebGLRenderer({ antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            document.body.appendChild(renderer.domElement);\n\n            // OrbitControls for camera interaction\n            controls = new THREE.OrbitControls(camera, renderer.domElement);\n            controls.enableDamping = true; // Enable smooth camera movement\n            controls.dampingFactor = 0.05;\n            controls.screenSpacePanning = false;\n            controls.minDistance = 2;\n            controls.maxDistance = 10;\n\n            // Lighting\n            const ambientLight = new THREE.AmbientLight(0x404040, 2); // Soft white light\n            scene.add(ambientLight);\n            const pointLight = new THREE.PointLight(0xffffff, 1);\n            pointLight.position.set(5, 5, 5);\n            scene.add(pointLight);\n\n            // Handle window resizing\n            window.addEventListener('resize', onWindowResize, false);\n\n            // Setup Fano Plane nodes and lines\n            setupFanoPlane();\n\n            // Add event listener for the cycle button\n            document.getElementById('cycleFanoPlaneBtn').addEventListener('click', cycleFanoPlaneHighlight);\n\n            animate(); // Start the animation loop\n        }\n\n        /**\n         * Sets up the 7 cryptocurrency spheres in a Fano Plane configuration\n         * and draws the connecting lines.\n         */\n        function setupFanoPlane() {\n            const R_outer = 2.5; // Radius for the outer circle points\n            const R_inner = 0; // Center point\n\n            // Define positions for the 7 Fano Plane points\n            // Point 7 (index 6: Polkadot) is at the center (0,0,0)\n            // Points 1-6 (indices 0-5) are on a circle in the XY plane\n            const positions = [\n                // Point 1 (index 0: Bitcoin)\n                new THREE.Vector3(R_outer, 0, 0),\n                // Point 2 (index 1: Ethereum)\n                new THREE.Vector3(R_outer * Math.cos(Math.PI / 3), R_outer * Math.sin(Math.PI / 3), 0),\n                // Point 3 (index 2: Ripple)\n                new THREE.Vector3(R_outer * Math.cos(2 * Math.PI / 3), R_outer * Math.sin(2 * Math.PI / 3), 0),\n                // Point 4 (index 3: Solana)\n                new THREE.Vector3(R_outer * Math.cos(Math.PI), R_outer * Math.sin(Math.PI), 0),\n                // Point 5 (index 4: Cardano)\n                new THREE.Vector3(R_outer * Math.cos(4 * Math.PI / 3), R_outer * Math.sin(4 * Math.PI / 3), 0),\n                // Point 6 (index 5: Dogecoin)\n                new THREE.Vector3(R_outer * Math.cos(5 * Math.PI / 3), R_outer * Math.sin(5 * Math.PI / 3), 0),\n                // Point 7 (index 6: Polkadot) - Center\n                new THREE.Vector3(R_inner, R_inner, R_inner)\n            ];\n\n            // Create spheres for each cryptocurrency\n            cryptocurrencies.forEach((crypto, index) => {\n                const geometry = new THREE.SphereGeometry(0.1, 32, 32); // Small initial size\n                const material = new THREE.MeshPhongMaterial({ color: crypto.color });\n                const sphere = new THREE.Mesh(geometry, material);\n                sphere.position.copy(positions[index]);\n                sphere.userData.id = crypto.id; // Store crypto ID for later lookup\n                sphere.userData.originalColor = crypto.color; // Store original color\n                scene.add(sphere);\n                cryptoMeshes.push(sphere);\n\n                // Create text label for each crypto\n                const canvas = document.createElement('canvas');\n                const context = canvas.getContext('2d');\n                const fontSize = 48;\n                context.font = `${fontSize}px Inter`;\n                const textWidth = context.measureText(crypto.symbol).width;\n                canvas.width = textWidth + 20;\n                canvas.height = fontSize + 20;\n                context.font = `${fontSize}px Inter`;\n                context.fillStyle = 'white';\n                context.textAlign = 'center';\n                context.textBaseline = 'middle';\n                context.fillText(crypto.symbol, canvas.width / 2, canvas.height / 2);\n\n                const texture = new THREE.CanvasTexture(canvas);\n                const spriteMaterial = new THREE.SpriteMaterial({ map: texture });\n                const sprite = new THREE.Sprite(spriteMaterial);\n                sprite.scale.set(0.5, 0.25, 1); // Adjust scale as needed\n                sprite.position.copy(sphere.position).add(new THREE.Vector3(0, 0.2, 0)); // Position above sphere\n                scene.add(sprite);\n                cryptoLabels[crypto.id] = sprite; // Store sprite for updates\n            });\n\n            // Draw Fano Plane lines\n            fanoLinesConfig.forEach(lineIndices => {\n                const points = [];\n                lineIndices.forEach(index => {\n                    points.push(cryptoMeshes[index].position);\n                });\n                const geometry = new THREE.BufferGeometry().setFromPoints(points);\n                const material = new THREE.LineBasicMaterial({ color: DEFAULT_LINE_COLOR, transparent: true, opacity: DEFAULT_LINE_OPACITY });\n                const line = new THREE.Line(geometry, material);\n                scene.add(line);\n                fanoLinesObjects.push(line);\n            });\n        }\n\n        /**\n         * Fetches cryptocurrency prices from CoinGecko API.\n         */\n        async function fetchCryptoPrices() {\n            document.getElementById('loading-overlay').style.display = 'flex'; // Show loading overlay\n            const ids = cryptocurrencies.map(c => c.id).join(',');\n            const vsCurrencies = 'usd';\n            const url = `${COINGECKO_API_URL}?ids=${ids}&vs_currencies=${vsCurrencies}`;\n\n            try {\n                const response = await fetch(url);\n                if (!response.ok) {\n                    throw new Error(`HTTP error! status: ${response.status}`);\n                }\n                const data = await response.json();\n                updateVisualization(data);\n            } catch (error) {\n                console.error('Error fetching cryptocurrency prices:', error);\n                document.getElementById('crypto-prices-display').innerHTML = '<p class="text-red-500">Failed to load prices. Please try again later.</p>';\n            } finally {\n                document.getElementById('loading-overlay').style.display = 'none'; // Hide loading overlay\n            }\n        }\n\n        /**\n         * Updates the 3D visualization based on fetched cryptocurrency prices.\n         * @param {object} data - The price data from CoinGecko API.\n         */\n        function updateVisualization(data) {\n            let maxPrice = 0;\n            // Find the maximum price for normalization\n            for (const crypto of cryptocurrencies) {\n                if (data[crypto.id] && data[crypto.id].usd) {\n                    maxPrice = Math.max(maxPrice, data[crypto.id].usd);\n                }\n            }\n\n            const priceDisplay = document.getElementById('crypto-prices-display');\n            priceDisplay.innerHTML = ''; // Clear previous prices\n\n            cryptoMeshes.forEach(sphere => {\n                const cryptoId = sphere.userData.id;\n                const priceInfo = data[cryptoId];\n                if (priceInfo && priceInfo.usd) {\n                    const price = priceInfo.usd;\n                    // Normalize price to scale sphere size (e.g., 0.1 to 1.0)\n                    // Using a logarithmic scale for better visual distinction across vastly different prices\n                    const minLogPrice = Math.log(0.001); // Smallest possible price for log scale\n                    const maxLogPrice = Math.log(Math.max(maxPrice, 0.001)); // Ensure maxLogPrice is not -Infinity\n                    const normalizedPrice = (Math.log(Math.max(price, 0.001)) - minLogPrice) / (maxLogPrice - minLogPrice);\n                    const scaleFactor = 0.1 + normalizedPrice * 0.9; // Scale from 0.1 to 1.0\n\n                    sphere.scale.set(scaleFactor, scaleFactor, scaleFactor);\n\n                    // Update text label position\n                    if (cryptoLabels[cryptoId]) {\n                        // Position label above the sphere, considering its scaled size\n                        cryptoLabels[cryptoId].position.copy(sphere.position).add(new THREE.Vector3(0, sphere.geometry.parameters.radius * scaleFactor + 0.1, 0));\n                    }\n\n                    // Update price display in the info panel\n                    const cryptoName = cryptocurrencies.find(c => c.id === cryptoId)?.name || cryptoId;\n                    const priceElement = document.createElement('div');\n                    priceElement.className = 'crypto-item';\n                    priceElement.innerHTML = `\n                        <span class="crypto-name">${cryptoName} (${cryptoId.toUpperCase()})</span>\n                        <span class="crypto-price">$${price.toFixed(2)}</span>\n                    `;\n                    priceDisplay.appendChild(priceElement);\n                } else {\n                    // If price data is missing, reset scale and show N/A\n                    sphere.scale.set(0.1, 0.1, 0.1); // Reset to base size\n                    const cryptoName = cryptocurrencies.find(c => c.id === cryptoId)?.name || cryptoId;\n                    const priceElement = document.createElement('div');\n                    priceElement.className = 'crypto-item';\n                    priceElement.innerHTML = `\n                        <span class="crypto-name">${cryptoName} (${cryptoId.toUpperCase()})</span>\n                        <span class="crypto-price text-red-500">N/A</span>\n                    `;\n                    priceDisplay.appendChild(priceElement);\n                }\n            });\n        }\n\n        /**\n         * Cycles through the 7 Fano Plane lines and highlights the current one.\n         */\n        function cycleFanoPlaneHighlight() {\n            // Reset all spheres and lines to their default state first\n            cryptoMeshes.forEach(mesh => {\n                // Ensure the material is a MeshPhongMaterial to set color\n                if (mesh.material instanceof THREE.MeshPhongMaterial) {\n                    mesh.material.color.set(mesh.userData.originalColor);\n                }\n            });\n            fanoLinesObjects.forEach(line => {\n                // Ensure the material is a LineBasicMaterial to set color and opacity\n                if (line.material instanceof THREE.LineBasicMaterial) {\n                    line.material.color.set(DEFAULT_LINE_COLOR);\n                    line.material.opacity = DEFAULT_LINE_OPACITY;\n                }\n            });\n\n            // Increment current Fano line index, loop back to 0 if at end\n            currentFanoLineIndex = (currentFanoLineIndex + 1) % fanoLinesConfig.length;\n\n            // Get the indices of the cryptocurrencies on the current Fano line\n            const currentLineCryptoIndices = fanoLinesConfig[currentFanoLineIndex];\n\n            // Highlight the spheres on the current line\n            currentLineCryptoIndices.forEach(index => {\n                const mesh = cryptoMeshes[index];\n                if (mesh && mesh.material instanceof THREE.MeshPhongMaterial) {\n                    mesh.material.color.set(HIGHLIGHT_SPHERE_COLOR);\n                }\n            });\n\n            // Highlight the current line itself\n            const currentLineObject = fanoLinesObjects[currentFanoLineIndex];\n            if (currentLineObject && currentLineObject.material instanceof THREE.LineBasicMaterial) {\n                currentLineObject.material.color.set(HIGHLIGHT_LINE_COLOR);\n                currentLineObject.material.opacity = 1.0; // Make it fully opaque\n            }\n        }\n\n        /**\n         * Handles window resize events to keep the canvas responsive.\n         */\n        function onWindowResize() {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        }\n\n        /**\n         * Animation loop for Three.js.\n         */\n        function animate() {\n            requestAnimationFrame(animate);\n            controls.update(); // Only required if controls.enableDamping or controls.autoRotate are set to true\n            renderer.render(scene, camera);\n        }\n\n        // Start the application when the window loads\n        window.onload = function () {\n            init();\n            fetchCryptoPrices(); // Initial fetch\n            setInterval(fetchCryptoPrices, FETCH_INTERVAL); // Fetch prices periodically\n        };\n    
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
