DOCTYPE <!doctype html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="utf-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    TEXT \n
    STARTTAG <title>
      RAWTEXT I-230 Sonar Closure\n<style>\n/* Layout: one column; the claim, then the dial with its hand, the precession, the factors, the eight\n   predictions checked live, and the year axis. Self-contained: no fonts or scripts are fetched. */\n:root {\n  --bg: #f4f3ef; --panel: #ffffff; --ink: #1d1f22; --muted: #5f646b; --rule: #d8d6cf;\n  --time: #2f6f8f; --held: #b9b4a6; --hand: #c2492b; --five: #b8860b; --ok: #2e7d4f; --bad: #b3261e;\n  --f-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;\n  --f-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {\n  --bg: #15171a; --panel: #1d2024; --ink: #e6e7e9; --muted: #9aa0a8; --rule: #30343a;\n  --time: #6fb3d6; --held: #4a4f57; --hand: #ff7a59; --five: #e2b44a; --ok: #6fcf97; --bad: #ff8a80; color-scheme: dark } }\n:root[data-theme="dark"] {\n  --bg: #15171a; --panel: #1d2024; --ink: #e6e7e9; --muted: #9aa0a8; --rule: #30343a;\n  --time: #6fb3d6; --held: #4a4f57; --hand: #ff7a59; --five: #e2b44a; --ok: #6fcf97; --bad: #ff8a80; color-scheme: dark }\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--f-body); }\n.wrap { max-width: 900px; margin: 0 auto; padding-block: 32px 64px; display: grid; gap: 28px;\n  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\nh1 { font-size: 1.8rem; line-height: 1.2; margin: 0; text-wrap: balance; }\nh2 { font-size: 1.2rem; margin: 0; }\np { margin: 0; max-width: 68ch; }\n.muted { color: var(--muted); }\n.eyebrow { font: 600 .75rem var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }\ncode, .mono { font-family: var(--f-mono); font-size: .9em; }\nsection { display: grid; gap: 12px; }\n.panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 16px; display: grid; gap: 12px; min-width: 0; }\n.claim { border-left: 4px solid var(--hand); padding-left: 14px; font-size: 1.05rem; }\n.two { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 20px; align-items: center; }\n@media (max-width: 680px) { .two { grid-template-columns: 1fr; } }\nsvg { display: block; width: 100%; height: auto; }\n.readout { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; font: .92rem var(--f-mono); }\n.readout dt { color: var(--muted); } .readout dd { margin: 0; }\n.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\nbutton { font: 600 .85rem var(--f-mono); padding: 6px 12px; border: 1px solid var(--rule); border-radius: 4px; background: var(--bg); color: var(--ink); cursor: pointer; }\nbutton[aria-pressed="true"] { border-color: var(--hand); color: var(--hand); }\nbutton:focus-visible, input:focus-visible { outline: 2px solid var(--hand); outline-offset: 2px; }\ninput[type=range] { flex: 1 1 220px; accent-color: var(--hand); min-width: 0; }\n.strip { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }\n.cycle { border: 1px solid var(--rule); border-radius: 6px; padding: 8px 4px; text-align: center; font: .85rem var(--f-mono); }\n.cycle b { display: block; font-size: 1.3rem; }\n.cycle.now { border-color: var(--hand); }\n.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: .88rem; color: var(--muted); }\n.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }\n.table-wrap { overflow-x: auto; }\ntable { border-collapse: collapse; font: .9rem var(--f-mono); font-variant-numeric: tabular-nums; width: 100%; }\nth, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--rule); vertical-align: top; }\nth { color: var(--muted); font-weight: 600; }\ntd.five { color: var(--five); font-weight: 700; }\n.pred { display: grid; grid-template-columns: 2.6rem 1fr auto; gap: 4px 12px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--rule); }\n.pred .id { font: 700 .9rem var(--f-mono); }\n.pred .got { font: .82rem var(--f-mono); color: var(--muted); grid-column: 2 / 4; }\n.mark { font: 700 .85rem var(--f-mono); }\n.mark.ok { color: var(--ok); } .mark.bad { color: var(--bad); }\nfooter { font-size: .88rem; color: var(--muted); display: grid; gap: 6px; border-top: 1px solid var(--rule); padding-top: 16px; }\n@media (prefers-reduced-motion: reduce) { .anim { transition: none !important; } }\n</style>\n</head>\n<body>\n<div class="wrap">\n\n<header style="display:grid;gap:10px">\n  <div class="eyebrow">omi-axioms · I-230 · tag 6E · a visual proof</div>\n  <h1>The sonar's 75 is the 60-in-64 dial with five blocks</h1>\n  <p class="claim">In unbound's <em>Atomic Incidence Surface</em>, <code>SONAR_PERIOD = 75</code> (its comment: <em>5 channels × 15 lanes</em>). It does not divide the 5,040-tick master clock. Each master cycle it starts one channel later, and after five cycles, <b>25,200 = 7 × 3 × 5 × 240</b> ticks, everything closes. The reason is one extra 5.</p>\n  <p class="muted">Every number on this page is computed here, live, by the same checks as <code>js/catalog/I-230.ts</code>. The eight predictions below were written before the checks first ran.</p>\n</header>\n\n<section>\n  <h2>1. One dial: blocks of 16, fifteen carry time</h2>\n  <p>Your <em>60-in-64 Clock</em>: 64 slots, 60 for time and 4 held back. At 256 slots, 240 and 16. The sonar is the same dial with five blocks: 80 slots, 75 for time, 5 held back.</p>\n  <div class="panel two">\n    <svg id="dial" viewBox="-160 -160 320 320" role="img" aria-label="The sonar dial: five blocks of sixteen slots, fifteen carrying time, with the sonar hand"></svg>\n    <div style="display:grid;gap:12px">\n      <div class="controls">\n        <button type="button" id="b75" aria-pressed="true">5 channels · 75</button>\n        <button type="button" id="b60" aria-pressed="false">4 channels · 60</button>\n      </div>\n      <dl class="readout" aria-live="polite">\n        <dt>tick</dt><dd id="r-tick"></dd>\n        <dt>master cycle</dt><dd id="r-cycle"></dd>\n        <dt>tick mod 5040</dt><dd id="r-mod"></dd>\n        <dt>sonar phase</dt><dd id="r-phase"></dd>\n        <dt>channel · lane</dt><dd id="r-cl"></dd>\n        <dt>closes after</dt><dd id="r-close"></dd>\n      </dl>\n      <div class="controls">\n        <button type="button" id="play">Play</button>\n        <button type="button" id="jump">Next master cycle</button>\n        <input type="range" id="scrub" min="0" max="25199" step="1" value="0" aria-label="Tick">\n      </div>\n      <div class="legend"><span><i style="background:var(--time)"></i>slot that carries time</span><span><i style="background:var(--held)"></i>slot held back</span><span><i style="background:var(--hand)"></i>the sonar</span></div>\n    </div>\n  </div>\n</section>\n\n<section>\n  <h2>2. The precession</h2>\n  <p>5040 mod 75 = 15, exactly one channel. So the first tick of each master cycle finds the sonar one channel further on. Switch to the 60 above and every cycle starts on channel 0, because 5040 = 84 × 60.</p>\n  <div class="panel">\n    <div class="strip" id="strip"></div>\n    <p class="muted mono" id="strip-note"></p>\n  </div>\n</section>\n\n<section>\n  <h2>3. Why: count the fives</h2>\n  <div class="panel">\n    <div class="table-wrap"><table id="factors"></table></div>\n    <p>Each block of 15 lanes already carries one 5. Four channels keep one 5 (60), and 7! = 5040 has one 5, so the 60 closes. Five channels bring a second 5 (75 = 3 × 5²), which 5040 cannot absorb. The closure has to take the 5 in once more: 25,200 = 5 × 5040. The whole 80-slot dial closes (5040 = 63 × 80); only the 75 that carry time do not.</p>\n  </div>\n</section>\n\n<section>\n  <h2>4. The eight predictions, checked now</h2>\n  <div class="panel" id="preds"></div>\n</section>\n\n<section>\n  <h2>5. On the year axis</h2>\n  <p>With the astronomical year index as the tick (<code>_CODE/U/10100</code>, <code>10101</code>, <code>10102</code> are −1, 0, +1):</p>\n  <div class="panel"><div class="table-wrap"><table id="years"></table></div>\n    <p class="muted">Every period resets at index 0, because every count starts there. What belongs to 75 is that AD 525, Dionysius' year, shares the reset: 525 = 7 × 75, the Fano period against the sonar, and the <code>% 525</code> in the component.</p></div>\n</section>\n\n<footer>\n  <p>Proof: omi-axioms <code>js/catalog/I-230.ts</code> (commit aae9768, merged cbac392), tag 6E, 117 records holding. Claim: ZIGUAROTH <code>_ARTICLES/SONAR/sonar.mime</code>. Sources: unbound <code>TSX/src/templates/Atomic Incidence Surface.tsx</code>; boxed <code>_archive/The 60-in-64 Clock.md</code>.</p>\n  <p>What is proved is arithmetic. That the fifth channel is the hidden 5 of 5!, a time zone, or the 6000 years is the author's reading, held open.</p>\n</footer>\n</div>\n\n<script>\n"use strict";\nconst MASTER = 5040, LANES = 15, SLOTS = 16;\nconst gcd = (a, b) => (b ? gcd(b, a % b) : a);\nconst lcm = (a, b) => (a / gcd(a, b)) * b;\nconst fives = (n) => { let k = 0; while (n && n % 5 === 0) { n /= 5; k++; } return k; };\nconst factor = (n) => { const out = []; for (let p = 2; n > 1; p++) { let k = 0; while (n % p === 0) { n /= p; k++; } if (k) out.push([p, k]); } return out; };\nconst css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();\nconst NS = "http://www.w3.org/2000/svg";\nconst el = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); parent && parent.appendChild(e); return e; };\n\nlet channels = 5, tick = 0, timer = null;\nconst sonar = () => channels * LANES;\n\n// ── the dial ──\nconst dial = document.getElementById("dial");\nlet slotEls = [], hand;\nfunction drawDial() {\n  dial.replaceChildren();\n  const n = channels * SLOTS, R = 130, r = 104;\n  slotEls = [];\n  for (let s = 0; s < n; s++) {\n    const a0 = (s / n) * 2 * Math.PI - Math.PI / 2, a1 = ((s + 0.86) / n) * 2 * Math.PI - Math.PI / 2;\n    const p = (rad, a) => `${(rad * Math.cos(a)).toFixed(2)} ${(rad * Math.sin(a)).toFixed(2)}`;\n    const held = s % SLOTS === SLOTS - 1;\n    slotEls.push(el("path", { d: `M ${p(r, a0)} L ${p(R, a0)} A ${R} ${R} 0 0 1 ${p(R, a1)} L ${p(r, a1)} A ${r} ${r} 0 0 0 ${p(r, a0)} Z`, fill: css(held ? "--held" : "--time"), opacity: held ? 1 : .35 }, dial));\n  }\n  for (let c = 0; c < channels; c++) {\n    const a = ((c * SLOTS + 7.5) / n) * 2 * Math.PI - Math.PI / 2;\n    el("text", { x: (146 * Math.cos(a)).toFixed(1), y: (146 * Math.sin(a)).toFixed(1), "text-anchor": "middle", "dominant-baseline": "central", fill: css("--muted"), "font-size": "11", "font-family": "ui-monospace, monospace" }, dial).textContent = "ch " + c;\n  }\n  el("circle", { r: 96, fill: "none", stroke: css("--rule") }, dial);\n  hand = el("line", { x1: 0, y1: 0, x2: 0, y2: -100, stroke: css("--hand"), "stroke-width": 3, "stroke-linecap": "round" }, dial);\n  el("circle", { r: 4, fill: css("--hand") }, dial);\n  const t1 = el("text", { y: -8, "text-anchor": "middle", fill: css("--ink"), "font-size": "22", "font-weight": "700", "font-family": "ui-monospace, monospace" }, dial);\n  t1.id = "center1";\n  const t2 = el("text", { y: 16, "text-anchor": "middle", fill: css("--muted"), "font-size": "11", "font-family": "ui-monospace, monospace" }, dial);\n  t2.id = "center2";\n}\n\nfunction render() {\n  const P = sonar(), phase = tick % P, ch = Math.floor(phase / LANES), lane = phase % LANES, slot = ch * SLOTS + lane, n = channels * SLOTS;\n  slotEls.forEach((e, s) => { if (s % SLOTS !== SLOTS - 1) e.setAttribute("opacity", s === slot ? 1 : .35); });\n  const a = ((slot + 0.43) / n) * 360;\n  hand.setAttribute("transform", `rotate(${a.toFixed(2)})`);\n  document.getElementById("center1").textContent = P;\n  document.getElementById("center2").textContent = `${channels} × 15 of ${channels} × 16`;\n  const L = lcm(MASTER, P);\n  document.getElementById("r-tick").textContent = tick.toLocaleString("en-US");\n  document.getElementById("r-cycle").textContent = Math.floor(tick / MASTER);\n  document.getElementById("r-mod").textContent = tick % MASTER;\n  document.getElementById("r-phase").textContent = `${phase} of ${P}`;\n  document.getElementById("r-cl").textContent = `${ch} · ${lane}`;\n  document.getElementById("r-close").textContent = `lcm(5040, ${P}) = ${L.toLocaleString("en-US")} = ${L / MASTER} × 5040`;\n  document.getElementById("scrub").max = L - 1;\n  document.getElementById("scrub").value = tick;\n  // precession strip\n  const strip = document.getElementById("strip"), cyc = Math.floor(tick / MASTER);\n  strip.replaceChildren(...[0, 1, 2, 3, 4, 5].map((k) => {\n    const d = document.createElement("div");\n    d.className = "cycle" + (k === cyc % 6 ? " now" : "");\n    d.innerHTML = `cycle ${k}<b>ch ${Math.floor(((k * MASTER) % P) / LANES)}</b>phase ${(k * MASTER) % P}`;\n    return d;\n  }));\n  document.getElementById("strip-note").textContent = P === 75\n    ? "start channels 0 1 2 3 4 0: one channel per master cycle, back to 0 after five (25,200 ticks)"\n    : "start channel 0 every cycle: 60 divides 5040, so the sonar never drifts";\n}\n\nfunction setChannels(c) {\n  channels = c; tick = tick % lcm(MASTER, sonar());\n  document.getElementById("b75").setAttribute("aria-pressed", c === 5);\n  document.getElementById("b60").setAttribute("aria-pressed", c === 4);\n  drawDial(); render();\n}\ndocument.getElementById("b75").onclick = () => setChannels(5);\ndocument.getElementById("b60").onclick = () => setChannels(4);\ndocument.getElementById("scrub").oninput = (e) => { stop(); tick = +e.target.value; render(); };\ndocument.getElementById("jump").onclick = () => { stop(); tick = (Math.floor(tick / MASTER) + 1) * MASTER % lcm(MASTER, sonar()); render(); };\nconst playBtn = document.getElementById("play");\nfunction stop() { clearInterval(timer); timer = null; playBtn.textContent = "Play"; }\nplayBtn.onclick = () => {\n  if (timer) return stop();\n  playBtn.textContent = "Pause";\n  timer = setInterval(() => { tick = (tick + 1) % lcm(MASTER, sonar()); render(); }, 60);\n};\n\n// ── factors ──\nconst fmt = (n) => factor(n).map(([p, k]) => (p === 5 ? `<span style="color:var(--five);font-weight:700">5${k > 1 ? "^" + k : ""}</span>` : p + (k > 1 ? "^" + k : ""))).join(" × ");\ndocument.getElementById("factors").innerHTML = `<thead><tr><th>number</th><th>what it is</th><th>prime factors</th><th>fives</th></tr></thead><tbody>` +\n  [[15, "lanes in a channel"], [60, "four channels"], [75, "five channels (the sonar)"], [80, "the whole five-block dial"], [5040, "7!, the master clock"], [25200, "the closure, lcm(5040, 75)"]]\n    .map(([n, w]) => `<tr><td>${n.toLocaleString("en-US")}</td><td>${w}</td><td>${fmt(n)}</td><td class="${fives(n) > 1 ? "five" : ""}">${fives(n)}</td></tr>`).join("") + `</tbody>`;\n\n// ── the eight predictions, run live ──\nconst pow2 = (n) => (n & (n - 1)) === 0;\nconst startCh = (k) => Math.floor(((k * MASTER) % 75) / LANES);\nconst visits = [0, 0, 0, 0, 0]; for (let t = 0; t < 25200; t++) visits[Math.floor((t % 75) / LANES)]++;\nconst P = [\n  ["P1", "60, 240 and 75 are one dial: blocks of 16 slots with 15 carrying time, in 4, 16 and 5 blocks",\n    () => [4 * 15 === 60 && 16 * 15 === 240 && 5 * 15 === 75 && 64 - 60 === 4 && 256 - 240 === 16 && 80 - 75 === 5, "60 = 4×15 of 64 · 240 = 16×15 of 256 · 75 = 5×15 of 80"]],\n  ["P2", "60 closes on the 5040 clock; 75 does not, and 5040 mod 75 = 15, one channel",\n    () => [MASTER % 60 === 0 && MASTER % 75 === 15, `5040 mod 60 = ${MASTER % 60} · 5040 mod 75 = ${MASTER % 75}`]],\n  ["P3", "each master cycle starts the sonar one channel later: 0 1 2 3 4, then 0",\n    () => { const s = [0, 1, 2, 3, 4, 5].map(startCh); return [s.join() === "0,1,2,3,4,0" && visits.every((v) => v === visits[0]), `start channels ${s.join(" ")} · ticks per channel over 25,200: ${visits.join(", ")}`]; }],\n  ["P4", "it closes at 25,200 = 5 × 5040 = 7 × 3 × 5 × 240, a 5-part counter added to 7 × 3 × 240",\n    () => [lcm(MASTER, 75) === 25200 && 5 * MASTER === 25200 && 7 * 3 * 5 * 240 === 25200 && 7 * 3 * 240 === MASTER, `lcm(5040, 75) = ${lcm(MASTER, 75)}`]],\n  ["P5", "the reason is the 5: 75 = 3 × 5² against 7!'s single 5, while the whole 80-slot dial closes",\n    () => [fives(75) === 2 && fives(MASTER) === 1 && fives(60) === 1 && MASTER % 80 === 0, `fives: 75 → ${fives(75)}, 5040 → ${fives(MASTER)}, 60 → ${fives(60)} · 5040 mod 80 = ${MASTER % 80}`]],\n  ["P6", "only the five-block dial is not a power of two: 64 and 256, but 80",\n    () => [pow2(64) && pow2(256) && !pow2(80), "64 = 2^6 · 256 = 2^8 · 80 = 5 × 2^4"]],\n  ["P7", "525 = lcm(7, 75) = 7 × 75, the Fano period against the sonar",\n    () => [lcm(7, 75) === 525 && 7 * 75 === 525, `lcm(7, 75) = ${lcm(7, 75)}`]],\n  ["P8", "25,200 closes the 4-, 28- and 400-year calendar cycles, and not the 19-year one",\n    () => [[4, 28, 400].every((y) => 25200 % y === 0) && 25200 % 19 !== 0, `25,200 ÷ 4, 28, 400 = ${25200 / 4}, ${25200 / 28}, ${25200 / 400} · ÷ 19 = ${(25200 / 19).toFixed(2)}`]],\n];\ndocument.getElementById("preds").innerHTML = P.map(([id, text, f]) => {\n  const [ok, got] = f();\n  return `<div class="pred"><span class="id">${id}</span><span>${text}</span><span class="mark ${ok ? "ok" : "bad"}">${ok ? "holds" : "FAILS"}</span><span class="got">${got}</span></div>`;\n}).join("") + `<p class="muted" style="margin-top:8px">${P.every(([, , f]) => f()[0]) ? "All eight hold." : "A prediction failed."}</p>`;\n\n// ── the year axis ──\nconst years = [["2 BC", -1, "_CODE/U/10100"], ["1 BC", 0, "_CODE/U/10101"], ["AD 1", 1, "_CODE/U/10102"], ["AD 525", 525, "Dionysius"], ["AD 2026", 2026, "this year"], ["AD 2239", 2239, "Hebrew AM 6000 begins"]];\nconst mod = (a, m) => ((a % m) + m) % m;\ndocument.getElementById("years").innerHTML = `<thead><tr><th>year</th><th>index</th><th>where</th><th>phase of 75</th><th>channel · lane</th></tr></thead><tbody>` +\n  years.map(([y, i, w]) => { const p = mod(i, 75); return `<tr><td>${y}</td><td>${i}</td><td>${w}</td><td>${p}${p === 0 ? " · reset" : ""}</td><td>${Math.floor(p / 15)} · ${p % 15}</td></tr>`; }).join("") + `</tbody>`;\n\nmatchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { drawDial(); render(); });\ndrawDial(); render();\n</script>\n</body>\n</html>\n
      OPEN
    OPEN
  OPEN
