DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n  
    STARTTAG <meta charset="UTF-8">
    TEXT \n  
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n  
    STARTTAG <title>
      RAWTEXT Semantic Universe\n  <style>\n    body { \n      margin: 0; \n      font-family: Arial, sans-serif;\n      overflow: hidden;\n    }\n    canvas { \n      display: block; \n      position: fixed;\n      top: 0;\n      left: 0;\n    }\n    .controls {\n      position: fixed;\n      top: 20px;\n      left: 20px;\n      background: rgba(0,0,0,0.7);\n      padding: 15px;\n      border-radius: 8px;\n      color: white;\n      z-index: 100;\n      max-width: 600px;\n    }\n    .form-group {\n      margin-bottom: 15px;\n    }\n    label {\n      display: block;\n      margin-bottom: 5px;\n    }\n    input, textarea, select, button {\n      width: 100%;\n      padding: 8px;\n      margin-bottom: 10px;\n      border-radius: 4px;\n      border: 1px solid #444;\n      background: #333;\n      color: white;\n    }\n    button {\n      background: #4CAF50;\n      border: none;\n      cursor: pointer;\n      transition: background 0.3s;\n    }\n    button:hover {\n      background: #45a049;\n    }\n    .forms-container {\n      display: flex;\n      gap: 20px;\n    }\n    .form-section {\n      flex: 1;\n    }\n    h3 {\n      margin-top: 0;\n      color: #4CAF50;\n    }\n    .word-list {\n      max-height: 150px;\n      overflow-y: auto;\n      margin-top: 15px;\n      padding: 5px;\n      background: rgba(0,0,0,0.3);\n      border-radius: 4px;\n    }\n    .word-item {\n      padding: 5px;\n      margin-bottom: 3px;\n      background: rgba(255,255,255,0.1);\n      border-radius: 3px;\n    }\n  </style>\n</head>\n<body>\n  <div class="controls">\n    <div class="forms-container">\n      <div class="form-section">\n        <h3>Add Word-Definition Pair</h3>\n        <div class="form-group">\n          <label for="word">Word:</label>\n          <input type="text" id="word" placeholder="Enter word">\n        </div>\n        <div class="form-group">\n          <label for="definition">Definition:</label>\n          <textarea id="definition" rows="3" placeholder="Enter definition"></textarea>\n        </div>\n        <div class="form-group">\n          <label for="pos">Part of Speech:</label>\n          <select id="pos">\n            <option value="noun">Noun</option>\n            <option value="verb">Verb</option>\n            <option value="adjective">Adjective</option>\n            <option value="pronoun">Pronoun</option>\n            <option value="other">Other</option>\n          </select>\n        </div>\n        <button id="addWordBtn">Add Word Point</button>\n        \n        <div class="word-list" id="wordList">\n          <!-- Word list will be populated here -->\n        </div>\n      </div>\n\n      <div class="form-section">\n        <h3>Create Sentence Tetrahedron</h3>\n        <div class="form-group">\n          <label for="noun">Noun:</label>\n          <select id="noun"></select>\n        </div>\n        <div class="form-group">\n          <label for="verb">Verb:</label>\n          <select id="verb"></select>\n        </div>\n        <div class="form-group">\n          <label for="adjective">Adjective:</label>\n          <select id="adjective"></select>\n        </div>\n        <div class="form-group">\n          <label for="pronoun">Pronoun:</label>\n          <select id="pronoun"></select>\n        </div>\n        <button id="createSentenceBtn">Create Sentence</button>\n        \n        <div class="form-group">\n          <label for="sentence-display">Generated Sentence:</label>\n          <div id="sentence-display" style="background: #222; padding: 10px; border-radius: 4px; min-height: 20px;"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script type="module">\n    import * as THREE from 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js';\n    import { OrbitControls } from 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/examples/jsm/controls/OrbitControls.js';\n\n    // Define the LanguageTetrahedron class\n    class LanguageTetrahedron {\n      static getResonance(word, def) {\n        const wordHash = this.stringToHash(word);\n        const defHash = this.stringToHash(def);\n        return Math.abs(Math.cos((wordHash - defHash) % 1000));\n      }\n\n      static getWordVector(word, def, time) {\n        const c = this.getResonance(word, def);\n        const phase = c * (time % 628) / 100;\n        const radius = 5 + (c * 2); // Base radius plus a factor of resonance\n        return {\n          x: radius * Math.sin(phase),\n          y: radius * Math.sin(phase + 2.094),\n          z: radius * Math.sin(phase + 4.188),\n          t: time,\n          c: c\n        };\n      }\n\n      static getCentroid(points) {\n        const sum = points.reduce((acc, p) => ({\n          x: acc.x + p.x,\n          y: acc.y + p.y,\n          z: acc.z + p.z,\n          t: acc.t + p.t,\n          c: acc.c + p.c\n        }), {x: 0, y: 0, z: 0, t: 0, c: 0});\n\n        return {\n          x: sum.x / points.length,\n          y: sum.y / points.length,\n          z: sum.z / points.length,\n          t: sum.t,\n          c: sum.c / points.length\n        };\n      }\n\n      static buildSentenceTetrahedron(words, defs, time) {\n        if (words.length !== 4 || defs.length !== 4) {\n          throw new Error("Exactly 4 words and definitions required");\n        }\n\n        const vertices = words.map((w, i) => \n          this.getWordVector(w, defs[i], time));\n        \n        const centroid = this.getCentroid(vertices);\n        const frequency = Math.sqrt(\n          vertices.reduce((sum, v) => sum + Math.pow(v.c - centroid.c, 2), 0) / vertices.length\n        );\n\n        return { vertices, centroid, frequency };\n      }\n\n      static stringToHash(str) {\n        let hash = 0;\n        for (let i = 0; i < str.length; i++) {\n          hash = ((hash << 5) - hash) + str.charCodeAt(i);\n          hash |= 0;\n        }\n        return Math.abs(hash) / 2147483647; // Normalize between 0 and 1\n      }\n    }\n\n    class SemanticUniverse {\n      constructor() {\n        this.words = [];\n        this.sentences = [];\n        this.wordDefMap = new Map();\n        this.posMap = new Map(); // Map words to their part of speech\n        this.clock = new THREE.Clock();\n        this.elapsedTime = 0;\n        \n        this.initThree();\n        this.initUI();\n        this.animate();\n      }\n\n      initThree() {\n        this.scene = new THREE.Scene();\n        this.scene.background = new THREE.Color(0x050510);\n        \n        this.camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);\n        this.camera.position.z = 15;\n\n        this.renderer = new THREE.WebGLRenderer({ antialias: true });\n        this.renderer.setSize(window.innerWidth, window.innerHeight);\n        this.renderer.setPixelRatio(window.devicePixelRatio);\n        document.body.appendChild(this.renderer.domElement);\n\n        this.controls = new OrbitControls(this.camera, this.renderer.domElement);\n        this.controls.enableDamping = true;\n\n        // Add lights\n        const light = new THREE.PointLight(0xffffff, 1, 100);\n        light.position.set(0, 10, 10);\n        this.scene.add(light);\n        this.scene.add(new THREE.AmbientLight(0x404040));\n\n        // Add grid helper\n        const gridHelper = new THREE.GridHelper(20, 20, 0x444444, 0x222222);\n        this.scene.add(gridHelper);\n        \n        // Handle window resize\n        window.addEventListener('resize', () => {\n          this.camera.aspect = window.innerWidth / window.innerHeight;\n          this.camera.updateProjectionMatrix();\n          this.renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n      }\n\n      initUI() {\n        // Word-Definition Form\n        document.getElementById('addWordBtn').addEventListener('click', () => {\n          const word = document.getElementById('word').value.trim();\n          const definition = document.getElementById('definition').value.trim();\n          const pos = document.getElementById('pos').value;\n          \n          if (word && definition) {\n            this.addWordDefinition(word, definition, pos);\n            document.getElementById('word').value = '';\n            document.getElementById('definition').value = '';\n            this.updateWordLists();\n            this.updateWordSelects();\n          }\n        });\n\n        // Sentence Form\n        document.getElementById('createSentenceBtn').addEventListener('click', () => {\n          const noun = document.getElementById('noun').value;\n          const verb = document.getElementById('verb').value;\n          const adjective = document.getElementById('adjective').value;\n          const pronoun = document.getElementById('pronoun').value;\n          \n          if (noun && verb && adjective && pronoun) {\n            const sentence = `${pronoun} ${adjective} ${noun} ${verb}`;\n            document.getElementById('sentence-display').textContent = sentence;\n            this.createSentenceTetrahedron([noun, verb, adjective, pronoun]);\n          }\n        });\n      }\n\n      updateWordLists() {\n        const wordList = document.getElementById('wordList');\n        wordList.innerHTML = '';\n        \n        this.wordDefMap.forEach((def, word) => {\n          const pos = this.posMap.get(word);\n          const wordItem = document.createElement('div');\n          wordItem.className = 'word-item';\n          wordItem.textContent = `${word} (${pos}): ${def.substring(0, 30)}${def.length > 30 ? '...' : ''}`;\n          wordList.appendChild(wordItem);\n        });\n      }\n\n      updateWordSelects() {\n        // Update noun select\n        this.updateSelect('noun', 'noun');\n        \n        // Update verb select\n        this.updateSelect('verb', 'verb');\n        \n        // Update adjective select\n        this.updateSelect('adjective', 'adjective');\n        \n        // Update pronoun select\n        this.updateSelect('pronoun', 'pronoun');\n      }\n\n      updateSelect(selectId, pos) {\n        const select = document.getElementById(selectId);\n        select.innerHTML = '';\n        \n        // Add empty option\n        const emptyOption = document.createElement('option');\n        emptyOption.value = '';\n        emptyOption.textContent = `Select ${pos}`;\n        select.appendChild(emptyOption);\n        \n        // Add words of the specific part of speech\n        this.wordDefMap.forEach((def, word) => {\n          const wordPos = this.posMap.get(word);\n          if (wordPos === pos || pos === 'other') {\n            const option = document.createElement('option');\n            option.value = word;\n            option.textContent = word;\n            select.appendChild(option);\n          }\n        });\n      }\n\n      addWordDefinition(word, definition, pos) {\n        if (this.wordDefMap.has(word)) return;\n\n        this.wordDefMap.set(word, definition);\n        this.posMap.set(word, pos);\n        const particle = this.createSemanticParticle(word, definition);\n        this.words.push(particle);\n        this.scene.add(particle.mesh);\n        this.scene.add(particle.text);\n      }\n\n      createSemanticParticle(word, definition) {\n        const pos = this.posMap.get(word);\n        const hue = this.getHueForPOS(pos);\n        const geometry = new THREE.SphereGeometry(0.2, 16, 16);\n        const material = new THREE.MeshPhongMaterial({ \n          color: new THREE.Color().setHSL(hue, 0.8, 0.5),\n          emissive: new THREE.Color().setHSL(hue, 0.9, 0.2)\n        });\n        const mesh = new THREE.Mesh(geometry, material);\n        \n        const vector = LanguageTetrahedron.getWordVector(word, definition, 0);\n        mesh.position.set(vector.x, vector.y, vector.z);\n        \n        // Add text label\n        const text = this.createTextLabel(word, mesh.position, pos);\n        \n        return {\n          mesh,\n          text,\n          word,\n          definition,\n          pos,\n          velocity: new THREE.Vector3(),\n          frequency: vector.c,\n          basePosition: new THREE.Vector3(vector.x, vector.y, vector.z)\n        };\n      }\n\n      getHueForPOS(pos) {\n        // Define distinct colors for each part of speech\n        switch(pos) {\n          case 'noun': return 0.1; // Green-yellow\n          case 'verb': return 0.6; // Blue\n          case 'adjective': return 0.9; // Purple\n          case 'pronoun': return 0.3; // Orange\n          default: return 0.0; // Red\n        }\n      }\n\n      createTextLabel(word, position, pos) {\n        const canvas = document.createElement('canvas');\n        canvas.width = 256;\n        canvas.height = 128;\n        const context = canvas.getContext('2d');\n        context.fillStyle = 'rgba(0, 0, 0, 0.7)';\n        context.fillRect(0, 0, canvas.width, canvas.height);\n        context.font = 'Bold 40px Arial';\n        context.textAlign = 'center';\n        context.fillStyle = 'white';\n        context.fillText(word, canvas.width/2, canvas.height/2 + 15);\n        context.font = 'italic 20px Arial';\n        context.fillText(`(${pos})`, canvas.width/2, canvas.height/2 + 45);\n        \n        const texture = new THREE.CanvasTexture(canvas);\n        const material = new THREE.SpriteMaterial({ map: texture });\n        const sprite = new THREE.Sprite(material);\n        sprite.position.copy(position);\n        sprite.position.y += 0.5;\n        sprite.scale.set(1.5, 0.75, 1);\n        return sprite;\n      }\n\n      createSentenceTetrahedron(words) {\n        const definitions = words.map(word => this.wordDefMap.get(word));\n        const tetra = LanguageTetrahedron.buildSentenceTetrahedron(words, definitions, this.elapsedTime);\n\n        // Create tetrahedron geometry\n        const tetraSize = Math.max(1, tetra.frequency * 3);\n        const geometry = new THREE.TetrahedronGeometry(tetraSize);\n        \n        // Create material with opacity\n        const material = new THREE.MeshPhongMaterial({\n          color: 0x00ff99,\n          transparent: true,\n          opacity: 0.3,\n          wireframe: false\n        });\n        \n        const tetraMesh = new THREE.Mesh(geometry, material);\n        tetraMesh.position.set(tetra.centroid.x, tetra.centroid.y, tetra.centroid.z);\n        \n        // Create wireframe edges\n        const edges = new THREE.EdgesGeometry(geometry);\n        const line = new THREE.LineSegments(\n          edges,\n          new THREE.LineBasicMaterial({ color: 0x00ff99, linewidth: 2 })\n        );\n        line.position.copy(tetraMesh.position);\n        \n        // Create centroid force indicator\n        const centroidSphere = new THREE.Mesh(\n          new THREE.SphereGeometry(0.2, 16, 16),\n          new THREE.MeshBasicMaterial({ color: 0xff3300 })\n        );\n        centroidSphere.position.copy(tetraMesh.position);\n        \n        // Create connections to word points\n        const wordPoints = [];\n        const connections = [];\n        \n        for (let word of words) {\n          const wordObj = this.words.find(w => w.word === word);\n          if (wordObj) {\n            wordPoints.push(wordObj.mesh.position);\n            \n            const lineMaterial = new THREE.LineBasicMaterial({ \n              color: 0xffff00,\n              transparent: true,\n              opacity: 0.4\n            });\n            \n            const lineGeometry = new THREE.BufferGeometry().setFromPoints([\n              new THREE.Vector3(tetraMesh.position.x, tetraMesh.position.y, tetraMesh.position.z),\n              new THREE.Vector3(wordObj.mesh.position.x, wordObj.mesh.position.y, wordObj.mesh.position.z)\n            ]);\n            \n            const connection = new THREE.Line(lineGeometry, lineMaterial);\n            connections.push(connection);\n            this.scene.add(connection);\n          }\n        }\n        \n        // Add everything to the scene\n        this.scene.add(tetraMesh);\n        this.scene.add(line);\n        this.scene.add(centroidSphere);\n        \n        // Store the sentence object\n        this.sentences.push({\n          mesh: tetraMesh,\n          wireframe: line,\n          centroid: centroidSphere,\n          words: words,\n          definitions: definitions,\n          connections: connections,\n          frequency: tetra.frequency,\n          phase: 0\n        });\n      }\n\n      animate() {\n        requestAnimationFrame(this.animate.bind(this));\n        \n        const delta = this.clock.getDelta();\n        this.elapsedTime += delta;\n        \n        // Update word particles\n        this.words.forEach(word => {\n          const time = this.elapsedTime * word.frequency * 0.5;\n          const vector = LanguageTetrahedron.getWordVector(word.word, word.definition, time);\n          \n          word.mesh.position.x = vector.x;\n          word.mesh.position.y = vector.y;\n          word.mesh.position.z = vector.z;\n          \n          // Update text position\n          word.text.position.copy(word.mesh.position);\n          word.text.position.y += 0.5;\n        });\n        \n        // Update sentence tetrahedra\n        this.sentences.forEach(sentence => {\n          sentence.phase += delta * sentence.frequency;\n          \n          // Animate the tetrahedron\n          sentence.mesh.rotation.x = Math.sin(sentence.phase * 0.5) * 0.2;\n          sentence.mesh.rotation.y = sentence.phase * 0.3;\n          sentence.wireframe.rotation.copy(sentence.mesh.rotation);\n          \n          // Pulse the size slightly\n          const scale = 1 + Math.sin(sentence.phase * 2) * 0.1;\n          sentence.mesh.scale.set(scale, scale, scale);\n          sentence.wireframe.scale.copy(sentence.mesh.scale);\n          \n          // Update connections\n          sentence.connections.forEach((connection, i) => {\n            const wordObj = this.words.find(w => w.word === sentence.words[i]);\n            if (wordObj) {\n              const points = [\n                sentence.centroid.position,\n                wordObj.mesh.position\n              ];\n              \n              connection.geometry.dispose();\n              connection.geometry = new THREE.BufferGeometry().setFromPoints(points);\n            }\n          });\n        });\n        \n        this.controls.update();\n        this.renderer.render(this.scene, this.camera);\n      }\n    }\n\n    // Initialize the application\n    const app = new SemanticUniverse();\n    \n    // Add some example words to start with\n    setTimeout(() => {\n      app.addWordDefinition("cat", "A small domesticated carnivorous mammal", "noun");\n      app.addWordDefinition("run", "To move at a speed faster than walking", "verb");\n      app.addWordDefinition("happy", "Feeling or showing pleasure or contentment", "adjective");\n      app.addWordDefinition("they", "Used to refer to two or more people or things", "pronoun");\n      app.addWordDefinition("dog", "A domesticated carnivorous mammal", "noun");\n      app.addWordDefinition("jump", "To push oneself off a surface and into the air", "verb");\n      app.addWordDefinition("beautiful", "Pleasing the senses or mind aesthetically", "adjective");\n      app.addWordDefinition("she", "Used to refer to a female person or animal", "pronoun");\n      \n      app.updateWordLists();\n      app.updateWordSelects();\n    }, 500);\n  </script>\n</body>\n</html>
