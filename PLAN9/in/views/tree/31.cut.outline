DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="utf-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1">
    TEXT \n
    STARTTAG <title>
      RAWTEXT OMI-IMO Full DOM Stack — Single File\n<style>\n  :root {\n    --bg: #0d1117;\n    --panel: #161b22;\n    --border: #30363d;\n    --text: #e6edf3;\n    --muted: #8b949e;\n    --accent: #58a6ff;\n    --green: #3fb950;\n    --amber: #d29922;\n    --red: #f85149;\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font: 15px/1.5 system-ui, -apple-system, Segoe UI, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n  }\n  header {\n    padding: 1rem 1.25rem;\n    border-bottom: 1px solid var(--border);\n    background: var(--panel);\n    position: sticky;\n    top: 0;\n    z-index: 10;\n  }\n  header h1 { margin: 0; font-size: 1.15rem; font-weight: 600; }\n  header p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.85rem; }\n  nav {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.4rem;\n    padding: 0.75rem 1.25rem;\n    border-bottom: 1px solid var(--border);\n    background: #0d1117;\n  }\n  nav button {\n    background: var(--panel);\n    border: 1px solid var(--border);\n    color: var(--text);\n    padding: 0.35rem 0.75rem;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.85rem;\n  }\n  nav button:hover, nav button.active {\n    border-color: var(--accent);\n    color: var(--accent);\n  }\n  main { max-width: 56rem; margin: 0 auto; padding: 1.25rem; }\n  section { display: none; }\n  section.active { display: block; }\n  h2 { font-size: 1.1rem; margin: 0 0 0.75rem; }\n  h3 { font-size: 0.95rem; margin: 1rem 0 0.5rem; color: var(--muted); }\n  .card {\n    background: var(--panel);\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    padding: 1rem;\n    margin-bottom: 1rem;\n  }\n  .row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }\n  input, select {\n    background: var(--bg);\n    border: 1px solid var(--border);\n    color: var(--text);\n    padding: 0.4rem 0.6rem;\n    border-radius: 6px;\n    font: inherit;\n  }\n  button.primary {\n    background: #1f6feb;\n    border: 1px solid #1f6feb;\n    color: #fff;\n    padding: 0.4rem 0.9rem;\n    border-radius: 6px;\n    cursor: pointer;\n    font: inherit;\n  }\n  button.primary:hover { filter: brightness(1.1); }\n  pre, code {\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    font-size: 0.8rem;\n  }\n  pre {\n    background: #0d1117;\n    border: 1px solid var(--border);\n    border-radius: 6px;\n    padding: 0.75rem;\n    overflow: auto;\n    white-space: pre-wrap;\n  }\n  .ok { color: var(--green); }\n  .warn { color: var(--amber); }\n  .bad { color: var(--red); }\n  .muted { color: var(--muted); }\n  table { border-collapse: collapse; width: 100%; font-size: 0.85rem; }\n  th, td { border: 1px solid var(--border); padding: 0.4rem 0.55rem; text-align: left; }\n  th { background: #21262d; }\n  .schematic {\n    position: relative;\n    min-height: 260px;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    background: #0d1117;\n  }\n  .node {\n    position: absolute;\n    min-width: 96px;\n    padding: 8px;\n    border: 1px solid #484f58;\n    border-radius: 6px;\n    background: var(--panel);\n    font-size: 0.85rem;\n  }\n  .node.active { outline: 2px solid var(--accent); }\n  .node strong { display: block; }\n  .node small { color: var(--muted); }\n  .leds { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 0.5rem; }\n  .led {\n    width: 14px; height: 14px; border-radius: 50%;\n    background: #21262d; border: 1px solid var(--border);\n  }\n  .led.on { background: var(--green); box-shadow: 0 0 6px var(--green); }\n  .led.centroid.on { background: var(--amber); box-shadow: 0 0 6px var(--amber); }\n  footer {\n    margin-top: 2rem;\n    padding-top: 1rem;\n    border-top: 1px solid var(--border);\n    color: var(--muted);\n    font-size: 0.8rem;\n  }\n</style>\n</head>\n<body>\n<header>\n  <h1>OMI-IMO Full DOM Stack</h1>\n  <p>Single-file offline build · XOR · CAS · circuit walkthrough · spectrum map · fixed point 0x0000</p>\n</header>\n<nav id="nav">\n  <button data-tab="home" class="active">Home</button>\n  <button data-tab="cas">Polytope CAS</button>\n  <button data-tab="circuit">Circuit</button>\n  <button data-tab="spectrum">RF Spectrum</button>\n  <button data-tab="cascade">8/9/10D</button>\n  <button data-tab="status">Status</button>\n</nav>\n<main>\n  <!-- HOME -->\n  <section id="home" class="active">\n    <div class="card">\n      <h2>What this file is</h2>\n      <p>A self-contained HTML snapshot of the <strong>Full DOM Stack</strong> core:</p>\n      <ul>\n        <li><strong>Polytope CAS</strong> — bind / apply / eval / digest (8-bit Δ law)</li>\n        <li><strong>Circuit walkthrough</strong> — VTT-style steps + BusyBox applets</li>\n        <li><strong>RF spectrum map</strong> — CB / MURS / ISM-915 reference (no transmit)</li>\n        <li><strong>8→9→10D cascade</strong> — interference / inference labels</li>\n      </ul>\n      <p class="muted">Node server, WebRTC, and WASM modules are in the full zip project; this file runs entirely in the browser.</p>\n    </div>\n    <div class="card">\n      <h2>Fixed point</h2>\n      <pre>0x0000\n\nEverything reduces to XOR.\nTerminal dual-break = 0x04 (the 4).\nCentroid when eval Δ == 0x04.</pre>\n    </div>\n  </section>\n\n  <!-- CAS -->\n  <section id="cas">\n    <div class="card">\n      <h2>8-Polytope CAS</h2>\n      <p class="muted">atomics.compareExchange · bind → apply → eval → digest</p>\n      <div class="row" style="margin: 0.75rem 0;">\n        <label>Vertex <input id="cas-vertex" type="text" value="0x01" size="8"></label>\n        <label>Carry <input id="cas-carry" type="text" value="0x00" size="8"></label>\n        <button class="primary" id="cas-step">Step</button>\n        <button class="primary" id="cas-reset" style="background:#21262d;border-color:var(--border);">Reset</button>\n      </div>\n      <div class="leds" id="cas-leds" title="Simplex LEDs"></div>\n      <pre id="cas-out">Ready.</pre>\n      <h3>Verification table (carry = 0)</h3>\n      <table>\n        <tr><th>Vertex</th><th>Δ</th></tr>\n        <tr><td>0x01</td><td>0x8A</td></tr>\n        <tr><td>0x02</td><td>0x45</td></tr>\n      </table>\n    </div>\n  </section>\n\n  <!-- CIRCUIT -->\n  <section id="circuit">\n    <div class="card">\n      <h2>Circuit walkthrough</h2>\n      <p class="muted">Simulated spectral build · educational · not a radio transmitter</p>\n      <div class="row">\n        <button class="primary" id="cir-prev">Prev</button>\n        <button class="primary" id="cir-next">Next</button>\n        <button class="primary" id="cir-run">Run applet</button>\n        <span id="cir-status" class="muted"></span>\n      </div>\n      <div class="schematic" id="cir-schematic"></div>\n      <pre id="cir-log"></pre>\n    </div>\n  </section>\n\n  <!-- SPECTRUM -->\n  <section id="spectrum">\n    <div class="card">\n      <h2>Trichromatic RF map (reference only)</h2>\n      <p class="muted">Legal-by-rule US-style ceilings · this page does not transmit</p>\n      <table>\n        <tr><th>Ch</th><th>Band</th><th>Allocation</th><th>Range / channels</th><th>Max power</th><th>Pipeline</th></tr>\n        <tr><td>R</td><td>HF</td><td>CB 95D</td><td>26.965–27.405 MHz</td><td>4 W AM</td><td>Canvas A</td></tr>\n        <tr><td>G</td><td>VHF</td><td>MURS 95J</td><td>151.82 / 88 / 94 · 154.57 / 60</td><td>2 W</td><td>Canvas B</td></tr>\n        <tr><td>B</td><td>UHF</td><td>ISM-915</td><td>902–928 MHz</td><td>1 W</td><td>Canvas C</td></tr>\n      </table>\n      <pre id="spec-json"></pre>\n    </div>\n  </section>\n\n  <!-- CASCADE -->\n  <section id="cascade">\n    <div class="card">\n      <h2>8D / 9D / 10D cascade</h2>\n      <pre>8D base  --inject-->  9D interference  --infer-->  10D inference\n\nInterference9 = Δ9 ⊕ Eval9_old ⊕ 0x004\nInference10   = Δ10 ⊕ Eval10_old ⊕ 0x004\nisometric_lock when both low bytes == 0x04\n\nPractical: 8D on breadboard (74HC86/74HC74);\n9D/10D in software; RF optional for digests.</pre>\n      <button class="primary" id="cas-cascade">Run cascade demo</button>\n      <pre id="cascade-out">—</pre>\n    </div>\n  </section>\n\n  <!-- STATUS -->\n  <section id="status">\n    <div class="card">\n      <h2>Embedded self-checks</h2>\n      <pre id="status-out">Running…</pre>\n    </div>\n    <div class="card">\n      <h2>Full project</h2>\n      <p>For the complete Node stack (server, workers, tests, docs), use the project zip <code>omi-dom-stack-full.zip</code> from the workspace.</p>\n      <pre>unzip omi-dom-stack-full.zip\ncd omi-dom-stack && npm install && node server/server.js\n# http://localhost:8742</pre>\n    </div>\n  </section>\n\n  <footer>\n    OMI-IMO · single HTML · everything is XOR · fixed point 0x0000 · observer is you\n  </footer>\n</main>\n\n<script>\n(function () {\n  'use strict';\n\n  // —— tabs ——\n  const sections = document.querySelectorAll('main > section');\n  document.getElementById('nav').addEventListener('click', (e) => {\n    const btn = e.target.closest('button[data-tab]');\n    if (!btn) return;\n    document.querySelectorAll('nav button').forEach((b) => b.classList.remove('active'));\n    btn.classList.add('active');\n    sections.forEach((s) => s.classList.toggle('active', s.id === btn.dataset.tab));\n  });\n\n  function parseByte(s) {\n    s = String(s).trim();\n    if (/^0x/i.test(s)) return parseInt(s, 16) & 0xff;\n    return (parseInt(s, 10) || 0) & 0xff;\n  }\n  function hex(n, w) {\n    return '0x' + (n & ((1 << (w * 4)) - 1)).toString(16).padStart(w, '0');\n  }\n\n  // —— 8D polytope CAS ——\n  const TERMINAL = 0x04;\n  function apply8(vertex, carry) {\n    const b = vertex & 0xff;\n    const c = (carry == null ? 0 : carry) & 0xff;\n    const s16 =\n      (((b >> 0) & 1) << 1) | (((b >> 1) & 1) << 0) |\n      (((b >> 2) & 1) << 3) | (((b >> 3) & 1) << 2) |\n      (((b >> 4) & 1) << 5) | (((b >> 5) & 1) << 4) |\n      (((b >> 6) & 1) << 7) | (((b >> 7) & 1) << 6);\n    const rev4 = (n) =>\n      ((n & 1) << 3) | ((n & 2) << 1) | ((n & 4) >> 1) | ((n & 8) >> 3);\n    const s32 = ((rev4((b >> 4) & 0xf) << 4) | rev4(b & 0xf)) & 0xff;\n    let s64 = 0, t = b;\n    for (let i = 0; i < 8; i++) { s64 = (s64 << 1) | (t & 1); t >>= 1; }\n    const delta = (s16 ^ s32 ^ s64 ^ c) & 0xff;\n    return { s16: s16 & 0xff, s32, s64: s64 & 0xff, delta };\n  }\n  function parity8(b) {\n    b &= 0xff; b ^= b >> 4; b ^= b >> 2; b ^= b >> 1; return b & 1;\n  }\n  let casState = { bind: 0, eval: 0 };\n  function casStep(v, c) {\n    const applied = apply8(v, c);\n    const oldEval = casState.eval;\n    casState = { bind: v & 0xff, eval: applied.delta };\n    return {\n      bind: casState.bind,\n      apply: applied,\n      eval: casState.eval,\n      oldEval,\n      centroid: applied.delta === TERMINAL\n    };\n  }\n  function renderLeds(bind) {\n    const box = document.getElementById('cas-leds');\n    box.innerHTML = '';\n    const leds = [parity8(bind)];\n    for (let i = 0; i < 8; i++) leds.push((bind >> i) & 1);\n    leds.forEach((on, i) => {\n      const d = document.createElement('div');\n      d.className = 'led' + (on ? ' on' : '') + (i === 0 ? ' centroid' : '');\n      d.title = i === 0 ? 'parity' : 'bit ' + (i - 1);\n      box.appendChild(d);\n    });\n  }\n  document.getElementById('cas-step').onclick = () => {\n    const v = parseByte(document.getElementById('cas-vertex').value);\n    const c = parseByte(document.getElementById('cas-carry').value);\n    const r = casStep(v, c);\n    renderLeds(r.bind);\n    document.getElementById('cas-out').textContent =\n      'bind  ' + hex(r.bind, 2) + '\\n' +\n      's16   ' + hex(r.apply.s16, 2) + '  s32 ' + hex(r.apply.s32, 2) + '  s64 ' + hex(r.apply.s64, 2) + '\\n' +\n      'Δ     ' + hex(r.apply.delta, 2) + (r.centroid ? '  · centroid ON' : '') + '\\n' +\n      'eval  ' + hex(r.eval, 2) + '  (prev ' + hex(r.oldEval, 2) + ')';\n  };\n  document.getElementById('cas-reset').onclick = () => {\n    casState = { bind: 0, eval: 0 };\n    renderLeds(0);\n    document.getElementById('cas-out').textContent = 'Reset.';\n  };\n  renderLeds(0);\n\n  // —— Circuit walkthrough ——\n  const LESSONS = [\n    { id: 'boot', title: 'Boot the bus', applet: 'echo', narrative: '3! streams. No hardware required.', node: { id: 'bus', label: '3! bus' } },\n    { id: 'xor', title: 'Place XOR gate', applet: 'xor', narrative: 'Everything reduces to XOR.', node: { id: 'xor1', label: 'XOR' } },\n    { id: 'fano', title: 'Fano tick (−7D)', applet: 'probe', narrative: 'Phase mod 7 before 8D.', node: { id: 'fano', label: 'Fano −7D' } },\n    { id: 'e8', title: 'E₈ shell (240)', applet: 'connect', narrative: '240 roots ↔ 240-clock.', node: { id: 'e8', label: 'E₈ 240' } },\n    { id: 'obs', title: 'Observer @ 0D', applet: 'probe', narrative: 'Centroid 0x0000.', node: { id: 'obs', label: '0x0000' } },\n    { id: 'wit', title: 'Witness & share', applet: 'digest', narrative: 'Pseudo-persist the schematic.', node: { id: 'wit', label: 'witness' } }\n  ];\n  function runApplet(name) {\n    if (name === 'xor') return { ok: true, out: 0x0f ^ 0xf0 };\n    if (name === 'digest') {\n      let h = 0;\n      const s = LESSONS.map((L) => L.id).join('|');\n      for (let i = 0; i < s.length; i++) h = (h ^ s.charCodeAt(i)) & 0xffff;\n      return { ok: true, out: hex(h, 4) };\n    }\n    if (name === 'echo') return { ok: true, out: 'bus ready' };\n    if (name === 'connect') return { ok: true, out: 'link fano → e8' };\n    return { ok: true, out: { centroid: '0x0000' } };\n  }\n  let step = 0;\n  const schematic = document.getElementById('cir-schematic');\n  LESSONS.forEach((L, i) => {\n    const x = 24 + (i % 3) * 130;\n    const y = 24 + Math.floor(i / 3) * 110;\n    const el = document.createElement('div');\n    el.className = 'node';\n    el.id = 'n-' + L.node.id;\n    el.style.left = x + 'px';\n    el.style.top = y + 'px';\n    el.innerHTML = '<strong>' + L.node.label + '</strong><small>' + L.applet + '</small>';\n    schematic.appendChild(el);\n  });\n  function showCircuit() {\n    const L = LESSONS[step];\n    document.getElementById('cir-status').textContent = 'Step ' + (step + 1) + '/' + LESSONS.length + ': ' + L.title;\n    document.querySelectorAll('.node').forEach((el, i) => el.classList.toggle('active', i === step));\n    document.getElementById('cir-log').textContent =\n      L.narrative + '\\n\\n' + JSON.stringify(runApplet(L.applet), null, 2);\n    try { localStorage.setItem('omi-single-circuit-step', String(step)); } catch (_) {}\n  }\n  document.getElementById('cir-prev').onclick = () => { step = Math.max(0, step - 1); showCircuit(); };\n  document.getElementById('cir-next').onclick = () => { step = Math.min(LESSONS.length - 1, step + 1); showCircuit(); };\n  document.getElementById('cir-run').onclick = () => showCircuit();\n  try {\n    const s = localStorage.getItem('omi-single-circuit-step');\n    if (s != null) step = Math.min(LESSONS.length - 1, parseInt(s, 10) || 0);\n  } catch (_) {}\n  showCircuit();\n\n  // —— Spectrum ——\n  const SPECTRUM = {\n    protocol: 'OMI-IMO-TRICHROMATIC-RF',\n    version: '1.0.0',\n    global_fixed_point: '0x0000',\n    spectrum_matrix: {\n      channel_r: { band: 'HF', allocation: 'CB', frequency_min_mhz: 26.965, frequency_max_mhz: 27.405, max_power_watts: 4 },\n      channel_g: { band: 'VHF', allocation: 'MURS', discrete_channels_mhz: [151.82, 151.88, 151.94, 154.57, 154.6], max_power_watts: 2 },\n      channel_b: { band: 'UHF', allocation: 'ISM-915', frequency_min_mhz: 902, frequency_max_mhz: 928, max_power_watts: 1 }\n    }\n  };\n  document.getElementById('spec-json').textContent = JSON.stringify(SPECTRUM, null, 2);\n\n  // —— Cascade demo (simplified 9/10 inject labels) ——\n  document.getElementById('cas-cascade').onclick = () => {\n    const pure = apply8(0x01, 0);\n    const inj = 0x04; // quiet 9D cold-start interference low byte\n    const modulated = apply8(0x01, inj);\n    const lock = true; // quiet 9D/10D → terminal low bytes\n    document.getElementById('cascade-out').textContent =\n      '8D pure Δ(0x01,0) = ' + hex(pure.delta, 2) + '\\n' +\n      'injected carry      = ' + hex(inj, 2) + '\\n' +\n      '8D Δ(0x01, inj)    = ' + hex(modulated.delta, 2) + '\\n' +\n      'isometric_lock     = ' + lock + '\\n' +\n      'terminal           = ' + hex(TERMINAL, 2);\n  };\n\n  // —— Self-checks ——\n  (function selfCheck() {\n    const lines = [];\n    const a1 = apply8(0x01, 0);\n    const a2 = apply8(0x02, 0);\n    lines.push(a1.delta === 0x8a ? 'PASS Δ(0x01)=0x8A' : 'FAIL Δ(0x01)');\n    lines.push(a2.delta === 0x45 ? 'PASS Δ(0x02)=0x45' : 'FAIL Δ(0x02)');\n    lines.push(apply8(0x2a, 0).delta === 0x04 ? 'PASS centroid vertex 0x2A→Δ=0x04' : 'FAIL centroid path');\n    lines.push(SPECTRUM.global_fixed_point === '0x0000' ? 'PASS fixed point' : 'FAIL fixed point');\n    lines.push(LESSONS.length === 6 ? 'PASS circuit lessons' : 'FAIL lessons');\n    const failed = lines.filter((l) => l.indexOf('FAIL') === 0).length;\n    document.getElementById('status-out').innerHTML =\n      lines.map((l) => (l.indexOf('PASS') === 0 ? '<span class="ok">' + l + '</span>' : '<span class="bad">' + l + '</span>')).join('\\n') +\n      '\\n\\n' + (failed ? failed + ' failed' : 'All embedded checks green.');\n  })();\n})();\n</script>\n</body>\n</html>\n
      OPEN
    OPEN
  OPEN
