DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n    
    STARTTAG <meta charset="UTF-8">
    TEXT \n    
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n    
    STARTTAG <title>
      RAWTEXT Cryptocurrency 5-Simplex Visualization
    ENDTAG </title>
    TEXT \n    
    COMMENT <!-- Tailwind CSS CDN -->
    TEXT \n    
    STARTTAG <script src="https://cdn.tailwindcss.com">
    ENDTAG </script>
    TEXT \n    
    COMMENT <!-- Three.js CDN -->
    TEXT \n    
    STARTTAG <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js">
    ENDTAG </script>
    TEXT \n    
    COMMENT <!-- OrbitControls for camera interaction -->
    TEXT \n    
    STARTTAG <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js">
    ENDTAG </script>
    TEXT \n    
    STARTTAG <style>
      RAWTEXT \n        body {\n            margin: 0;\n            overflow: hidden; /* Hide scrollbars */\n            font-family: 'Inter', sans-serif; /* Use Inter font */\n            background-color: #1a202c; /* Dark background */\n            color: #e2e8f0; /* Light text color */\n        }\n        canvas {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n        #info-panel {\n            position: absolute;\n            top: 1rem;\n            left: 1rem;\n            background-color: rgba(26, 32, 44, 0.8); /* Dark background with transparency */\n            padding: 1rem;\n            border-radius: 0.75rem; /* Rounded corners */\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n            max-height: calc(100% - 2rem); /* Limit height for responsiveness */\n            overflow-y: auto; /* Enable scrolling if content overflows */\n        }\n        #loading-overlay {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background-color: rgba(0, 0, 0, 0.7);\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            color: white;\n            font-size: 1.5rem;\n            z-index: 1000;\n        }\n        .crypto-item {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 0.5rem 0;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .crypto-item:last-child {\n            border-bottom: none;\n        }\n        .crypto-name {\n            font-weight: bold;\n            margin-right: 1rem;\n        }\n        .crypto-price {\n            color: #48bb78; /* Green color for prices */\n        }\n    
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n    
    STARTTAG <div id="loading-overlay">
      TEXT \n        
      STARTTAG <p>
        TEXT Loading cryptocurrency data and setting up visualization...
      ENDTAG </p>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div id="info-panel" class="text-sm">
      TEXT \n        
      STARTTAG <h2 class="text-lg font-bold mb-2">
        TEXT Cryptocurrency Values
      ENDTAG </h2>
      TEXT \n        
      STARTTAG <div id="crypto-prices-display">
        TEXT \n            
        COMMENT <!-- Crypto prices will be dynamically inserted here -->
        TEXT \n        
      ENDTAG </div>
      TEXT \n        
      STARTTAG <p class="mt-4 text-xs text-gray-400">
        TEXT \n            * Sizes of spheres reflect current market prices.\n            
        STARTTAG <br>
        TEXT \n            * Updates every 30 seconds.\n        
      ENDTAG </p>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <script>
      RAWTEXT \n        // Global variables for Three.js scene\n        let scene, camera, renderer, controls;\n        // Array to store Three.js mesh objects for cryptocurrencies\n        const cryptoMeshes = [];\n        // Array to store Three.js line objects for connections\n        const cryptoLines = [];\n        // Object to store text sprites for labels\n        const cryptoLabels = {};\n\n        // Configuration for cryptocurrencies to fetch\n        const cryptocurrencies = [\n            { id: 'bitcoin', name: 'Bitcoin', symbol: 'BTC', color: 0xffa500 }, // Orange\n            { id: 'ethereum', name: 'Ethereum', symbol: 'ETH', color: 0x667eea }, // Indigo\n            { id: 'ripple', name: 'XRP', symbol: 'XRP', color: 0x4299e1 }, // Blue\n            { id: 'solana', name: 'Solana', symbol: 'SOL', color: 0x9f7aea }, // Purple\n            { id: 'cardano', name: 'Cardano', symbol: 'ADA', color: 0xf6ad55 }, // Orange-yellow\n            { id: 'dogecoin', name: 'Dogecoin', symbol: 'DOGE', color: 0xf6e05e }  // Yellow\n        ];\n\n        // Base URL for CoinGecko API\n        const COINGECKO_API_URL = 'https://api.coingecko.com/api/v3/simple/price';\n        // Interval for fetching data (in milliseconds)\n        const FETCH_INTERVAL = 30000; // 30 seconds\n\n        /**\n         * Initializes the Three.js scene, camera, renderer, and controls.\n         */\n        function init() {\n            // Scene setup\n            scene = new THREE.Scene();\n            scene.background = new THREE.Color(0x1a202c); // Dark background\n\n            // Camera setup\n            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.z = 5; // Initial camera position\n\n            // Renderer setup\n            renderer = new THREE.WebGLRenderer({ antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            document.body.appendChild(renderer.domElement);\n\n            // OrbitControls for camera interaction\n            controls = new THREE.OrbitControls(camera, renderer.domElement);\n            controls.enableDamping = true; // Enable smooth camera movement\n            controls.dampingFactor = 0.05;\n            controls.screenSpacePanning = false;\n            controls.minDistance = 2;\n            controls.maxDistance = 10;\n\n            // Lighting\n            const ambientLight = new THREE.AmbientLight(0x404040, 2); // Soft white light\n            scene.add(ambientLight);\n            const pointLight = new THREE.PointLight(0xffffff, 1);\n            pointLight.position.set(5, 5, 5);\n            scene.add(pointLight);\n\n            // Handle window resizing\n            window.addEventListener('resize', onWindowResize, false);\n\n            // Initial setup of cryptocurrency spheres and connections\n            setupSimplexNodes();\n            animate(); // Start the animation loop\n        }\n\n        /**\n         * Sets up the initial symmetrical positions for the cryptocurrency nodes\n         * and draws the connecting lines (edges of the conceptual simplex).\n         */\n        function setupSimplexNodes() {\n            const radius = 2; // Radius for initial symmetrical placement\n            const numCryptos = cryptocurrencies.length;\n\n            // Create spheres for each cryptocurrency and position them symmetrically\n            for (let i = 0; i < numCryptos; i++) {\n                const crypto = cryptocurrencies[i];\n                // Distribute points roughly on a sphere for initial symmetry\n                const phi = Math.acos(-1 + (2 * i) / numCryptos);\n                const theta = Math.sqrt(numCryptos * Math.PI) * phi;\n\n                const x = radius * Math.cos(theta) * Math.sin(phi);\n                const y = radius * Math.sin(theta) * Math.sin(phi);\n                const z = radius * Math.cos(phi);\n\n                const geometry = new THREE.SphereGeometry(0.1, 32, 32); // Small initial size\n                const material = new THREE.MeshPhongMaterial({ color: crypto.color });\n                const sphere = new THREE.Mesh(geometry, material);\n                sphere.position.set(x, y, z);\n                sphere.userData.id = crypto.id; // Store crypto ID for later lookup\n                scene.add(sphere);\n                cryptoMeshes.push(sphere);\n\n                // Create text label for each crypto\n                const canvas = document.createElement('canvas');\n                const context = canvas.getContext('2d');\n                const fontSize = 48;\n                context.font = `${fontSize}px Arial`;\n                const textWidth = context.measureText(crypto.symbol).width;\n                canvas.width = textWidth + 20;\n                canvas.height = fontSize + 20;\n                context.font = `${fontSize}px Arial`;\n                context.fillStyle = 'white';\n                context.textAlign = 'center';\n                context.textBaseline = 'middle';\n                context.fillText(crypto.symbol, canvas.width / 2, canvas.height / 2);\n\n                const texture = new THREE.CanvasTexture(canvas);\n                const spriteMaterial = new THREE.SpriteMaterial({ map: texture });\n                const sprite = new THREE.Sprite(spriteMaterial);\n                sprite.scale.set(0.5, 0.25, 1); // Adjust scale as needed\n                sprite.position.copy(sphere.position).add(new THREE.Vector3(0, 0.2, 0)); // Position above sphere\n                scene.add(sprite);\n                cryptoLabels[crypto.id] = sprite; // Store sprite for updates\n            }\n\n            // Connect all nodes to each other to form the conceptual simplex edges (K6 graph)\n            for (let i = 0; i < numCryptos; i++) {\n                for (let j = i + 1; j < numCryptos; j++) {\n                    const material = new THREE.LineBasicMaterial({ color: 0x6b7280, transparent: true, opacity: 0.5 }); // Gray, semi-transparent\n                    const points = [];\n                    points.push(cryptoMeshes[i].position);\n                    points.push(cryptoMeshes[j].position);\n                    const geometry = new THREE.BufferGeometry().setFromPoints(points);\n                    const line = new THREE.Line(geometry, material);\n                    scene.add(line);\n                    cryptoLines.push(line);\n                }\n            }\n        }\n\n        /**\n         * Fetches cryptocurrency prices from CoinGecko API.\n         */\n        async function fetchCryptoPrices() {\n            document.getElementById('loading-overlay').style.display = 'flex'; // Show loading overlay\n            const ids = cryptocurrencies.map(c => c.id).join(',');\n            const vsCurrencies = 'usd';\n            const url = `${COINGECKO_API_URL}?ids=${ids}&vs_currencies=${vsCurrencies}`;\n\n            try {\n                const response = await fetch(url);\n                if (!response.ok) {\n                    throw new Error(`HTTP error! status: ${response.status}`);\n                }\n                const data = await response.json();\n                updateVisualization(data);\n            } catch (error) {\n                console.error('Error fetching cryptocurrency prices:', error);\n                document.getElementById('crypto-prices-display').innerHTML = '<p class="text-red-500">Failed to load prices. Please try again later.</p>';\n            } finally {\n                document.getElementById('loading-overlay').style.display = 'none'; // Hide loading overlay\n            }\n        }\n\n        /**\n         * Updates the 3D visualization based on fetched cryptocurrency prices.\n         * @param {object} data - The price data from CoinGecko API.\n         */\n        function updateVisualization(data) {\n            let maxPrice = 0;\n            // Find the maximum price for normalization\n            for (const crypto of cryptocurrencies) {\n                if (data[crypto.id] && data[crypto.id].usd) {\n                    maxPrice = Math.max(maxPrice, data[crypto.id].usd);\n                }\n            }\n\n            const priceDisplay = document.getElementById('crypto-prices-display');\n            priceDisplay.innerHTML = ''; // Clear previous prices\n\n            cryptoMeshes.forEach(sphere => {\n                const cryptoId = sphere.userData.id;\n                const priceInfo = data[cryptoId];\n                if (priceInfo && priceInfo.usd) {\n                    const price = priceInfo.usd;\n                    // Normalize price to scale sphere size (e.g., 0.1 to 1.0)\n                    // Using a logarithmic scale for better visual distinction across vastly different prices\n                    const minLogPrice = Math.log(0.001); // Smallest possible price for log scale\n                    const maxLogPrice = Math.log(maxPrice);\n                    const normalizedPrice = (Math.log(Math.max(price, 0.001)) - minLogPrice) / (maxLogPrice - minLogPrice);\n                    const scaleFactor = 0.1 + normalizedPrice * 0.9; // Scale from 0.1 to 1.0\n\n                    sphere.scale.set(scaleFactor, scaleFactor, scaleFactor);\n\n                    // Update text label position\n                    if (cryptoLabels[cryptoId]) {\n                        cryptoLabels[cryptoId].position.copy(sphere.position).add(new THREE.Vector3(0, sphere.geometry.parameters.radius * scaleFactor + 0.1, 0));\n                    }\n\n                    // Update price display in the info panel\n                    const cryptoName = cryptocurrencies.find(c => c.id === cryptoId)?.name || cryptoId;\n                    const priceElement = document.createElement('div');\n                    priceElement.className = 'crypto-item';\n                    priceElement.innerHTML = `\n                        <span class="crypto-name">${cryptoName} (${cryptoId.toUpperCase()})</span>\n                        <span class="crypto-price">$${price.toFixed(2)}</span>\n                    `;\n                    priceDisplay.appendChild(priceElement);\n                } else {\n                    // If price data is missing, reset scale and show N/A\n                    sphere.scale.set(0.1, 0.1, 0.1); // Reset to base size\n                    const cryptoName = cryptocurrencies.find(c => c.id === cryptoId)?.name || cryptoId;\n                    const priceElement = document.createElement('div');\n                    priceElement.className = 'crypto-item';\n                    priceElement.innerHTML = `\n                        <span class="crypto-name">${cryptoName} (${cryptoId.toUpperCase()})</span>\n                        <span class="crypto-price text-red-500">N/A</span>\n                    `;\n                    priceDisplay.appendChild(priceElement);\n                }\n            });\n\n            // Update lines to reflect new sphere positions (if positions were dynamic, which they are not in this version, but good practice)\n            cryptoLines.forEach(line => {\n                line.geometry.attributes.position.needsUpdate = true;\n            });\n        }\n\n        /**\n         * Handles window resize events to keep the canvas responsive.\n         */\n        function onWindowResize() {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        }\n\n        /**\n         * Animation loop for Three.js.\n         */\n        function animate() {\n            requestAnimationFrame(animate);\n            controls.update(); // Only required if controls.enableDamping or controls.autoRotate are set to true\n            renderer.render(scene, camera);\n        }\n\n        // Start the application when the window loads\n        window.onload = function () {\n            init();\n            fetchCryptoPrices(); // Initial fetch\n            setInterval(fetchCryptoPrices, FETCH_INTERVAL); // Fetch prices periodically\n        };\n    
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
