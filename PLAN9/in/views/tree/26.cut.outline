DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="UTF-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n
    STARTTAG <title>
      RAWTEXT Epistemic Observability Engine — Canvas Model\n<style>\n  :root {\n    --bg: #0b0f14;\n    --panel: #121820;\n    --border: #1e2a38;\n    --text: #e6edf3;\n    --muted: #8b9bb4;\n    --accent: #3b82f6;\n    --kk: #22c55e;\n    --ku: #eab308;\n    --uk: #f97316;\n    --uu: #ef4444;\n    --cyan: #22d3ee;\n    --purple: #a78bfa;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n  }\n  header {\n    padding: 12px 20px;\n    border-bottom: 1px solid var(--border);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: var(--panel);\n  }\n  header h1 {\n    font-size: 1.15rem;\n    font-weight: 600;\n    letter-spacing: 0.02em;\n  }\n  header .badge {\n    font-size: 0.7rem;\n    background: #1e3a5f;\n    color: var(--cyan);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .layout {\n    display: grid;\n    grid-template-columns: 1fr 340px;\n    flex: 1;\n    min-height: 0;\n  }\n  .canvas-wrap {\n    position: relative;\n    background: #0a0e13;\n    border-right: 1px solid var(--border);\n  }\n  canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n  .sidebar {\n    background: var(--panel);\n    overflow-y: auto;\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  .section {\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    padding: 12px;\n    background: #0f1520;\n  }\n  .section h2 {\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    color: var(--muted);\n    margin-bottom: 10px;\n  }\n  .row {\n    display: flex;\n    gap: 8px;\n    margin-bottom: 8px;\n    align-items: center;\n  }\n  .row:last-child { margin-bottom: 0; }\n  label {\n    font-size: 0.8rem;\n    color: var(--muted);\n    min-width: 70px;\n  }\n  input[type="range"] {\n    flex: 1;\n    accent-color: var(--accent);\n  }\n  input[type="number"] {\n    width: 64px;\n    background: #0b0f14;\n    border: 1px solid var(--border);\n    color: var(--text);\n    padding: 4px 6px;\n    border-radius: 4px;\n    font-size: 0.8rem;\n  }\n  button {\n    background: #1e3a5f;\n    color: var(--text);\n    border: 1px solid #2a4a6f;\n    padding: 7px 12px;\n    border-radius: 6px;\n    font-size: 0.8rem;\n    cursor: pointer;\n    transition: background 0.15s;\n  }\n  button:hover { background: #2a4a6f; }\n  button.primary {\n    background: var(--accent);\n    border-color: #2563eb;\n  }\n  button.primary:hover { background: #2563eb; }\n  button.danger {\n    background: #7f1d1d;\n    border-color: #991b1b;\n  }\n  .bars {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n  .bar-row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 0.75rem;\n  }\n  .bar-label {\n    width: 28px;\n    font-weight: 600;\n  }\n  .bar-track {\n    flex: 1;\n    height: 10px;\n    background: #1a2332;\n    border-radius: 4px;\n    overflow: hidden;\n  }\n  .bar-fill {\n    height: 100%;\n    border-radius: 4px;\n    transition: width 0.25s ease;\n  }\n  .bar-val {\n    width: 36px;\n    text-align: right;\n    color: var(--muted);\n  }\n  .kk .bar-fill { background: var(--kk); }\n  .ku .bar-fill { background: var(--ku); }\n  .uk .bar-fill { background: var(--uk); }\n  .uu .bar-fill { background: var(--uu); }\n  .metric {\n    display: flex;\n    justify-content: space-between;\n    font-size: 0.8rem;\n    margin-bottom: 4px;\n  }\n  .metric span:last-child {\n    font-family: ui-monospace, monospace;\n    color: var(--cyan);\n  }\n  .log {\n    font-family: ui-monospace, monospace;\n    font-size: 0.7rem;\n    max-height: 140px;\n    overflow-y: auto;\n    color: var(--muted);\n    line-height: 1.4;\n  }\n  .log .entry { margin-bottom: 2px; }\n  .log .cid { color: var(--purple); }\n  .hint {\n    font-size: 0.7rem;\n    color: var(--muted);\n    line-height: 1.35;\n  }\n  .status {\n    display: flex;\n    gap: 12px;\n    font-size: 0.75rem;\n  }\n  .status-item {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n  }\n  footer {\n    border-top: 1px solid var(--border);\n    padding: 8px 20px;\n    font-size: 0.7rem;\n    color: var(--muted);\n    background: var(--panel);\n    display: flex;\n    justify-content: space-between;\n  }\n  @media (max-width: 900px) {\n    .layout { grid-template-columns: 1fr; }\n    .canvas-wrap { height: 420px; }\n  }\n</style>\n</head>\n<body>\n<header>\n  <h1>Epistemic Observability Engine</h1>\n  <div class="status">\n    <span class="status-item"><span class="dot" style="background:var(--kk)"></span> KK</span>\n    <span class="status-item"><span class="dot" style="background:var(--ku)"></span> KU</span>\n    <span class="status-item"><span class="dot" style="background:var(--uk)"></span> UK</span>\n    <span class="status-item"><span class="dot" style="background:var(--uu)"></span> UU</span>\n    <span class="badge">Canvas Model · v1.0</span>\n  </div>\n</header>\n\n<div class="layout">\n  <div class="canvas-wrap">\n    <canvas id="c"></canvas>\n  </div>\n\n  <aside class="sidebar">\n    <!-- Epistemic State -->\n    <div class="section">\n      <h2>Epistemic Vector</h2>\n      <div class="bars">\n        <div class="bar-row kk">\n          <span class="bar-label">KK</span>\n          <div class="bar-track"><div class="bar-fill" id="bar-kk" style="width:40%"></div></div>\n          <span class="bar-val" id="val-kk">0.40</span>\n        </div>\n        <div class="bar-row ku">\n          <span class="bar-label">KU</span>\n          <div class="bar-track"><div class="bar-fill" id="bar-ku" style="width:30%"></div></div>\n          <span class="bar-val" id="val-ku">0.30</span>\n        </div>\n        <div class="bar-row uk">\n          <span class="bar-label">UK</span>\n          <div class="bar-track"><div class="bar-fill" id="bar-uk" style="width:50%"></div></div>\n          <span class="bar-val" id="val-uk">0.50</span>\n        </div>\n        <div class="bar-row uu">\n          <span class="bar-label">UU</span>\n          <div class="bar-track"><div class="bar-fill" id="bar-uu" style="width:25%"></div></div>\n          <span class="bar-val" id="val-uu">0.25</span>\n        </div>\n      </div>\n      <div class="row" style="margin-top:10px">\n        <button onclick="randomizeEpistemic()">Randomize</button>\n        <button onclick="resetEpistemic()">Reset</button>\n      </div>\n    </div>\n\n    <!-- Observability -->\n    <div class="section">\n      <h2>Observability · UK · φ(V)</h2>\n      <div class="row">\n        <label>Vertices V</label>\n        <input type="range" id="v-slider" min="1" max="2000" value="100" oninput="updateV(this.value)">\n        <input type="number" id="v-num" value="100" min="1" max="5000" onchange="updateV(this.value)">\n      </div>\n      <div class="metric"><span>φ(V)</span><span id="phi-val">40</span></div>\n      <div class="metric"><span>UK · φ(V)</span><span id="obs-val">20.00</span></div>\n      <div class="metric"><span>Bound status</span><span id="bound-status" style="color:var(--kk)">stable</span></div>\n      <p class="hint" style="margin-top:8px">As V grows, UK variance would explode. Multiplying by Euler’s totient φ(V) keeps the observable state bounded.</p>\n    </div>\n\n    <!-- Geometry / Canonicalization -->\n    <div class="section">\n      <h2>Geometry & Canonicalization</h2>\n      <div class="row">\n        <button class="primary" onclick="addPoint()">Add Point</button>\n        <button onclick="canonicalize()">Canonicalize</button>\n        <button class="danger" onclick="clearPoints()">Clear</button>\n      </div>\n      <p class="hint" style="margin-top:8px">Click canvas to place points. Canonicalize runs successive reflections toward the dominant chamber (x≥0, y≥0).</p>\n    </div>\n\n    <!-- Q* & RBAC -->\n    <div class="section">\n      <h2>Q* Cost & Geometric RBAC</h2>\n      <div class="metric"><span>Q* cost J</span><span id="q-cost">—</span></div>\n      <div class="metric"><span>Access</span><span id="access-status">—</span></div>\n      <div class="row" style="margin-top:8px">\n        <button onclick="computeQ()">Evaluate Q*</button>\n        <button onclick="checkAccess()">Check Access</button>\n      </div>\n      <p class="hint" style="margin-top:8px">Q* minimizes ||UK·φ − observation||. Access is granted when Euclidean distance to grant point &lt; threshold.</p>\n    </div>\n\n    <!-- Provenance -->\n    <div class="section">\n      <h2>Provenance Log (Merkle-style)</h2>\n      <div class="log" id="log"></div>\n      <div class="row" style="margin-top:8px">\n        <button onclick="clearLog()">Clear Log</button>\n      </div>\n    </div>\n  </aside>\n</div>\n\n<footer>\n  <span>Kernel · Canonicalization · Observability Parameterizer · Q* · Geometric RBAC</span>\n  <span>Single-file canvas model of the Epistemic Observability Engine</span>\n</footer>\n\n<script>\n// ─────────────────────────────────────────────────────────────\n// Core State\n// ─────────────────────────────────────────────────────────────\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\n\nlet W = 0, H = 0, cx = 0, cy = 0, scale = 1;\n\nconst state = {\n  points: [],           // {x,y, id, color, canonical}\n  epistemic: { kk: 0.4, ku: 0.3, uk: 0.5, uu: 0.25 },\n  V: 100,\n  phi: 40,\n  obs: 20,\n  grantPoint: { x: 0.6, y: 0.4 },\n  threshold: 0.55,\n  animating: false,\n  log: []\n};\n\n// ─────────────────────────────────────────────────────────────\n// Math helpers\n// ─────────────────────────────────────────────────────────────\nfunction eulerTotient(n) {\n  n = Math.floor(Math.max(1, n));\n  let result = n;\n  for (let p = 2; p * p <= n; p++) {\n    if (n % p === 0) {\n      while (n % p === 0) n /= p;\n      result -= result / p;\n    }\n  }\n  if (n > 1) result -= result / n;\n  return Math.floor(result);\n}\n\nfunction dist(a, b) {\n  const dx = a.x - b.x, dy = a.y - b.y;\n  return Math.sqrt(dx*dx + dy*dy);\n}\n\nfunction reflect(p, normal) {\n  // Reflect point p over the line defined by unit normal\n  const dot = p.x * normal.x + p.y * normal.y;\n  return {\n    x: p.x - 2 * dot * normal.x,\n    y: p.y - 2 * dot * normal.y\n  };\n}\n\n// Simple roots for 2-D “Weyl” approximation of dominant chamber\nconst SIMPLE_ROOTS = [\n  { x: 1, y: 0 },   // reflect over y-axis if x < 0\n  { x: 0, y: 1 }    // reflect over x-axis if y < 0\n];\n\nfunction isDominant(p) {\n  return p.x >= -1e-9 && p.y >= -1e-9;\n}\n\nfunction canonicalizePoint(p) {\n  let cur = { ...p };\n  const path = [{ ...cur }];\n  // Max 4 reflections is enough in 2-D\n  for (let i = 0; i < 6; i++) {\n    if (isDominant(cur)) break;\n    if (cur.x < 0) {\n      cur = reflect(cur, SIMPLE_ROOTS[0]);\n      path.push({ ...cur });\n    }\n    if (cur.y < 0) {\n      cur = reflect(cur, SIMPLE_ROOTS[1]);\n      path.push({ ...cur });\n    }\n  }\n  return path;\n}\n\n// ─────────────────────────────────────────────────────────────\n// Logging / Provenance\n// ─────────────────────────────────────────────────────────────\nfunction cid() {\n  return 'mlss://' + Math.random().toString(16).slice(2, 10);\n}\n\nfunction log(msg, type = 'info') {\n  const entry = { t: Date.now(), msg, type, cid: cid() };\n  state.log.unshift(entry);\n  if (state.log.length > 40) state.log.pop();\n  renderLog();\n}\n\nfunction renderLog() {\n  const el = document.getElementById('log');\n  el.innerHTML = state.log.map(e =>\n    `<div class="entry"><span class="cid">${e.cid.slice(0,14)}</span> · ${e.msg}</div>`\n  ).join('');\n}\n\nfunction clearLog() {\n  state.log = [];\n  renderLog();\n}\n\n// ─────────────────────────────────────────────────────────────\n// Epistemic UI\n// ─────────────────────────────────────────────────────────────\nfunction updateEpistemicUI() {\n  const e = state.epistemic;\n  const max = Math.max(e.kk, e.ku, e.uk, e.uu, 0.01);\n  document.getElementById('bar-kk').style.width = (e.kk / max * 100) + '%';\n  document.getElementById('bar-ku').style.width = (e.ku / max * 100) + '%';\n  document.getElementById('bar-uk').style.width = (e.uk / max * 100) + '%';\n  document.getElementById('bar-uu').style.width = (e.uu / max * 100) + '%';\n  document.getElementById('val-kk').textContent = e.kk.toFixed(2);\n  document.getElementById('val-ku').textContent = e.ku.toFixed(2);\n  document.getElementById('val-uk').textContent = e.uk.toFixed(2);\n  document.getElementById('val-uu').textContent = e.uu.toFixed(2);\n  updateObservability();\n}\n\nfunction randomizeEpistemic() {\n  state.epistemic = {\n    kk: +(Math.random() * 0.9 + 0.1).toFixed(2),\n    ku: +(Math.random() * 0.9 + 0.1).toFixed(2),\n    uk: +(Math.random() * 0.9 + 0.1).toFixed(2),\n    uu: +(Math.random() * 0.9 + 0.1).toFixed(2)\n  };\n  updateEpistemicUI();\n  log('Epistemic vector randomized');\n}\n\nfunction resetEpistemic() {\n  state.epistemic = { kk: 0.4, ku: 0.3, uk: 0.5, uu: 0.25 };\n  updateEpistemicUI();\n  log('Epistemic vector reset');\n}\n\n// ─────────────────────────────────────────────────────────────\n// Observability\n// ─────────────────────────────────────────────────────────────\nfunction updateV(v) {\n  v = Math.max(1, Math.min(5000, +v || 1));\n  state.V = v;\n  document.getElementById('v-slider').value = Math.min(2000, v);\n  document.getElementById('v-num').value = v;\n  updateObservability();\n}\n\nfunction updateObservability() {\n  state.phi = eulerTotient(state.V);\n  state.obs = state.epistemic.uk * state.phi;\n  document.getElementById('phi-val').textContent = state.phi;\n  document.getElementById('obs-val').textContent = state.obs.toFixed(2);\n  const bound = state.obs < 200 ? 'stable' : state.obs < 800 ? 'elevated' : 'high';\n  const el = document.getElementById('bound-status');\n  el.textContent = bound;\n  el.style.color = bound === 'stable' ? 'var(--kk)' : bound === 'elevated' ? 'var(--ku)' : 'var(--uu)';\n}\n\n// ─────────────────────────────────────────────────────────────\n// Points & Geometry\n// ─────────────────────────────────────────────────────────────\nfunction addPoint(px, py) {\n  let x, y;\n  if (px !== undefined) {\n    // from click (pixel → normalized)\n    x = (px - cx) / scale;\n    y = (cy - py) / scale; // flip y\n  } else {\n    x = (Math.random() - 0.5) * 2.4;\n    y = (Math.random() - 0.5) * 2.4;\n  }\n  const id = state.points.length;\n  state.points.push({\n    x, y, id,\n    color: `hsl(${(id * 47) % 360}, 70%, 60%)`,\n    path: null,\n    step: 0\n  });\n  log(`Point P${id} added at (${x.toFixed(2)}, ${y.toFixed(2)})`);\n  draw();\n}\n\nfunction clearPoints() {\n  state.points = [];\n  log('All points cleared');\n  draw();\n}\n\nfunction canonicalize() {\n  if (state.animating) return;\n  state.animating = true;\n  let any = false;\n  state.points.forEach(p => {\n    if (!isDominant(p)) {\n      p.path = canonicalizePoint(p);\n      p.step = 0;\n      any = true;\n    }\n  });\n  if (!any) {\n    log('All points already in dominant chamber');\n    state.animating = false;\n    return;\n  }\n  log('Canonicalization started (Weyl reflections)');\n  animateCanonicalize();\n}\n\nfunction animateCanonicalize() {\n  let done = true;\n  state.points.forEach(p => {\n    if (p.path && p.step < p.path.length - 1) {\n      p.step++;\n      const next = p.path[p.step];\n      p.x = next.x;\n      p.y = next.y;\n      done = false;\n    }\n  });\n  draw();\n  if (!done) {\n    requestAnimationFrame(() => setTimeout(animateCanonicalize, 220));\n  } else {\n    state.points.forEach(p => { p.path = null; });\n    state.animating = false;\n    log('Canonicalization complete → dominant chamber');\n  }\n}\n\n// ─────────────────────────────────────────────────────────────\n// Q* & Access\n// ─────────────────────────────────────────────────────────────\nfunction computeQ() {\n  // Synthetic observation = average of current points projected\n  let obsX = 0, obsY = 0;\n  if (state.points.length) {\n    state.points.forEach(p => { obsX += p.x; obsY += p.y; });\n    obsX /= state.points.length;\n    obsY /= state.points.length;\n  } else {\n    obsX = 0.3; obsY = 0.2;\n  }\n  // Target state derived from observability\n  const target = state.obs / 100; // scale\n  const J = Math.sqrt((state.epistemic.uk * state.phi / 100 - target) ** 2 + (obsX - 0.4) ** 2);\n  document.getElementById('q-cost').textContent = J.toFixed(4);\n  log(`Q* cost J = ${J.toFixed(4)} (observation vs UK·φ)`);\n}\n\nfunction checkAccess() {\n  if (!state.points.length) {\n    document.getElementById('access-status').textContent = 'no points';\n    return;\n  }\n  // Use first point as agent, grantPoint as resource\n  const agent = state.points[0];\n  const d = dist(agent, state.grantPoint);\n  const allowed = d < state.threshold;\n  const el = document.getElementById('access-status');\n  el.textContent = allowed ? 'GRANTED' : 'DENIED';\n  el.style.color = allowed ? 'var(--kk)' : 'var(--uu)';\n  log(`RBAC check: dist=${d.toFixed(3)} ${allowed ? '< threshold → GRANT' : '≥ threshold → DENY'}`);\n  draw();\n}\n\n// ─────────────────────────────────────────────────────────────\n// Drawing\n// ─────────────────────────────────────────────────────────────\nfunction resize() {\n  const wrap = canvas.parentElement;\n  W = wrap.clientWidth;\n  H = wrap.clientHeight;\n  canvas.width = W * devicePixelRatio;\n  canvas.height = H * devicePixelRatio;\n  ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);\n  cx = W / 2;\n  cy = H / 2;\n  scale = Math.min(W, H) * 0.32;\n  draw();\n}\n\nfunction toScreen(p) {\n  return {\n    x: cx + p.x * scale,\n    y: cy - p.y * scale\n  };\n}\n\nfunction drawGrid() {\n  ctx.strokeStyle = '#1a2332';\n  ctx.lineWidth = 1;\n  // axes\n  ctx.beginPath();\n  ctx.moveTo(0, cy); ctx.lineTo(W, cy);\n  ctx.moveTo(cx, 0); ctx.lineTo(cx, H);\n  ctx.stroke();\n\n  // dominant chamber shading\n  ctx.fillStyle = 'rgba(34, 197, 94, 0.06)';\n  ctx.fillRect(cx, 0, W - cx, cy);\n\n  // unit circle\n  ctx.beginPath();\n  ctx.arc(cx, cy, scale, 0, Math.PI * 2);\n  ctx.strokeStyle = '#1e2a38';\n  ctx.stroke();\n\n  // labels\n  ctx.fillStyle = '#4a5568';\n  ctx.font = '11px system-ui';\n  ctx.fillText('+x', W - 24, cy - 6);\n  ctx.fillText('+y', cx + 6, 14);\n  ctx.fillText('dominant chamber', cx + 12, 28);\n}\n\nfunction drawGrant() {\n  const s = toScreen(state.grantPoint);\n  // threshold circle\n  ctx.beginPath();\n  ctx.arc(s.x, s.y, state.threshold * scale, 0, Math.PI * 2);\n  ctx.strokeStyle = 'rgba(167, 139, 250, 0.35)';\n  ctx.setLineDash([4, 4]);\n  ctx.stroke();\n  ctx.setLineDash([]);\n  // grant point\n  ctx.beginPath();\n  ctx.arc(s.x, s.y, 7, 0, Math.PI * 2);\n  ctx.fillStyle = '#a78bfa';\n  ctx.fill();\n  ctx.fillStyle = '#c4b5fd';\n  ctx.font = '11px system-ui';\n  ctx.fillText('grant', s.x + 10, s.y - 6);\n}\n\nfunction drawPoints() {\n  state.points.forEach(p => {\n    const s = toScreen(p);\n    // trail if animating\n    if (p.path) {\n      ctx.beginPath();\n      p.path.forEach((pt, i) => {\n        const sp = toScreen(pt);\n        if (i === 0) ctx.moveTo(sp.x, sp.y);\n        else ctx.lineTo(sp.x, sp.y);\n      });\n      ctx.strokeStyle = p.color + '88';\n      ctx.lineWidth = 1.5;\n      ctx.stroke();\n    }\n    // point\n    ctx.beginPath();\n    ctx.arc(s.x, s.y, 8, 0, Math.PI * 2);\n    ctx.fillStyle = p.color;\n    ctx.fill();\n    ctx.strokeStyle = '#0b0f14';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n    // id\n    ctx.fillStyle = '#e6edf3';\n    ctx.font = '10px system-ui';\n    ctx.fillText('P' + p.id, s.x + 10, s.y + 4);\n  });\n}\n\nfunction drawEpistemicRadar() {\n  // small radar in corner\n  const rx = 70, ry = H - 70, r = 42;\n  const e = state.epistemic;\n  const vals = [e.kk, e.ku, e.uk, e.uu];\n  const colors = ['#22c55e', '#eab308', '#f97316', '#ef4444'];\n  const labels = ['KK', 'KU', 'UK', 'UU'];\n  const max = Math.max(...vals, 0.5);\n\n  ctx.beginPath();\n  ctx.arc(rx, ry, r, 0, Math.PI * 2);\n  ctx.strokeStyle = '#1e2a38';\n  ctx.stroke();\n\n  ctx.beginPath();\n  vals.forEach((v, i) => {\n    const ang = -Math.PI / 2 + i * (Math.PI / 2);\n    const len = (v / max) * r;\n    const x = rx + Math.cos(ang) * len;\n    const y = ry + Math.sin(ang) * len;\n    if (i === 0) ctx.moveTo(x, y);\n    else ctx.lineTo(x, y);\n  });\n  ctx.closePath();\n  ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';\n  ctx.fill();\n  ctx.strokeStyle = '#3b82f6';\n  ctx.stroke();\n\n  vals.forEach((v, i) => {\n    const ang = -Math.PI / 2 + i * (Math.PI / 2);\n    const x = rx + Math.cos(ang) * (r + 12);\n    const y = ry + Math.sin(ang) * (r + 12);\n    ctx.fillStyle = colors[i];\n    ctx.font = '9px system-ui';\n    ctx.textAlign = 'center';\n    ctx.fillText(labels[i], x, y + 3);\n  });\n  ctx.textAlign = 'left';\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, W, H);\n  drawGrid();\n  drawGrant();\n  drawPoints();\n  drawEpistemicRadar();\n}\n\n// ─────────────────────────────────────────────────────────────\n// Events\n// ─────────────────────────────────────────────────────────────\ncanvas.addEventListener('click', e => {\n  const rect = canvas.getBoundingClientRect();\n  addPoint(e.clientX - rect.left, e.clientY - rect.top);\n});\n\nwindow.addEventListener('resize', resize);\n\n// ─────────────────────────────────────────────────────────────\n// Init\n// ─────────────────────────────────────────────────────────────\nfunction init() {\n  resize();\n  updateEpistemicUI();\n  // seed a few points\n  addPoint();\n  addPoint();\n  log('Engine ready · click canvas to place points');\n  log('Core formula active: Observable = UK · φ(V)');\n}\n\ninit();\n</script>\n</body>\n</html>\n
      OPEN
    OPEN
  OPEN
