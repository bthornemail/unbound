DOCTYPE <!doctype html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="utf-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1">
    TEXT \n
    STARTTAG <title>
      RAWTEXT HTML Gallery\n<style>\n  :root {\n    --bg: #f3f4f6; --card: #ffffff; --border: #e5e7eb; --border-hover: #9ca3af;\n    --text: #111827; --text-2: #374151; --muted: #6b7280; --pill: #f3f4f6;\n    --badge: #fef3c7; --badge-text: #92400e; --focus: #6b7280;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg: #0f1115; --card: #181b21; --border: #2a2f38; --border-hover: #4b5563;\n      --text: #f3f4f6; --text-2: #d1d5db; --muted: #9ca3af; --pill: #232730;\n      --badge: #3b2f12; --badge-text: #fcd34d; --focus: #9ca3af;\n    }\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0; background: var(--bg); color: var(--text);\n    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;\n  }\n  .wrap { max-width: 72rem; margin: 0 auto; padding: 40px 16px; }\n  header { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; }\n  h1 { margin: 0; font-size: 1.875rem; }\n  header p { margin: 4px 0 0; color: var(--muted); }\n  input[type="search"] {\n    width: 100%; max-width: 18rem; padding: 8px 12px; border-radius: 8px;\n    border: 1px solid var(--border); background: var(--card); color: var(--text); font: inherit;\n  }\n  input[type="search"]:focus { outline: none; border-color: var(--focus); }\n  section { margin-bottom: 40px; }\n  h2 { margin: 0 0 12px; font-size: .8rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }\n  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }\n  a.card {\n    display: flex; flex-direction: column; padding: 20px; border-radius: 12px; text-decoration: none; color: inherit;\n    background: var(--card); border: 1px solid var(--border); box-shadow: 0 1px 2px rgb(0 0 0 / .05);\n    transition: transform .15s, border-color .15s, box-shadow .15s;\n  }\n  a.card:hover, a.card:focus-visible { transform: translateY(-2px); border-color: var(--border-hover); box-shadow: 0 4px 12px rgb(0 0 0 / .08); outline: none; }\n  a.card:hover h3 { text-decoration: underline; }\n  .meta { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: .75rem; color: var(--muted); }\n  .pill { background: var(--pill); border-radius: 999px; padding: 1px 8px; }\n  h3 { margin: 0; font-size: 1rem; }\n  .summary { margin: 4px 0 0; font-size: .875rem; font-weight: 500; color: var(--text-2); }\n  .desc { margin: 8px 0 0; font-size: .875rem; color: var(--muted); }\n  .file { margin-top: auto; padding-top: 12px; font: .75rem ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); word-break: break-all; }\n  .badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }\n  .badge { font-size: .7rem; padding: 1px 8px; border-radius: 999px; background: var(--badge); color: var(--badge-text); }\n  .empty { color: var(--muted); }\n</style>\n</head>\n<body>\n<div class="wrap">\n  <header>\n    <div>\n      <h1>HTML Gallery</h1>\n      <p id="count"></p>\n    </div>\n    <input id="filter" type="search" placeholder="Filter pages…" aria-label="Filter pages">\n  </header>\n  <main id="groups"></main>\n  <p id="empty" class="empty" hidden></p>\n</div>\n\n<script>\n  // One entry per page in this folder. A plain file server may not list directories,\n  // so a new page shows up here only once it has an entry.\n  // needs: what the page relies on beyond this folder (shown as badges).\n  const pages = [\n    // Readings & codepoints\n    { file: 'Fano Constants.html', title: 'Fano Constants', group: 'Readings & codepoints',\n      summary: 'Every SVG file read as one 7-bit constant on the Fano plane.',\n      description: 'Each SVG is read as text, its marked dots located, and the result becomes a 7-bit mask. Pick two points and the third on their line is computed as a ⊕ b and lit; two views of the same files check each other.',\n      needs: [] },\n    { file: 'Reading I-229.html', title: 'Reading I-229', group: 'Readings & codepoints',\n      summary: 'One proof followed start to finish: YHWH and its renderings.',\n      description: 'Writes the prediction first, fixes the literal as codepoints, reduces each rendering (THE LORD, Yahweh, Yah, Jah, Jehovah…) to its base, and classes each comparison as MIRROR (same base) or RAISE (base replaced).',\n      needs: [] },\n    { file: 'Term Treemap.html', title: 'Term Treemap', group: 'Readings & codepoints',\n      summary: 'YHWH across four witnesses, with the masks between them.',\n      description: 'A fixed hierarchy of the Name, its four letter cells and their letter and mark layers, filled from each witness’s literal codepoints, plus one bit per cell marking where each pair of witnesses differs. Drawn with d3.',\n      needs: ['CDN'] },\n    { file: 'The 60-in-64 Clock.html', title: 'The 60-in-64 Clock', group: 'Readings & codepoints',\n      summary: 'A 64-slot dial where 60 carry time and 4 are held for control.',\n      description: 'Walks through the dial, the four spare codes, the counter, and why the same shape repeats at 256 slots so that 240 and 60 fit together.',\n      needs: [] },\n    { file: 'codepoints-book.html', title: 'Codepoint Popup Book', group: 'Readings & codepoints',\n      summary: 'Uppercase paths open pages of nested lowercase codepoints.',\n      description: 'Template-literal paths in the shape (/[:uppercase:][:lowercase:]?/) become canvas pages over the range 20–7E. Each path builds an in-memory WebVTT track whose cues can be stepped or played.',\n      needs: [] },\n    { file: 'slide_ruler.html', title: '16-Bit Kernel Slide Ruler', group: 'Readings & codepoints',\n      summary: 'Slide a 16-bit state through rotl/rotr/XOR and land on a codepoint.',\n      description: 'Set the state X and constant C for rotl(x,1) ^ rotl(x,3) ^ rotr(x,2) ^ C; the result picks a Boolean operator, an Aegean plane header and a Braille offset, resolving to one Unicode codepoint across planes 0–16.',\n      needs: ['CDN'] },\n    { file: 'The Light Garden.html', title: 'The Light Garden', group: 'Readings & codepoints',\n      summary: 'A popup book you open to join a commons.',\n      description: 'Seven points and seven lines read as people, tones or colours: the story of Wisdom, Law and the Tribe at the city gate, a hundred and forty-four stories, two switches to make it yours, and the centre.',\n      needs: [] },\n    { file: 'Catastrophic Backtracking.html', title: 'Catastrophic Backtracking', group: 'Readings & codepoints',\n      summary: 'Why a one-line regex can take years on a tiny input, measured live.',\n      description: 'Two patterns that accept the same strings, one of which makes the engine chase every path. Shows the blowup live, then the fix: hold the set of states and step once per character.',\n      needs: [] },\n\n    // Media Spectrum\n    { file: 'media-spectrum-4bit-xor-adder.html', title: 'Media Spectrum → 4-bit XOR Adder', group: 'Media Spectrum',\n      summary: 'Live audio FFT driving a 4-bit adder built from four XOR topologies.',\n      description: 'The original: 128 FFT bins drive four OffscreenCanvas workers, one per XOR (5/6/8-NAND/10-NOR transistors) as stages of a shared adder, with a 4-bit adder control surface. Spectrum snapshots become scrubbable cues that bind CSS properties and the operation.',\n      needs: ['Microphone'] },\n    { file: 'media-spectrum-4bit-xor-adder-1.html', title: 'Media Spectrum → 4-bit XOR Adder (oscilloscope)', group: 'Media Spectrum',\n      summary: 'The XOR adder with a time-domain oscilloscope added.',\n      description: 'Same quad-worker adder, plus a green-phosphor oscilloscope of the waveform and ADD / SUB / XOR-only / AND-mask operation modes, with one camera view per XOR topology.',\n      needs: ['Microphone'] },\n    { file: 'media-spectrum-4bit-xor-adder-2.html', title: 'Media Spectrum → 4-bit XOR Adder (helices)', group: 'Media Spectrum',\n      summary: 'The oscilloscope version, with DNA/RNA helix views and carry pulses.',\n      description: 'Builds on the oscilloscope version: each of the four worker views draws DNA/RNA helices with carry-lookahead pulses orbiting them, one worker per adder stage.',\n      needs: ['Microphone'] },\n    { file: 'Media Spectrum DevTools.html', title: 'Media Spectrum DevTools', group: 'Media Spectrum',\n      summary: 'A 128-bin audio spectrum as an 8×16 grid, with a snapshot timeline.',\n      description: 'Real FFT from the Web Audio AnalyserNode laid out as 128 ports and an 8×16 grid. Snapshots go onto a timeline you can click to inspect; double-click to return to live. No libraries.',\n      needs: ['Microphone'] },\n\n    // OMI / GENESIS\n    { file: 'omi-dom-stack-full.html', title: 'OMI-IMO Full DOM Stack', group: 'OMI / GENESIS',\n      summary: 'The Full DOM Stack core as one offline file.',\n      description: 'XOR, the 8-polytope compare-and-swap, a circuit walkthrough, the spectrum map, the fixed point 0x0000 and a verification table with carry = 0, all in a single self-contained snapshot.',\n      needs: [] },\n    { file: 'OMI-IMO DOM Protocol Bootstrap.html', title: 'OMI-IMO DOM Protocol Bootstrap', group: 'OMI / GENESIS',\n      summary: 'A -5D to 10D bootstrap pipeline with a Web Audio observer.',\n      description: 'The 0D observer is a Web Audio PannerNode; a logic kernel and closure ring validate the trigintaduonion and sexagintaquatronion gate formalization, with a trace log of each step.',\n      needs: [] },\n    { file: 'wesiri.html', title: 'WESIRI — Federated Light Protocol', group: 'OMI / GENESIS',\n      summary: 'A light-ring protocol over a graph of federated SVG documents.',\n      description: 'Rotating rings and a document graph of SVG nodes over a mock ESP32 lattice, with an NDJSON commit log, the Rumsfeldian epistemic quadrants (KK/KU/UK/UU), a Φ stop metric, the L1–L7 face invariants and a 16×16 shared buffer. Seek, sweep and line controls.',\n      needs: [] },\n    { file: 'GENESIS 3D Repo Visualizer.html', title: 'GENESIS 3D Repo Visualizer', group: 'OMI / GENESIS',\n      summary: 'A repo scan shown as a 3D realm, layer 0.',\n      description: 'Sample output of a genesis.sh scan drawn in three.js: meshes chosen by meta tags, rings for group boundaries and floating shells for wrappers.',\n      needs: ['CDN'] },\n\n    // 3D universes\n    { file: 'Browser-side Three.js with MQTT Controller.html', title: 'Three.js MQTT Controller', group: '3D universes',\n      summary: 'Several three.js views published over MQTT.',\n      description: 'A controller scene plus fixed-view scenes, each with its own camera. Connect to an MQTT broker over WebSockets and publish the views on demand or automatically.',\n      needs: ['MQTT broker', 'CDN'] },\n    { file: 'Tetrahedral Consciousness Universe - Interactive Browser Demo (1).html', title: 'Tetrahedral Consciousness Universe', group: '3D universes',\n      summary: 'One tetrahedron of 8-bit states evolving over time.',\n      description: 'The single-tetrahedron version: set focus (α), noise and time flow, then run, step or reset while entropy, coherence, integration and the centroid are tracked.',\n      needs: ['CDN'] },\n    { file: 'Tetrahedral Consciousness Universe - Interactive Browser Demo.html', title: 'Collective Consciousness Mesh', group: '3D universes',\n      summary: 'A grid of coupled tetrahedra syncing with each other.',\n      description: 'The networked version of the tetrahedral universe: a mesh of nodes with coupling, noise and focus controls, node / connection / field views, and buttons to randomize, synchronize or send a wave, with global coherence and synchronization readouts.',\n      needs: ['CDN'] },\n    { file: 'Recursive Consensus Universe.html', title: 'Recursive Consensus Universe', group: '3D universes',\n      summary: 'Observers converging on consensus nodes, in A-Frame.',\n      description: 'ΔD(Ψₙ) = 1 ⇔ QₙΨₙ = ΨC,ₙ as a navigable scene. Choose the operator (min, max, avg, product, geometric mean) and threshold; click a node to inspect its kind, level and α.',\n      needs: ['CDN'] },\n    { file: 'Semantic Universe Visualization.html', title: 'Semantic Universe', group: '3D universes',\n      summary: 'Words placed as points; sentences built as tetrahedra.',\n      description: 'Add word–definition pairs tagged by part of speech, then pick a noun, verb, adjective and pronoun to build a sentence tetrahedron sized by its resonance.',\n      needs: ['CDN'] },\n    { file: 'Philosophical Constellation Visualization.html', title: 'Philosophical Constellation', group: '3D universes',\n      summary: 'Concepts placed by their mathematical signature.',\n      description: 'Each concept is positioned from its length, trigonometric values and distance from centre. Switch between constellation, polygon and radial layouts and click a node to see its properties.',\n      needs: [] },\n    { file: 'The Reality Compiler - Interactive Multiverse.html', title: 'The Reality Compiler', group: '3D universes',\n      summary: 'Compose function pipelines into “systems” and run them in 3D.',\n      description: 'Pick functions (math, data, state, string, MCP) and initial JSON to create a system, or quantize a phrase into one with Gemini; then run a selection sequence and inspect each system’s pipeline and result.',\n      needs: ['Gemini key', 'CDN'] },\n    { file: 'Cryptocurrency 5-Simplex Visualization.html', title: 'Cryptocurrency 5-Simplex', group: '3D universes',\n      summary: 'Live coin prices as spheres on a 5-simplex.',\n      description: 'Fetches prices from CoinGecko every 30 seconds and draws each coin as a sphere sized by price, joined as the vertices of a 5-simplex.',\n      needs: ['Internet', 'CDN'] },\n    { file: 'Cryptocurrency Fano Plane Cycle Visualization.html', title: 'Cryptocurrency Fano Plane Cycle', group: '3D universes',\n      summary: 'Live coin prices as spheres on the Fano plane’s lines.',\n      description: 'The same CoinGecko feed as the 5-simplex page, with seven coins joined along the seven lines of the Fano plane.',\n      needs: ['Internet', 'CDN'] },\n\n    // Protocol demos\n    { file: 'UBHP Harmonic Signature Demo.html', title: 'UBHP Harmonic Signature Demo', group: 'Protocol demos',\n      summary: 'Harmonic signatures for text, compared in a similarity matrix.',\n      description: 'The Universal Binary Hypergraph Protocol’s harmonic signature (golden-ratio based) for each input, with a matrix of distances once there are at least two.',\n      needs: [] },\n    { file: 'Zero-Graph Harmonic Client.html', title: 'Zero-Graph Harmonic Client', group: 'Protocol demos',\n      summary: 'A harmonic database of words, searchable and shared over libp2p.',\n      description: 'Add words or text as harmonic vectors, search by cosine similarity, export and import the database as JSON, and start a libp2p node to connect to peers and sync.',\n      needs: ['CDN'] },\n    { file: 'The 7-Day God Mirror - Protocol Edition.html', title: 'The 7-Day God Mirror', group: 'Protocol demos',\n      summary: 'A seven-day “God is ___” journal with a sovereign identity.',\n      description: 'Each day’s answer is encoded with the IP6 universal basis (modulo 7, basis 5) and signed with a generated identity. Journal, pattern, calendar and collective views, binomial pattern analysis, and an exportable protocol signature.',\n      needs: [] },\n    { file: 'God Mirror Embeddable Widget.html', title: 'God Mirror Embeddable Widget', group: 'Protocol demos',\n      summary: 'A one-question “God is ___” widget you can embed anywhere.',\n      description: 'Answer in one word; it is saved only on your device. Share it, or copy the embed code for your own site; links to the full 7-day app.',\n      needs: [] },\n    { file: 'epistemic-observability-engine.html', title: 'Epistemic Observability Engine', group: 'Protocol demos',\n      summary: 'Epistemic vectors, observability bounded by φ(V), and geometric RBAC.',\n      description: 'A canvas model: place points and canonicalize them by reflecting toward the dominant chamber, watch UK variance kept bounded by Euler’s totient φ(V), and see Q* cost and geometric role-based access, with a provenance log.',\n      needs: [] },\n\n    // Apps\n    { file: 'Mobile Security Camera App.html', title: 'Mobile Security Camera', group: 'Apps',\n      summary: 'Turn a phone or laptop camera into a motion-detecting monitor.',\n      description: 'Choose a camera, set motion sensitivity, and it flags motion with automatic screenshots; also records video, takes manual screenshots and has a night mode. Everything stays in the browser.',\n      needs: ['Camera'] },\n  ];\n\n  const needLabels = {\n    Microphone: 'Asks for the microphone',\n    Camera: 'Asks for the camera',\n    Internet: 'Fetches live data online',\n    'Gemini key': 'Needs a Gemini API key',\n    'MQTT broker': 'Needs an MQTT broker on ws://localhost:8083',\n    CDN: 'Loads libraries from a CDN, so needs internet',\n  };\n\n  const groupsEl = document.getElementById('groups');\n  const filterEl = document.getElementById('filter');\n  const emptyEl = document.getElementById('empty');\n  const countEl = document.getElementById('count');\n  const groups = [...new Set(pages.map((p) => p.group))];\n\n  const el = (tag, className, text) => {\n    const node = document.createElement(tag);\n    if (className) node.className = className;\n    if (text != null) node.textContent = text;\n    return node;\n  };\n\n  const card = (page) => {\n    const a = el('a', 'card');\n    a.href = encodeURIComponent(page.file);\n    const meta = el('div', 'meta');\n    meta.append(el('span', 'pill', page.group), el('span', null, `#${pages.indexOf(page) + 1}`));\n    a.append(meta, el('h3', null, page.title), el('p', 'summary', page.summary), el('p', 'desc', page.description));\n    if (page.needs.length) {\n      const badges = el('div', 'badges');\n      for (const need of page.needs) {\n        const badge = el('span', 'badge', need);\n        badge.title = needLabels[need] ?? need;\n        badges.append(badge);\n      }\n      a.append(badges);\n    }\n    a.append(el('div', 'file', page.file));\n    return a;\n  };\n\n  const render = () => {\n    const q = filterEl.value.trim().toLowerCase();\n    const visible = pages.filter((p) =>\n      !q || [p.title, p.group, p.summary, p.description, p.file, ...p.needs].some((t) => t.toLowerCase().includes(q)));\n    groupsEl.replaceChildren();\n    for (const group of groups) {\n      const items = visible.filter((p) => p.group === group);\n      if (!items.length) continue;\n      const section = el('section');\n      const grid = el('div', 'grid');\n      grid.append(...items.map(card));\n      section.append(el('h2', null, group), grid);\n      groupsEl.append(section);\n    }\n    countEl.textContent = q ? `${visible.length} of ${pages.length} pages` : `${pages.length} pages`;\n    emptyEl.hidden = visible.length > 0;\n    emptyEl.textContent = `No pages match “${filterEl.value}”.`;\n  };\n\n  filterEl.value = decodeURIComponent(location.hash.slice(1));\n  filterEl.addEventListener('input', () => {\n    history.replaceState(null, '', filterEl.value ? `#${encodeURIComponent(filterEl.value)}` : location.pathname);\n    render();\n  });\n  render();\n</script>\n</body>\n</html>\n
      OPEN
    OPEN
  OPEN
