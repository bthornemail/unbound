DOCTYPE <!doctype html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n  
    STARTTAG <meta charset="utf-8">
    TEXT \n  
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1">
    TEXT \n  
    STARTTAG <title>
      RAWTEXT Codepoint Popup Book · literal paths\n  <!--\n    Plain-text friendly SPA for busybox httpd / any HTTP/1.1 server.\n    Expected response headers when served:\n      Content-Type: text/html; charset=utf-8\n    Linked resources (SVG, VTT) are fetched as:\n      image/svg+xml  ·  text/vtt  ·  text/plain\n    No CDN, no imports, no build. Relative paths only.\n  -->\n  <style>\n    :root {\n      --bg: #071013;\n      --ink: #d7fff5;\n      --dim: #6a9a8e;\n      --accent: #72ffe0;\n      --cell: #122022;\n      --line: #23695d;\n      --hot: #c26a2b;\n      --ok: #2f7d4a;\n      --stage-w: min(96vw, 960px);\n      --stage-h: min(58vh, 540px);\n    }\n    @media (prefers-color-scheme: light) {\n      :root {\n        --bg: #f4f7f6; --ink: #122022; --dim: #4a6a60;\n        --accent: #0a6a5a; --cell: #fff; --line: #8ab;\n      }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n    * { box-sizing: border-box; }\n    html, body {\n      margin: 0; min-height: 100%;\n      background: var(--bg); color: var(--ink);\n      font: 14px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    }\n    main {\n      max-width: 1100px; margin: 0 auto;\n      padding: max(12px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right))\n               max(24px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));\n    }\n    header { margin-bottom: 1rem; }\n    h1 {\n      margin: 0 0 .25rem; font-size: clamp(1.2rem, 4vw, 1.6rem);\n      color: var(--accent); letter-spacing: .04em;\n    }\n    .sub { color: var(--dim); font-size: 12px; }\n    .book {\n      display: grid;\n      grid-template-columns: minmax(160px, 220px) 1fr;\n      gap: 1rem;\n    }\n    @media (max-width: 720px) {\n      .book { grid-template-columns: 1fr; }\n    }\n    nav.paths {\n      border: 1px solid var(--line); border-radius: 8px;\n      background: var(--cell); padding: .6rem .5rem;\n      max-height: var(--stage-h); overflow: auto;\n    }\n    nav.paths button {\n      display: block; width: 100%; text-align: left;\n      background: transparent; border: 0; color: var(--ink);\n      font: inherit; padding: .4rem .5rem; border-radius: 4px;\n      cursor: pointer;\n    }\n    nav.paths button:hover,\n    nav.paths button[aria-current="page"] {\n      background: #1a3030; color: var(--accent);\n    }\n    nav.paths .child {\n      padding-left: 1.1rem; color: var(--dim); font-size: 12px;\n    }\n    nav.paths .child[aria-current="page"] { color: var(--accent); }\n    .stage-wrap {\n      border: 1px solid var(--line); border-radius: 8px;\n      background: #020607; overflow: hidden;\n      display: flex; flex-direction: column;\n    }\n    .stage-bar {\n      display: flex; flex-wrap: wrap; gap: .5rem; align-items: center;\n      padding: .5rem .75rem; border-bottom: 1px solid var(--line);\n      font-size: 12px; color: var(--dim);\n    }\n    .stage-bar strong { color: var(--accent); font-weight: 600; }\n    .stage-bar button {\n      font: inherit; font-size: 12px; cursor: pointer;\n      background: var(--cell); color: var(--ink);\n      border: 1px solid var(--line); border-radius: 4px;\n      padding: .25rem .55rem;\n    }\n    .stage-bar button:hover { border-color: var(--accent); color: var(--accent); }\n    canvas#page {\n      display: block; width: 100%; height: var(--stage-h);\n      background: #020607; touch-action: none;\n    }\n    .cue-panel {\n      border-top: 1px solid var(--line);\n      padding: .55rem .75rem; min-height: 3.2rem;\n      font-size: 12px; color: var(--dim);\n    }\n    .cue-panel .active { color: var(--accent); }\n    .meta {\n      margin-top: .75rem; font-size: 11px; color: var(--dim);\n      display: grid; gap: .35rem;\n    }\n    .meta code { color: var(--ink); }\n    video#cue-engine {\n      position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>CODEPOINT POPUP BOOK</h1>\n      <p class="sub">\n        Uppercase template-literal paths · nested lowercase codepoint children ·\n        canvas pages · TextTrack / VTTCue frames · media-query layout ·\n        HTTP/1.1 relative fetches (<code>text/html</code>, <code>image/svg+xml</code>, <code>text/vtt</code>)\n      </p>\n    </header>\n\n    <div class="book">\n      <nav class="paths" id="path-nav" aria-label="Literal path index"></nav>\n      <div class="stage-wrap">\n        <div class="stage-bar">\n          <span>page <strong id="page-name">—</strong></span>\n          <span id="page-range">range 20–7E</span>\n          <button type="button" id="btn-prev" title="Previous page">←</button>\n          <button type="button" id="btn-next" title="Next page">→</button>\n          <button type="button" id="btn-step" title="Advance delta">Δ step</button>\n          <button type="button" id="btn-play" title="Play cue track">play cues</button>\n          <span id="state-hex">state 0x0000</span>\n        </div>\n        <canvas id="page" width="960" height="540" aria-label="SVG page canvas"></canvas>\n        <div class="cue-panel" id="cue-panel" aria-live="polite">\n          <span class="active" id="cue-text">load a path · cues bind to TextTrack</span>\n        </div>\n      </div>\n    </div>\n\n    <div class="meta">\n      <div>path grammar: <code>(/[:uppercase:][:lowercase:]?/)</code> nested — Uppercase = MPT node (template literal name), lowercase = child codepoint list</div>\n      <div>delta: <code>rotl16(1) ^ rotl16(3) ^ rotl16(14) ^ 0x1d1d</code> · same law as probe / agent-commons</div>\n      <div>MIME when served over HTTP/1.1: document <code>text/html; charset=utf-8</code> · pages <code>image/svg+xml</code> · cues <code>text/vtt</code></div>\n    </div>\n  </main>\n\n  <!-- Hidden media element hosts TextTrack; cues drive frame labels -->\n  <video id="cue-engine" muted playsinline></video>\n\n  <script>\n(function () {\n  'use strict';\n\n  // ── delta law (W16) — projection of the BusyBox probe ─────────────\n  function rotl16(v, n) {\n    return ((v << n) | (v >>> (16 - n))) & 0xffff;\n  }\n  function nextState(v) {\n    return (rotl16(v, 1) ^ rotl16(v, 3) ^ rotl16(v, 14) ^ 0x1d1d) & 0xffff;\n  }\n\n  // ── selected literal range (printable ASCII) ─────────────────────\n  const RANGE_LO = 0x20;\n  const RANGE_HI = 0x7e;\n\n  // ── Uppercase template-literal path tree ─────────────────────────\n  // Shape: (/[:uppercase:][:lowercase:]?/) nested\n  // Uppercase = MPT node / page key\n  // lowercase = child codepoint-list segment\n  const PATHS = {\n    WORD: {\n      src: null,\n      kind: 'literal',\n      text: 'WORD',\n      children: {\n        codepoints: [0x57, 0x4f, 0x52, 0x44],\n        reverse: 'DROW',\n      },\n    },\n    GOD: {\n      src: null,\n      kind: 'literal',\n      text: 'GOD',\n      children: {\n        codepoints: [0x47, 0x4f, 0x44],\n        reverse: 'DOG',\n      },\n    },\n    OF: {\n      src: null,\n      kind: 'literal',\n      text: 'OF',\n      children: {\n        codepoints: [0x4f, 0x46],\n        dual: 'of',\n        dualCodepoints: [0x6f, 0x66],\n        xor: [0x20, 0x20],\n      },\n    },\n    IS: {\n      src: null,\n      kind: 'literal',\n      text: 'IS',\n      children: {\n        codepoints: [0x49, 0x53],\n        dual: 'is',\n        dualCodepoints: [0x69, 0x73],\n        xor: [0x20, 0x20],\n      },\n    },\n    CGAT: {\n      src: './Difference_DNA_RNA-EN.svg',\n      kind: 'svg',\n      children: {\n        bases: ['C', 'G', 'A', 'T'],\n        codepoints: [0x43, 0x47, 0x41, 0x54],\n      },\n    },\n    CGAU: {\n      src: './Difference_DNA_RNA-EN.svg',\n      kind: 'svg',\n      children: {\n        bases: ['C', 'G', 'A', 'U'],\n        codepoints: [0x43, 0x47, 0x41, 0x55],\n      },\n    },\n    E8: {\n      src: './e8-step.svg',\n      kind: 'svg',\n      children: {\n        step: '12deg',\n        shells: 8,\n        roots: 240,\n      },\n    },\n    CLA: {\n      src: './Four_bit_adder_with_carry_lookahead.svg',\n      kind: 'svg',\n      children: {\n        bits: 4,\n        orbit: ['AA55', '718E', 'EE11', 'CA35'],\n      },\n    },\n    KMAP: {\n      src: './Karnaugh_map_torus.svg',\n      kind: 'svg',\n      children: {\n        gray: true,\n        alt: './K-map_6,8,9,10,11,12,13,14.svg',\n      },\n    },\n    SMITH: {\n      src: './Smith_chart_gen.svg',\n      kind: 'svg',\n      children: {\n        step: '12deg',\n      },\n    },\n    PROOFS: {\n      src: './visual-proofs.svg',\n      kind: 'svg',\n      children: {\n        table: 'periodic',\n        elements: 34,\n      },\n    },\n    DELTA: {\n      src: null,\n      kind: 'law',\n      children: {\n        formula: 'rotl1^rotl3^rotl14^0x1d1d',\n        width: 16,\n        period: 8,\n      },\n    },\n  };\n\n  // Flat page order for prev/next (Uppercase nodes only)\n  const PAGE_KEYS = Object.keys(PATHS);\n\n  // ── DOM ──────────────────────────────────────────────────────────\n  const canvas = document.getElementById('page');\n  const ctx = canvas.getContext('2d');\n  const nav = document.getElementById('path-nav');\n  const pageName = document.getElementById('page-name');\n  const pageRange = document.getElementById('page-range');\n  const stateHex = document.getElementById('state-hex');\n  const cueText = document.getElementById('cue-text');\n  const cueEngine = document.getElementById('cue-engine');\n  const btnPrev = document.getElementById('btn-prev');\n  const btnNext = document.getElementById('btn-next');\n  const btnStep = document.getElementById('btn-step');\n  const btnPlay = document.getElementById('btn-play');\n\n  let pageIndex = 0;\n  let state = 0x0000;\n  let raf = 0;\n  let imgCache = new Map();\n  let track = null;\n  let reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => draw());\n  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {\n    reducedMotion = e.matches;\n  });\n\n  // ── build path nav from Uppercase / lowercase tree ───────────────\n  function buildNav() {\n    nav.innerHTML = '';\n    for (const key of PAGE_KEYS) {\n      const node = PATHS[key];\n      const btn = document.createElement('button');\n      btn.type = 'button';\n      btn.textContent = key;\n      btn.dataset.key = key;\n      btn.addEventListener('click', () => openPage(key));\n      nav.appendChild(btn);\n      const kids = node.children || {};\n      for (const child of Object.keys(kids)) {\n        // lowercase child path\n        const cbtn = document.createElement('button');\n        cbtn.type = 'button';\n        cbtn.className = 'child';\n        cbtn.textContent = child;\n        cbtn.dataset.key = key;\n        cbtn.dataset.child = child;\n        cbtn.addEventListener('click', () => openPage(key, child));\n        nav.appendChild(cbtn);\n      }\n    }\n  }\n\n  function openPage(key, child) {\n    const idx = PAGE_KEYS.indexOf(key);\n    if (idx >= 0) pageIndex = idx;\n    const node = PATHS[key];\n    pageName.textContent = child ? `${key}/${child}` : key;\n    for (const b of nav.querySelectorAll('button')) {\n      const on =\n        b.dataset.key === key &&\n        (child ? b.dataset.child === child : !b.dataset.child);\n      b.setAttribute('aria-current', on ? 'page' : 'false');\n    }\n    loadCues(key, child);\n    draw(child);\n  }\n\n  // ── image load ───────────────────────────────────────────────────\n  function loadImage(src) {\n    if (!src) return Promise.resolve(null);\n    if (imgCache.has(src)) return Promise.resolve(imgCache.get(src));\n    return new Promise((resolve) => {\n      const img = new Image();\n      img.decoding = 'async';\n      img.onload = () => { imgCache.set(src, img); resolve(img); };\n      img.onerror = () => resolve(null);\n      // relative URL — server should send image/svg+xml\n      img.src = src;\n    });\n  }\n\n  // ── TextTrack / VTTCue frames ────────────────────────────────────\n  // Build an in-memory WebVTT from the path node, attach as blob track.\n  function loadCues(key, child) {\n    const node = PATHS[key];\n    const lines = [];\n    lines.push('WEBVTT');\n    lines.push('');\n    lines.push('NOTE HTTP/1.1 Content-Type: text/vtt');\n    lines.push('');\n    const kids = node.children || {};\n    let t = 0;\n    const mk = (label, body) => {\n      const a = fmtTime(t);\n      t += 1.2;\n      const b = fmtTime(t);\n      lines.push(`${a} --> ${b}`);\n      lines.push(`${label}: ${body}`);\n      lines.push('');\n    };\n    mk(key, node.kind || 'node');\n    if (child && kids[child] !== undefined) {\n      mk(child, formatChild(kids[child]));\n    } else {\n      for (const [k, v] of Object.entries(kids)) mk(k, formatChild(v));\n    }\n    mk('delta', '0x' + state.toString(16).padStart(4, '0'));\n    mk('range', RANGE_LO.toString(16) + '-' + RANGE_HI.toString(16));\n\n    const blob = new Blob([lines.join('\\n')], { type: 'text/vtt' });\n    const url = URL.createObjectURL(blob);\n\n    // reset video + track\n    while (cueEngine.textTracks.length) {\n      /* clear by replacing source */\n      break;\n    }\n    cueEngine.pause();\n    // Remove old tracks by resetting media\n    cueEngine.removeAttribute('src');\n    const old = cueEngine.querySelector('track');\n    if (old) old.remove();\n\n    const tr = document.createElement('track');\n    tr.kind = 'captions';\n    tr.label = key;\n    tr.srclang = 'en';\n    tr.src = url;\n    tr.default = true;\n    cueEngine.appendChild(tr);\n\n    // Silent media timeline long enough for cues (data URI wav silence optional;\n    // many browsers fire cues on track mode even without media — use play with empty)\n    // Use a minimal media: blank canvas stream is heavy; instead step cues manually on play.\n    track = null;\n    tr.addEventListener('load', () => {\n      track = tr.track;\n      if (track) track.mode = 'showing';\n    });\n    // Fallback: parse cues ourselves for display\n    window.__cueLines = lines.filter((l) => l && !l.startsWith('NOTE') && !l.startsWith('WEBVTT') && !l.includes('-->'));\n    window.__cueIdx = 0;\n    cueText.textContent = window.__cueLines[0] || '';\n  }\n\n  function fmtTime(sec) {\n    const m = Math.floor(sec / 60);\n    const s = sec % 60;\n    return `00:${String(m).padStart(2, '0')}:${s.toFixed(3).padStart(6, '0')}`;\n  }\n\n  function formatChild(v) {\n    if (Array.isArray(v)) {\n      if (typeof v[0] === 'number') {\n        return v.map((n) => n.toString(16).padStart(2, '0')).join(' ');\n      }\n      return v.join(',');\n    }\n    if (v && typeof v === 'object') return JSON.stringify(v);\n    return String(v);\n  }\n\n  // ── canvas draw ──────────────────────────────────────────────────\n  async function draw(child) {\n    const key = PAGE_KEYS[pageIndex];\n    const node = PATHS[key];\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const cssW = canvas.clientWidth || 960;\n    const cssH = canvas.clientHeight || 540;\n    canvas.width = Math.floor(cssW * dpr);\n    canvas.height = Math.floor(cssH * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n    const W = cssW;\n    const H = cssH;\n    const dark = matchMedia('(prefers-color-scheme: dark)').matches ||\n      !matchMedia('(prefers-color-scheme: light)').matches;\n\n    ctx.fillStyle = dark ? '#020607' : '#f8fafa';\n    ctx.fillRect(0, 0, W, H);\n\n    // try SVG page\n    let drewSvg = false;\n    if (node.src) {\n      const img = await loadImage(node.src);\n      if (img) {\n        const scale = Math.min((W - 24) / img.naturalWidth, (H - 24) / img.naturalHeight);\n        const dw = img.naturalWidth * scale;\n        const dh = img.naturalHeight * scale;\n        ctx.drawImage(img, (W - dw) / 2, (H - dh) / 2, dw, dh);\n        drewSvg = true;\n      }\n    }\n\n    // overlay: codepoint mapping strip + path\n    ctx.save();\n    ctx.fillStyle = dark ? 'rgba(7,16,19,0.82)' : 'rgba(255,255,255,0.88)';\n    ctx.fillRect(0, H - 72, W, 72);\n    ctx.fillStyle = dark ? '#72ffe0' : '#0a6a5a';\n    ctx.font = '13px ui-monospace, monospace';\n    ctx.fillText(pageName.textContent, 12, H - 48);\n\n    const kids = node.children || {};\n    let cps = null;\n    if (child && Array.isArray(kids[child]) && typeof kids[child][0] === 'number') {\n      cps = kids[child];\n    } else if (Array.isArray(kids.codepoints)) {\n      cps = kids.codepoints;\n    }\n    ctx.fillStyle = dark ? '#d7fff5' : '#122022';\n    ctx.font = '12px ui-monospace, monospace';\n    if (cps) {\n      const label = cps.map((n) => n.toString(16).padStart(2, '0')).join(' ');\n      ctx.fillText('codepoints ' + label, 12, H - 28);\n      // deviation vs selected range\n      const out = cps.filter((n) => n < RANGE_LO || n > RANGE_HI).length;\n      ctx.fillStyle = out ? '#c26a2b' : '#2f7d4a';\n      ctx.fillText(\n        out ? `deviation ${out} outside ${RANGE_LO.toString(16)}-${RANGE_HI.toString(16)}` :\n              `all inside ${RANGE_LO.toString(16)}-${RANGE_HI.toString(16)}`,\n        12, H - 10\n      );\n    } else if (child && kids[child] !== undefined) {\n      ctx.fillText(child + ' · ' + formatChild(kids[child]), 12, H - 28);\n    } else if (!drewSvg) {\n      // pure law / literal page\n      drawLiteralPage(ctx, W, H - 72, key, node, dark);\n    }\n\n    // state badge\n    ctx.fillStyle = dark ? '#6a9a8e' : '#4a6a60';\n    ctx.font = '11px ui-monospace, monospace';\n    ctx.textAlign = 'right';\n    ctx.fillText('Δ 0x' + state.toString(16).padStart(4, '0'), W - 12, H - 12);\n    ctx.textAlign = 'left';\n    ctx.restore();\n\n    stateHex.textContent = 'state 0x' + state.toString(16).padStart(4, '0');\n  }\n\n  function drawLiteralPage(ctx, W, H, key, node, dark) {\n    const text = node.text || key;\n    ctx.fillStyle = dark ? '#72ffe0' : '#0a6a5a';\n    ctx.font = 'bold 48px ui-monospace, monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(text, W / 2, H / 2 - 10);\n    const kids = node.children || {};\n    if (Array.isArray(kids.codepoints)) {\n      ctx.font = '18px ui-monospace, monospace';\n      ctx.fillStyle = dark ? '#d7fff5' : '#122022';\n      ctx.fillText(\n        kids.codepoints.map((n) => n.toString(16).padStart(2, '0')).join('  '),\n        W / 2,\n        H / 2 + 36\n      );\n    }\n    if (kids.xor) {\n      ctx.font = '14px ui-monospace, monospace';\n      ctx.fillStyle = '#e0c060';\n      ctx.fillText('⊕ ' + kids.xor.map((n) => n.toString(16)).join(' '), W / 2, H / 2 + 64);\n    }\n    if (kids.reverse) {\n      ctx.fillStyle = dark ? '#6a9a8e' : '#4a6a60';\n      ctx.fillText('↺ ' + kids.reverse, W / 2, H / 2 + 90);\n    }\n    ctx.textAlign = 'left';\n  }\n\n  // ── controls ─────────────────────────────────────────────────────\n  btnPrev.addEventListener('click', () => {\n    pageIndex = (pageIndex - 1 + PAGE_KEYS.length) % PAGE_KEYS.length;\n    openPage(PAGE_KEYS[pageIndex]);\n  });\n  btnNext.addEventListener('click', () => {\n    pageIndex = (pageIndex + 1) % PAGE_KEYS.length;\n    openPage(PAGE_KEYS[pageIndex]);\n  });\n  btnStep.addEventListener('click', () => {\n    state = nextState(state);\n    stateHex.textContent = 'state 0x' + state.toString(16).padStart(4, '0');\n    // use low bits to nudge page index when on DELTA\n    if (PAGE_KEYS[pageIndex] === 'DELTA') {\n      draw();\n    } else {\n      // subtle: re-draw with updated badge\n      draw(nav.querySelector('button[aria-current="page"]')?.dataset.child);\n    }\n  });\n  btnPlay.addEventListener('click', () => {\n    const lines = window.__cueLines || [];\n    if (!lines.length) return;\n    let i = 0;\n    const tick = () => {\n      cueText.textContent = lines[i] || '';\n      i += 1;\n      if (i < lines.length && !reducedMotion) {\n        setTimeout(tick, 1200);\n      }\n    };\n    tick();\n  });\n\n  // resize\n  window.addEventListener('resize', () => {\n    cancelAnimationFrame(raf);\n    raf = requestAnimationFrame(() => draw(\n      nav.querySelector('button[aria-current="page"]')?.dataset.child\n    ));\n  });\n\n  // ── init ─────────────────────────────────────────────────────────\n  buildNav();\n  pageRange.textContent = `range ${RANGE_LO.toString(16)}–${RANGE_HI.toString(16)}`;\n  openPage(PAGE_KEYS[0]);\n})();\n  </script>\n</body>\n</html>\n
      OPEN
    OPEN
  OPEN
