DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n    
    STARTTAG <meta charset="UTF-8">
    TEXT \n    
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n    
    STARTTAG <title>
      RAWTEXT The 7-Day God Mirror
    ENDTAG </title>
    TEXT \n    
    STARTTAG <style>
      RAWTEXT \n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 16px;\n        }\n        \n        .widget {\n            background: rgba(255, 255, 255, 0.97);\n            border-radius: 12px;\n            padding: 24px;\n            max-width: 480px;\n            width: 100%;\n            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\n        }\n        \n        .header {\n            text-align: center;\n            margin-bottom: 20px;\n        }\n        \n        .title {\n            font-size: 22px;\n            font-weight: 700;\n            color: #1e1b4b;\n            margin-bottom: 4px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 8px;\n        }\n        \n        .subtitle {\n            font-size: 13px;\n            color: #6b7280;\n        }\n        \n        .question {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            margin-bottom: 16px;\n        }\n        \n        .label {\n            font-size: 18px;\n            font-weight: 600;\n            color: #312e81;\n            white-space: nowrap;\n        }\n        \n        .input {\n            flex: 1;\n            padding: 10px 14px;\n            font-size: 16px;\n            border: 2px solid #8b5cf6;\n            border-radius: 8px;\n            outline: none;\n            transition: all 0.2s ease;\n        }\n        \n        .input:focus {\n            border-color: #7c3aed;\n            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);\n        }\n        \n        .input::placeholder {\n            color: #9ca3af;\n            font-style: italic;\n        }\n        \n        .buttons {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 8px;\n            margin-bottom: 12px;\n        }\n        \n        .btn {\n            padding: 10px 16px;\n            font-size: 14px;\n            font-weight: 600;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.2s ease;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n            text-decoration: none;\n        }\n        \n        .btn-primary {\n            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);\n            color: white;\n            grid-column: span 2;\n        }\n        \n        .btn-primary:hover {\n            transform: translateY(-1px);\n            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.4);\n        }\n        \n        .btn-secondary {\n            background: #f3f4f6;\n            color: #1e1b4b;\n            border: 1px solid #e5e7eb;\n        }\n        \n        .btn-secondary:hover {\n            background: #e5e7eb;\n        }\n        \n        .message {\n            background: #10b981;\n            color: white;\n            padding: 10px;\n            border-radius: 6px;\n            text-align: center;\n            font-size: 14px;\n            margin-bottom: 12px;\n            display: none;\n        }\n        \n        .message.show {\n            display: block;\n            animation: slideIn 0.3s ease;\n        }\n        \n        @keyframes slideIn {\n            from { opacity: 0; transform: translateY(-10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .info {\n            padding-top: 12px;\n            border-top: 1px solid #e5e7eb;\n            font-size: 12px;\n            color: #6b7280;\n            text-align: center;\n            line-height: 1.5;\n        }\n        \n        .modal {\n            display: none;\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: rgba(0, 0, 0, 0.75);\n            z-index: 1000;\n            align-items: center;\n            justify-content: center;\n            padding: 16px;\n        }\n        \n        .modal.show {\n            display: flex;\n            animation: fadeIn 0.2s ease;\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n        \n        .modal-content {\n            background: white;\n            border-radius: 12px;\n            width: 100%;\n            max-width: 500px;\n            max-height: 90vh;\n            overflow-y: auto;\n            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);\n        }\n        \n        .modal-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 16px 20px;\n            border-bottom: 1px solid #e5e7eb;\n        }\n        \n        .modal-title {\n            font-size: 18px;\n            font-weight: 600;\n            color: #1e1b4b;\n        }\n        \n        .modal-close {\n            background: none;\n            border: none;\n            font-size: 24px;\n            color: #6b7280;\n            cursor: pointer;\n            padding: 0;\n            width: 28px;\n            height: 28px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 4px;\n            transition: all 0.2s ease;\n        }\n        \n        .modal-close:hover {\n            background: #f3f4f6;\n            color: #1e1b4b;\n        }\n        \n        .modal-body {\n            padding: 20px;\n        }\n        \n        .modal-text {\n            margin-bottom: 12px;\n            color: #6b7280;\n            font-size: 13px;\n        }\n        \n        .textarea {\n            width: 100%;\n            height: 140px;\n            padding: 10px;\n            font-family: 'Monaco', 'Courier New', monospace;\n            font-size: 11px;\n            border: 2px solid #e5e7eb;\n            border-radius: 6px;\n            resize: vertical;\n            background: #f9fafb;\n            color: #1e1b4b;\n            line-height: 1.4;\n        }\n        \n        .textarea:focus {\n            outline: none;\n            border-color: #8b5cf6;\n        }\n        \n        @media (max-width: 480px) {\n            .widget {\n                padding: 20px;\n            }\n            \n            .question {\n                flex-direction: column;\n                align-items: stretch;\n                gap: 6px;\n            }\n            \n            .label {\n                font-size: 16px;\n            }\n            \n            .buttons {\n                grid-template-columns: 1fr;\n            }\n            \n            .btn-primary {\n                grid-column: span 1;\n            }\n        }\n    
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n    
    STARTTAG <div class="widget">
      TEXT \n        
      STARTTAG <div class="header">
        TEXT \n            
        STARTTAG <div class="title">
          TEXT \n                
          STARTTAG <span>
            TEXT ✨
          ENDTAG </span>
          TEXT \n                The 7-Day God Mirror\n            
        ENDTAG </div>
        TEXT \n            
        STARTTAG <div class="subtitle">
          TEXT Answer honestly. Just one word.
        ENDTAG </div>
        TEXT \n        
      ENDTAG </div>
      TEXT \n        \n        
      STARTTAG <div class="question">
        TEXT \n            
        STARTTAG <span class="label">
          TEXT God is
        ENDTAG </span>
        TEXT \n            
        STARTTAG <input \n                type="text" \n                id="godAnswer" \n                class="input" \n                placeholder="your answer..."\n                maxlength="50"\n            >
        TEXT \n        
      ENDTAG </div>
      TEXT \n        \n        
      STARTTAG <div id="savedMessage" class="message">
        TEXT \n            ✓ Saved to your device!\n        
      ENDTAG </div>
      TEXT \n        \n        
      STARTTAG <div class="buttons">
        TEXT \n            
        STARTTAG <button class="btn btn-primary" onclick="saveAnswer()">
          TEXT \n                💾 Save Answer\n            
        ENDTAG </button>
        TEXT \n            
        STARTTAG <button class="btn btn-secondary" onclick="shareAnswer()">
          TEXT \n                🔗 Share\n            
        ENDTAG </button>
        TEXT \n            
        STARTTAG <button class="btn btn-secondary" onclick="showEmbed()">
          TEXT \n                📋 Embed\n            
        ENDTAG </button>
        TEXT \n            
        STARTTAG <a \n                href="https://bthornemail.github.io/god-is-word/" \n                target="_blank"\n                class="btn btn-secondary"\n                style="grid-column: span 2;"\n            >
          TEXT \n                📊 View Full App\n            
        ENDTAG </a>
        TEXT \n        
      ENDTAG </div>
      TEXT \n        \n        
      STARTTAG <div class="info">
        TEXT \n            Your answer is saved only on your device.
        STARTTAG <br>
        TEXT \n            Complete all 7 days in the full app to see patterns.\n        
      ENDTAG </div>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div id="embedModal" class="modal" onclick="if(event.target===this) closeEmbed()">
      TEXT \n        
      STARTTAG <div class="modal-content">
        TEXT \n            
        STARTTAG <div class="modal-header">
          TEXT \n                
          STARTTAG <div class="modal-title">
            TEXT Embed This Widget
          ENDTAG </div>
          TEXT \n                
          STARTTAG <button class="modal-close" onclick="closeEmbed()">
            TEXT &times;
          ENDTAG </button>
          TEXT \n            
        ENDTAG </div>
        TEXT \n            
        STARTTAG <div class="modal-body">
          TEXT \n                
          STARTTAG <p class="modal-text">
            TEXT \n                    Copy and paste this code into your website:\n                
          ENDTAG </p>
          TEXT \n                
          STARTTAG <textarea \n                    id="embedCode" \n                    class="textarea"\n                    readonly\n                    onclick="this.select()"\n                >
          ENDTAG </textarea>
          TEXT \n                
          STARTTAG <button class="btn btn-primary" style="width: 100%; margin-top: 12px;" onclick="copyEmbed()">
            TEXT \n                    📋 Copy to Clipboard\n                
          ENDTAG </button>
          TEXT \n                
          STARTTAG <div id="copyMessage" class="message" style="margin-top: 12px;">
            TEXT \n                    ✓ Copied!\n                
          ENDTAG </div>
          TEXT \n            
        ENDTAG </div>
        TEXT \n        
      ENDTAG </div>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <script>
      RAWTEXT \n        const WIDGET_URL = 'https://bthornemail.github.io/god-is-word/widget.html';\n        const APP_URL = 'https://bthornemail.github.io/god-is-word/';\n        \n        function saveAnswer() {\n            const input = document.getElementById('godAnswer');\n            const message = document.getElementById('savedMessage');\n            const answer = input.value.trim();\n            \n            if (!answer) {\n                alert('Please enter an answer first');\n                return;\n            }\n            \n            let quickAnswers = JSON.parse(localStorage.getItem('god_quick_answers') || '[]');\n            \n            quickAnswers.push({\n                word: answer,\n                timestamp: new Date().toISOString(),\n                source: 'widget'\n            });\n            \n            localStorage.setItem('god_quick_answers', JSON.stringify(quickAnswers));\n            \n            message.classList.add('show');\n            input.value = '';\n            \n            setTimeout(() => {\n                message.classList.remove('show');\n            }, 2500);\n        }\n        \n        function shareAnswer() {\n            const input = document.getElementById('godAnswer');\n            const answer = input.value.trim();\n            \n            if (!answer) {\n                alert('Please enter an answer first to share it');\n                return;\n            }\n            \n            const shareText = `God is ${answer}\\n\\nMy answer from The 7-Day God Mirror 🪞✨\\n\\nWhat do you think?\\n${APP_URL}`;\n            \n            if (navigator.share) {\n                navigator.share({\n                    title: 'The 7-Day God Mirror',\n                    text: shareText\n                }).catch(() => fallbackShare(shareText));\n            } else {\n                fallbackShare(shareText);\n            }\n        }\n        \n        function fallbackShare(text) {\n            navigator.clipboard.writeText(text).then(() => {\n                alert('📋 Share text copied to clipboard!\\n\\nPaste it anywhere to share your answer.');\n            }).catch(() => {\n                prompt('Copy this text to share:', text);\n            });\n        }\n        \n        function showEmbed() {\n            const modal = document.getElementById('embedModal');\n            const embedCode = document.getElementById('embedCode');\n            \n            const code = `<!-- The 7-Day God Mirror Widget -->\n<iframe \n    src="${WIDGET_URL}" \n    width="100%" \n    height="400" \n    frameborder="0"\n    style="border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 500px;"\n    title="The 7-Day God Mirror"\n></iframe>`;\n            \n            embedCode.value = code;\n            modal.classList.add('show');\n        }\n        \n        function closeEmbed() {\n            document.getElementById('embedModal').classList.remove('show');\n        }\n        \n        function copyEmbed() {\n            const embedCode = document.getElementById('embedCode');\n            const copyMessage = document.getElementById('copyMessage');\n            \n            embedCode.select();\n            navigator.clipboard.writeText(embedCode.value).then(() => {\n                copyMessage.classList.add('show');\n                setTimeout(() => {\n                    copyMessage.classList.remove('show');\n                }, 2000);\n            });\n        }\n        \n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'Escape') closeEmbed();\n        });\n        \n        document.getElementById('godAnswer').addEventListener('keypress', (e) => {\n            if (e.key === 'Enter') saveAnswer();\n        });\n    
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
