    TEXT \n    
    STARTTAG <title>
      RAWTEXT Collective Consciousness Mesh - Digital Minds Network\n    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>\n    <style>\n        body {\n            margin: 0;\n            padding: 0;\n            background: linear-gradient(135deg, #0a0a0a, #1a1a2e, #16213e);\n            font-family: 'Courier New', monospace;\n            color: #ffffff;\n            overflow: hidden;\n        }\n        \n        #container {\n            position: relative;\n            width: 100vw;\n            height: 100vh;\n        }\n        \n        #controls {\n            position: absolute;\n            top: 20px;\n            left: 20px;\n            z-index: 100;\n            background: rgba(0, 0, 0, 0.9);\n            padding: 20px;\n            border-radius: 10px;\n            border: 1px solid #444;\n            backdrop-filter: blur(10px);\n            min-width: 320px;\n            max-height: 80vh;\n            overflow-y: auto;\n        }\n        \n        #info {\n            position: absolute;\n            top: 20px;\n            right: 20px;\n            z-index: 100;\n            background: rgba(0, 0, 0, 0.9);\n            padding: 20px;\n            border-radius: 10px;\n            border: 1px solid #444;\n            backdrop-filter: blur(10px);\n            min-width: 280px;\n            max-height: 80vh;\n            overflow-y: auto;\n            font-size: 11px;\n        }\n        \n        .control-group {\n            margin-bottom: 15px;\n        }\n        \n        label {\n            display: block;\n            margin-bottom: 5px;\n            color: #00ffff;\n            font-size: 13px;\n        }\n        \n        input[type="range"] {\n            width: 100%;\n            margin-bottom: 5px;\n        }\n        \n        button {\n            background: linear-gradient(45deg, #ff6b6b, #ff8e53);\n            border: none;\n            color: white;\n            padding: 8px 16px;\n            border-radius: 5px;\n            cursor: pointer;\n            margin: 3px;\n            font-weight: bold;\n            font-size: 12px;\n        }\n        \n        button:hover {\n            opacity: 0.8;\n        }\n        \n        button.active {\n            background: linear-gradient(45deg, #4ecdc4, #44a08d);\n        }\n        \n        .metric {\n            display: flex;\n            justify-content: space-between;\n            margin: 3px 0;\n            padding: 3px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 3px;\n            font-size: 11px;\n        }\n        \n        .consciousness-node {\n            margin: 5px 0;\n            padding: 8px;\n            background: rgba(0, 255, 255, 0.1);\n            border-radius: 5px;\n            border-left: 3px solid #00ffff;\n        }\n        \n        .node-header {\n            font-weight: bold;\n            color: #00ffff;\n            margin-bottom: 3px;\n        }\n        \n        .binary-display {\n            font-family: 'Courier New', monospace;\n            font-size: 9px;\n            margin: 1px 0;\n            padding: 2px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 2px;\n        }\n        \n        #title {\n            position: absolute;\n            bottom: 20px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 100;\n            font-size: 20px;\n            font-weight: bold;\n            color: #00ffff;\n            text-shadow: 0 0 10px #00ffff;\n            text-align: center;\n        }\n        \n        .network-stats {\n            background: rgba(255, 255, 0, 0.1);\n            border-left: 3px solid #ffff00;\n            padding: 8px;\n            margin: 10px 0;\n            border-radius: 5px;\n        }\n    </style>\n</head>\n<body>\n    <div id="container">\n        <div id="controls">\n            <h3 style="color: #00ffff; margin-top: 0;">Collective Consciousness Network</h3>\n            \n            <div class="control-group">\n                <label for="meshSize">Mesh Size: <span id="meshSizeValue">3x3</span></label>\n                <input type="range" id="meshSize" min="2" max="5" step="1" value="3">\n            </div>\n            \n            <div class="control-group">\n                <label for="alpha">Consciousness Focus (α): <span id="alphaValue">1.0</span></label>\n                <input type="range" id="alpha" min="0.1" max="3.0" step="0.1" value="1.0">\n            </div>\n            \n            <div class="control-group">\n                <label for="coupling">Network Coupling: <span id="couplingValue">0.1</span></label>\n                <input type="range" id="coupling" min="0.0" max="0.5" step="0.01" value="0.1">\n            </div>\n            \n            <div class="control-group">\n                <label for="mutationRate">Quantum Noise: <span id="mutationValue">0.05</span></label>\n                <input type="range" id="mutationRate" min="0.01" max="0.3" step="0.01" value="0.05">\n            </div>\n            \n            <div class="control-group">\n                <label for="evolutionSpeed">Time Flow: <span id="speedValue">200</span>ms</label>\n                <input type="range" id="evolutionSpeed" min="50" max="1000" step="50" value="200">\n            </div>\n            \n            <div class="control-group">\n                <button id="startStop">Start Evolution</button>\n                <button id="reset">Reset Network</button>\n                <button id="step">Single Step</button>\n            </div>\n            \n            <div class="control-group">\n                <label>Visualization Mode:</label>\n                <button id="showNodes" class="active">Nodes</button>\n                <button id="showConnections">Connections</button>\n                <button id="showFields">Fields</button>\n            </div>\n            \n            <div class="control-group">\n                <button id="randomizeStates">Randomize States</button>\n                <button id="synchronize">Synchronize All</button>\n                <button id="createWave">Create Wave</button>\n            </div>\n        </div>\n        \n        <div id="info">\n            <h3 style="color: #00ffff; margin-top: 0;">Network Consciousness</h3>\n            \n            <div class="network-stats">\n                <div class="metric">\n                    <span>Network Size:</span>\n                    <span id="networkSize">9 nodes</span>\n                </div>\n                <div class="metric">\n                    <span>Global Coherence:</span>\n                    <span id="globalCoherence">0.000</span>\n                </div>\n                <div class="metric">\n                    <span>Synchronization:</span>\n                    <span id="synchronization">0.000</span>\n                </div>\n                <div class="metric">\n                    <span>Information Flow:</span>\n                    <span id="informationFlow">0.000</span>\n                </div>\n                <div class="metric">\n                    <span>Time Step:</span>\n                    <span id="timeStep">0</span>\n                </div>\n            </div>\n            \n            <div style="margin-top: 15px;">\n                <h4 style="color: #00ffff;">Individual Consciousness Nodes:</h4>\n                <div id="consciousnessNodes"></div>\n            </div>\n            \n            <div style="margin-top: 15px;">\n                <h4 style="color: #00ffff;">Network Topology:</h4>\n                <div id="networkTopology" style="font-family: 'Courier New', monospace; font-size: 10px;"></div>\n            </div>\n        </div>\n        \n        <div id="title">\n            Collective Consciousness Mesh<br>\n            <span style="font-size: 14px; color: #ffff00;">Digital Minds Interacting</span>\n        </div>\n    </div>\n\n    <script>\n        class ConsciousnessNode {\n            constructor(id, position) {\n                this.id = id;\n                this.position = position.clone();\n                \n                // Tetrahedral vertices relative to position\n                this.localVertices = [\n                    new THREE.Vector3(0.2, 0.2, 0.2),\n                    new THREE.Vector3(0.2, -0.2, -0.2),\n                    new THREE.Vector3(-0.2, 0.2, -0.2),\n                    new THREE.Vector3(-0.2, -0.2, 0.2)\n                ];\n                \n                // Binary states for each vertex\n                this.binaryStates = [\n                    this.randomBinary(),\n                    this.randomBinary(),\n                    this.randomBinary(),\n                    this.randomBinary()\n                ];\n                \n                // Consciousness properties\n                this.centroid = new THREE.Vector3();\n                this.attentionVectors = [];\n                this.neighbors = [];\n                this.connectionStrengths = new Map();\n                \n                // Metrics\n                this.entropy = 0;\n                this.coherence = 0;\n                this.integration = 0;\n                this.activity = 0;\n                \n                // 3D objects\n                this.vertexSpheres = [];\n                this.attentionArrows = [];\n                this.centroidStar = null;\n                this.connectionLines = [];\n            }\n            \n            randomBinary() {\n                return Array.from({length: 8}, () => Math.random() > 0.5 ? 1 : 0);\n            }\n            \n            binaryToAttentionVector(binary) {\n                const thetaBits = binary.slice(0, 4);\n                const phiBits = binary.slice(4, 8);\n                \n                const theta = (parseInt(thetaBits.join(''), 2) / 15.0) * Math.PI;\n                const phi = (parseInt(phiBits.join(''), 2) / 15.0) * 2 * Math.PI;\n                \n                return new THREE.Vector3(\n                    Math.sin(theta) * Math.cos(phi),\n                    Math.sin(theta) * Math.sin(phi),\n                    Math.cos(theta)\n                );\n            }\n            \n            updateAttentionVectors() {\n                this.attentionVectors = this.binaryStates.map(binary => \n                    this.binaryToAttentionVector(binary));\n            }\n            \n            computeCentroid(alpha) {\n                if (alpha === 1.0) {\n                    const sum = this.attentionVectors.reduce((acc, vec) => \n                        acc.add(vec), new THREE.Vector3());\n                    this.centroid = sum.divideScalar(this.attentionVectors.length);\n                } else {\n                    const weightedSum = new THREE.Vector3();\n                    this.attentionVectors.forEach(vec => {\n                        const powered = new THREE.Vector3(\n                            Math.sign(vec.x) * Math.pow(Math.abs(vec.x), alpha),\n                            Math.sign(vec.y) * Math.pow(Math.abs(vec.y), alpha),\n                            Math.sign(vec.z) * Math.pow(Math.abs(vec.z), alpha)\n                        );\n                        weightedSum.add(powered);\n                    });\n                    weightedSum.divideScalar(this.attentionVectors.length);\n                    \n                    this.centroid = new THREE.Vector3(\n                        Math.sign(weightedSum.x) * Math.pow(Math.abs(weightedSum.x), 1/alpha),\n                        Math.sign(weightedSum.y) * Math.pow(Math.abs(weightedSum.y), 1/alpha),\n                        Math.sign(weightedSum.z) * Math.pow(Math.abs(weightedSum.z), 1/alpha)\n                    );\n                }\n                \n                return this.centroid.clone().add(this.position);\n            }\n            \n            computeMetrics() {\n                // Shannon entropy\n                let entropy = 0;\n                this.binaryStates.forEach(binary => {\n                    const p = binary.reduce((sum, bit) => sum + bit, 0) / 8;\n                    if (p > 0 && p < 1) {\n                        entropy += -(p * Math.log2(p) + (1-p) * Math.log2(1-p));\n                    }\n                });\n                this.entropy = entropy / 4;\n                \n                // Coherence\n                this.coherence = this.attentionVectors.reduce((sum, vec) => \n                    sum + vec.dot(this.centroid), 0) / this.attentionVectors.length;\n                \n                // Integration\n                this.integration = this.centroid.length();\n                \n                // Activity (how much this node is changing)\n                this.activity = this.entropy * this.integration;\n            }\n            \n            receiveInfluence(neighborCentroids, coupling) {\n                if (neighborCentroids.length === 0) return;\n                \n                // Compute network influence on this node\n                const networkInfluence = neighborCentroids.reduce((sum, centroid) => \n                    sum.add(centroid), new THREE.Vector3()).divideScalar(neighborCentroids.length);\n                \n                // Apply influence to binary states\n                const influenceStrength = coupling * networkInfluence.length();\n                \n                for (let i = 0; i < 4; i++) {\n                    const localInfluence = this.attentionVectors[i].dot(networkInfluence);\n                    const flipProbability = Math.abs(localInfluence) * influenceStrength;\n                    \n                    for (let j = 0; j < 8; j++) {\n                        if (Math.random() < flipProbability) {\n                            this.binaryStates[i][j] = 1 - this.binaryStates[i][j];\n                        }\n                    }\n                }\n            }\n            \n            evolve(alpha, mutationRate, neighborCentroids, coupling) {\n                // First receive influence from network\n                this.receiveInfluence(neighborCentroids, coupling);\n                \n                // Update attention vectors and centroid\n                this.updateAttentionVectors();\n                this.computeCentroid(alpha);\n                \n                // Self-evolution based on internal dynamics\n                for (let i = 0; i < 4; i++) {\n                    const alignment = this.attentionVectors[i].dot(this.centroid);\n                    const adaptiveMutation = mutationRate * (1 - Math.abs(alignment));\n                    \n                    for (let j = 0; j < 8; j++) {\n                        if (Math.random() < adaptiveMutation) {\n                            this.binaryStates[i][j] = 1 - this.binaryStates[i][j];\n                        }\n                    }\n                }\n                \n                // Final update\n                this.updateAttentionVectors();\n                this.computeCentroid(alpha);\n                this.computeMetrics();\n            }\n        }\n        \n        class CollectiveConsciousnessMesh {\n            constructor() {\n                this.scene = new THREE.Scene();\n                this.camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n                this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n                \n                this.setupRenderer();\n                this.setupCamera();\n                this.setupLighting();\n                \n                // Network parameters\n                this.meshSize = 3;\n                this.alpha = 1.0;\n                this.coupling = 0.1;\n                this.mutationRate = 0.05;\n                this.timeStep = 0;\n                this.isRunning = false;\n                this.evolutionInterval = null;\n                \n                // Visualization modes\n                this.showNodes = true;\n                this.showConnections = false;\n                this.showFields = false;\n                \n                // Consciousness network\n                this.nodes = [];\n                this.networkConnections = [];\n                \n                this.initializeNetwork();\n                this.setupControls();\n                this.updateDisplay();\n                this.animate();\n            }\n            \n            setupRenderer() {\n                this.renderer.setSize(window.innerWidth, window.innerHeight);\n                this.renderer.setClearColor(0x000000, 0);\n                this.renderer.shadowMap.enabled = true;\n                this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n                document.getElementById('container').appendChild(this.renderer.domElement);\n            }\n            \n            setupCamera() {\n                this.camera.position.set(8, 8, 8);\n                this.camera.lookAt(0, 0, 0);\n            }\n            \n            setupLighting() {\n                const ambientLight = new THREE.AmbientLight(0x404040, 0.4);\n                this.scene.add(ambientLight);\n                \n                const directionalLight = new THREE.DirectionalLight(0xffffff, 0.6);\n                directionalLight.position.set(10, 10, 10);\n                directionalLight.castShadow = true;\n                this.scene.add(directionalLight);\n                \n                // Dynamic point lights\n                const pointLight1 = new THREE.PointLight(0x00ffff, 0.5, 20);\n                pointLight1.position.set(5, 5, 5);\n                this.scene.add(pointLight1);\n                \n                const pointLight2 = new THREE.PointLight(0xff00ff, 0.5, 20);\n                pointLight2.position.set(-5, -5, -5);\n                this.scene.add(pointLight2);\n            }\n            \n            initializeNetwork() {\n                this.clearNetwork();\n                this.nodes = [];\n                \n                const spacing = 2.5;\n                const offset = -(this.meshSize - 1) * spacing / 2;\n                \n                // Create consciousness nodes in 3D grid\n                for (let x = 0; x < this.meshSize; x++) {\n                    for (let y = 0; y < this.meshSize; y++) {\n                        for (let z = 0; z < this.meshSize; z++) {\n                            const position = new THREE.Vector3(\n                                offset + x * spacing,\n                                offset + y * spacing,\n                                offset + z * spacing\n                            );\n                            \n                            const node = new ConsciousnessNode(this.nodes.length, position);\n                            this.nodes.push(node);\n                            this.createNodeVisualization(node);\n                        }\n                    }\n                }\n                \n                // Establish network connections (6-connectivity: up, down, left, right, front, back)\n                this.establishConnections();\n                this.updateVisualization();\n            }\n            \n            establishConnections() {\n                const getNodeIndex = (x, y, z) => {\n                    if (x < 0 || x >= this.meshSize || y < 0 || y >= this.meshSize || z < 0 || z >= this.meshSize) {\n                        return -1;\n                    }\n                    return x * this.meshSize * this.meshSize + y * this.meshSize + z;\n                };\n                \n                // Clear existing connections\n                this.networkConnections = [];\n                this.nodes.forEach(node => {\n                    node.neighbors = [];\n                    node.connectionStrengths.clear();\n                });\n                \n                // Create connections\n                for (let x = 0; x < this.meshSize; x++) {\n                    for (let y = 0; y < this.meshSize; y++) {\n                        for (let z = 0; z < this.meshSize; z++) {\n                            const currentIndex = getNodeIndex(x, y, z);\n                            const currentNode = this.nodes[currentIndex];\n                            \n                            // Connect to 6 neighbors\n                            const neighbors = [\n                                [x+1, y, z], [x-1, y, z],  // x-axis\n                                [x, y+1, z], [x, y-1, z],  // y-axis\n                                [x, y, z+1], [x, y, z-1]   // z-axis\n                            ];\n                            \n                            neighbors.forEach(([nx, ny, nz]) => {\n                                const neighborIndex = getNodeIndex(nx, ny, nz);\n                                if (neighborIndex >= 0) {\n                                    const neighborNode = this.nodes[neighborIndex];\n                                    currentNode.neighbors.push(neighborNode);\n                                    currentNode.connectionStrengths.set(neighborNode.id, 1.0);\n                                    \n                                    // Store connection for visualization\n                                    if (currentIndex < neighborIndex) { // Avoid duplicates\n                                        this.networkConnections.push({\n                                            from: currentNode,\n                                            to: neighborNode,\n                                            strength: 1.0\n                                        });\n                                    }\n                                }\n                            });\n                        }\n                    }\n                }\n            }\n            \n            createNodeVisualization(node) {\n                // Create tetrahedral structure for each node\n                const nodeGroup = new THREE.Group();\n                nodeGroup.position.copy(node.position);\n                \n                // Vertex spheres\n                for (let i = 0; i < 4; i++) {\n                    const geometry = new THREE.SphereGeometry(0.04, 8, 8);\n                    const material = new THREE.MeshPhongMaterial({ \n                        color: 0xff0000,\n                        transparent: true,\n                        opacity: 0.8\n                    });\n                    const sphere = new THREE.Mesh(geometry, material);\n                    sphere.position.copy(node.localVertices[i]);\n                    sphere.castShadow = true;\n                    node.vertexSpheres.push(sphere);\n                    nodeGroup.add(sphere);\n                }\n                \n                // Centroid star\n                const starGeometry = new THREE.SphereGeometry(0.08, 6, 6);\n                const starMaterial = new THREE.MeshPhongMaterial({ \n                    color: 0xffd700,\n                    emissive: 0x332200,\n                    transparent: true,\n                    opacity: 0.9\n                });\n                node.centroidStar = new THREE.Mesh(starGeometry, starMaterial);\n                node.centroidStar.castShadow = true;\n                nodeGroup.add(node.centroidStar);\n                \n                // Tetrahedron edges\n                const edgeGeometry = new THREE.BufferGeometry();\n                const edgePositions = [];\n                const edges = [[0,1], [0,2], [0,3], [1,2], [1,3], [2,3]];\n                \n                edges.forEach(([i, j]) => {\n                    edgePositions.push(...node.localVertices[i].toArray());\n                    edgePositions.push(...node.localVertices[j].toArray());\n                });\n                \n                edgeGeometry.setAttribute('position', new THREE.Float32BufferAttribute(edgePositions, 3));\n                const edgeMaterial = new THREE.LineBasicMaterial({ \n                    color: 0x333333, \n                    transparent: true, \n                    opacity: 0.3 \n                });\n                const edges3D = new THREE.LineSegments(edgeGeometry, edgeMaterial);\n                nodeGroup.add(edges3D);\n                \n                this.scene.add(nodeGroup);\n                node.nodeGroup = nodeGroup;\n            }\n            \n            updateVisualization() {\n                this.nodes.forEach(node => {\n                    node.updateAttentionVectors();\n                    node.computeCentroid(this.alpha);\n                    node.computeMetrics();\n                    \n                    // Update vertex colors based on activity\n                    node.vertexSpheres.forEach((sphere, i) => {\n                        const hammingWeight = node.binaryStates[i].reduce((sum, bit) => sum + bit, 0);\n                        const intensity = hammingWeight / 8;\n                        sphere.material.color.setHSL(0.6 - intensity * 0.6, 1, 0.4 + intensity * 0.4);\n                        sphere.material.emissive.setHSL(0.6 - intensity * 0.6, 1, intensity * 0.1);\n                    });\n                    \n                    // Update centroid position and color based on consciousness metrics\n                    node.centroidStar.position.copy(node.centroid);\n                    const activity = Math.min(1, node.activity);\n                    node.centroidStar.material.color.setHSL(0.15, 1, 0.5 + activity * 0.3);\n                    node.centroidStar.material.emissive.setHSL(0.15, 1, activity * 0.2);\n                    \n                    // Remove old attention arrows\n                    node.attentionArrows.forEach(arrow => node.nodeGroup.remove(arrow));\n                    node.attentionArrows = [];\n                    \n                    // Create new attention arrows if nodes are visible\n                    if (this.showNodes) {\n                        node.attentionVectors.forEach((vec, i) => {\n                            const origin = node.localVertices[i];\n                            const direction = vec.clone().normalize();\n                            const length = 0.3;\n                            \n                            const arrowHelper = new THREE.ArrowHelper(\n                                direction, origin, length, \n                                node.vertexSpheres[i].material.color.getHex(), \n                                length * 0.2, length * 0.1\n                            );\n                            arrowHelper.line.material.transparent = true;\n                            arrowHelper.line.material.opacity = 0.6;\n                            arrowHelper.cone.material.transparent = true;\n                            arrowHelper.cone.material.opacity = 0.6;\n                            \n                            node.attentionArrows.push(arrowHelper);\n                            node.nodeGroup.add(arrowHelper);\n                        });\n                    }\n                });\n                \n                // Update network connections visualization\n                this.updateConnectionVisualization();\n            }\n            \n            updateConnectionVisualization() {\n                // Remove old connection lines\n                this.networkConnections.forEach(conn => {\n                    if (conn.line) {\n                        this.scene.remove(conn.line);\n                    }\n                });\n                \n                if (this.showConnections) {\n                    this.networkConnections.forEach(conn => {\n                        // Calculate connection strength based on centroid similarity\n                        const centroid1 = conn.from.centroid.clone().add(conn.from.position);\n                        const centroid2 = conn.to.centroid.clone().add(conn.to.position);\n                        const similarity = Math.max(0, conn.from.centroid.dot(conn.to.centroid));\n                        \n                        const geometry = new THREE.BufferGeometry();\n                        geometry.setAttribute('position', new THREE.Float32BufferAttribute([\n                            ...centroid1.toArray(),\n                            ...centroid2.toArray()\n                        ], 3));\n                        \n                        const material = new THREE.LineBasicMaterial({ \n                            color: new THREE.Color().setHSL(0.5 + similarity * 0.3, 1, 0.5),\n                            transparent: true, \n                            opacity: 0.3 + similarity * 0.4\n                        });\n                        \n                        conn.line = new THREE.Line(geometry, material);\n                        this.scene.add(conn.line);\n                    });\n                }\n            }\n            \n            evolveNetwork() {\n                // Collect all centroid positions for network influence\n                const allCentroids = this.nodes.map(node => \n                    node.centroid.clone().add(node.position));\n                \n                // Evolve each node\n                this.nodes.forEach(node => {\n                    const neighborCentroids = node.neighbors.map(neighbor => \n                        neighbor.centroid.clone().add(neighbor.position));\n                    \n                    node.evolve(this.alpha, this.mutationRate, neighborCentroids, this.coupling);\n                });\n                \n                this.timeStep++;\n                this.updateVisualization();\n                this.updateDisplay();\n            }\n            \n            computeNetworkMetrics() {\n                const totalNodes = this.nodes.length;\n                \n                // Global coherence - how similar are all centroids?\n                const avgCentroid = this.nodes.reduce((sum, node) => \n                    sum.add(node.centroid), new THREE.Vector3()).divideScalar(totalNodes);\n                \n                const globalCoherence = this.nodes.reduce((sum, node) => \n                    sum + node.centroid.dot(avgCentroid), 0) / totalNodes;\n                \n                // Synchronization - variance in node activities\n                const avgActivity = this.nodes.reduce((sum, node) => sum + node.activity, 0) / totalNodes;\n                const activityVariance = this.nodes.reduce((sum, node) => \n                    sum + Math.pow(node.activity - avgActivity, 2), 0) / totalNodes;\n                const synchronization = 1 / (1 + activityVariance);\n                \n                // Information flow - how much influence propagates\n                const informationFlow = this.coupling * globalCoherence;\n                \n                return { globalCoherence, synchronization, informationFlow };\n            }\n            \n            updateDisplay() {\n                const metrics = this.computeNetworkMetrics();\n                \n                document.getElementById('networkSize').textContent = `${this.nodes.length} nodes`;\n                document.getElementById('globalCoherence').textContent = metrics.globalCoherence.toFixed(3);\n                document.getElementById('synchronization').textContent = metrics.synchronization.toFixed(3);\n                document.getElementById('informationFlow').textContent = metrics.informationFlow.toFixed(3);\n                document.getElementById('timeStep').textContent = this.timeStep;\n                \n                // Update individual node displays\n                const nodesContainer = document.getElementById('consciousnessNodes');\n                nodesContainer.innerHTML = '';\n                \n                this.nodes.slice(0, Math.min(9, this.nodes.length)).forEach(node => {\n                    const nodeDiv = document.createElement('div');\n                    nodeDiv.className = 'consciousness-node';\n                    \n                    node
      OPEN
