DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n    
    STARTTAG <meta charset="UTF-8">
    TEXT \n    
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n    
    STARTTAG <title>
      RAWTEXT Security Camera
    ENDTAG </title>
    TEXT \n    
    STARTTAG <style>
      RAWTEXT \n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            background: linear-gradient(135deg, #1a1a2e, #16213e);\n            color: white;\n            min-height: 100vh;\n            display: flex;\n            flex-direction: column;\n        }\n\n        .header {\n            background: rgba(0, 0, 0, 0.8);\n            padding: 1rem;\n            text-align: center;\n            border-bottom: 2px solid #00ff88;\n        }\n\n        .header h1 {\n            font-size: 1.5rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .status {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n            font-size: 0.9rem;\n        }\n\n        .status-dot {\n            width: 12px;\n            height: 12px;\n            border-radius: 50%;\n            background: #ff4444;\n            animation: pulse 2s infinite;\n        }\n\n        .status-dot.active {\n            background: #00ff88;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.5; }\n        }\n\n        .camera-container {\n            flex: 1;\n            position: relative;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            padding: 1rem;\n        }\n\n        #videoElement {\n            width: 100%;\n            max-width: 800px;\n            height: auto;\n            border-radius: 15px;\n            box-shadow: 0 10px 30px rgba(0, 255, 136, 0.3);\n            background: #000;\n        }\n\n        .overlay {\n            position: absolute;\n            top: 20px;\n            left: 20px;\n            background: rgba(0, 0, 0, 0.7);\n            padding: 10px 15px;\n            border-radius: 10px;\n            font-size: 0.9rem;\n            border: 1px solid #00ff88;\n        }\n\n        .controls {\n            padding: 1rem;\n            background: rgba(0, 0, 0, 0.8);\n            display: flex;\n            flex-wrap: wrap;\n            gap: 1rem;\n            justify-content: center;\n            align-items: center;\n        }\n\n        .btn {\n            padding: 12px 24px;\n            border: none;\n            border-radius: 25px;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .btn-primary {\n            background: linear-gradient(45deg, #00ff88, #00cc6a);\n            color: #000;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(0, 255, 136, 0.4);\n        }\n\n        .btn-secondary {\n            background: linear-gradient(45deg, #ff4444, #cc3333);\n            color: white;\n        }\n\n        .btn-secondary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(255, 68, 68, 0.4);\n        }\n\n        .btn-info {\n            background: linear-gradient(45deg, #4a90e2, #357abd);\n            color: white;\n        }\n\n        .btn-info:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(74, 144, 226, 0.4);\n        }\n\n        .btn:disabled {\n            opacity: 0.5;\n            cursor: not-allowed;\n            transform: none;\n        }\n\n        .camera-select {\n            padding: 10px 15px;\n            border-radius: 10px;\n            border: 2px solid #00ff88;\n            background: rgba(0, 0, 0, 0.8);\n            color: white;\n            font-size: 1rem;\n        }\n\n        .recording-indicator {\n            position: fixed;\n            top: 20px;\n            right: 20px;\n            background: #ff4444;\n            color: white;\n            padding: 8px 16px;\n            border-radius: 20px;\n            font-weight: bold;\n            animation: pulse 1s infinite;\n            display: none;\n        }\n\n        .motion-alert {\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            background: #ff4444;\n            color: white;\n            padding: 20px 40px;\n            border-radius: 15px;\n            font-size: 1.2rem;\n            font-weight: bold;\n            display: none;\n            animation: alertBlink 0.5s infinite;\n            z-index: 1000;\n        }\n\n        @keyframes alertBlink {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.7; }\n        }\n\n        .settings {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 1rem;\n            align-items: center;\n        }\n\n        .setting-group {\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .setting-group label {\n            font-size: 0.9rem;\n            color: #ccc;\n        }\n\n        .setting-group input[type="range"] {\n            width: 100px;\n        }\n\n        .toast {\n            position: fixed;\n            bottom: 20px;\n            right: 20px;\n            background: #00ff88;\n            color: #000;\n            padding: 12px 20px;\n            border-radius: 10px;\n            font-weight: bold;\n            display: none;\n            animation: slideIn 0.3s ease;\n        }\n\n        @keyframes slideIn {\n            from { transform: translateX(100%); }\n            to { transform: translateX(0); }\n        }\n\n        @media (max-width: 768px) {\n            .controls {\n                padding: 0.5rem;\n            }\n            \n            .btn {\n                padding: 10px 20px;\n                font-size: 0.9rem;\n            }\n            \n            .settings {\n                justify-content: center;\n            }\n            \n            .overlay {\n                font-size: 0.8rem;\n                padding: 8px 12px;\n            }\n        }\n    
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n    
    STARTTAG <div class="header">
      TEXT \n        
      STARTTAG <h1>
        TEXT 🔒 Security Camera
      ENDTAG </h1>
      TEXT \n        
      STARTTAG <div class="status">
        TEXT \n            
        STARTTAG <div class="status-dot" id="statusDot">
        ENDTAG </div>
        TEXT \n            
        STARTTAG <span id="statusText">
          TEXT Camera Offline
        ENDTAG </span>
        TEXT \n        
      ENDTAG </div>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div class="camera-container">
      TEXT \n        
      STARTTAG <video id="videoElement" autoplay muted playsinline>
      ENDTAG </video>
      TEXT \n        
      STARTTAG <div class="overlay">
        TEXT \n            
        STARTTAG <div>
          TEXT 📅 
          STARTTAG <span id="currentTime">
          ENDTAG </span>
        ENDTAG </div>
        TEXT \n            
        STARTTAG <div>
          TEXT 📍 Monitoring Active
        ENDTAG </div>
        TEXT \n        
      ENDTAG </div>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div class="recording-indicator" id="recordingIndicator">
      TEXT \n        🔴 RECORDING\n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div class="motion-alert" id="motionAlert">
      TEXT \n        ⚠️ MOTION DETECTED ⚠️\n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div class="controls">
      TEXT \n        
      STARTTAG <button class="btn btn-primary" id="startBtn">
        TEXT Start Camera
      ENDTAG </button>
      TEXT \n        
      STARTTAG <button class="btn btn-secondary" id="stopBtn" disabled>
        TEXT Stop Camera
      ENDTAG </button>
      TEXT \n        
      STARTTAG <button class="btn btn-info" id="recordBtn" disabled>
        TEXT Start Recording
      ENDTAG </button>
      TEXT \n        
      STARTTAG <button class="btn btn-info" id="screenshotBtn" disabled>
        TEXT Screenshot
      ENDTAG </button>
      TEXT \n        \n        
      STARTTAG <select class="camera-select" id="cameraSelect">
        TEXT \n            
        STARTTAG <option value="">
          TEXT Select Camera
        ENDTAG </option>
        TEXT \n        
      ENDTAG </select>
      TEXT \n\n        
      STARTTAG <div class="settings">
        TEXT \n            
        STARTTAG <div class="setting-group">
          TEXT \n                
          STARTTAG <label>
            TEXT Motion Sensitivity:
          ENDTAG </label>
          TEXT \n                
          STARTTAG <input type="range" id="motionSensitivity" min="10" max="100" value="30">
          TEXT \n                
          STARTTAG <span id="sensitivityValue">
            TEXT 30
          ENDTAG </span>
          TEXT \n            
        ENDTAG </div>
        TEXT \n            \n            
        STARTTAG <div class="setting-group">
          TEXT \n                
          STARTTAG <label>
            TEXT \n                    
            STARTTAG <input type="checkbox" id="motionDetection">
            TEXT  Motion Detection\n                
          ENDTAG </label>
          TEXT \n            
        ENDTAG </div>
        TEXT \n            \n            
        STARTTAG <div class="setting-group">
          TEXT \n                
          STARTTAG <label>
            TEXT \n                    
            STARTTAG <input type="checkbox" id="nightMode">
            TEXT  Night Mode\n                
          ENDTAG </label>
          TEXT \n            
        ENDTAG </div>
        TEXT \n        
      ENDTAG </div>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <div class="toast" id="toast">
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <script>
      RAWTEXT \n        class SecurityCamera {\n            constructor() {\n                this.video = document.getElementById('videoElement');\n                this.canvas = document.createElement('canvas');\n                this.ctx = this.canvas.getContext('2d');\n                this.stream = null;\n                this.mediaRecorder = null;\n                this.recordedChunks = [];\n                this.isRecording = false;\n                this.motionDetection = false;\n                this.lastFrame = null;\n                this.motionThreshold = 30;\n                \n                this.initializeElements();\n                this.updateTime();\n                this.setupEventListeners();\n                this.getCameraDevices();\n                \n                setInterval(() => this.updateTime(), 1000);\n            }\n\n            initializeElements() {\n                this.startBtn = document.getElementById('startBtn');\n                this.stopBtn = document.getElementById('stopBtn');\n                this.recordBtn = document.getElementById('recordBtn');\n                this.screenshotBtn = document.getElementById('screenshotBtn');\n                this.cameraSelect = document.getElementById('cameraSelect');\n                this.statusDot = document.getElementById('statusDot');\n                this.statusText = document.getElementById('statusText');\n                this.recordingIndicator = document.getElementById('recordingIndicator');\n                this.motionAlert = document.getElementById('motionAlert');\n                this.motionSensitivity = document.getElementById('motionSensitivity');\n                this.sensitivityValue = document.getElementById('sensitivityValue');\n                this.motionDetectionCheckbox = document.getElementById('motionDetection');\n                this.nightModeCheckbox = document.getElementById('nightMode');\n                this.toast = document.getElementById('toast');\n            }\n\n            setupEventListeners() {\n                this.startBtn.addEventListener('click', () => this.startCamera());\n                this.stopBtn.addEventListener('click', () => this.stopCamera());\n                this.recordBtn.addEventListener('click', () => this.toggleRecording());\n                this.screenshotBtn.addEventListener('click', () => this.takeScreenshot());\n                this.cameraSelect.addEventListener('change', () => this.switchCamera());\n                \n                this.motionSensitivity.addEventListener('input', (e) => {\n                    this.motionThreshold = parseInt(e.target.value);\n                    this.sensitivityValue.textContent = e.target.value;\n                });\n                \n                this.motionDetectionCheckbox.addEventListener('change', (e) => {\n                    this.motionDetection = e.target.checked;\n                    if (this.motionDetection) {\n                        this.startMotionDetection();\n                        this.showToast('Motion detection enabled');\n                    } else {\n                        this.showToast('Motion detection disabled');\n                    }\n                });\n                \n                this.nightModeCheckbox.addEventListener('change', (e) => {\n                    this.toggleNightMode(e.target.checked);\n                });\n\n                // Handle page visibility changes\n                document.addEventListener('visibilitychange', () => {\n                    if (document.hidden && this.stream) {\n                        this.showToast('Camera running in background');\n                    }\n                });\n            }\n\n            async getCameraDevices() {\n                try {\n                    const devices = await navigator.mediaDevices.enumerateDevices();\n                    const videoDevices = devices.filter(device => device.kind === 'videoinput');\n                    \n                    this.cameraSelect.innerHTML = '<option value="">Select Camera</option>';\n                    videoDevices.forEach((device, index) => {\n                        const option = document.createElement('option');\n                        option.value = device.deviceId;\n                        option.textContent = device.label || `Camera ${index + 1}`;\n                        this.cameraSelect.appendChild(option);\n                    });\n                } catch (error) {\n                    console.error('Error getting camera devices:', error);\n                    this.showToast('Error accessing camera devices');\n                }\n            }\n\n            async startCamera() {\n                try {\n                    const constraints = {\n                        video: {\n                            width: { ideal: 1280 },\n                            height: { ideal: 720 },\n                            facingMode: 'environment'\n                        },\n                        audio: false\n                    };\n\n                    if (this.cameraSelect.value) {\n                        constraints.video.deviceId = { exact: this.cameraSelect.value };\n                    }\n\n                    this.stream = await navigator.mediaDevices.getUserMedia(constraints);\n                    this.video.srcObject = this.stream;\n                    \n                    this.updateStatus(true);\n                    this.startBtn.disabled = true;\n                    this.stopBtn.disabled = false;\n                    this.recordBtn.disabled = false;\n                    this.screenshotBtn.disabled = false;\n                    \n                    this.showToast('Camera started successfully');\n                    \n                    // Setup canvas for motion detection\n                    this.video.addEventListener('loadedmetadata', () => {\n                        this.canvas.width = this.video.videoWidth;\n                        this.canvas.height = this.video.videoHeight;\n                    });\n                    \n                } catch (error) {\n                    console.error('Error starting camera:', error);\n                    this.showToast('Error starting camera. Please check permissions.');\n                }\n            }\n\n            stopCamera() {\n                if (this.stream) {\n                    this.stream.getTracks().forEach(track => track.stop());\n                    this.stream = null;\n                    this.video.srcObject = null;\n                }\n                \n                if (this.isRecording) {\n                    this.stopRecording();\n                }\n                \n                this.updateStatus(false);\n                this.startBtn.disabled = false;\n                this.stopBtn.disabled = true;\n                this.recordBtn.disabled = true;\n                this.screenshotBtn.disabled = true;\n                \n                this.showToast('Camera stopped');\n            }\n\n            async switchCamera() {\n                if (this.stream) {\n                    this.stopCamera();\n                    await new Promise(resolve => setTimeout(resolve, 100));\n                    this.startCamera();\n                }\n            }\n\n            toggleRecording() {\n                if (this.isRecording) {\n                    this.stopRecording();\n                } else {\n                    this.startRecording();\n                }\n            }\n\n            startRecording() {\n                try {\n                    this.recordedChunks = [];\n                    this.mediaRecorder = new MediaRecorder(this.stream, {\n                        mimeType: 'video/webm'\n                    });\n                    \n                    this.mediaRecorder.ondataavailable = (event) => {\n                        if (event.data.size > 0) {\n                            this.recordedChunks.push(event.data);\n                        }\n                    };\n                    \n                    this.mediaRecorder.onstop = () => {\n                        const blob = new Blob(this.recordedChunks, { type: 'video/webm' });\n                        this.downloadVideo(blob);\n                    };\n                    \n                    this.mediaRecorder.start();\n                    this.isRecording = true;\n                    this.recordBtn.textContent = 'Stop Recording';\n                    this.recordBtn.className = 'btn btn-secondary';\n                    this.recordingIndicator.style.display = 'block';\n                    \n                    this.showToast('Recording started');\n                } catch (error) {\n                    console.error('Error starting recording:', error);\n                    this.showToast('Error starting recording');\n                }\n            }\n\n            stopRecording() {\n                if (this.mediaRecorder && this.isRecording) {\n                    this.mediaRecorder.stop();\n                    this.isRecording = false;\n                    this.recordBtn.textContent = 'Start Recording';\n                    this.recordBtn.className = 'btn btn-info';\n                    this.recordingIndicator.style.display = 'none';\n                    \n                    this.showToast('Recording stopped and saved');\n                }\n            }\n\n            takeScreenshot() {\n                this.ctx.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);\n                this.canvas.toBlob((blob) => {\n                    const url = URL.createObjectURL(blob);\n                    const a = document.createElement('a');\n                    a.href = url;\n                    a.download = `security-screenshot-${new Date().toISOString().slice(0, 19).replace(/[:.]/g, '-')}.png`;\n                    a.click();\n                    URL.revokeObjectURL(url);\n                    \n                    this.showToast('Screenshot saved');\n                });\n            }\n\n            downloadVideo(blob) {\n                const url = URL.createObjectURL(blob);\n                const a = document.createElement('a');\n                a.href = url;\n                a.download = `security-recording-${new Date().toISOString().slice(0, 19).replace(/[:.]/g, '-')}.webm`;\n                a.click();\n                URL.revokeObjectURL(url);\n            }\n\n            startMotionDetection() {\n                if (!this.motionDetection || !this.stream) return;\n                \n                const detectMotion = () => {\n                    if (!this.motionDetection || !this.stream) return;\n                    \n                    this.ctx.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);\n                    const currentFrame = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);\n                    \n                    if (this.lastFrame) {\n                        const diff = this.calculateFrameDifference(this.lastFrame, currentFrame);\n                        if (diff > this.motionThreshold) {\n                            this.triggerMotionAlert();\n                        }\n                    }\n                    \n                    this.lastFrame = currentFrame;\n                    setTimeout(detectMotion, 100);\n                };\n                \n                setTimeout(detectMotion, 1000);\n            }\n\n            calculateFrameDifference(frame1, frame2) {\n                let diff = 0;\n                const pixels = frame1.data.length;\n                \n                for (let i = 0; i < pixels; i += 4) {\n                    const r1 = frame1.data[i], g1 = frame1.data[i + 1], b1 = frame1.data[i + 2];\n                    const r2 = frame2.data[i], g2 = frame2.data[i + 1], b2 = frame2.data[i + 2];\n                    \n                    diff += Math.abs(r1 - r2) + Math.abs(g1 - g2) + Math.abs(b1 - b2);\n                }\n                \n                return diff / (pixels / 4);\n            }\n\n            triggerMotionAlert() {\n                this.motionAlert.style.display = 'block';\n                setTimeout(() => {\n                    this.motionAlert.style.display = 'none';\n                }, 2000);\n                \n                this.showToast('Motion detected!');\n                \n                // Auto-screenshot on motion\n                if (this.stream) {\n                    setTimeout(() => this.takeScreenshot(), 500);\n                }\n            }\n\n            toggleNightMode(enabled) {\n                if (enabled) {\n                    this.video.style.filter = 'brightness(1.5) contrast(1.2)';\n                    this.showToast('Night mode enabled');\n                } else {\n                    this.video.style.filter = 'none';\n                    this.showToast('Night mode disabled');\n                }\n            }\n\n            updateStatus(active) {\n                if (active) {\n                    this.statusDot.classList.add('active');\n                    this.statusText.textContent = 'Camera Online';\n                } else {\n                    this.statusDot.classList.remove('active');\n                    this.statusText.textContent = 'Camera Offline';\n                }\n            }\n\n            updateTime() {\n                const now = new Date();\n                const timeString = now.toLocaleString();\n                document.getElementById('currentTime').textContent = timeString;\n            }\n\n            showToast(message) {\n                this.toast.textContent = message;\n                this.toast.style.display = 'block';\n                setTimeout(() => {\n                    this.toast.style.display = 'none';\n                }, 3000);\n            }\n        }\n\n        // Initialize the security camera app\n        const securityCamera = new SecurityCamera();\n    
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
