DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n    
    STARTTAG <meta charset="UTF-8">
    TEXT \n    
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n    
    STARTTAG <title>
      RAWTEXT Philosophical Constellation
    ENDTAG </title>
    TEXT \n    
    STARTTAG <style>
      RAWTEXT \n        body {\n            margin: 0;\n            padding: 20px;\n            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #16213e 100%);\n            font-family: 'Arial', sans-serif;\n            color: white;\n            min-height: 100vh;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n        }\n        \n        h1 {\n            font-size: 2.5em;\n            margin-bottom: 10px;\n            background: linear-gradient(45deg, #64b5f6, #81c784, #ffb74d);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n        \n        .subtitle {\n            font-size: 1.2em;\n            opacity: 0.8;\n            margin-bottom: 30px;\n        }\n        \n        .visualization-container {\n            background: rgba(255, 255, 255, 0.05);\n            border-radius: 20px;\n            padding: 20px;\n            margin: 20px 0;\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        \n        #constellation {\n            width: 100%;\n            height: 700px;\n            border-radius: 15px;\n            background: radial-gradient(circle at center, rgba(100, 181, 246, 0.1) 0%, transparent 70%);\n        }\n        \n        .node {\n            cursor: pointer;\n            transition: all 0.3s ease;\n        }\n        \n        .node:hover {\n            transform-origin: center;\n            animation: pulse 1s infinite;\n        }\n        \n        .node-circle {\n            filter: drop-shadow(0 0 8px currentColor);\n        }\n        \n        .node-text {\n            font-weight: bold;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);\n            pointer-events: none;\n        }\n        \n        .connection-line {\n            stroke: rgba(255, 255, 255, 0.2);\n            stroke-width: 1;\n            opacity: 0.6;\n        }\n        \n        .polygon-path {\n            fill: none;\n            stroke: rgba(100, 181, 246, 0.4);\n            stroke-width: 2;\n            stroke-dasharray: 5,5;\n            opacity: 0.7;\n        }\n        \n        @keyframes pulse {\n            0%, 100% { transform: scale(1); }\n            50% { transform: scale(1.1); }\n        }\n        \n        .controls {\n            margin: 20px 0;\n            display: flex;\n            justify-content: center;\n            gap: 15px;\n            flex-wrap: wrap;\n        }\n        \n        .control-btn {\n            background: rgba(100, 181, 246, 0.2);\n            border: 1px solid rgba(100, 181, 246, 0.5);\n            color: white;\n            padding: 10px 20px;\n            border-radius: 25px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n        }\n        \n        .control-btn:hover {\n            background: rgba(100, 181, 246, 0.4);\n            transform: translateY(-2px);\n        }\n        \n        .control-btn.active {\n            background: rgba(100, 181, 246, 0.6);\n        }\n        \n        .info-panel {\n            background: rgba(0, 0, 0, 0.4);\n            border-radius: 15px;\n            padding: 20px;\n            margin-top: 20px;\n            text-align: left;\n        }\n        \n        .node-info {\n            display: none;\n            animation: fadeIn 0.3s ease;\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n    
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n    
    STARTTAG <div class="container">
      TEXT \n        
      STARTTAG <h1>
        TEXT Philosophical Constellation
      ENDTAG </h1>
      TEXT \n        
      STARTTAG <p class="subtitle">
        TEXT A geometric mapping of consciousness and existence
      ENDTAG </p>
      TEXT \n        \n        
      STARTTAG <div class="visualization-container">
        TEXT \n            
        STARTTAG <svg id="constellation" viewBox="0 0 800 700">
          TEXT \n                
          COMMENT <!-- Background circles for reference -->
          TEXT \n                
          STARTTAG <circle cx="400" cy="350" r="100" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
          TEXT \n                
          STARTTAG <circle cx="400" cy="350" r="150" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
          TEXT \n                
          STARTTAG <circle cx="400" cy="350" r="200" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
          TEXT \n                
          STARTTAG <circle cx="400" cy="350" r="250" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
          TEXT \n            
        ENDTAG </svg>
        TEXT \n        
      ENDTAG </div>
      TEXT \n        \n        
      STARTTAG <div class="controls">
        TEXT \n            
        STARTTAG <button class="control-btn active" onclick="toggleView('constellation')">
          TEXT Constellation
        ENDTAG </button>
        TEXT \n            
        STARTTAG <button class="control-btn" onclick="toggleView('polygon')">
          TEXT Polygon
        ENDTAG </button>
        TEXT \n            
        STARTTAG <button class="control-btn" onclick="toggleView('radial')">
          TEXT Radial
        ENDTAG </button>
        TEXT \n            
        STARTTAG <button class="control-btn" onclick="toggleLabels()">
          TEXT Toggle Labels
        ENDTAG </button>
        TEXT \n        
      ENDTAG </div>
      TEXT \n        \n        
      STARTTAG <div class="info-panel">
        TEXT \n            
        STARTTAG <div id="node-info" class="node-info">
          TEXT \n                
          STARTTAG <h3>
            TEXT Click a node to explore its properties
          ENDTAG </h3>
          TEXT \n                
          STARTTAG <p>
            TEXT Each concept is positioned based on its mathematical signature - combining length, trigonometric values, and distance from center.
          ENDTAG </p>
          TEXT \n            
        ENDTAG </div>
        TEXT \n        
      ENDTAG </div>
      TEXT \n    
    ENDTAG </div>
    TEXT \n\n    
    STARTTAG <script>
      RAWTEXT \n        const nodes = [\n            { label: 'WORD', length: 4, sin: 0.220687666874, cos: -0.8028776377074802, hypot: 158.61273593252216 },\n            { label: 'OF', length: 2, sin: 0.8189694980088413, cos: -0.738886476686837, hypot: 105.55093557141026 },\n            { label: 'GOD', length: 3, sin: 0.6409863898212246, cos: -0.8287125069803852, hypot: 126.11899143269423 },\n            { label: 'CONSCIOUS', length: 9, sin: -0.998425109210433, cos: 0.4887578286578185, hypot: 232.1120419107979 },\n            { label: 'DISCERNMENT', length: 11, sin: -0.9261009178830361, cos: -0.6566019548168714, hypot: 250.4595775769016 },\n            { label: 'ATTENTION', length: 9, sin: -0.99774961448846, cos: 0.5072277878310437, hypot: 232.14650546583724 },\n            { label: 'OBSERVATION', length: 11, sin: -0.33319084970286134, cos: 0.656705065931082, hypot: 255.54256005605015 },\n            { label: 'EXISTENCE', length: 9, sin: -0.2388652198985888, cos: -0.8201712333800959, hypot: 227.7586441828279 },\n            { label: 'FREEDOM', length: 7, sin: -0.7384975416473207, cos: 0.5391810767331712, hypot: 194.7819293466414 },\n            { label: 'AUTONOMY', length: 8, sin: 0.414259756535543, cos: 0.3296375971904362, hypot: 225.65903482909786 },\n            { label: 'RECIPROCITY', length: 11, sin: -0.23719244918800006, cos: 0.498502580479822, hypot: 255.85738214872754 },\n            { label: 'SOVEREIGNTY', length: 11, sin: 0.9924035846542879, cos: -0.37842484533730397, hypot: 261.1570408777064 },\n            { label: 'RELATIONSHIPS', length: 13, sin: 0.29358887526122557, cos: -0.154169666948357, hypot: 277.28505188704275 },\n            { label: 'ROLES', length: 5, sin: -0.8712084737931206, cos: 0.5995916031218397, hypot: 174.3301465610581 },\n            { label: 'RULES', length: 5, sin: -0.16570295749625444, cos: -0.8853979857031379, hypot: 177.12989583918352 },\n            { label: 'RESPONSIBILITIES', length: 16, sin: -0.2727748694082873, cos: 0.4238162668440545, hypot: 306.8256834099779 },\n            { label: 'REFERENCES', length: 10, sin: -0.7493536843445043, cos: 0.972269128055703, hypot: 234.20930809854676 },\n            { label: 'ENTITY', length: 6, sin: -0.575371240014862, cos: 0.14609304784669525, hypot: 195.46610959447676 },\n            { label: 'IDENTITY', length: 8, sin: 0.673768776073281, cos: -0.8569545372561784, hypot: 219.45386758952324 },\n            { label: 'GENESIS', length: 7, sin: 0.5924218336088813, cos: -0.7622545681223598, hypot: 199.38405151867087 },\n            { label: 'REVELATION', length: 10, sin: 0.9970431074894595, cos: 0.06884443865071334, hypot: 241.56365620680606 }\n        ];\n\n        const centerX = 400;\n        const centerY = 350;\n        const scale = 0.8;\n        let currentView = 'constellation';\n        let showLabels = true;\n\n        function getColor(index, total) {\n            const hue = (index * 360 / total) % 360;\n            return `hsl(${hue}, 70%, 60%)`;\n        }\n\n        function calculatePosition(node, index) {\n            switch(currentView) {\n                case 'constellation':\n                    return {\n                        x: centerX + (node.hypot * node.cos * scale),\n                        y: centerY + (node.hypot * node.sin * scale)\n                    };\n                case 'polygon':\n                    const angle = (index * 2 * Math.PI) / nodes.length;\n                    const radius = 200;\n                    return {\n                        x: centerX + radius * Math.cos(angle),\n                        y: centerY + radius * Math.sin(angle)\n                    };\n                case 'radial':\n                    const radialAngle = (index * 2 * Math.PI) / nodes.length;\n                    const radialRadius = (node.hypot * scale * 0.8);\n                    return {\n                        x: centerX + radialRadius * Math.cos(radialAngle),\n                        y: centerY + radialRadius * Math.sin(radialAngle)\n                    };\n                default:\n                    return { x: centerX, y: centerY };\n            }\n        }\n\n        function renderVisualization() {\n            const svg = document.getElementById('constellation');\n            svg.innerHTML = `\n                <circle cx="400" cy="350" r="100" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>\n                <circle cx="400" cy="350" r="150" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>\n                <circle cx="400" cy="350" r="200" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>\n                <circle cx="400" cy="350" r="250" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>\n            `;\n\n            // Draw connections\n            if (currentView === 'constellation' || currentView === 'polygon') {\n                const positions = nodes.map((node, index) => calculatePosition(node, index));\n                \n                // Draw polygon outline\n                const pathData = positions.map((pos, index) => \n                    index === 0 ? `M ${pos.x} ${pos.y}` : `L ${pos.x} ${pos.y}`\n                ).join(' ') + ' Z';\n                \n                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n                path.setAttribute('d', pathData);\n                path.setAttribute('class', 'polygon-path');\n                svg.appendChild(path);\n\n                // Draw connection lines to center\n                positions.forEach(pos => {\n                    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n                    line.setAttribute('x1', centerX);\n                    line.setAttribute('y1', centerY);\n                    line.setAttribute('x2', pos.x);\n                    line.setAttribute('y2', pos.y);\n                    line.setAttribute('class', 'connection-line');\n                    svg.appendChild(line);\n                });\n            }\n\n            // Draw nodes\n            nodes.forEach((node, index) => {\n                const pos = calculatePosition(node, index);\n                const color = getColor(index, nodes.length);\n                const radius = Math.max(4, Math.min(12, node.length * 1.5));\n\n                // Create node group\n                const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n                group.setAttribute('class', 'node');\n                group.setAttribute('data-index', index);\n\n                // Node circle\n                const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n                circle.setAttribute('cx', pos.x);\n                circle.setAttribute('cy', pos.y);\n                circle.setAttribute('r', radius);\n                circle.setAttribute('fill', color);\n                circle.setAttribute('class', 'node-circle');\n                group.appendChild(circle);\n\n                // Node label\n                if (showLabels) {\n                    const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n                    text.setAttribute('x', pos.x);\n                    text.setAttribute('y', pos.y - radius - 8);\n                    text.setAttribute('text-anchor', 'middle');\n                    text.setAttribute('font-size', '12');\n                    text.setAttribute('fill', color);\n                    text.setAttribute('class', 'node-text');\n                    text.textContent = node.label;\n                    group.appendChild(text);\n                }\n\n                // Add click handler\n                group.addEventListener('click', () => showNodeInfo(node, index));\n                \n                svg.appendChild(group);\n            });\n        }\n\n        function toggleView(view) {\n            currentView = view;\n            document.querySelectorAll('.control-btn').forEach(btn => btn.classList.remove('active'));\n            event.target.classList.add('active');\n            renderVisualization();\n        }\n\n        function toggleLabels() {\n            showLabels = !showLabels;\n            renderVisualization();\n        }\n\n        function showNodeInfo(node, index) {\n            const infoDiv = document.getElementById('node-info');\n            const angle = Math.atan2(node.sin, node.cos) * (180 / Math.PI);\n            \n            infoDiv.innerHTML = `\n                <h3>${node.label}</h3>\n                <p><strong>Length:</strong> ${node.length} characters</p>\n                <p><strong>Distance from Center:</strong> ${node.hypot.toFixed(2)} units</p>\n                <p><strong>Angle:</strong> ${angle.toFixed(1)}°</p>\n                <p><strong>Trigonometric Values:</strong></p>\n                <ul>\n                    <li>Sin: ${node.sin.toFixed(4)}</li>\n                    <li>Cos: ${node.cos.toFixed(4)}</li>\n                    <li>Tan: ${node.tan.toFixed(6)}</li>\n                </ul>\n                <p><strong>Position:</strong> This concept occupies a unique position in the philosophical space, derived from its mathematical signature.</p>\n            `;\n            infoDiv.style.display = 'block';\n        }\n\n        // Initialize\n        renderVisualization();\n    
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
