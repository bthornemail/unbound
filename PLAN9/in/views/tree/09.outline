DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="UTF-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n
    STARTTAG <title>
      RAWTEXT Media Spectrum DevTools
    ENDTAG </title>
    TEXT \n
    STARTTAG <style>
      RAWTEXT \n:root{\n  --bg:#f5f5f7; --panel:#ffffff; --border:#d8d8dc; --text:#1a1a1e;\n  --muted:#6b6b74; --accent:#3a6ff0; --accent-dim:#e4ecff;\n  --cell-low:#e9eaf5; --cell-hi:#3a6ff0; --danger:#d0413f;\n  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;\n}\n@media (prefers-color-scheme: dark){\n  :root:not([data-theme="light"]){\n    --bg:#0f0f13; --panel:#18181e; --border:#2c2c34; --text:#eceef2;\n    --muted:#9a9aa5; --accent:#6d93ff; --accent-dim:#1e2942;\n    --cell-low:#20222c; --cell-hi:#6d93ff; --danger:#ff6b68;\n  }\n}\n:root[data-theme="dark"]{\n  --bg:#0f0f13; --panel:#18181e; --border:#2c2c34; --text:#eceef2;\n  --muted:#9a9aa5; --accent:#6d93ff; --accent-dim:#1e2942;\n  --cell-low:#20222c; --cell-hi:#6d93ff; --danger:#ff6b68;\n}\n*{box-sizing:border-box;}\nbody{margin:0;background:var(--bg);color:var(--text);min-height:100vh;}\nheader{padding:14px 16px;border-bottom:1px solid var(--border);background:var(--panel);}\nh1{font-size:16px;margin:0 0 4px;}\n.sub{font-size:12px;color:var(--muted);margin-bottom:10px;line-height:1.5;}\n.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;}\n.controls label{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px;}\nbutton{\n  font-size:13px;padding:7px 12px;border-radius:8px;border:1px solid var(--border);\n  background:var(--panel);color:var(--text);cursor:pointer;\n}\nbutton.primary{background:var(--accent);color:#fff;border-color:var(--accent);}\nbutton:disabled{opacity:.45;cursor:not-allowed;}\ninput[type=range]{width:120px;}\nmain{\n  display:grid;\n  grid-template-columns:200px 1fr 220px;\n  gap:1px;background:var(--border);\n  max-width:100%;\n  min-height:420px;\n}\n@media (max-width:760px){\n  main{grid-template-columns:1fr;}\n}\n.panel{background:var(--panel);padding:10px;overflow:auto;}\n.panel h2{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 8px;}\n#ports{display:flex;flex-direction:column;gap:2px;font-family:ui-monospace,Menlo,monospace;font-size:11px;max-height:400px;overflow:auto;}\n.port-row{display:flex;justify-content:space-between;padding:2px 4px;border-radius:4px;}\n.port-row span.v{color:var(--muted);}\n#asciiGrid{\n  display:grid;grid-template-columns:repeat(16,1fr);gap:3px;max-width:480px;margin:0 auto;\n}\n.cell{\n  aspect-ratio:1;display:flex;align-items:center;justify-content:center;\n  font-family:ui-monospace,Menlo,monospace;font-size:11px;border-radius:4px;\n  background:var(--cell-low);color:var(--text);transition:background .08s linear;\n}\n#legend div{font-size:11px;color:var(--muted);padding:3px 0;border-bottom:1px dashed var(--border);}\n#legend b{color:var(--text);}\nfooter{padding:10px 16px;border-top:1px solid var(--border);background:var(--panel);}\n#timeline{display:flex;gap:4px;overflow-x:auto;padding:6px 0;}\n.cue{\n  flex:0 0 auto;font-size:10px;font-family:ui-monospace,monospace;color:var(--muted);\n  border:1px solid var(--border);border-radius:6px;padding:4px 7px;cursor:pointer;background:var(--panel);\n}\n.cue.active{background:var(--accent-dim);color:var(--accent);border-color:var(--accent);}\n.status{font-size:11px;color:var(--muted);margin-top:6px;}\n
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n
    STARTTAG <header>
      TEXT \n  
      STARTTAG <h1>
        TEXT Media Spectrum DevTools
      ENDTAG </h1>
      TEXT \n  
      STARTTAG <div class="sub">
        TEXT Real FFT via Web Audio's 
        STARTTAG <code>
          TEXT AnalyserNode
        ENDTAG </code>
        TEXT  (fftSize 256 → 128 frequency bins), laid out as an 8×16 grid. No plugins, no external libraries.
      ENDTAG </div>
      TEXT \n  
      STARTTAG <div class="controls">
        TEXT \n    
        STARTTAG <label>
          TEXT Source: 
          STARTTAG <input type="file" id="fileInput" accept="audio/*,video/*">
        ENDTAG </label>
        TEXT \n    
        STARTTAG <button id="micBtn">
          TEXT 🎙️ Use microphone
        ENDTAG </button>
        TEXT \n    
        STARTTAG <button id="playBtn" class="primary" disabled>
          TEXT ▶ Play
        ENDTAG </button>
        TEXT \n    
        STARTTAG <label>
          TEXT Pan 
          STARTTAG <input type="range" id="pan" min="-1" max="1" step="0.05" value="0">
        ENDTAG </label>
        TEXT \n    
        STARTTAG <label>
          TEXT Snapshot every 
          STARTTAG <input type="range" id="interval" min="150" max="2000" step="50" value="500">
          TEXT  ms
        ENDTAG </label>
        TEXT \n  
      ENDTAG </div>
      TEXT \n  
      STARTTAG <div class="status" id="status">
        TEXT No source loaded.
      ENDTAG </div>
      TEXT \n
    ENDTAG </header>
    TEXT \n\n
    STARTTAG <main>
      TEXT \n  
      STARTTAG <section class="panel">
        TEXT \n    
        STARTTAG <h2>
          TEXT Ports (128 channels)
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div id="ports">
        ENDTAG </div>
        TEXT \n  
      ENDTAG </section>
      TEXT \n\n  
      STARTTAG <section class="panel">
        TEXT \n    
        STARTTAG <h2>
          TEXT Spectrum grid (8 rows × 16 cols)
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div id="asciiGrid">
        ENDTAG </div>
        TEXT \n  
      ENDTAG </section>
      TEXT \n\n  
      STARTTAG <section class="panel">
        TEXT \n    
        STARTTAG <h2>
          TEXT Row legend
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div id="legend">
        ENDTAG </div>
        TEXT \n  
      ENDTAG </section>
      TEXT \n
    ENDTAG </main>
    TEXT \n\n
    STARTTAG <footer>
      TEXT \n  
      STARTTAG <h2 style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 4px;">
        TEXT Timeline (click a snapshot to inspect it)
      ENDTAG </h2>
      TEXT \n  
      STARTTAG <div id="timeline">
      ENDTAG </div>
      TEXT \n
    ENDTAG </footer>
    TEXT \n\n
    STARTTAG <script>
      RAWTEXT \n(() => {\n  const fileInput = document.getElementById('fileInput');\n  const micBtn = document.getElementById('micBtn');\n  const playBtn = document.getElementById('playBtn');\n  const panCtl = document.getElementById('pan');\n  const intervalCtl = document.getElementById('interval');\n  const statusEl = document.getElementById('status');\n  const portsEl = document.getElementById('ports');\n  const gridEl = document.getElementById('asciiGrid');\n  const legendEl = document.getElementById('legend');\n  const timelineEl = document.getElementById('timeline');\n\n  const ROWS = 8, COLS = 16, N = ROWS * COLS; // 128 bins, matches fftSize=256 analyser output exactly\n\n  const rowLabels = [\n    '0x0_ — bins 0–15',\n    '0x1_ — bins 16–31',\n    '0x2_ — bins 32–47',\n    '0x3_ — bins 48–63',\n    '0x4_ — bins 64–79',\n    '0x5_ — bins 80–95',\n    '0x6_ — bins 96–111',\n    '0x7_ — bins 112–127',\n  ];\n  rowLabels.forEach((l,i) => {\n    const d = document.createElement('div');\n    d.innerHTML = `<b>Row ${i}</b> ${l}`;\n    legendEl.appendChild(d);\n  });\n\n  // Build grid cells + port rows once\n  const cells = [];\n  for (let i = 0; i < N; i++) {\n    const c = document.createElement('div');\n    c.className = 'cell';\n    gridEl.appendChild(c);\n    cells.push(c);\n\n    const p = document.createElement('div');\n    p.className = 'port-row';\n    p.innerHTML = `<span>ch${String(i).padStart(3,'0')}</span><span class="v">0</span>`;\n    portsEl.appendChild(p);\n  }\n  const portVals = Array.from(portsEl.querySelectorAll('.v'));\n\n  let audioCtx, analyser, sourceNode, pannerNode, mediaEl, rafId;\n  let dataArr;\n  let playing = false;\n  let cues = [];       // {t, snapshot}\n  let lastSnapshotAt = 0;\n  let viewingCueIdx = null; // null = live\n\n  function ensureCtx() {\n    if (!audioCtx) {\n      audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n      analyser = audioCtx.createAnalyser();\n      analyser.fftSize = 256; // => frequencyBinCount === 128\n      pannerNode = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;\n      dataArr = new Uint8Array(analyser.frequencyBinCount);\n    }\n    return audioCtx;\n  }\n\n  function wireGraph(node, {toDestination}) {\n    node.disconnect && node.disconnect();\n    if (pannerNode) {\n      node.connect(pannerNode);\n      pannerNode.connect(analyser);\n    } else {\n      node.connect(analyser);\n    }\n    if (toDestination) analyser.connect(audioCtx.destination);\n  }\n\n  fileInput.addEventListener('change', async (e) => {\n    const file = e.target.files[0];\n    if (!file) return;\n    ensureCtx();\n    if (mediaEl) { mediaEl.pause(); mediaEl.remove(); }\n    mediaEl = document.createElement(file.type.startsWith('video') ? 'video' : 'audio');\n    mediaEl.src = URL.createObjectURL(file);\n    mediaEl.controls = false;\n    mediaEl.style.display = 'none';\n    document.body.appendChild(mediaEl);\n    sourceNode = audioCtx.createMediaElementSource(mediaEl);\n    wireGraph(sourceNode, {toDestination: true});\n    statusEl.textContent = `Loaded: ${file.name}`;\n    playBtn.disabled = false;\n  });\n\n  micBtn.addEventListener('click', async () => {\n    try {\n      ensureCtx();\n      const stream = await navigator.mediaDevices.getUserMedia({audio: true});\n      sourceNode = audioCtx.createMediaStreamSource(stream);\n      wireGraph(sourceNode, {toDestination: false}); // avoid feedback: analyse only, no output\n      statusEl.textContent = 'Microphone connected (monitoring only, not routed to speakers).';\n      playBtn.disabled = false;\n      startLoop();\n      playing = true;\n      playBtn.textContent = '■ Stop';\n    } catch (err) {\n      statusEl.textContent = 'Microphone access denied or unavailable: ' + err.message;\n    }\n  });\n\n  playBtn.addEventListener('click', async () => {\n    if (!audioCtx) return;\n    if (audioCtx.state === 'suspended') await audioCtx.resume();\n    if (mediaEl) {\n      if (playing) { mediaEl.pause(); } else { mediaEl.play(); }\n    }\n    playing = !playing;\n    playBtn.textContent = playing ? '⏸ Pause' : '▶ Play';\n    if (playing) startLoop(); else stopLoop();\n  });\n\n  panCtl.addEventListener('input', () => {\n    if (pannerNode) pannerNode.pan.value = parseFloat(panCtl.value);\n  });\n\n  function snapshotToGrid(arr) {\n    for (let i = 0; i < N; i++) {\n      const v = arr[i] || 0; // 0..255\n      const pct = v / 255;\n      cells[i].style.background = `color-mix(in srgb, var(--cell-low), var(--cell-hi) ${Math.round(pct*100)}%)`;\n      cells[i].textContent = v > 40 ? String.fromCharCode(0x20 + (v % 95)) : '';\n      portVals[i].textContent = v;\n    }\n  }\n\n  function startLoop() {\n    cancelAnimationFrame(rafId);\n    const tick = () => {\n      if (!analyser) return;\n      analyser.getByteFrequencyData(dataArr);\n      if (viewingCueIdx === null) snapshotToGrid(dataArr);\n\n      const now = performance.now();\n      const interval = parseInt(intervalCtl.value, 10);\n      if (now - lastSnapshotAt >= interval) {\n        lastSnapshotAt = now;\n        addCue(Array.from(dataArr));\n      }\n      rafId = requestAnimationFrame(tick);\n    };\n    rafId = requestAnimationFrame(tick);\n  }\n  function stopLoop() { cancelAnimationFrame(rafId); }\n\n  function addCue(snapshot) {\n    const t = mediaEl ? mediaEl.currentTime : performance.now()/1000;\n    cues.push({t, snapshot});\n    if (cues.length > 60) cues.shift();\n    renderTimeline();\n  }\n\n  function renderTimeline() {\n    timelineEl.innerHTML = '';\n    cues.forEach((c, idx) => {\n      const el = document.createElement('div');\n      el.className = 'cue' + (viewingCueIdx === idx ? ' active' : '');\n      el.textContent = c.t.toFixed(2) + 's';\n      el.addEventListener('click', () => {\n        viewingCueIdx = idx;\n        snapshotToGrid(c.snapshot);\n        renderTimeline();\n      });\n      timelineEl.appendChild(el);\n    });\n    timelineEl.scrollLeft = timelineEl.scrollWidth;\n  }\n\n  // Double-click timeline area background to return to live view\n  timelineEl.addEventListener('dblclick', (e) => {\n    if (e.target === timelineEl) { viewingCueIdx = null; renderTimeline(); }\n  });\n})();\n
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
TEXT \n
