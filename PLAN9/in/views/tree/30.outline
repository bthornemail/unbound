DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="UTF-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n
    STARTTAG <title>
      RAWTEXT Media Spectrum → 4-bit XOR Adder (Quad Offscreen Workers)
    ENDTAG </title>
    TEXT \n
    STARTTAG <style>
      RAWTEXT \n:root {\n  --bg: #0f0f13;\n  --panel: #18181e;\n  --border: #2c2c34;\n  --text: #eceef2;\n  --muted: #9a9aa5;\n  --accent: #6d93ff;\n  --accent-dim: #1e2942;\n  --cell-low: #20222c;\n  --cell-hi: #6d93ff;\n  --danger: #ff6b68;\n  --ok: #4ade80;\n  --warn: #fbbf24;\n\n  /* Scrubbable proto-cues bound to spectrum energy */\n  --cue-energy: 0;\n  --cue-pan: 0;\n  --cue-bin0: 0; --cue-bin1: 0; --cue-bin2: 0; --cue-bin3: 0;\n  --op-mode: 0; /* 0=ADD 1=SUB 2=XOR-only 3=AND-mask */\n  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;\n}\n\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--bg); color: var(--text); min-height: 100vh; }\n\nheader {\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border);\n  background: var(--panel);\n  display: flex; flex-wrap: wrap; gap: 12px; align-items: center;\n}\nh1 { font-size: 15px; margin: 0; }\n.sub { font-size: 11px; color: var(--muted); max-width: 520px; line-height: 1.4; }\n\n.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n.controls label { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 4px; }\nbutton, select {\n  font-size: 12px; padding: 6px 10px; border-radius: 6px;\n  border: 1px solid var(--border); background: var(--panel); color: var(--text); cursor: pointer;\n}\nbutton.primary { background: var(--accent); color: #fff; border-color: var(--accent); }\nbutton:disabled { opacity: .4; cursor: not-allowed; }\ninput[type=range] { width: 100px; }\n.status { font-size: 11px; color: var(--muted); margin-left: auto; }\n\n/* Layout */\n.grid {\n  display: grid;\n  grid-template-columns: 220px 1fr 280px;\n  grid-template-rows: auto 1fr auto;\n  gap: 1px; background: var(--border);\n  min-height: calc(100vh - 110px);\n}\n@media (max-width: 1100px) {\n  .grid { grid-template-columns: 1fr; }\n}\n\n.panel { background: var(--panel); padding: 10px; overflow: auto; }\n.panel h2 {\n  font-size: 10px; text-transform: uppercase; letter-spacing: .05em;\n  color: var(--muted); margin: 0 0 8px;\n}\n\n/* Spectrum grid */\n#asciiGrid {\n  display: grid; grid-template-columns: repeat(16, 1fr); gap: 2px;\n  max-width: 420px; margin: 0 auto;\n}\n.cell {\n  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;\n  font-family: ui-monospace, Menlo, monospace; font-size: 9px;\n  border-radius: 3px; background: var(--cell-low); transition: background .06s linear;\n}\n\n/* Ports */\n#ports { font-family: ui-monospace, Menlo, monospace; font-size: 10px; max-height: 380px; overflow: auto; }\n.port-row { display: flex; justify-content: space-between; padding: 1px 3px; border-radius: 3px; }\n.port-row span.v { color: var(--muted); }\n\n/* Quad camera views */\n.quad {\n  display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;\n  gap: 4px; height: 100%; min-height: 420px;\n}\n.cam {\n  position: relative; background: #0a0a0e; border: 1px solid var(--border);\n  border-radius: 6px; overflow: hidden;\n}\n.cam canvas { width: 100%; height: 100%; display: block; }\n.cam .label {\n  position: absolute; top: 4px; left: 6px; font-size: 10px;\n  background: rgba(0,0,0,.65); padding: 2px 6px; border-radius: 4px;\n  pointer-events: none;\n}\n.cam .label b { color: var(--accent); }\n\n/* Adder / control surface */\n.adder {\n  display: flex; flex-direction: column; gap: 10px;\n}\n.bits {\n  display: flex; gap: 6px; flex-wrap: wrap; font-family: ui-monospace, monospace;\n}\n.bit {\n  width: 28px; height: 28px; border-radius: 4px; border: 1px solid var(--border);\n  display: flex; align-items: center; justify-content: center; font-size: 12px;\n  background: var(--cell-low); cursor: pointer; user-select: none;\n}\n.bit.on { background: var(--accent); color: #fff; border-color: var(--accent); }\n.bit.carry { border-color: var(--warn); }\n.op-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }\n.op-row label { font-size: 11px; color: var(--muted); }\n\n/* Timeline / VTT cues */\nfooter {\n  grid-column: 1 / -1;\n  padding: 8px 12px; border-top: 1px solid var(--border); background: var(--panel);\n}\n#timeline {\n  display: flex; gap: 3px; overflow-x: auto; padding: 4px 0; min-height: 36px;\n}\n.cue {\n  flex: 0 0 auto; font-size: 9px; font-family: ui-monospace, monospace;\n  color: var(--muted); border: 1px solid var(--border); border-radius: 4px;\n  padding: 3px 6px; cursor: pointer; background: var(--panel);\n}\n.cue.active { background: var(--accent-dim); color: var(--accent); border-color: var(--accent); }\n.cue.bound { outline: 1px solid var(--ok); }\n\n/* CSS media-query style binding demo */\n@media (min-width: 1px) {\n  .energy-bar {\n    height: 4px; background: linear-gradient(90deg, var(--cell-low), var(--accent));\n    width: calc(var(--cue-energy) * 1%); border-radius: 2px; transition: width .08s;\n  }\n}\n
    ENDTAG </style>
    TEXT \n
  ENDTAG </head>
  TEXT \n
  STARTTAG <body>
    TEXT \n
    STARTTAG <header>
      TEXT \n  
      STARTTAG <div>
        TEXT \n    
        STARTTAG <h1>
          TEXT Media Spectrum → 4-bit XOR Adder
        ENDTAG </h1>
        TEXT \n    
        STARTTAG <div class="sub">
          TEXT \n      Real FFT (AnalyserNode fftSize 256 → 128 bins) drives four OffscreenCanvas workers.\n      Each worker models one transistor-count XOR (5 / 6 / 8 NAND / 10 NOR) as a stage of a shared 4-bit adder.\n      Spectrum snapshots become scrubbable VTT-style TextTrack cues that bind CSS custom properties &amp; operation mode.\n    
        ENDTAG </div>
        TEXT \n  
      ENDTAG </div>
      TEXT \n  
      STARTTAG <div class="controls">
        TEXT \n    
        STARTTAG <label>
          TEXT Source 
          STARTTAG <input type="file" id="fileInput" accept="audio/*,video/*">
        ENDTAG </label>
        TEXT \n    
        STARTTAG <button id="micBtn">
          TEXT 🎙 Mic
        ENDTAG </button>
        TEXT \n    
        STARTTAG <button id="playBtn" class="primary" disabled>
          TEXT ▶ Play
        ENDTAG </button>
        TEXT \n    
        STARTTAG <label>
          TEXT Pan 
          STARTTAG <input type="range" id="pan" min="-1" max="1" step="0.05" value="0">
        ENDTAG </label>
        TEXT \n    
        STARTTAG <label>
          TEXT Snap every 
          STARTTAG <input type="range" id="interval" min="120" max="1500" step="30" value="400">
          TEXT  ms
        ENDTAG </label>
        TEXT \n    
        STARTTAG <label>
          TEXT Op\n      
          STARTTAG <select id="opSelect">
            TEXT \n        
            STARTTAG <option value="0">
              TEXT ADD
            ENDTAG </option>
            TEXT \n        
            STARTTAG <option value="1">
              TEXT SUB (XOR + invert)
            ENDTAG </option>
            TEXT \n        
            STARTTAG <option value="2">
              TEXT XOR-only
            ENDTAG </option>
            TEXT \n        
            STARTTAG <option value="3">
              TEXT AND-mask
            ENDTAG </option>
            TEXT \n      
          ENDTAG </select>
          TEXT \n    
        ENDTAG </label>
        TEXT \n  
      ENDTAG </div>
      TEXT \n  
      STARTTAG <div class="status" id="status">
        TEXT No source · workers ready
      ENDTAG </div>
      TEXT \n
    ENDTAG </header>
    TEXT \n\n
    STARTTAG <div class="grid">
      TEXT \n  
      COMMENT <!-- Left: spectrum + ports -->
      TEXT \n  
      STARTTAG <section class="panel">
        TEXT \n    
        STARTTAG <h2>
          TEXT Spectrum (8×16 = 128 bins)
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div id="asciiGrid">
        ENDTAG </div>
        TEXT \n    
        STARTTAG <h2 style="margin-top:12px">
          TEXT Ports (ch000–ch127)
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div id="ports">
        ENDTAG </div>
        TEXT \n  
      ENDTAG </section>
      TEXT \n\n  
      COMMENT <!-- Center: quad camera views -->
      TEXT \n  
      STARTTAG <section class="panel" style="padding:6px">
        TEXT \n    
        STARTTAG <h2>
          TEXT Quad camera views — one OffscreenCanvas worker per XOR topology
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div class="quad">
          TEXT \n      
          STARTTAG <div class="cam" id="cam0">
            TEXT \n        
            STARTTAG <canvas id="cv0">
            ENDTAG </canvas>
            TEXT \n        
            STARTTAG <div class="label">
              STARTTAG <b>
                TEXT XOR-5
              ENDTAG </b>
              TEXT  discrete · 5 BJT
            ENDTAG </div>
            TEXT \n      
          ENDTAG </div>
          TEXT \n      
          STARTTAG <div class="cam" id="cam1">
            TEXT \n        
            STARTTAG <canvas id="cv1">
            ENDTAG </canvas>
            TEXT \n        
            STARTTAG <div class="label">
              STARTTAG <b>
                TEXT XOR-6
              ENDTAG </b>
              TEXT  buffered · 6 BJT
            ENDTAG </div>
            TEXT \n      
          ENDTAG </div>
          TEXT \n      
          STARTTAG <div class="cam" id="cam2">
            TEXT \n        
            STARTTAG <canvas id="cv2">
            ENDTAG </canvas>
            TEXT \n        
            STARTTAG <div class="label">
              STARTTAG <b>
                TEXT XOR-8
              ENDTAG </b>
              TEXT  NAND ×4 · 8 BJT
            ENDTAG </div>
            TEXT \n      
          ENDTAG </div>
          TEXT \n      
          STARTTAG <div class="cam" id="cam3">
            TEXT \n        
            STARTTAG <canvas id="cv3">
            ENDTAG </canvas>
            TEXT \n        
            STARTTAG <div class="label">
              STARTTAG <b>
                TEXT XOR-10
              ENDTAG </b>
              TEXT  NOR ×5 · 10 BJT
            ENDTAG </div>
            TEXT \n      
          ENDTAG </div>
          TEXT \n    
        ENDTAG </div>
        TEXT \n  
      ENDTAG </section>
      TEXT \n\n  
      COMMENT <!-- Right: adder control surface -->
      TEXT \n  
      STARTTAG <section class="panel adder">
        TEXT \n    
        STARTTAG <h2>
          TEXT 4-bit Adder Control Surface
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div>
          TEXT \n      
          STARTTAG <div style="font-size:11px;color:var(--muted);margin-bottom:4px">
            TEXT Operand A (click bits)
          ENDTAG </div>
          TEXT \n      
          STARTTAG <div class="bits" id="bitsA">
          ENDTAG </div>
          TEXT \n    
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div>
          TEXT \n      
          STARTTAG <div style="font-size:11px;color:var(--muted);margin-bottom:4px">
            TEXT Operand B
          ENDTAG </div>
          TEXT \n      
          STARTTAG <div class="bits" id="bitsB">
          ENDTAG </div>
          TEXT \n    
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div>
          TEXT \n      
          STARTTAG <div style="font-size:11px;color:var(--muted);margin-bottom:4px">
            TEXT Sum / Result + Carry
          ENDTAG </div>
          TEXT \n      
          STARTTAG <div class="bits" id="bitsS">
          ENDTAG </div>
          TEXT \n    
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div class="op-row">
          TEXT \n      
          STARTTAG <label>
            TEXT Mode driven by cue energy → 
            STARTTAG <span id="modeLabel">
              TEXT ADD
            ENDTAG </span>
          ENDTAG </label>
          TEXT \n    
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div class="energy-bar" id="energyBar">
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div style="font-size:10px;color:var(--muted);line-height:1.4;margin-top:6px">
          TEXT \n      Low-band energy (bins 0-15) modulates A; mid-band (32-47) modulates B.\n      High energy auto-switches operation when “cue-bind” is active.\n      Double-click timeline to return to live.\n    
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div style="margin-top:8px">
          TEXT \n      
          STARTTAG <button id="bindBtn">
            TEXT Bind current cue → CSS / mode
          ENDTAG </button>
          TEXT \n      
          STARTTAG <button id="unbindBtn">
            TEXT Unbind all
          ENDTAG </button>
          TEXT \n    
        ENDTAG </div>
        TEXT \n    
        STARTTAG <div id="legend" style="font-size:10px;color:var(--muted);margin-top:10px">
        ENDTAG </div>
        TEXT \n  
      ENDTAG </section>
      TEXT \n\n  
      COMMENT <!-- Footer: timeline = VTT-style cues -->
      TEXT \n  
      STARTTAG <footer>
        TEXT \n    
        STARTTAG <h2 style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 4px">
          TEXT \n      Timeline — scrubbable proto-cues (click to inspect / bind)\n    
        ENDTAG </h2>
        TEXT \n    
        STARTTAG <div id="timeline">
        ENDTAG </div>
        TEXT \n  
      ENDTAG </footer>
      TEXT \n
    ENDTAG </div>
    TEXT \n\n
    COMMENT <!-- Hidden video/audio element for MediaElementSource + TextTrack -->
    TEXT \n
    STARTTAG <video id="mediaEl" style="display:none" crossorigin="anonymous">
    ENDTAG </video>
    TEXT \n\n
    STARTTAG <script>
      RAWTEXT \n(() => {\n  const ROWS = 8, COLS = 16, N = 128;\n  const rowLabels = [\n    '0x0_ bins 0–15 (low → A)',\n    '0x1_ bins 16–31',\n    '0x2_ bins 32–47 (mid → B)',\n    '0x3_ bins 48–63',\n    '0x4_ bins 64–79',\n    '0x5_ bins 80–95',\n    '0x6_ bins 96–111',\n    '0x7_ bins 112–127 (high → mode)'\n  ];\n\n  // DOM\n  const fileInput = document.getElementById('fileInput');\n  const micBtn    = document.getElementById('micBtn');\n  const playBtn   = document.getElementById('playBtn');\n  const panCtl    = document.getElementById('pan');\n  const intervalCtl = document.getElementById('interval');\n  const opSelect  = document.getElementById('opSelect');\n  const statusEl  = document.getElementById('status');\n  const portsEl   = document.getElementById('ports');\n  const gridEl    = document.getElementById('asciiGrid');\n  const timelineEl= document.getElementById('timeline');\n  const mediaEl   = document.getElementById('mediaEl');\n  const energyBar = document.getElementById('energyBar');\n  const modeLabel = document.getElementById('modeLabel');\n  const bindBtn   = document.getElementById('bindBtn');\n  const unbindBtn = document.getElementById('unbindBtn');\n\n  // Build spectrum cells + port rows\n  const cells = [];\n  for (let i = 0; i < N; i++) {\n    const c = document.createElement('div');\n    c.className = 'cell';\n    gridEl.appendChild(c);\n    cells.push(c);\n\n    const p = document.createElement('div');\n    p.className = 'port-row';\n    p.innerHTML = `<span>ch${String(i).padStart(3,'0')}</span><span class="v">0</span>`;\n    portsEl.appendChild(p);\n  }\n  const portVals = Array.from(portsEl.querySelectorAll('.v'));\n\n  // Legend\n  const legendEl = document.getElementById('legend');\n  rowLabels.forEach((l, i) => {\n    const d = document.createElement('div');\n    d.textContent = `Row ${i}: ${l}`;\n    legendEl.appendChild(d);\n  });\n\n  // 4-bit UI\n  let A = 0b0101, B = 0b0011; // demo defaults\n  const bitsA = document.getElementById('bitsA');\n  const bitsB = document.getElementById('bitsB');\n  const bitsS = document.getElementById('bitsS');\n\n  function renderBits(el, val, editable, isResult = false) {\n    el.innerHTML = '';\n    for (let i = 3; i >= 0; i--) {\n      const b = document.createElement('div');\n      b.className = 'bit' + (((val >> i) & 1) ? ' on' : '');\n      b.textContent = (val >> i) & 1;\n      if (editable) {\n        b.addEventListener('click', () => {\n          if (el === bitsA) A ^= (1 << i);\n          else B ^= (1 << i);\n          updateAdder();\n        });\n      }\n      el.appendChild(b);\n    }\n    if (isResult) {\n      const c = document.createElement('div');\n      c.className = 'bit carry';\n      c.textContent = 'C';\n      c.title = 'Carry out';\n      el.appendChild(c);\n    }\n  }\n\n  // Pure JS 4-bit adder / subtractor / XOR / AND using the four XOR topologies conceptually\n  function xor5(a, b) { return a ^ b; } // discrete 5-transistor equivalent\n  function xor6(a, b) { return a ^ b; } // buffered\n  function xor8(a, b) { return a ^ b; } // NAND realization\n  function xor10(a, b){ return a ^ b; } // NOR realization\n\n  // Full adder built from the XOR variants (each bit stage can pick a topology)\n  function fullAdder(a, b, cin, topo = 0) {\n    const xorFn = [xor5, xor6, xor8, xor10][topo % 4];\n    const sum = xorFn(xorFn(a, b), cin);\n    const cout = (a & b) | (cin & (a ^ b));\n    return { sum, cout };\n  }\n\n  function compute(A, B, mode) {\n    let result = 0, carry = 0;\n    if (mode === 2) { // pure XOR\n      for (let i = 0; i < 4; i++) {\n        const bit = xor5((A >> i) & 1, (B >> i) & 1);\n        result |= bit << i;\n      }\n      return { result, carry: 0 };\n    }\n    if (mode === 3) { // AND mask\n      return { result: A & B, carry: 0 };\n    }\n    // ADD or SUB\n    const Bb = mode === 1 ? (~B & 0xF) : B;\n    carry = mode === 1 ? 1 : 0; // 2's complement\n    for (let i = 0; i < 4; i++) {\n      const { sum, cout } = fullAdder((A >> i) & 1, (Bb >> i) & 1, carry, i);\n      result |= sum << i;\n      carry = cout;\n    }\n    return { result: result & 0xF, carry };\n  }\n\n  function updateAdder() {\n    const mode = parseInt(opSelect.value, 10);\n    const { result, carry } = compute(A, B, mode);\n    renderBits(bitsA, A, true);\n    renderBits(bitsB, B, true);\n    renderBits(bitsS, result, false, true);\n    // light the carry bit\n    const carryEl = bitsS.querySelector('.carry');\n    if (carryEl) {\n      carryEl.classList.toggle('on', !!carry);\n      carryEl.textContent = carry ? '1' : '0';\n    }\n    modeLabel.textContent = opSelect.options[mode].text;\n    document.documentElement.style.setProperty('--op-mode', mode);\n\n    // push current state to all workers\n    workers.forEach((w, i) => {\n      w.postMessage({\n        type: 'state',\n        A, B, result, carry, mode,\n        topo: i,\n        energy: parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--cue-energy')) || 0\n      });\n    });\n  }\n\n  // ---------- Audio + Spectrum ----------\n  let audioCtx, analyser, sourceNode, pannerNode, dataArr;\n  let playing = false, rafId = null;\n  let cues = [];          // { t, snapshot: Uint8Array, energy }\n  let lastSnapshotAt = 0;\n  let viewingCueIdx = null;\n  let boundCueIdx = null;\n\n  function ensureCtx() {\n    if (!audioCtx) {\n      audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n      analyser = audioCtx.createAnalyser();\n      analyser.fftSize = 256;\n      analyser.smoothingTimeConstant = 0.65;\n      pannerNode = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;\n      dataArr = new Uint8Array(analyser.frequencyBinCount);\n    }\n    return audioCtx;\n  }\n\n  function wireGraph(node, toDest) {\n    try { node.disconnect(); } catch (_) {}\n    if (pannerNode) {\n      node.connect(pannerNode);\n      pannerNode.connect(analyser);\n    } else {\n      node.connect(analyser);\n    }\n    if (toDest) analyser.connect(audioCtx.destination);\n  }\n\n  fileInput.addEventListener('change', async e => {\n    const file = e.target.files[0];\n    if (!file) return;\n    ensureCtx();\n    if (mediaEl.src) URL.revokeObjectURL(mediaEl.src);\n    mediaEl.src = URL.createObjectURL(file);\n    sourceNode = audioCtx.createMediaElementSource(mediaEl);\n    wireGraph(sourceNode, true);\n    statusEl.textContent = `Loaded: ${file.name}`;\n    playBtn.disabled = false;\n\n    // Attach a TextTrack for VTT-style cues\n    while (mediaEl.textTracks.length) mediaEl.removeTrack(mediaEl.textTracks[0]);\n    const track = mediaEl.addTextTrack('metadata', 'spectrum-cues', 'en');\n    track.mode = 'hidden';\n  });\n\n  micBtn.addEventListener('click', async () => {\n    try {\n      ensureCtx();\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      sourceNode = audioCtx.createMediaStreamSource(stream);\n      wireGraph(sourceNode, false);\n      statusEl.textContent = 'Microphone (monitor only)';\n      playBtn.disabled = false;\n      startLoop();\n      playing = true;\n      playBtn.textContent = '■ Stop';\n    } catch (err) {\n      statusEl.textContent = 'Mic error: ' + err.message;\n    }\n  });\n\n  playBtn.addEventListener('click', async () => {\n    if (!audioCtx) return;\n    if (audioCtx.state === 'suspended') await audioCtx.resume();\n    if (mediaEl.src) {\n      if (playing) mediaEl.pause();\n      else mediaEl.play();\n    }\n    playing = !playing;\n    playBtn.textContent = playing ? '⏸ Pause' : '▶ Play';\n    if (playing) startLoop(); else stopLoop();\n  });\n\n  panCtl.addEventListener('input', () => {\n    if (pannerNode) pannerNode.pan.value = parseFloat(panCtl.value);\n  });\n\n  opSelect.addEventListener('change', updateAdder);\n\n  function snapshotToGrid(arr) {\n    let energy = 0;\n    for (let i = 0; i < N; i++) {\n      const v = arr[i] || 0;\n      energy += v;\n      const pct = v / 255;\n      cells[i].style.background = `color-mix(in srgb, var(--cell-low), var(--cell-hi) ${Math.round(pct * 100)}%)`;\n      cells[i].textContent = v > 45 ? String.fromCharCode(0x20 + (v % 95)) : '';\n      portVals[i].textContent = v;\n    }\n    const avgEnergy = energy / (N * 255) * 100;\n    document.documentElement.style.setProperty('--cue-energy', avgEnergy.toFixed(1));\n    energyBar.style.width = avgEnergy + '%';\n\n    // low / mid / high band → CSS vars for potential media-query binding\n    const low  = arr.slice(0, 16).reduce((a, b) => a + b, 0) / (16 * 255);\n    const mid  = arr.slice(32, 48).reduce((a, b) => a + b, 0) / (16 * 255);\n    const high = arr.slice(112, 128).reduce((a, b) => a + b, 0) / (16 * 255);\n    document.documentElement.style.setProperty('--cue-bin0', (low * 100).toFixed(1));\n    document.documentElement.style.setProperty('--cue-bin2', (mid * 100).toFixed(1));\n    document.documentElement.style.setProperty('--cue-bin7', (high * 100).toFixed(1));\n\n    // optional auto-modulation of operands from spectrum when live\n    if (viewingCueIdx === null && boundCueIdx === null) {\n      // gentle influence only\n      const aNudge = Math.round(low * 15);\n      const bNudge = Math.round(mid * 15);\n      // leave manual bits alone unless user wants full auto\n    }\n  }\n\n  function startLoop() {\n    cancelAnimationFrame(rafId);\n    const tick = () => {\n      if (!analyser) return;\n      analyser.getByteFrequencyData(dataArr);\n      if (viewingCueIdx === null) snapshotToGrid(dataArr);\n\n      const now = performance.now();\n      const interval = parseInt(intervalCtl.value, 10);\n      if (now - lastSnapshotAt >= interval) {\n        lastSnapshotAt = now;\n        addCue(Array.from(dataArr));\n      }\n      rafId = requestAnimationFrame(tick);\n    };\n    rafId = requestAnimationFrame(tick);\n  }\n  function stopLoop() { cancelAnimationFrame(rafId); }\n\n  function addCue(snapshot) {\n    const t = mediaEl.src && !mediaEl.paused ? mediaEl.currentTime : performance.now() / 1000;\n    const energy = snapshot.reduce((a, b) => a + b, 0) / (N * 255) * 100;\n    cues.push({ t, snapshot, energy });\n    if (cues.length > 80) cues.shift();\n    renderTimeline();\n\n    // also push a VTT cue onto the TextTrack if we have a media element\n    if (mediaEl.textTracks.length) {\n      const track = mediaEl.textTracks[0];\n      const cue = new VTTCue(t, t + 0.4, JSON.stringify({ energy: energy.toFixed(1) }));\n      try { track.addCue(cue); } catch (_) {}\n    }\n  }\n\n  function renderTimeline() {\n    timelineEl.innerHTML = '';\n    cues.forEach((c, idx) => {\n      const el = document.createElement('div');\n      el.className = 'cue' +\n        (viewingCueIdx === idx ? ' active' : '') +\n        (boundCueIdx === idx ? ' bound' : '');\n      el.textContent = c.t.toFixed(2) + 's · E' + c.energy.toFixed(0);\n      el.title = 'Click to inspect · Shift-click to bind';\n      el.addEventListener('click', e => {\n        if (e.shiftKey) {\n          boundCueIdx = idx;\n          applyBoundCue(c);\n        } else {\n          viewingCueIdx = idx;\n          snapshotToGrid(c.snapshot);\n        }\n        renderTimeline();\n      });\n      timelineEl.appendChild(el);\n    });\n    timelineEl.scrollLeft = timelineEl.scrollWidth;\n  }\n\n  timelineEl.addEventListener('dblclick', e => {\n    if (e.target === timelineEl) {\n      viewingCueIdx = null;\n      renderTimeline();\n    }\n  });\n\n  function applyBoundCue(c) {\n    document.documentElement.style.setProperty('--cue-energy', c.energy.toFixed(1));\n    // map energy to operation mode for demo\n    const mode = c.energy > 55 ? 1 : c.energy > 35 ? 2 : 0;\n    opSelect.value = String(mode);\n    updateAdder();\n    statusEl.textContent = `Bound cue @ ${c.t.toFixed(2)}s → mode ${opSelect.options[mode].text}`;\n  }\n\n  bindBtn.addEventListener('click', () => {\n    if (viewingCueIdx !== null) {\n      boundCueIdx = viewingCueIdx;\n      applyBoundCue(cues[viewingCueIdx]);\n      renderTimeline();\n    } else {\n      statusEl.textContent = 'Select a cue first, then bind';\n    }\n  });\n  unbindBtn.addEventListener('click', () => {\n    boundCueIdx = null;\n    renderTimeline();\n    statusEl.textContent = 'Unbound';\n  });\n\n  // ---------- OffscreenCanvas Workers ----------\n  const workerCode = `\n    const topologies = [\n      { name: 'XOR-5', transistors: 5, color: '#6d93ff' },\n      { name: 'XOR-6', transistors: 6, color: '#4ade80' },\n      { name: 'XOR-8', transistors: 8, color: '#fbbf24' },\n      { name: 'XOR-10', transistors: 10, color: '#ff6b68' }\n    ];\n\n    let canvas, ctx, W, H, state = { A:0, B:0, result:0, carry:0, mode:0, topo:0, energy:0 };\n    let t = 0;\n\n    function drawTransistor(x, y, on, scale = 1) {\n      ctx.save();\n      ctx.translate(x, y);\n      ctx.scale(scale, scale);\n      // body\n      ctx.fillStyle = on ? '#e2e8f0' : '#334155';\n      ctx.beginPath();\n      ctx.moveTo(-6, -8); ctx.lineTo(6, -8); ctx.lineTo(6, 8); ctx.lineTo(-6, 8);\n      ctx.closePath(); ctx.fill();\n      // legs\n      ctx.strokeStyle = on ? '#94a3b8' : '#475569';\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.moveTo(0, -8); ctx.lineTo(0, -14);\n      ctx.moveTo(-4, 8); ctx.lineTo(-4, 14);\n      ctx.moveTo(4, 8); ctx.lineTo(4, 14);\n      ctx.stroke();\n      // base indicator\n      if (on) {\n        ctx.fillStyle = '#fbbf24';\n        ctx.beginPath(); ctx.arc(0, 0, 2.5, 0, Math.PI * 2); ctx.fill();\n      }\n      ctx.restore();\n    }\n\n    function drawWire(x1, y1, x2, y2, active) {\n      ctx.strokeStyle = active ? '#6d93ff' : '#334155';\n      ctx.lineWidth = active ? 2 : 1;\n      ctx.beginPath();\n      ctx.moveTo(x1, y1); ctx.lineTo(x2, y2);\n      ctx.stroke();\n    }\n\n    function render() {\n      if (!ctx) return;\n      t += 0.016;\n      const topo = topologies[state.topo % 4];\n      ctx.fillStyle = '#0a0a0e';\n      ctx.fillRect(0, 0, W, H);\n\n      // title bar\n      ctx.fillStyle = 'rgba(0,0,0,0.55)';\n      ctx.fillRect(0, 0, W, 22);\n      ctx.fillStyle = topo.color;\n      ctx.font = 'bold 11px ui-monospace, monospace';\n      ctx.fillText(topo.name + '  ·  ' + topo.transistors + ' BJT', 8, 15);\n\n      // simple schematic layout – positions scale with transistor count\n      const n = topo.transistors;\n      const cx = W / 2, cy = H / 2 + 10;\n      const spread = Math.min(W * 0.7, n * 28);\n\n      // input rails\n      const aOn = !!(state.A & 1);\n      const bOn = !!(state.B & 1);\n      const outOn = !!(state.result & 1);\n\n      drawWire(20, cy - 30, cx - spread/2, cy - 30, aOn);\n      drawWire(20, cy + 30, cx - spread/2, cy + 30, bOn);\n      ctx.fillStyle = aOn ? '#6d93ff' : '#475569';\n      ctx.font = '10px monospace';\n      ctx.fillText('A', 6, cy - 26);\n      ctx.fillStyle = bOn ? '#6d93ff' : '#475569';\n      ctx.fillText('B', 6, cy + 34);\n\n      // transistors in a rough chain / tree\n      for (let i = 0; i < n; i++) {\n        const frac = n === 1 ? 0.5 : i / (n - 1);\n        const x = cx - spread/2 + frac * spread;\n        const y = cy + Math.sin(frac * Math.PI) * (i % 2 ? 18 : -18);\n        const active = (i < 2 && (aOn || bOn)) || (i >= n - 2 && outOn) ||\n                       (state.energy > 40 && Math.sin(t * 3 + i) > 0.3);\n        drawTransistor(x, y, active, 1.1);\n        if (i > 0) {\n          const prevFrac = (i - 1) / (n - 1);\n          const px = cx - spread/2 + prevFrac * spread;\n          const py = cy + Math.sin(prevFrac * Math.PI) * ((i - 1) % 2 ? 18 : -18);\n          drawWire(px + 6, py, x - 6, y, active);\n        }\n      }\n\n      // output LED\n      const ledX = W - 36, ledY = cy;\n      drawWire(cx + spread/2 + 10, cy, ledX - 12, ledY, outOn);\n      ctx.beginPath();\n      ctx.arc(ledX, ledY, 9, 0, Math.PI * 2);\n      ctx.fillStyle = outOn ? topo.color : '#1e293b';\n      ctx.fill();\n      ctx.strokeStyle = '#64748b';\n      ctx.stroke();\n      if (outOn) {\n        ctx.fillStyle = '#fff';\n        ctx.font = '9px monospace';\n        ctx.fillText('1', ledX - 3, ledY + 3);\n      }\n\n      // energy meter\n      ctx.fillStyle = '#1e293b';\n      ctx.fillRect(8, H - 14, W - 16, 6);\n      ctx.fillStyle = topo.color;\n      ctx.fillRect(8, H - 14, (W - 16) * Math.min(1, state.energy / 100), 6);\n\n      // mode badge\n      const modes = ['ADD', 'SUB', 'XOR', 'AND'];\n      ctx.fillStyle = 'rgba(0,0,0,0.5)';\n      ctx.fillRect(W - 52, 4, 44, 14);\n      ctx.fillStyle = '#94a3b8';\n      ctx.font = '9px monospace';\n      ctx.fillText(modes[state.mode] || 'ADD', W - 46, 14);\n\n      requestAnimationFrame(render);\n    }\n\n    self.onmessage = (e) => {\n      const msg = e.data;\n      if (msg.type === 'init') {\n        canvas = msg.canvas;\n        ctx = canvas.getContext('2d');\n        W = canvas.width;\n        H = canvas.height;\n        state.topo = msg.topo;\n        render();\n      } else if (msg.type === 'state') {\n        Object.assign(state, msg);\n      } else if (msg.type === 'resize') {\n        if (canvas) {\n          canvas.width = msg.w;\n          canvas.height = msg.h;\n          W = msg.w; H = msg.h;\n        }\n      }\n    };\n  `;\n\n  const workers = [];\n  const canvases = [];\n\n  function initWorkers() {\n    const blob = new Blob([workerCode], { type: 'application/javascript' });\n    const url = URL.createObjectURL(blob);\n\n    for (let i = 0; i < 4; i++) {\n      const cv = document.getElementById('cv' + i);\n      // size to container\n      const rect = cv.parentElement.getBoundingClientRect();\n      cv.width = Math.max(200, Math.floor(rect.width * devicePixelRatio));\n      cv.height = Math.max(160, Math.floor(rect.height * devicePixelRatio));\n\n      const off = cv.transferControlToOffscreen();\n      const w = new Worker(url);\n      w.postMessage({ type: 'init', canvas: off, topo: i }, [off]);\n      workers.push(w);\n      canvases.push(cv);\n    }\n    URL.revokeObjectURL(url);\n  }\n\n  // resize observer to keep offscreen canvases sharp\n  const ro = new ResizeObserver(entries => {\n    entries.forEach(entry => {\n      const idx = ['cam0','cam1','cam2','cam3'].indexOf(entry.target.id);\n      if (idx < 0 || !workers[idx]) return;\n      const w = Math.floor(entry.contentRect.width * devicePixelRatio);\n      const h = Math.floor(entry.contentRect.height * devicePixelRatio);\n      workers[idx].postMessage({ type: 'resize', w, h });\n    });\n  });\n  ['cam0','cam1','cam2','cam3'].forEach(id => ro.observe(document.getElementById(id)));\n\n  // boot\n  initWorkers();\n  updateAdder();\n  statusEl.textContent = 'Workers live · load audio or use mic';\n})();\n
    ENDTAG </script>
    TEXT \n
  ENDTAG </body>
  TEXT \n
ENDTAG </html>
TEXT \n
