DOCTYPE <!DOCTYPE html>
TEXT \n
STARTTAG <html lang="en">
  TEXT \n
  STARTTAG <head>
    TEXT \n
    STARTTAG <meta charset="UTF-8">
    TEXT \n
    STARTTAG <meta name="viewport" content="width=device-width, initial-scale=1.0">
    TEXT \n
    STARTTAG <title>
      RAWTEXT Media Spectrum → 4-bit XOR Adder (Quad Offscreen Workers)\n<style>\n:root {\n  --bg: #0f0f13;\n  --panel: #18181e;\n  --border: #2c2c34;\n  --text: #eceef2;\n  --muted: #9a9aa5;\n  --accent: #6d93ff;\n  --accent-dim: #1e2942;\n  --cell-low: #20222c;\n  --cell-hi: #6d93ff;\n  --danger: #ff6b68;\n  --ok: #4ade80;\n  --warn: #fbbf24;\n  --cue-energy: 0;\n  --cue-pan: 0;\n  --op-mode: 0;\n  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;\n}\n\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--bg); color: var(--text); min-height: 100vh; }\n\nheader {\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border);\n  background: var(--panel);\n  display: flex; flex-wrap: wrap; gap: 12px; align-items: center;\n}\nh1 { font-size: 15px; margin: 0; }\n.sub { font-size: 11px; color: var(--muted); max-width: 520px; line-height: 1.4; }\n\n.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n.controls label { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 4px; }\nbutton, select {\n  font-size: 12px; padding: 6px 10px; border-radius: 6px;\n  border: 1px solid var(--border); background: var(--panel); color: var(--text); cursor: pointer;\n}\nbutton.primary { background: var(--accent); color: #fff; border-color: var(--accent); }\nbutton:disabled { opacity: .4; cursor: not-allowed; }\ninput[type=range] { width: 100px; }\n.status { font-size: 11px; color: var(--muted); margin-left: auto; }\n\n.grid {\n  display: grid;\n  grid-template-columns: 240px 1fr 280px;\n  grid-template-rows: auto 1fr auto;\n  gap: 1px; background: var(--border);\n  min-height: calc(100vh - 110px);\n}\n@media (max-width: 1100px) {\n  .grid { grid-template-columns: 1fr; }\n}\n\n.panel { background: var(--panel); padding: 10px; overflow: auto; }\n.panel h2 {\n  font-size: 10px; text-transform: uppercase; letter-spacing: .05em;\n  color: var(--muted); margin: 0 0 8px;\n}\n\n/* Real oscilloscope look */\n#oscilloscope-wrap {\n  margin-bottom: 12px;\n  border: 2px solid #1a2a1a;\n  border-radius: 4px;\n  overflow: hidden;\n  background: #020804;\n  box-shadow:\n    inset 0 0 30px rgba(0, 40, 0, 0.6),\n    0 0 0 1px #0a1a0a;\n  position: relative;\n}\n#oscilloscope-wrap::after {\n  /* subtle CRT vignette */\n  content: "";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.45) 100%);\n}\n#oscilloscope {\n  display: block;\n  width: 100%;\n  height: 110px;\n}\n\n/* Spectrum grid */\n#asciiGrid {\n  display: grid; grid-template-columns: repeat(16, 1fr); gap: 2px;\n  max-width: 420px; margin: 0 auto;\n}\n.cell {\n  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;\n  font-family: ui-monospace, Menlo, monospace; font-size: 9px;\n  border-radius: 3px; background: var(--cell-low); transition: background .06s linear;\n}\n\n#ports { font-family: ui-monospace, Menlo, monospace; font-size: 10px; max-height: 320px; overflow: auto; }\n.port-row { display: flex; justify-content: space-between; padding: 1px 3px; border-radius: 3px; }\n.port-row span.v { color: var(--muted); }\n\n.quad {\n  display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;\n  gap: 4px; height: 100%; min-height: 420px;\n}\n.cam {\n  position: relative; background: #0a0a0e; border: 1px solid var(--border);\n  border-radius: 6px; overflow: hidden;\n}\n.cam canvas { width: 100%; height: 100%; display: block; }\n.cam .label {\n  position: absolute; top: 4px; left: 6px; font-size: 10px;\n  background: rgba(0,0,0,.65); padding: 2px 6px; border-radius: 4px;\n  pointer-events: none;\n}\n.cam .label b { color: var(--accent); }\n\n.adder { display: flex; flex-direction: column; gap: 10px; }\n.bits { display: flex; gap: 6px; flex-wrap: wrap; font-family: ui-monospace, monospace; }\n.bit {\n  width: 28px; height: 28px; border-radius: 4px; border: 1px solid var(--border);\n  display: flex; align-items: center; justify-content: center; font-size: 12px;\n  background: var(--cell-low); cursor: pointer; user-select: none;\n}\n.bit.on { background: var(--accent); color: #fff; border-color: var(--accent); }\n.bit.carry { border-color: var(--warn); }\n.op-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }\n.op-row label { font-size: 11px; color: var(--muted); }\n\nfooter {\n  grid-column: 1 / -1;\n  padding: 8px 12px; border-top: 1px solid var(--border); background: var(--panel);\n}\n#timeline {\n  display: flex; gap: 3px; overflow-x: auto; padding: 4px 0; min-height: 36px;\n}\n.cue {\n  flex: 0 0 auto; font-size: 9px; font-family: ui-monospace, monospace;\n  color: var(--muted); border: 1px solid var(--border); border-radius: 4px;\n  padding: 3px 6px; cursor: pointer; background: var(--panel);\n}\n.cue.active { background: var(--accent-dim); color: var(--accent); border-color: var(--accent); }\n.cue.bound { outline: 1px solid var(--ok); }\n\n.energy-bar {\n  height: 4px; background: linear-gradient(90deg, var(--cell-low), var(--accent));\n  width: calc(var(--cue-energy) * 1%); border-radius: 2px; transition: width .08s;\n}\n</style>\n</head>\n<body>\n<header>\n  <div>\n    <h1>Media Spectrum → 4-bit XOR Adder</h1>\n    <div class="sub">\n      Real FFT (AnalyserNode) drives four OffscreenCanvas workers modelling the 5 / 6 / 8 / 10 transistor XOR topologies.\n      Spectrum snapshots become scrubbable VTT-style cues that bind CSS custom properties &amp; operation mode.\n    </div>\n  </div>\n  <div class="controls">\n    <label>Source <input type="file" id="fileInput" accept="audio/*,video/*"></label>\n    <button id="micBtn">🎙 Mic</button>\n    <button id="playBtn" class="primary" disabled>▶ Play</button>\n    <label>Pan <input type="range" id="pan" min="-1" max="1" step="0.05" value="0"></label>\n    <label>Snap every <input type="range" id="interval" min="120" max="1500" step="30" value="400"> ms</label>\n    <label>Op\n      <select id="opSelect">\n        <option value="0">ADD</option>\n        <option value="1">SUB (XOR + invert)</option>\n        <option value="2">XOR-only</option>\n        <option value="3">AND-mask</option>\n      </select>\n    </label>\n  </div>\n  <div class="status" id="status">No source · workers ready</div>\n</header>\n\n<div class="grid">\n  <section class="panel">\n    <h2>Oscilloscope (time domain)</h2>\n    <div id="oscilloscope-wrap">\n      <canvas id="oscilloscope" width="400" height="110"></canvas>\n    </div>\n    <h2>Spectrum (8×16 = 128 bins)</h2>\n    <div id="asciiGrid"></div>\n    <h2 style="margin-top:12px">Ports (ch000–ch127)</h2>\n    <div id="ports"></div>\n  </section>\n\n  <section class="panel" style="padding:6px">\n    <h2>Quad camera views — DNA/RNA helices + CLA orbit pulses (one worker per stage)</h2>\n    <div class="quad">\n      <div class="cam" id="cam0">\n        <canvas id="cv0"></canvas>\n        <div class="label"><b>DNA · AA55</b> unit 0 · XOR-5</div>\n      </div>\n      <div class="cam" id="cam1">\n        <canvas id="cv1"></canvas>\n        <div class="label"><b>RNA · 718E</b> unit 1 · XOR-6</div>\n      </div>\n      <div class="cam" id="cam2">\n        <canvas id="cv2"></canvas>\n        <div class="label"><b>DNA · EE11</b> unit 2 · XOR-8</div>\n      </div>\n      <div class="cam" id="cam3">\n        <canvas id="cv3"></canvas>\n        <div class="label"><b>RNA · CA35</b> unit 3 · XOR-10</div>\n      </div>\n    </div>\n  </section>\n\n  <section class="panel adder">\n    <h2>4-bit Adder Control Surface</h2>\n    <div>\n      <div style="font-size:11px;color:var(--muted);margin-bottom:4px">Operand A (click bits)</div>\n      <div class="bits" id="bitsA"></div>\n    </div>\n    <div>\n      <div style="font-size:11px;color:var(--muted);margin-bottom:4px">Operand B</div>\n      <div class="bits" id="bitsB"></div>\n    </div>\n    <div>\n      <div style="font-size:11px;color:var(--muted);margin-bottom:4px">Sum / Result + Carry</div>\n      <div class="bits" id="bitsS"></div>\n    </div>\n    <div class="op-row">\n      <label>Mode driven by cue energy → <span id="modeLabel">ADD</span></label>\n    </div>\n    <div class="energy-bar" id="energyBar"></div>\n    <div style="font-size:10px;color:var(--muted);line-height:1.4;margin-top:6px">\n      Low-band energy modulates A; mid-band modulates B.\n      High energy can auto-switch operation when a cue is bound.\n      Double-click timeline to return to live.\n    </div>\n    <div style="margin-top:8px">\n      <button id="bindBtn">Bind current cue → CSS / mode</button>\n      <button id="unbindBtn">Unbind all</button>\n    </div>\n    <div id="legend" style="font-size:10px;color:var(--muted);margin-top:10px"></div>\n  </section>\n\n  <footer>\n    <h2 style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 4px">\n      Timeline — scrubbable proto-cues (click to inspect / Shift-click to bind)\n    </h2>\n    <div id="timeline"></div>\n  </footer>\n</div>\n\n<video id="mediaEl" style="display:none" crossorigin="anonymous"></video>\n\n<script>\n(() => {\n  const ROWS = 8, COLS = 16, N = 128;\n  const rowLabels = [\n    '0x0_ bins 0–15 (low → A)',\n    '0x1_ bins 16–31',\n    '0x2_ bins 32–47 (mid → B)',\n    '0x3_ bins 48–63',\n    '0x4_ bins 64–79',\n    '0x5_ bins 80–95',\n    '0x6_ bins 96–111',\n    '0x7_ bins 112–127 (high → mode)'\n  ];\n\n  const fileInput = document.getElementById('fileInput');\n  const micBtn    = document.getElementById('micBtn');\n  const playBtn   = document.getElementById('playBtn');\n  const panCtl    = document.getElementById('pan');\n  const intervalCtl = document.getElementById('interval');\n  const opSelect  = document.getElementById('opSelect');\n  const statusEl  = document.getElementById('status');\n  const portsEl   = document.getElementById('ports');\n  const gridEl    = document.getElementById('asciiGrid');\n  const timelineEl= document.getElementById('timeline');\n  const mediaEl   = document.getElementById('mediaEl');\n  const energyBar = document.getElementById('energyBar');\n  const modeLabel = document.getElementById('modeLabel');\n  const bindBtn   = document.getElementById('bindBtn');\n  const unbindBtn = document.getElementById('unbindBtn');\n\n  // Build spectrum cells + port rows\n  const cells = [];\n  for (let i = 0; i < N; i++) {\n    const c = document.createElement('div');\n    c.className = 'cell';\n    gridEl.appendChild(c);\n    cells.push(c);\n\n    const p = document.createElement('div');\n    p.className = 'port-row';\n    p.innerHTML = `<span>ch${String(i).padStart(3,'0')}</span><span class="v">0</span>`;\n    portsEl.appendChild(p);\n  }\n  const portVals = Array.from(portsEl.querySelectorAll('.v'));\n\n  const legendEl = document.getElementById('legend');\n  rowLabels.forEach((l, i) => {\n    const d = document.createElement('div');\n    d.textContent = `Row ${i}: ${l}`;\n    legendEl.appendChild(d);\n  });\n\n  // 4-bit UI\n  let A = 0b0101, B = 0b0011;\n  const bitsA = document.getElementById('bitsA');\n  const bitsB = document.getElementById('bitsB');\n  const bitsS = document.getElementById('bitsS');\n\n  function renderBits(el, val, editable, isResult = false) {\n    el.innerHTML = '';\n    for (let i = 3; i >= 0; i--) {\n      const b = document.createElement('div');\n      b.className = 'bit' + (((val >> i) & 1) ? ' on' : '');\n      b.textContent = (val >> i) & 1;\n      if (editable) {\n        b.addEventListener('click', () => {\n          if (el === bitsA) A ^= (1 << i);\n          else B ^= (1 << i);\n          updateAdder();\n        });\n      }\n      el.appendChild(b);\n    }\n    if (isResult) {\n      const c = document.createElement('div');\n      c.className = 'bit carry';\n      c.textContent = 'C';\n      c.title = 'Carry out';\n      el.appendChild(c);\n    }\n  }\n\n  function xor5(a, b) { return a ^ b; }\n  function xor6(a, b) { return a ^ b; }\n  function xor8(a, b) { return a ^ b; }\n  function xor10(a, b){ return a ^ b; }\n\n  function fullAdder(a, b, cin, topo = 0) {\n    const xorFn = [xor5, xor6, xor8, xor10][topo % 4];\n    const sum = xorFn(xorFn(a, b), cin);\n    const cout = (a & b) | (cin & (a ^ b));\n    return { sum, cout };\n  }\n\n  function compute(A, B, mode) {\n    let result = 0, carry = 0;\n    if (mode === 2) {\n      for (let i = 0; i < 4; i++) {\n        result |= (xor5((A >> i) & 1, (B >> i) & 1)) << i;\n      }\n      return { result, carry: 0 };\n    }\n    if (mode === 3) return { result: A & B, carry: 0 };\n\n    const Bb = mode === 1 ? (~B & 0xF) : B;\n    carry = mode === 1 ? 1 : 0;\n    for (let i = 0; i < 4; i++) {\n      const { sum, cout } = fullAdder((A >> i) & 1, (Bb >> i) & 1, carry, i);\n      result |= sum << i;\n      carry = cout;\n    }\n    return { result: result & 0xF, carry };\n  }\n\n  function updateAdder() {\n    const mode = parseInt(opSelect.value, 10);\n    const { result, carry } = compute(A, B, mode);\n    renderBits(bitsA, A, true);\n    renderBits(bitsB, B, true);\n    renderBits(bitsS, result, false, true);\n    const carryEl = bitsS.querySelector('.carry');\n    if (carryEl) {\n      carryEl.classList.toggle('on', !!carry);\n      carryEl.textContent = carry ? '1' : '0';\n    }\n    modeLabel.textContent = opSelect.options[mode].text;\n    document.documentElement.style.setProperty('--op-mode', mode);\n\n    workers.forEach((w, i) => {\n      w.postMessage({\n        type: 'state',\n        A, B, result, carry, mode,\n        topo: i,\n        energy: parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--cue-energy')) || 0\n      });\n    });\n  }\n\n  // ---------- Audio + Spectrum + Oscilloscope ----------\n  let audioCtx, analyser, waveAnalyser, sourceNode, pannerNode, dataArr, waveArr;\n  let playing = false, rafId = null;\n  let cues = [];\n  let lastSnapshotAt = 0;\n  let viewingCueIdx = null;\n  let boundCueIdx = null;\n\n  const oscCanvas = document.getElementById('oscilloscope');\n  const oscCtx = oscCanvas.getContext('2d');\n\n  function ensureCtx() {\n    if (!audioCtx) {\n      audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n\n      analyser = audioCtx.createAnalyser();\n      analyser.fftSize = 256;\n      analyser.smoothingTimeConstant = 0.65;\n      dataArr = new Uint8Array(analyser.frequencyBinCount);\n\n      waveAnalyser = audioCtx.createAnalyser();\n      waveAnalyser.fftSize = 2048;\n      waveAnalyser.smoothingTimeConstant = 0.25;\n      waveArr = new Uint8Array(waveAnalyser.frequencyBinCount);\n\n      pannerNode = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;\n    }\n    return audioCtx;\n  }\n\n  function wireGraph(node, toDest) {\n    try { node.disconnect(); } catch (_) {}\n    if (pannerNode) {\n      node.connect(pannerNode);\n      pannerNode.connect(analyser);\n      pannerNode.connect(waveAnalyser);\n    } else {\n      node.connect(analyser);\n      node.connect(waveAnalyser);\n    }\n    if (toDest) analyser.connect(audioCtx.destination);\n  }\n\n  // ========== REAL OSCILLOSCOPE RENDERER ==========\n  function drawWaveform() {\n    if (!waveAnalyser || !oscCtx) return;\n\n    waveAnalyser.getByteTimeDomainData(waveArr);\n\n    const W = oscCanvas.width;\n    const H = oscCanvas.height;\n    const midY = H / 2;\n\n    // 1. Phosphor fade / persistence (dark green residual)\n    oscCtx.fillStyle = 'rgba(2, 8, 4, 0.35)';\n    oscCtx.fillRect(0, 0, W, H);\n\n    // 2. Classic CRT grid\n    oscCtx.lineWidth = 1;\n    // minor grid\n    oscCtx.strokeStyle = 'rgba(0, 80, 30, 0.25)';\n    const minorX = W / 50;\n    const minorY = H / 20;\n    oscCtx.beginPath();\n    for (let x = 0; x <= W; x += minorX) {\n      oscCtx.moveTo(x, 0); oscCtx.lineTo(x, H);\n    }\n    for (let y = 0; y <= H; y += minorY) {\n      oscCtx.moveTo(0, y); oscCtx.lineTo(W, y);\n    }\n    oscCtx.stroke();\n\n    // major grid (10×8 style)\n    oscCtx.strokeStyle = 'rgba(0, 140, 50, 0.35)';\n    const majorX = W / 10;\n    const majorY = H / 8;\n    oscCtx.beginPath();\n    for (let x = 0; x <= W; x += majorX) {\n      oscCtx.moveTo(x, 0); oscCtx.lineTo(x, H);\n    }\n    for (let y = 0; y <= H; y += majorY) {\n      oscCtx.moveTo(0, y); oscCtx.lineTo(W, y);\n    }\n    oscCtx.stroke();\n\n    // bright center crosshairs\n    oscCtx.strokeStyle = 'rgba(0, 220, 80, 0.45)';\n    oscCtx.lineWidth = 1.2;\n    oscCtx.beginPath();\n    oscCtx.moveTo(0, midY); oscCtx.lineTo(W, midY);\n    oscCtx.moveTo(W / 2, 0); oscCtx.lineTo(W / 2, H);\n    oscCtx.stroke();\n\n    // 3. Build the waveform path\n    const sliceWidth = W / waveArr.length;\n    oscCtx.beginPath();\n    let x = 0;\n    for (let i = 0; i < waveArr.length; i++) {\n      const v = waveArr[i] / 128.0;          // 0..2\n      const y = (v * H) / 2;\n      if (i === 0) oscCtx.moveTo(x, y);\n      else         oscCtx.lineTo(x, y);\n      x += sliceWidth;\n    }\n\n    // 4. Multi-pass phosphor glow (outer soft → inner bright)\n    // Outer glow\n    oscCtx.strokeStyle = 'rgba(0, 255, 70, 0.08)';\n    oscCtx.lineWidth = 9;\n    oscCtx.lineJoin = 'round';\n    oscCtx.lineCap = 'round';\n    oscCtx.stroke();\n\n    // Mid glow\n    oscCtx.strokeStyle = 'rgba(0, 255, 90, 0.22)';\n    oscCtx.lineWidth = 4.5;\n    oscCtx.stroke();\n\n    // Core bright green\n    oscCtx.strokeStyle = '#00ff5a';\n    oscCtx.lineWidth = 1.6;\n    oscCtx.stroke();\n\n    // Hot center (almost white-green)\n    oscCtx.strokeStyle = 'rgba(180, 255, 200, 0.85)';\n    oscCtx.lineWidth = 0.7;\n    oscCtx.stroke();\n\n    // 5. Very subtle horizontal scan lines (CRT feel)\n    oscCtx.fillStyle = 'rgba(0, 0, 0, 0.07)';\n    for (let y = 0; y < H; y += 3) {\n      oscCtx.fillRect(0, y, W, 1);\n    }\n  }\n\n  fileInput.addEventListener('change', async e => {\n    const file = e.target.files[0];\n    if (!file) return;\n    ensureCtx();\n    if (mediaEl.src) URL.revokeObjectURL(mediaEl.src);\n    mediaEl.src = URL.createObjectURL(file);\n    sourceNode = audioCtx.createMediaElementSource(mediaEl);\n    wireGraph(sourceNode, true);\n    statusEl.textContent = `Loaded: ${file.name}`;\n    playBtn.disabled = false;\n\n    while (mediaEl.textTracks.length) mediaEl.removeTrack(mediaEl.textTracks[0]);\n    const track = mediaEl.addTextTrack('metadata', 'spectrum-cues', 'en');\n    track.mode = 'hidden';\n  });\n\n  micBtn.addEventListener('click', async () => {\n    try {\n      ensureCtx();\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      sourceNode = audioCtx.createMediaStreamSource(stream);\n      wireGraph(sourceNode, false);\n      statusEl.textContent = 'Microphone (monitor only)';\n      playBtn.disabled = false;\n      startLoop();\n      playing = true;\n      playBtn.textContent = '■ Stop';\n    } catch (err) {\n      statusEl.textContent = 'Mic error: ' + err.message;\n    }\n  });\n\n  playBtn.addEventListener('click', async () => {\n    if (!audioCtx) return;\n    if (audioCtx.state === 'suspended') await audioCtx.resume();\n    if (mediaEl.src) {\n      if (playing) mediaEl.pause();\n      else mediaEl.play();\n    }\n    playing = !playing;\n    playBtn.textContent = playing ? '⏸ Pause' : '▶ Play';\n    if (playing) startLoop(); else stopLoop();\n  });\n\n  panCtl.addEventListener('input', () => {\n    if (pannerNode) pannerNode.pan.value = parseFloat(panCtl.value);\n  });\n\n  opSelect.addEventListener('change', updateAdder);\n\n  function snapshotToGrid(arr) {\n    let energy = 0;\n    for (let i = 0; i < N; i++) {\n      const v = arr[i] || 0;\n      energy += v;\n      const pct = v / 255;\n      cells[i].style.background = `color-mix(in srgb, var(--cell-low), var(--cell-hi) ${Math.round(pct * 100)}%)`;\n      cells[i].textContent = v > 45 ? String.fromCharCode(0x20 + (v % 95)) : '';\n      portVals[i].textContent = v;\n    }\n    const avgEnergy = energy / (N * 255) * 100;\n    document.documentElement.style.setProperty('--cue-energy', avgEnergy.toFixed(1));\n    energyBar.style.width = avgEnergy + '%';\n  }\n\n  function startLoop() {\n    cancelAnimationFrame(rafId);\n    const tick = () => {\n      if (!analyser) return;\n      analyser.getByteFrequencyData(dataArr);\n      if (viewingCueIdx === null) snapshotToGrid(dataArr);\n\n      drawWaveform();   // always live\n\n      const now = performance.now();\n      const interval = parseInt(intervalCtl.value, 10);\n      if (now - lastSnapshotAt >= interval) {\n        lastSnapshotAt = now;\n        addCue(Array.from(dataArr));\n      }\n      rafId = requestAnimationFrame(tick);\n    };\n    rafId = requestAnimationFrame(tick);\n  }\n  function stopLoop() { cancelAnimationFrame(rafId); }\n\n  function addCue(snapshot) {\n    const t = mediaEl.src && !mediaEl.paused ? mediaEl.currentTime : performance.now() / 1000;\n    const energy = snapshot.reduce((a, b) => a + b, 0) / (N * 255) * 100;\n    cues.push({ t, snapshot, energy });\n    if (cues.length > 80) cues.shift();\n    renderTimeline();\n\n    if (mediaEl.textTracks.length) {\n      const track = mediaEl.textTracks[0];\n      const cue = new VTTCue(t, t + 0.4, JSON.stringify({ energy: energy.toFixed(1) }));\n      try { track.addCue(cue); } catch (_) {}\n    }\n  }\n\n  function renderTimeline() {\n    timelineEl.innerHTML = '';\n    cues.forEach((c, idx) => {\n      const el = document.createElement('div');\n      el.className = 'cue' +\n        (viewingCueIdx === idx ? ' active' : '') +\n        (boundCueIdx === idx ? ' bound' : '');\n      el.textContent = c.t.toFixed(2) + 's · E' + c.energy.toFixed(0);\n      el.title = 'Click to inspect · Shift-click to bind';\n      el.addEventListener('click', e => {\n        if (e.shiftKey) {\n          boundCueIdx = idx;\n          applyBoundCue(c);\n        } else {\n          viewingCueIdx = idx;\n          snapshotToGrid(c.snapshot);\n        }\n        renderTimeline();\n      });\n      timelineEl.appendChild(el);\n    });\n    timelineEl.scrollLeft = timelineEl.scrollWidth;\n  }\n\n  timelineEl.addEventListener('dblclick', e => {\n    if (e.target === timelineEl) {\n      viewingCueIdx = null;\n      renderTimeline();\n    }\n  });\n\n  function applyBoundCue(c) {\n    document.documentElement.style.setProperty('--cue-energy', c.energy.toFixed(1));\n    const mode = c.energy > 55 ? 1 : c.energy > 35 ? 2 : 0;\n    opSelect.value = String(mode);\n    updateAdder();\n    statusEl.textContent = `Bound cue @ ${c.t.toFixed(2)}s → mode ${opSelect.options[mode].text}`;\n  }\n\n  bindBtn.addEventListener('click', () => {\n    if (viewingCueIdx !== null) {\n      boundCueIdx = viewingCueIdx;\n      applyBoundCue(cues[viewingCueIdx]);\n      renderTimeline();\n    } else {\n      statusEl.textContent = 'Select a cue first, then bind';\n    }\n  });\n  unbindBtn.addEventListener('click', () => {\n    boundCueIdx = null;\n    renderTimeline();\n    statusEl.textContent = 'Unbound';\n  });\n\n  // ---------- OffscreenCanvas Workers ----------\n  const workerCode = `\n    // CLA orbit from the 4-bit adder SVG (AA55 → 718E → EE11 → CA35)\n    const orbits = [\n      { word: 'AA55', label: 'unit 0 · nibble A · G0P0→C1', color: '#6d93ff', bases: ['A','A','5','5'] },\n      { word: '718E', label: 'unit 1 · nibble A · G1P1→C2', color: '#4ade80', bases: ['7','1','8','E'] },\n      { word: 'EE11', label: 'unit 2 · nibble 5 · G2P2→C3', color: '#fbbf24', bases: ['E','E','1','1'] },\n      { word: 'CA35', label: 'unit 3 · nibble 5 · G3P3→C4', color: '#ff6b68', bases: ['C','A','3','5'] }\n    ];\n    const dnaPairs = { A:'T', T:'A', G:'C', C:'G', '5':'A', '7':'T', '1':'A', '8':'G', 'E':'C', '3':'G' };\n    const rnaPairs = { A:'U', U:'A', G:'C', C:'G', '5':'A', '7':'U', '1':'A', '8':'G', 'E':'C', '3':'G' };\n    const baseColors = {\n      A:'#ff6b6b', T:'#4ecdc4', U:'#45b7d1', G:'#96ceb4', C:'#ffeaa7',\n      '5':'#ff6b6b', '7':'#4ecdc4', '1':'#ff6b6b', '8':'#96ceb4', 'E':'#ffeaa7', '3':'#96ceb4'\n    };\n\n    let canvas, ctx, W, H, state = { A:0, B:0, result:0, carry:0, mode:0, topo:0, energy:0 };\n    let t = 0;\n\n    function drawHelixBackbone(cx, cy, amp, len, phase, isRNA, active) {\n      const steps = 48;\n      ctx.beginPath();\n      for (let i = 0; i <= steps; i++) {\n        const frac = i / steps;\n        const x = cx - len/2 + frac * len;\n        const y = cy + Math.sin(frac * Math.PI * 4 + phase) * amp;\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      }\n      ctx.strokeStyle = active\n        ? (isRNA ? 'rgba(69,183,209,0.75)' : 'rgba(109,147,255,0.75)')\n        : 'rgba(80,90,110,0.35)';\n      ctx.lineWidth = isRNA ? 2.2 : 2.8;\n      ctx.lineCap = 'round';\n      ctx.stroke();\n      if (!isRNA) {\n        ctx.beginPath();\n        for (let i = 0; i <= steps; i++) {\n          const frac = i / steps;\n          const x = cx - len/2 + frac * len;\n          const y = cy + Math.sin(frac * Math.PI * 4 + phase + Math.PI) * amp;\n          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n        }\n        ctx.strokeStyle = active ? 'rgba(78,205,196,0.7)' : 'rgba(80,90,110,0.3)';\n        ctx.lineWidth = 2.8;\n        ctx.stroke();\n      }\n    }\n\n    function drawBasePair(x, y1, y2, base, complement, active, pulse) {\n      ctx.beginPath();\n      ctx.moveTo(x, y1); ctx.lineTo(x, y2);\n      ctx.strokeStyle = active\n        ? 'rgba(255,255,255,' + (0.2 + pulse * 0.55) + ')'\n        : 'rgba(100,110,130,0.18)';\n      ctx.lineWidth = 1.4 + pulse * 2.2;\n      ctx.stroke();\n\n      const r = 6.5 + pulse * 4;\n      ctx.beginPath();\n      ctx.arc(x, y1, r, 0, Math.PI * 2);\n      ctx.fillStyle = active ? (baseColors[base] || '#aaa') : '#334155';\n      ctx.fill();\n      if (active && pulse > 0.35) {\n        ctx.strokeStyle = 'rgba(255,255,255,0.55)';\n        ctx.lineWidth = 1;\n        ctx.stroke();\n      }\n      ctx.beginPath();\n      ctx.arc(x, y2, r * 0.9, 0, Math.PI * 2);\n      ctx.fillStyle = active ? (baseColors[complement] || '#888') : '#2a3142';\n      ctx.fill();\n      if (active) {\n        ctx.fillStyle = '#0a0a0e';\n        ctx.font = 'bold 8px ui-monospace, monospace';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(base, x, y1);\n        ctx.fillText(complement, x, y2);\n      }\n    }\n\n    function render() {\n      if (!ctx) return;\n      t += 0.018;\n      const orbit = orbits[state.topo % 4];\n      const isRNA = (state.topo % 2 === 1);\n      const pairs = isRNA ? rnaPairs : dnaPairs;\n\n      ctx.fillStyle = '#07080c';\n      ctx.fillRect(0, 0, W, H);\n\n      ctx.fillStyle = 'rgba(0,0,0,0.55)';\n      ctx.fillRect(0, 0, W, 26);\n      ctx.fillStyle = orbit.color;\n      ctx.font = 'bold 11px ui-monospace, monospace';\n      ctx.textAlign = 'left';\n      ctx.fillText((isRNA ? 'RNA' : 'DNA') + '  ·  ' + orbit.word, 8, 17);\n\n      ctx.fillStyle = '#94a3b8';\n      ctx.font = '9px ui-monospace, monospace';\n      ctx.fillText(orbit.label, 8, 40);\n\n      const energy = Math.min(1, state.energy / 80);\n      const bitPulse = ((state.A ^ state.B) & 0xF) / 15;\n      const stageActive = energy > 0.12 || bitPulse > 0.08;\n\n      const cx = W / 2;\n      const cy = H / 2 + 8;\n      const amp = Math.min(28, H * 0.18);\n      const len = W * 0.78;\n      const phase = t * 1.4 + state.topo * 0.8;\n\n      drawHelixBackbone(cx, cy, amp, len, phase, isRNA, stageActive);\n\n      const numPairs = 12;\n      for (let i = 0; i < numPairs; i++) {\n        const frac = (i + 0.5) / numPairs;\n        const x = cx - len/2 + frac * len;\n        const y1 = cy + Math.sin(frac * Math.PI * 4 + phase) * amp;\n        const y2 = isRNA\n          ? y1 + (i % 2 ? 14 : -14)\n          : cy + Math.sin(frac * Math.PI * 4 + phase + Math.PI) * amp;\n\n        const orbitBase = orbit.bases[i % 4];\n        const bit = (state.result >> (i % 4)) & 1;\n        const base = bit ? orbitBase : (isRNA ? 'U' : 'T');\n        const complement = pairs[base] || (isRNA ? 'A' : 'A');\n\n        const wave = 0.5 + 0.5 * Math.sin(t * 3.5 - i * 0.55);\n        const pulse = Math.min(1, energy * 0.7 + bit * 0.5 + wave * 0.35);\n\n        drawBasePair(x, y1, y2, base, complement, stageActive || pulse > 0.4, pulse);\n      }\n\n      const topoNames = ['XOR-5', 'XOR-6', 'XOR-8', 'XOR-10'];\n      ctx.fillStyle = 'rgba(0,0,0,0.45)';\n      ctx.fillRect(W - 58, 4, 52, 18);\n      ctx.fillStyle = orbit.color;\n      ctx.font = 'bold 10px ui-monospace, monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText(topoNames[state.topo % 4], W - 32, 16);\n\n      ctx.fillStyle = '#1e293b';\n      ctx.fillRect(8, H - 12, W - 16, 5);\n      ctx.fillStyle = orbit.color;\n      ctx.fillRect(8, H - 12, (W - 16) * Math.min(1, state.energy / 100), 5);\n\n      const modes = ['ADD', 'SUB', 'XOR', 'AND'];\n      ctx.fillStyle = 'rgba(0,0,0,0.5)';\n      ctx.fillRect(W - 48, H - 28, 40, 14);\n      ctx.fillStyle = '#94a3b8';\n      ctx.font = '9px ui-monospace, monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText(modes[state.mode] || 'ADD', W - 28, H - 18);\n\n      requestAnimationFrame(render);\n    }\n\n    self.onmessage = (e) => {\n      const msg = e.data;\n      if (msg.type === 'init') {\n        canvas = msg.canvas;\n        ctx = canvas.getContext('2d');\n        W = canvas.width;\n        H = canvas.height;\n        state.topo = msg.topo;\n        render();\n      } else if (msg.type === 'state') {\n        Object.assign(state, msg);\n      } else if (msg.type === 'resize') {\n        if (canvas) {\n          canvas.width = msg.w;\n          canvas.height = msg.h;\n          W = msg.w; H = msg.h;\n        }\n      }\n    };\n  `;\n\n  const workers = [];\n\n  function initWorkers() {\n    const blob = new Blob([workerCode], { type: 'application/javascript' });\n    const url = URL.createObjectURL(blob);\n\n    for (let i = 0; i < 4; i++) {\n      const cv = document.getElementById('cv' + i);\n      const rect = cv.parentElement.getBoundingClientRect();\n      cv.width = Math.max(200, Math.floor(rect.width * devicePixelRatio));\n      cv.height = Math.max(160, Math.floor(rect.height * devicePixelRatio));\n\n      const off = cv.transferControlToOffscreen();\n      const w = new Worker(url);\n      w.postMessage({ type: 'init', canvas: off, topo: i }, [off]);\n      workers.push(w);\n    }\n    URL.revokeObjectURL(url);\n  }\n\n  const ro = new ResizeObserver(entries => {\n    entries.forEach(entry => {\n      const idx = ['cam0','cam1','cam2','cam3'].indexOf(entry.target.id);\n      if (idx < 0 || !workers[idx]) return;\n      const w = Math.floor(entry.contentRect.width * devicePixelRatio);\n      const h = Math.floor(entry.contentRect.height * devicePixelRatio);\n      workers[idx].postMessage({ type: 'resize', w, h });\n    });\n  });\n  ['cam0','cam1','cam2','cam3'].forEach(id => ro.observe(document.getElementById(id)));\n\n  function resizeOscilloscope() {\n    const wrap = document.getElementById('oscilloscope-wrap');\n    if (!wrap || !oscCanvas) return;\n    const rect = wrap.getBoundingClientRect();\n    const dpr = window.devicePixelRatio || 1;\n    oscCanvas.width = Math.floor(rect.width * dpr);\n    oscCanvas.height = Math.floor(110 * dpr);\n    oscCanvas.style.width = rect.width + 'px';\n    oscCanvas.style.height = '110px';\n  }\n  window.addEventListener('resize', resizeOscilloscope);\n  requestAnimationFrame(resizeOscilloscope);\n\n  // boot\n  initWorkers();\n  updateAdder();\n  statusEl.textContent = 'Workers live · load audio or use mic';\n})();\n</script>\n</body>\n</html>\n
      OPEN
    OPEN
  OPEN
