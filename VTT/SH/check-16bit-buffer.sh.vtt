<c.HEAD>"FILE=${1:-}"</c>

SH/check-16bit-buffer.sh#7
00:00:06.000 --> 00:00:07.000
<c.HEAD>"[ -n ""$FILE"" ] || {"</c>

SH/check-16bit-buffer.sh#8
